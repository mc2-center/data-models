@prefix cckp:  <https://w3id.org/mc2-center/cckp-portal/> .
@prefix shape: <https://w3id.org/mc2-center/cckp-portal/shapes#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix sagecdm: <https://sage-bionetworks.github.io/SageCommonDataModel/> .

#################################################################
#    Shapes graph
#################################################################
#
# Instance-level structural checks for the CCKP portal graph - checked
# against data/rdf/cckp_kg.ttl by `make validate` and against
# cckp_kg_full.ttl (which adds the SCDM crosswalk edges §3a covers) by
# `make full-kg`. Also uploaded alongside the graph, so it doubles as the
# published graph's own description of its instance constraints. Kept separate
# from schema/cckp_portal.ttl (the OWL/LinkML-generated T-Box) the same way
# sagebrain-model keeps ontology/shacl/sagebrain-shapes.ttl separate from
# ontology/main/sagebrain.ttl: the T-Box stays a monotonic, open-world
# description; these shapes enforce closed-world instance constraints that
# rdfs:range/domain alone can't (e.g. a *specific* join property's object
# must have a specific rdf:type, not just any type in the union of that
# property's declared ranges across every field that reuses "Ref"/"Term"
# naming).
#
# Run WITHOUT RDFS/OWL entailment (matches sagebrain-shapes.ttl's own
# configuration note) - inference would make sh:class checks vacuous by
# entailing the type these shapes are supposed to be verifying.

<https://w3id.org/mc2-center/cckp-portal/shapes>
    a owl:Ontology ;
    dcterms:title "CCKP portal graph -- SHACL shapes" .

#################################################################
#    1. Per-class identifying-field shapes
#################################################################
#
# Dataset and Grant have a LinkML `identifier` slot, so each instance must
# carry exactly one. Publication, Tool, and EducationalResource have no
# identifier slot: build_triples.py's mint_id() keys them on the fields in
# FALLBACK_ID_FIELD, falling back to a synthetic ID when those are blank so
# the build doesn't crash on one bad row. Their shapes constrain the fields
# the schema actually declares (Tool.toolName is `required: true`,
# Publication.pubMedId is `range: integer`), so a row that only reached the
# synthetic fallback because it breaks those declarations is flagged here.
#
# ToolShape.toolName, EducationalResourceShape.title/alias, and
# PublicationShape.pubMedId are `sh:severity sh:Warning`: they're literal
# data-quality checks on one dirty row's own field, not structural graph
# damage, so one bad row is reported but doesn't block `make full-kg`/
# deploy. DatasetShape/GrantShape keep the default sh:Violation: their
# datasetId/grantId is the always-populated identifier slot, so a missing
# or mistyped one means extraction itself broke.

shape:DatasetShape
    a sh:NodeShape ;
    sh:targetClass cckp:Dataset ;
    rdfs:label "Dataset shape" ;
    sh:property [
        sh:path cckp:datasetId ;
        sh:name "datasetId" ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Every Dataset instance must have exactly one datasetId - it is the field build_triples.py's mint_id() uses to mint this instance's own IRI." ;
    ] .

shape:GrantShape
    a sh:NodeShape ;
    sh:targetClass cckp:Grant ;
    rdfs:label "Grant shape" ;
    sh:property [
        sh:path cckp:grantId ;
        sh:name "grantId" ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Every Grant instance must have exactly one grantId." ;
    ] .

shape:PublicationShape
    a sh:NodeShape ;
    sh:targetClass cckp:Publication ;
    rdfs:label "Publication shape" ;
    sh:property [
        sh:path cckp:pubMedId ;
        sh:name "pubMedId" ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:severity sh:Warning ;
        sh:message "A Publication instance may have at most one pubMedId, typed xsd:integer. A missing pubMedId is allowed (e.g. preprints; mint_id() then falls back to a synthetic ID). A non-integer value (a PMCID, a DOI) is kept by build_triples.py as a plain literal and fails this check." ;
    ] .

shape:ToolShape
    a sh:NodeShape ;
    sh:targetClass cckp:Tool ;
    rdfs:label "Tool shape" ;
    sh:property [
        sh:path cckp:toolName ;
        sh:name "toolName" ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Warning ;
        sh:message "Every Tool instance must have exactly one toolName (required in the schema, and the key mint_id() uses to mint this instance's own IRI). A Tool without one was minted from a synthetic fallback ID." ;
    ] .

shape:EducationalResourceShape
    a sh:NodeShape ;
    sh:targetClass cckp:EducationalResource ;
    rdfs:label "EducationalResource shape" ;
    sh:property [
        sh:path cckp:title ;
        sh:name "title" ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Warning ;
        sh:message "Every EducationalResource instance must have exactly one title." ;
    ] ;
    sh:property [
        sh:path cckp:alias ;
        sh:name "alias" ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Warning ;
        sh:message "An EducationalResource instance may have at most one alias (its Synapse ID). mint_id() keys on internalIdentifier first and alias when that is blank, so a second alias means two rows with different aliases were merged on a shared internalIdentifier." ;
    ] .

#################################################################
#    2. External-identifier IRI shapes (doi/pubMedId templating)
#################################################################
#
# scripts/build_triples.py's external_iri() only ever emits a cckp:doiIri /
# cckp:pubMedIdIri triple when the raw value's shape matched a real DOI or
# PubMed pattern (sentinel placeholders like "Pending Annotation" are
# skipped, never templated into a fake IRI) - these shapes assert that
# guarantee holds in the actual built graph, not just in the code.

shape:DoiIriShape
    a sh:NodeShape ;
    sh:targetSubjectsOf cckp:doiIri ;
    rdfs:label "DOI external-IRI shape" ;
    sh:property [
        sh:path cckp:doiIri ;
        sh:name "doiIri" ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^https://doi\\.org/10\\." ;
        sh:message "cckp:doiIri must be a real https://doi.org/10.* IRI, never a placeholder." ;
    ] .

shape:PubMedIdIriShape
    a sh:NodeShape ;
    sh:targetSubjectsOf cckp:pubMedIdIri ;
    rdfs:label "PubMed external-IRI shape" ;
    sh:property [
        sh:path cckp:pubMedIdIri ;
        sh:name "pubMedIdIri" ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^https://(pubmed\\.ncbi\\.nlm\\.nih\\.gov/|doi\\.org/10\\.)" ;
        sh:message "cckp:pubMedIdIri must be a real PubMed or DOI IRI (external_iri() detects the kind from the value's shape, not the field name), never a placeholder." ;
    ] .

shape:PublicationIdIriShape
    a sh:NodeShape ;
    sh:targetSubjectsOf cckp:publicationIdIri ;
    rdfs:label "publicationId external-IRI shape" ;
    sh:property [
        sh:path cckp:publicationIdIri ;
        sh:name "publicationIdIri" ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^https://(pubmed\\.ncbi\\.nlm\\.nih\\.gov/|doi\\.org/10\\.)" ;
        sh:message "cckp:publicationIdIri must be a real PubMed or DOI IRI, never a placeholder. EducationalResource.publicationId is a PubMed-join field, but a DOI there still yields a DOI IRI (external_iri() detects the kind from the value's shape)." ;
    ] .

#################################################################
#    3. Join-property range-typing shapes
#################################################################
#
# rdfs:range on a `cckp:{field}Ref` property (from the LinkML-generated
# T-Box) can only state the union of every class that field's cckp_join
# annotation ever targets across Dataset/Publication/Tool/Grant/
# EducationalResource. sh:class here states the one true target per
# specific ref property, which the union can't - mirrors sagebrain-shapes.ttl's
# own justification for why per-pair sh:class is strictly stronger than the
# ontology's rdfs:range union.

shape:GrantNumberRefShape
    a sh:NodeShape ;
    sh:targetSubjectsOf cckp:grantNumberRef ;
    rdfs:label "grantNumberRef join-target shape" ;
    sh:property [
        sh:path cckp:grantNumberRef ;
        sh:name "grantNumberRef target" ;
        sh:class cckp:Grant ;
        sh:message "cckp:grantNumberRef must point at a cckp:Grant instance." ;
    ] .

shape:PubMedIdRefShape
    a sh:NodeShape ;
    sh:targetSubjectsOf cckp:pubMedIdRef ;
    rdfs:label "pubMedIdRef join-target shape" ;
    sh:property [
        sh:path cckp:pubMedIdRef ;
        sh:name "pubMedIdRef target" ;
        sh:class cckp:Publication ;
        sh:message "cckp:pubMedIdRef must point at a cckp:Publication instance." ;
    ] .

shape:PublicationIdRefShape
    a sh:NodeShape ;
    sh:targetSubjectsOf cckp:publicationIdRef ;
    rdfs:label "publicationIdRef join-target shape" ;
    sh:property [
        sh:path cckp:publicationIdRef ;
        sh:name "publicationIdRef target" ;
        sh:class cckp:Publication ;
        sh:message "cckp:publicationIdRef must point at a cckp:Publication instance." ;
    ] .

shape:DatasetRefShape
    a sh:NodeShape ;
    sh:targetSubjectsOf cckp:datasetRef ;
    rdfs:label "datasetRef join-target shape" ;
    sh:property [
        sh:path cckp:datasetRef ;
        sh:name "datasetRef target" ;
        sh:class cckp:Dataset ;
        sh:message "cckp:datasetRef must point at a cckp:Dataset instance." ;
    ] .

shape:DatasetsRefShape
    a sh:NodeShape ;
    sh:targetSubjectsOf cckp:datasetsRef ;
    rdfs:label "datasetsRef join-target shape" ;
    sh:property [
        sh:path cckp:datasetsRef ;
        sh:name "datasetsRef target" ;
        sh:class cckp:Dataset ;
        sh:message "cckp:datasetsRef must point at a cckp:Dataset instance." ;
    ] .

#################################################################
#    3a. SCDM-crosswalk ref shapes
#################################################################
#
# These edges come from scripts/link_scdm.py (scdm_links.ttl), which is
# merged into data/rdf/cckp_kg_full.ttl but not cckp_kg.ttl. They are
# checked by `make full-kg`'s SHACL step and pass trivially under
# `make validate`.

shape:InstitutionRefShape
    a sh:NodeShape ;
    sh:targetSubjectsOf cckp:institutionRef ;
    rdfs:label "institutionRef join-target shape" ;
    sh:property [
        sh:path cckp:institutionRef ;
        sh:name "institutionRef target" ;
        sh:class sagecdm:Organization ;
        sh:message "cckp:institutionRef must point at a sagecdm:Organization instance." ;
    ] .

shape:ConsortiumRefShape
    a sh:NodeShape ;
    sh:targetSubjectsOf cckp:consortiumRef ;
    rdfs:label "consortiumRef join-target shape" ;
    sh:property [
        sh:path cckp:consortiumRef ;
        sh:name "consortiumRef target" ;
        sh:class sagecdm:Program ;
        sh:message "cckp:consortiumRef must point at a sagecdm:Program instance." ;
    ] .

shape:InvestigatorRefShape
    a sh:NodeShape ;
    sh:targetSubjectsOf cckp:investigatorRef ;
    rdfs:label "investigatorRef join-target shape" ;
    sh:property [
        sh:path cckp:investigatorRef ;
        sh:name "investigatorRef target" ;
        sh:class sagecdm:Person ;
        sh:message "cckp:investigatorRef must point at a sagecdm:Person instance. These targets are provisional stubs (cckp:provisional true) built from free-text names, not resolved identities." ;
    ] .

shape:ContributorRefShape
    a sh:NodeShape ;
    sh:targetSubjectsOf cckp:contributorRef ;
    rdfs:label "contributorRef join-target shape" ;
    sh:property [
        sh:path cckp:contributorRef ;
        sh:name "contributorRef target" ;
        sh:class sagecdm:Person ;
        sh:message "cckp:contributorRef must point at a sagecdm:Person instance. These targets are provisional stubs (cckp:provisional true) built from free-text names, not resolved identities." ;
    ] .
