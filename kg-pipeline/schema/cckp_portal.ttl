@prefix cckp: <https://w3id.org/mc2-center/cckp-portal/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/mc2-center/cckp-portal.owl.ttl> a owl:Ontology ;
    rdfs:label "cckp_portal" ;
    owl:imports cckp:mc2_model.linkml ;
    skos:definition "LinkML schema for the public discovery-layer entities of the Cancer Complexity Knowledge Portal (CCKP), as queried from their backing Synapse View tables. Reuses controlled-vocabulary enums from the MC2 Center data model (mc2_model.linkml.yaml) wherever a CCKP column corresponds to an MC2-governed attribute, so ontology IRI mappings are inherited rather than redefined." .

cckp:Dataset a owl:Class ;
    rdfs:label "Dataset" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cckp:datasetId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cckp:dataType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
