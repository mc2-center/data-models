            owl:allValuesFrom xsd:string ;
            owl:onProperty cckp:assay ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cckp:datasetAlias ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cckp:externalLink ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cckp:tumorType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cckp:overallDesign ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cckp:description ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty cckp:datasetName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cckp:theme ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cckp:pubMedId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cckp:tissue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cckp:downloadType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cckp:species ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cckp:publicationTitle ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cckp:datasetName ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
