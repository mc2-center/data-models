        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cckp:downloadSynId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty cckp:version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cckp:grantName ],
        [ a owl:Restriction ;
