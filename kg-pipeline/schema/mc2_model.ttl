    rdfs:subClassOf mc2:DatasetGrantNumberEnum .

<https://w3id.org/mc2-center/mc2-model/DatasetGrantNumberEnum#CA193489> a owl:Class ;
    rdfs:label "CA193489" ;
    rdfs:subClassOf mc2:DatasetGrantNumberEnum .

<https://w3id.org/mc2-center/mc2-model/DatasetGrantNumberEnum#CA195469> a owl:Class ;
    rdfs:label "CA195469" ;
    rdfs:subClassOf mc2:DatasetGrantNumberEnum .

<https://w3id.org/mc2-center/mc2-model/DatasetGrantNumberEnum#CA199315> a owl:Class ;
    rdfs:label "CA199315" ;
    rdfs:subClassOf mc2:DatasetGrantNumberEnum .

<https://w3id.org/mc2-center/mc2-model/DatasetGrantNumberEnum#CA202123> a owl:Class ;
    rdfs:label "CA202123" ;
    rdfs:subClassOf mc2:DatasetGrantNumberEnum .

<https://w3id.org/mc2-center/mc2-model/DatasetGrantNumberEnum#CA202144> a owl:Class ;
    rdfs:label "CA202144" ;
    rdfs:subClassOf mc2:DatasetGrantNumberEnum .

<https://w3id.org/mc2-center/mc2-model/DatasetGrantNumberEnum#CA202177> a owl:Class ;
    rdfs:label "CA202177" ;
    rdfs:subClassOf mc2:DatasetGrantNumberEnum .

<https://w3id.org/mc2-center/mc2-model/DatasetGrantNumberEnum#CA202229> a owl:Class ;
    rdfs:label "CA202229" ;
    rdfs:subClassOf mc2:DatasetGrantNumberEnum .

<https://w3id.org/mc2-center/mc2-model/DatasetGrantNumberEnum#CA202241> a owl:Class ;
    rdfs:label "CA202241" ;
    rdfs:subClassOf mc2:DatasetGrantNumberEnum .

<https://w3id.org/mc2-center/mc2-model/DatasetGrantNumberEnum#CA209891> a owl:Class ;
    rdfs:label "CA209891" ;
    rdfs:subClassOf mc2:DatasetGrantNumberEnum .

<https://w3id.org/mc2-center/mc2-model/DatasetGrantNumberEnum#CA209923> a owl:Class ;
    rdfs:label "CA209923" ;
    rdfs:subClassOf mc2:DatasetGrantNumberEnum .

<https://w3id.org/mc2-center/mc2-model/DatasetGrantNumberEnum#CA209971> a owl:Class ;
    rdfs:label "CA209971" ;
    rdfs:subClassOf mc2:DatasetGrantNumberEnum .

<https://w3id.org/mc2-center/mc2-model/DatasetGrantNumberEnum#CA209975> a owl:Class ;
    rdfs:label "CA209975" ;
