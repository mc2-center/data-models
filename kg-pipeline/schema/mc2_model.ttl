    rdfs:subClassOf mc2:ToolInputDataEnum,
        mc2:ToolOutputDataEnum .

EDAM:data_3768 a owl:Class ;
    rdfs:label "Clustered Expression Profiles" ;
    rdfs:subClassOf mc2:ToolInputDataEnum,
        mc2:ToolOutputDataEnum .

EDAM:data_3842 a owl:Class ;
    rdfs:label "Molecular Simulation Data" ;
    rdfs:subClassOf mc2:ToolInputDataEnum,
        mc2:ToolOutputDataEnum .

EDAM:data_3861 a owl:Class ;
    rdfs:label "Electronic Health Record" ;
    rdfs:subClassOf mc2:ToolInputDataEnum,
        mc2:ToolOutputDataEnum .

EDAM:data_3869 a owl:Class ;
    rdfs:label "Simulation" ;
    rdfs:subClassOf mc2:ToolInputDataEnum,
        mc2:ToolOutputDataEnum .

EDAM:data_3870 a owl:Class ;
    rdfs:label "Trajectory Data" ;
    rdfs:subClassOf mc2:ToolInputDataEnum,
        mc2:ToolOutputDataEnum .

EDAM:data_3872 a owl:Class ;
    rdfs:label "Topology Data" ;
    rdfs:subClassOf mc2:ToolInputDataEnum,
        mc2:ToolOutputDataEnum .

EDAM:data_3905 a owl:Class ;
    rdfs:label "Histogram" ;
    rdfs:subClassOf mc2:ToolInputDataEnum,
        mc2:ToolOutputDataEnum .

EDAM:data_3953 a owl:Class ;
    rdfs:label "Pathway Overrepresentation Data" ;
    rdfs:subClassOf mc2:ToolInputDataEnum,
        mc2:ToolOutputDataEnum .

EDAM:format_1333 a owl:Class ;
    rdfs:label "BLAST Results" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of results from a sequence database search using some variant of BLAST, including score data, alignment data, and summary tables." .

EDAM:format_1457 a owl:Class ;
    rdfs:label "Dot-Bracket Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format for RNA secondary structure using dot-bracket notation, originally generated by the Vienna RNA package/server." .

EDAM:format_1476 a owl:Class ;
    rdfs:label "PDB" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Protein Data Bank (PDB) format, a text-based format for representing macromolecular tertiary structure (atomic coordinates) and associated metadata, as used by PDB database entries." .

EDAM:format_1638 a owl:Class ;
    rdfs:label "cel" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of an Affymetrix CEL data file containing (raw) expression intensity information for individual probes on a microarray." .

EDAM:format_1644 a owl:Class ;
    rdfs:label "CHP" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "Format of an Affymetrix data file containing computed (normalized) expression, genotyping, or resequencing results for individual probes on a microarray, generated by Affymetrix analysis software." .

EDAM:format_1912 a owl:Class ;
    rdfs:label "Nexus Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Phylogenetic tree Nexus (text) format, used to store aligned sequences and/or tree data along with associated metadata blocks." .

EDAM:format_1919 a owl:Class ;
    rdfs:label "Sequence Record Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Data format for a molecular sequence record." .

EDAM:format_1920 a owl:Class ;
    rdfs:label "Sequence Feature Annotation Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Data format for molecular sequence feature information." .

EDAM:format_1921 a owl:Class ;
    rdfs:label "Alignment Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Data format for molecular sequence alignment information." .

EDAM:format_1930 a owl:Class ;
    rdfs:label "FASTQ" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Text-based format for storing both a biological sequence (usually nucleotide) and its corresponding quality scores, most commonly used for raw sequencing reads." .

EDAM:format_1931 a owl:Class ;
    rdfs:label "FASTQ-Illumina" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "FASTQ short read format variant using the Illumina 1.3+ quality-score encoding scheme." .

EDAM:format_1935 a owl:Class ;
    rdfs:label "GCG" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "GCG is a legacy sequence file format originally used by the Genetics Computer Group (GCG) software suite, now part of the Wisconsin Package, for representing annotated nucleotide or protein sequences." .

EDAM:format_1975 a owl:Class ;
    rdfs:label "GFF3" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Generic Feature Format version 3 (GFF3), a tab-delimited format for describing genomic features with a well-defined hierarchy of parent-child relationships." .

EDAM:format_1997 a owl:Class ;
    rdfs:label "Phylip Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "PHYLIP format for (aligned) molecular sequences, used by the PHYLIP phylogenetics software package." .

EDAM:format_1999 a owl:Class ;
    rdfs:label "Scores Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Alignment format for score values associated with pairs of sequences." .

EDAM:format_2006 a owl:Class ;
    rdfs:label "Phylogenetic Tree Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Data format for representing a phylogenetic tree." .

EDAM:format_2030 a owl:Class ;
    rdfs:label "Chemical Data Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of a report on a chemical compound or other chemical data." .

EDAM:format_2031 a owl:Class ;
    rdfs:label "Gene Annotation Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of a report on a particular locus, gene, gene system, or group of genes." .

EDAM:format_2032 a owl:Class ;
    rdfs:label "Workflow Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format used to represent a computational workflow." .

EDAM:format_2033 a owl:Class ;
    rdfs:label "Tertiary Structure Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Data format for a molecular tertiary (3D) structure." .

EDAM:format_2054 a owl:Class ;
    rdfs:label "Protein Interaction Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format for molecular (protein-protein) interaction data." .

EDAM:format_2057 a owl:Class ;
    rdfs:label "Sequence Trace Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format for sequence trace data, including base-call information from a sequencing instrument." .

EDAM:format_2058 a owl:Class ;
    rdfs:label "Gene Expression Report Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of a file of gene expression data, such as a gene expression matrix or profile." .

EDAM:format_2060 a owl:Class ;
    rdfs:label "Map Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "A format used to encode a genetic or physical map, specifying the positions and/or order of markers such as SNPs or genes along a chromosome (e.g. PLINK MAP files)." .

EDAM:format_2066 a owl:Class ;
    rdfs:label "Database Hits (Sequence) Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of a report on sequence hits and associated data from searching a sequence database." .

EDAM:format_2069 a owl:Class ;
    rdfs:label "Sequence Profile Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of a sequence profile, e.g. summarizing conserved positions across a family of aligned sequences." .

EDAM:format_2072 a owl:Class ;
    rdfs:label "Hidden Markov Model Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format for representing a hidden Markov model, e.g. as used for sequence profile searching." .

EDAM:format_2076 a owl:Class ;
    rdfs:label "RNA Secondary Structure Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format for the (predicted or experimentally determined) secondary structure of an RNA molecule." .

EDAM:format_2078 a owl:Class ;
    rdfs:label "Sequence Range Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format used to specify one or more ranges of sequence positions." .

EDAM:format_2170 a owl:Class ;
    rdfs:label "Sequence Cluster Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format used to represent clusters of molecular sequences." .

EDAM:format_2171 a owl:Class ;
    rdfs:label "Sequence Cluster Format (Protein)" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format used to represent clusters of protein sequences." .

EDAM:format_2195 a owl:Class ;
    rdfs:label "Ontology Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "A generic category of formats used for representing ontologies." .

EDAM:format_2206 a owl:Class ;
    rdfs:label "Sequence Feature Table Format (Text)" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Text-based format for a table of sequence features." .

EDAM:format_2305 a owl:Class ;
    rdfs:label "GFF" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "General/Generic Feature Format (GFF) for describing genes and other sequence features, of indeterminate version." .

EDAM:format_2306 a owl:Class ;
    rdfs:label "GTF" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Gene Transfer Format (GTF), a restricted, more strictly-defined version of GFF used to describe gene structure annotations." .

EDAM:format_2333 a owl:Class ;
    rdfs:label "Binary Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "A generic format in which data is encoded as binary, machine-readable content rather than plain text." .

EDAM:format_2548 a owl:Class ;
    rdfs:label "Sequence Feature Table Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format for a table of sequence features." .

EDAM:format_2554 a owl:Class ;
    rdfs:label "Alignment Format (Text)" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Text-based format for molecular sequence alignment information." .

EDAM:format_2556 a owl:Class ;
    rdfs:label "Phylogenetic Tree Format (Text)" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Text-based format for representing a phylogenetic tree." .

EDAM:format_2571 a owl:Class ;
    rdfs:label "Raw Sequence Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of a raw molecular sequence, i.e. specifying only the alphabet/characters used with no additional annotation." .

EDAM:format_2572 a owl:Class ;
    rdfs:label "BAM" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "BAM format, the binary, BGZF-compressed version of SAM format for alignment of nucleotide sequences (e.g. sequencing reads) to a reference sequence; may contain base-call and alignment qualities and other data." .

EDAM:format_2573 a owl:Class ;
    rdfs:label "SAM" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Sequence Alignment/Map (SAM) format, a text-based format for storing alignments of nucleotide sequences (e.g. sequencing reads) to a reference sequence, including base-call and alignment qualities." .

EDAM:format_2585 a owl:Class ;
    rdfs:label "SBML" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Systems Biology Markup Language (SBML), the standard XML format for encoding models of biological processes such as metabolism, cell signaling, and gene regulation." .

EDAM:format_2919 a owl:Class ;
    rdfs:label "Sequence Annotation Track Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of a sequence annotation track, typically displayed as a row of features in a genome browser." .

EDAM:format_2920 a owl:Class ;
    rdfs:label "Alignment Format (Pair Only)" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Data format for molecular sequence alignment information that can hold the alignment of only two sequences." .

EDAM:format_2921 a owl:Class ;
    rdfs:label "Sequence Variation Annotation Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of sequence variation annotation, e.g. describing indels, polymorphisms, or structural variants." .

EDAM:format_2924 a owl:Class ;
    rdfs:label "Phylip Format Variant" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Some non-standard variant of PHYLIP format for (aligned) sequences." .

EDAM:format_3005 a owl:Class ;
    rdfs:label "WIG" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "Wiggle format (WIG) of a sequence annotation track that consists of a value for each sequence position, typically displayed in a genome browser." .

EDAM:format_3006 a owl:Class ;
    rdfs:label "bigWig" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "bigWig format, an indexed binary format for large sequence annotation tracks consisting of a value for each sequence position; similar to the textual WIG format." .

EDAM:format_3016 a owl:Class ;
    rdfs:label "VCF" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Variant Call Format (VCF), a tabular text format for storing genomic sequence variations such as SNPs, indels, and structural variants." .

EDAM:format_3020 a owl:Class ;
    rdfs:label "BCF" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "The binary version of Variant Call Format (VCF) used to store sequence variation data such as indels, polymorphisms, and structural variants." .

EDAM:format_3033 a owl:Class ;
    rdfs:label "Matrix Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of a matrix (array) of numerical values." .

EDAM:format_3161 a owl:Class ;
    rdfs:label "MAGE-ML" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "MAGE-ML, an XML-based format standardized by MGED (now FGED) for representing microarray gene expression data." .

EDAM:format_3162 a owl:Class ;
    rdfs:label "MAGE-TAB" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "MAGE-TAB, a tab-delimited textual format standardized by MGED (now FGED) for representing microarray gene expression data." .

EDAM:format_3235 a owl:Class ;
    rdfs:label "Cytoband Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format for chromosome cytoband data, reflecting a UCSC Genome Browser database table." .

EDAM:format_3244 a owl:Class ;
    rdfs:label "mzML" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "mzML, an XML-based format standardized by HUPO PSI for raw mass spectrometer output data; the successor and unifier of the earlier mzData and mzXML formats." .

EDAM:format_3245 a owl:Class ;
    rdfs:label "Mass Spectrometry Data Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format for mass spectra and derived data, including peptide sequences and related metadata." .

EDAM:format_3247 a owl:Class ;
    rdfs:label "mzIdentML" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "The exchange format for peptides and proteins identified from mass spectra, standardised by HUPO PSI-PI; it can be used for outputs of proteomics search engines." .

EDAM:format_3285 a owl:Class ;
    rdfs:label "MAP" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "MAP files are plain-text files that associate genomic marker positions with identifiers, most commonly the PLINK .map format used in genetics to record chromosome and position information for markers paired with a corresponding genotype file." .

EDAM:format_3287 a owl:Class ;
    rdfs:label "Individual Genetic Data Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format for metadata describing an individual along with their associated genetic data." .

EDAM:format_3464 a owl:Class ;
    rdfs:label "JSON" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "JavaScript Object Notation (JSON), a lightweight, text-based format for representing tree-structured data using key-value pairs." .

EDAM:format_3467 a owl:Class ;
    rdfs:label "GIF" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Graphics Interchange Format, a bitmap image format supporting compression and animation." .

EDAM:format_3468 a owl:Class ;
    rdfs:label "xls" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Microsoft Excel spreadsheet binary file format (.xls), used prior to the introduction of the XML-based .xlsx format." .

EDAM:format_3475 a owl:Class ;
    rdfs:label "TSV" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Tabular data represented as tab-separated values in a text file." .

EDAM:format_3477 a owl:Class ;
    rdfs:label "Cytoscape Input File Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of the Cytoscape input file in which gene expression ratios or values are specified over one or more experiments." .

EDAM:format_3507 a owl:Class ;
    rdfs:label "Document Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of documents, including word processor, spreadsheet, and presentation files." .

EDAM:format_3508 a owl:Class ;
    rdfs:label "PDF" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Portable Document Format (PDF), a fixed-layout document format for reliably presenting text, images, and formatting independent of application, hardware, or operating system." .

EDAM:format_3547 a owl:Class ;
    rdfs:label "Image Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "A generic category of formats used for images and associated image metadata." .

EDAM:format_3554 a owl:Class ;
    rdfs:label "R File Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "File format used for scripts written in the R programming language, executed within the R software environment for statistical computation and graphics." .

EDAM:format_3580 a owl:Class ;
    rdfs:label "rcc" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "Reporter Code Count (RCC) is a data file output by the NanoString nCounter Digital Analyzer, containing gene/sample information, probe information, and probe counts." .

EDAM:format_3583 a owl:Class ;
    rdfs:label "bedgraph" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "BedGraph format, a tab-delimited text format for displaying continuous-valued genomic data (e.g. probability scores) as a track." .

EDAM:format_3586 a owl:Class ;
    rdfs:label "bed12" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A BED file variant in which each feature is described using all twelve standard BED columns, with no non-standard columns allowed." .

EDAM:format_3603 a owl:Class ;
    rdfs:label "PNG" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Portable Network Graphics (PNG), a lossless bitmap image compression format intended to replace GIF." .

EDAM:format_3604 a owl:Class ;
    rdfs:label "SVG" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Scalable Vector Graphics (SVG), an XML-based vector image format for two-dimensional graphics supporting interactivity and animation." .

EDAM:format_3617 a owl:Class ;
    rdfs:label "Graph Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Data format for representing graph data, i.e. a set of nodes and the edges connecting them." .

EDAM:format_3619 a owl:Class ;
    rdfs:label "sif" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Simple Interaction Format (SIF), a plain-text network/pathway format used by tools such as Cytoscape to represent nodes and their interactions." .

EDAM:format_3620 a owl:Class ;
    rdfs:label "xlsx" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Microsoft Excel spreadsheet format (.xlsx) consisting of a set of XML documents packaged in a ZIP-compressed container." .

EDAM:format_3651 a owl:Class ;
    rdfs:label "MGF" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "Mascot Generic Format (MGF) is a text-based file format that encodes multiple tandem mass spectrometry (MS/MS) spectra, with m/z and intensity pairs, in a single file." .

EDAM:format_3654 a owl:Class ;
    rdfs:label "mzXML" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A common file format for proteomics mass spectrometric data developed at the Seattle Proteome Center/Institute for Systems Biology." .

EDAM:format_3682 a owl:Class ;
    rdfs:label "imzML Metadata File" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "The metadata XML file (.imzML) component of the imzML mass spectrometry imaging data format, based on mzML, that stores acquisition and instrument metadata; paired with a binary .ibd file containing the mass spectra." .

EDAM:format_3696 a owl:Class ;
    rdfs:label "PS" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "PostScript format, a page description language used for representing formatted printable or displayable documents and vector graphics." .

EDAM:format_3698 a owl:Class ;
    rdfs:label "SRA" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "SRA archive format is the archive format used for input to, and export from, the NCBI Sequence Read Archive, storing raw next-generation sequencing reads and associated metadata." .

EDAM:format_3709 a owl:Class ;
    rdfs:label "GCT/Res Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Tab-delimited text file format (used by GenePattern) containing a column for each sample, a row for each gene, and an expression value for each gene in each sample." .

EDAM:format_3727 a owl:Class ;
    rdfs:label "OME-TIFF" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Open Microscopy Environment TIFF (OME-TIFF), an image file format consisting of standard TIFF/BigTIFF data with OME-XML metadata embedded in the image description, used to store microscopy image data." .

EDAM:format_3750 a owl:Class ;
    rdfs:label "YAML" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "YAML (YAML Ain't Markup Language), a human-readable, tree-structured data serialization format." .

EDAM:format_3751 a owl:Class ;
    rdfs:label "DSV" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Tabular data represented as values delimited by some (non-comma, non-tab) character in a text file." .

EDAM:format_3752 a owl:Class ;
    rdfs:label "CSV" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Tabular data represented as comma-separated values in a text file." .

EDAM:format_3780 a owl:Class ;
    rdfs:label "Annotated Text Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Data format of an annotated text, e.g. with recognised entities, concepts, and relations." .

EDAM:format_3822 a owl:Class ;
    rdfs:label "GML" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Graph Modeling Language (GML), a plain-text format for describing graph/network data, used by tools such as Cytoscape, Pajek, yEd, and NetworkX." .

EDAM:format_3865 a owl:Class ;
    rdfs:label "RNA Annotation Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "A general category of formats for annotated RNA data, including e.g. microRNA and RNA-Seq data." .

EDAM:format_3866 a owl:Class ;
    rdfs:label "Trajectory Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "File format used to store trajectory information (e.g. atomic coordinates over time) for a 3D structure, such as from a molecular dynamics simulation." .

EDAM:format_3879 a owl:Class ;
    rdfs:label "Topology Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of topology files containing the static structural information of a molecular system needed for a molecular simulation (e.g. GROMACS TOP, CHARMM PSF, AMBER PRMTOP)." .

EDAM:format_3882 a owl:Class ;
    rdfs:label "PSF" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Protein Structure File (PSF), a structure topology file format used by NAMD and CHARMM molecular simulation programs, containing atoms, bonds, angles, dihedrals, and related force-field terms." .

EDAM:format_3972 a owl:Class ;
    rdfs:label "BNGL" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "BioNetGen Language (BNGL), a format for specifying and simulating rule-based models of biochemical systems such as signal transduction, metabolic, and genetic regulatory networks." .

EDAM:format_3973 a owl:Class ;
    rdfs:label "Docker Image Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "A Docker image is a file, comprised of multiple layers, used to execute code in a Docker container; it packages an application together with its dependencies for a complete, executable environment." .

EDAM:format_3980 a owl:Class ;
    rdfs:label "RPKM" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Tab-delimited format for a gene expression levels table, with values calculated as Reads Per Kilobase of transcript per Million mapped reads (RPKM)." .

EDAM:format_3988 a owl:Class ;
    rdfs:label "LSM" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Zeiss' proprietary microscopy image format (based on TIFF), the default data export format for Zeiss LSM-series confocal microscopes, containing image data plus imaging acquisition settings." .

EDAM:format_3996 a owl:Class ;
    rdfs:label "Python Script" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "File format for scripts written in Python, a widely used high-level, general-purpose programming language." .

EDAM:format_3999 a owl:Class ;
    rdfs:label "R Script" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format for scripts written in the R language, an open-source programming language and environment for statistical computing and graphics." .

EDAM:format_4003 a owl:Class ;
    rdfs:label "NumPy Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "The standard binary file format used by NumPy - a fundamental Python package for scientific computing - for persisting a single arbitrary NumPy array on disk, including its shape and dtype information." .

EDAM:topic_3295 a owl:Class ;
    rdfs:label "Epigenetics" ;
    rdfs:subClassOf mc2:GrantThemeNameEnum,
        mc2:ToolTopicEnum .

DUO:0000004 a owl:Class ;
    rdfs:label "DUO:0000004" ;
    rdfs:subClassOf mc2:DataUseModifiersEnum,
        mc2:StudyDataUseCodesEnum ;
    skos:definition "This data use permission indicates there is no restriction on use." .

DUO:0000006 a owl:Class ;
    rdfs:label "DUO:0000006" ;
    rdfs:subClassOf mc2:DataUseModifiersEnum,
        mc2:StudyDataUseCodesEnum ;
    skos:definition "This data use permission indicates that use is allowed for health/medical/biomedical purposes; does not include the study of population origins or ancestry." .

DUO:0000011 a owl:Class ;
    rdfs:label "DUO:0000011" ;
    rdfs:subClassOf mc2:DataUseModifiersEnum,
        mc2:StudyDataUseCodesEnum ;
    skos:definition "This data use permission indicates that use of the data is limited to the study of population origins or ancestry." .

DUO:0000015 a owl:Class ;
    rdfs:label "DUO:0000015" ;
    rdfs:subClassOf mc2:DataUseModifiersEnum,
        mc2:StudyDataUseCodesEnum ;
    skos:definition "This data use modifier indicates that use does not allow methods development research (e.g., development of software or algorithms)." .

DUO:0000016 a owl:Class ;
    rdfs:label "DUO:0000016" ;
    rdfs:subClassOf mc2:DataUseModifiersEnum,
        mc2:StudyDataUseCodesEnum ;
    skos:definition "This data use modifier indicates that use is limited to genetic studies only (i.e., studies that include genotype research alone or both genotype and phenotype research, but not phenotype research exclusively)" .

DUO:0000017 a owl:Class ;
    rdfs:label "DUO:0000017" ;
    rdfs:subClassOf mc2:DataUseModifiersEnum,
        mc2:StudyDataUseCodesEnum ;
    skos:definition "Data use modifiers indicate additional conditions for use." .

DUO:0000018 a owl:Class ;
    rdfs:label "DUO:0000018" ;
    rdfs:subClassOf mc2:DataUseModifiersEnum,
        mc2:StudyDataUseCodesEnum ;
    skos:definition "This data use modifier indicates that use of the data is limited to not-for-profit organizations and not-for-profit use, non-commercial use." .

DUO:0000019 a owl:Class ;
    rdfs:label "DUO:0000019" ;
    rdfs:subClassOf mc2:DataUseModifiersEnum,
        mc2:StudyDataUseCodesEnum ;
    skos:definition "This data use modifier indicates that requestor agrees to make results of studies using the data available to the larger scientific community." .

DUO:0000021 a owl:Class ;
    rdfs:label "DUO:0000021" ;
    rdfs:subClassOf mc2:DataUseModifiersEnum,
        mc2:StudyDataUseCodesEnum ;
    skos:definition "This data use modifier indicates that the requestor must provide documentation of local IRB/ERB approval." .

DUO:0000027 a owl:Class ;
    rdfs:label "DUO:0000027" ;
    rdfs:subClassOf mc2:DataUseModifiersEnum,
        mc2:StudyDataUseCodesEnum ;
    skos:definition "This data use modifier indicates that use is limited to use within an approved project." .

DUO:0000029 a owl:Class ;
    rdfs:label "DUO:0000029" ;
    rdfs:subClassOf mc2:DataUseModifiersEnum,
        mc2:StudyDataUseCodesEnum ;
    skos:definition "This data use modifier indicates that the requestor must return derived/enriched data to the database/resource." .

DUO:0000042 a owl:Class ;
    rdfs:label "DUO:0000042" ;
    rdfs:subClassOf mc2:DataUseModifiersEnum,
        mc2:StudyDataUseCodesEnum ;
    skos:definition "This data use permission indicates that use is allowed for general research use for any research purpose." .

DUO:0000043 a owl:Class ;
    rdfs:label "DUO:0000043" ;
    rdfs:subClassOf mc2:DataUseModifiersEnum,
        mc2:StudyDataUseCodesEnum ;
    skos:definition "This data use modifier indicates that use is allowed for clinical use and care." .

DUO:0000044 a owl:Class ;
    rdfs:label "DUO:0000044" ;
    rdfs:subClassOf mc2:DataUseModifiersEnum,
        mc2:StudyDataUseCodesEnum ;
    skos:definition "This data use modifier indicates use for purposes of population, origin, or ancestry research is prohibited." .

DUO:0000045 a owl:Class ;
    rdfs:label "DUO:0000045" ;
    rdfs:subClassOf mc2:DataUseModifiersEnum,
        mc2:StudyDataUseCodesEnum ;
    skos:definition "This data use modifier indicates that use of the data is limited to not-for-profit organizations." .

DUO:0000046 a owl:Class ;
    rdfs:label "DUO:0000046" ;
    rdfs:subClassOf mc2:DataUseModifiersEnum,
        mc2:StudyDataUseCodesEnum ;
    skos:definition "This data use modifier indicates that use of the data is limited to not-for-profit use." .

NCIT:C113729 a owl:Class ;
    rdfs:label "GB" ;
    rdfs:subClassOf mc2:BiospecimenTumorGradeEnum,
        mc2:IndividualTumorGradeEnum ;
    skos:definition "A morphologic qualifier indicating that a neoplasm is of borderline malignancy." .

NCIT:C113730 a owl:Class ;
    rdfs:label "GX" ;
    rdfs:subClassOf mc2:BiospecimenTumorGradeEnum,
        mc2:IndividualTumorGradeEnum ;
    skos:definition "A morphologic qualifier indicating that the grade of a neoplasm cannot be assessed." .

NCIT:C12508 a owl:Class ;
    rdfs:label "Cell",
        "Whole Cell" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum,
        mc2:ImageObjectClassEnum ;
    skos:definition "The smallest unit of living structure capable of independent existence, composed of a membrane-enclosed mass of protoplasm containing a nucleus or nucleoid.",
        "The smallest units of living structure capable of independent existence, composed of a membrane-enclosed mass of protoplasm and containing a nucleus or nucleoid." .

NCIT:C14158 a owl:Class ;
    rdfs:label "High Grade" ;
    rdfs:subClassOf mc2:BiospecimenTumorGradeEnum,
        mc2:IndividualTumorGradeEnum ;
    skos:definition "A morphologic qualifier indicating that a neoplasm is poorly differentiated or undifferentiated (Grade 3 or Grade 4)." .

NCIT:C142663 a owl:Class ;
    rdfs:label "Level 1" ;
    rdfs:subClassOf mc2:DSPDatasetLevelEnum,
        mc2:FileLevelEnum ;
    skos:definition "Raw or minimally processed data" .

NCIT:C153249 a owl:Class ;
    rdfs:label "BAM" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A binary representation of a sequence alignment map (SAM), a compact and indexable representation of nucleotide sequence alignments, compressed using the BGZF (Blocked GNU Zip Format) library." .

NCIT:C156848 a owl:Class ;
    rdfs:label "Tumor Free" ;
    rdfs:subClassOf mc2:BiospecimenLastKnownDiseaseStatusEnum,
        mc2:IndividualLastKnownDiseaseStatusEnum ;
    skos:definition "There is no evidence of a tumor in the individual." .

NCIT:C156849 a owl:Class ;
    rdfs:label "With Tumor" ;
    rdfs:subClassOf mc2:BiospecimenLastKnownDiseaseStatusEnum,
        mc2:IndividualLastKnownDiseaseStatusEnum ;
    skos:definition "There is evidence of a tumor in an individual." .

NCIT:C162623 a owl:Class ;
    rdfs:label "Normal" ;
    rdfs:subClassOf mc2:BiospecimenCompositionEnum,
        mc2:BiospecimenTumorStatusEnum ;
    skos:definition "Tissue sample with cellular composition and architectural patterns expected for the particular anatomic site in which it belongs. There is no evidence of abnormal cellular infiltrates or tumor mass formation.",
        "Tissue sample with cellular composition and architectural patterns expected for the particular anatomic site in which it belongs; no evidence of abnormal cellular infiltrates or tumor mass formation." .

NCIT:C162692 a owl:Class ;
    rdfs:label "SVS" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "SVS is a proprietary, pyramidal TIFF-based whole-slide image file format produced by Aperio (Leica Biosystems) digital slide scanners, used to store high-resolution histopathology images." .

NCIT:C164009 a owl:Class ;
    rdfs:label "Bone Marrow",
        "Bone Marrow Normal" ;
    rdfs:subClassOf mc2:BiospecimenTypeCategoryEnum,
        mc2:BiospecimenTypeEnum ;
    skos:definition "A biological sample containing components collected from bone marrow of an experimental subject.",
        "A bone marrow specimen collected from a subject that does not contain malignant cells and is used as a normal reference sample." .

NCIT:C164049 a owl:Class ;
    rdfs:label "TSV" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A file format where each line in the file contains a single piece of data and where each field or value in a line of data is separated from the next by a tab character." .

NCIT:C164050 a owl:Class ;
    rdfs:label "xlsx" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A proprietary file format developed by Microsoft that allows the user to save a spreadsheet created in Excel in an open XML format; the file can be read and opened by other spreadsheet-compatible applications." .

NCIT:C165197 a owl:Class ;
    rdfs:label "Biochemical evidence of disease without structural correlate" ;
    rdfs:subClassOf mc2:BiospecimenLastKnownDiseaseStatusEnum,
        mc2:IndividualLastKnownDiseaseStatusEnum ;
    skos:definition "An indication that biochemical markers of a disease are present but morphological markers are absent." .

NCIT:C16565 a owl:Class ;
    rdfs:label "Evolution" ;
    rdfs:subClassOf mc2:GrantThemeNameEnum,
        mc2:ResourceTopicEnum ;
    skos:definition "The process by which populations of organisms change over successive generations through mechanisms such as mutation, genetic drift, and natural selection." .

NCIT:C172216 a owl:Class ;
    rdfs:label "VCF" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A text-based electronic file used for storing gene sequence variation data. The first text section is composed of a header containing the metadata and keywords used in the file, followed by the body of the file which is tab-separated into eight mandatory data columns for each sample, plus optional columns for other sample-related data." .

NCIT:C172484 a owl:Class ;
    rdfs:label "Semiautomatic" ;
    rdfs:subClassOf mc2:DeidentificationTypeEnum,
        mc2:StudyDeidentificationMethodTypeEnum ;
    skos:definition "Of or related to a method or process performed using a combination of manual and automatic means." .

NCIT:C17609 a owl:Class ;
    rdfs:label "Tumor Progression" ;
    rdfs:subClassOf mc2:GrantThemeNameEnum,
        mc2:ResourceTopicEnum ;
    skos:definition "A pathologic process in which molecular alterations result in a more aggressive cytologic and phenotypic profile and clinical course of a neoplasm over time." .

NCIT:C17610 a owl:Class ;
    rdfs:label "Blood",
        "Blood Derived Normal" ;
    rdfs:subClassOf mc2:BiospecimenTypeCategoryEnum,
        mc2:BiospecimenTypeEnum ;
    skos:definition "A peripheral blood specimen collected from a subject that is used as a source of germline (non-tumor) DNA or as a matched normal control for genomic comparisons.",
        "A small volume of blood removed for testing or storage." .

NCIT:C18206 a owl:Class ;
    rdfs:label "Distant Metastasis" ;
    rdfs:subClassOf mc2:BiospecimenLastKnownDiseaseStatusEnum,
        mc2:IndividualLastKnownDiseaseStatusEnum ;
    skos:definition "The presence of cancer cells that have spread from the primary tumor site and been detected at a distal anatomic site." .

NCIT:C182456 a owl:Class ;
    rdfs:label "CSV" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A text file format that separates data elements with commas." .

NCIT:C184762 a owl:Class ;
    rdfs:label "IDAT" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A proprietary, encrypted, compressed electronic file format from Illumina Inc. for storing genome-wide profiling data. The data contains a summary of the intensity data generated from each probe used during a sequencing or array run." .

NCIT:C184763 a owl:Class ;
    rdfs:label "HDF5" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A hierarchical, filesystem-like data format that can store metadata in the form of user-defined, named attributes, which are attached to groups and datasets, and representations of images and tables built up using datasets, groups and attributes." .

NCIT:C184769 a owl:Class ;
    rdfs:label "JSON" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A common open standard file format and data interchange format that uses human-readable text consisting of attribute-value pairs and arrays to store and transmit data." .

NCIT:C190162 a owl:Class ;
    rdfs:label "AVI" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A multimedia container format for audio video interleaved (AVI) files that allows for synchronous audio-with-video playback." .

NCIT:C190163 a owl:Class ;
    rdfs:label "BAI" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "An index file associated with a binary alignment map (BAM) file, a compressed binary version of a sequence alignment/map (SAM) file, used to enable rapid random access to alignment records." .

NCIT:C190165 a owl:Class ;
    rdfs:label "bedgraph" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A format that allows display of continuous-valued data in track format. This display type is useful for probability scores and transcriptome data." .

NCIT:C190167 a owl:Class ;
    rdfs:label "BIGWIG" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A format for large sequence annotation tracks that consist of a value for each sequence position, similar to the textual wiggle (WIG) format, but indexed and compressed for efficient random access." .

NCIT:C190171 a owl:Class ;
    rdfs:label "docx" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A file type that uses Open XML Document format to store data for Microsoft Word and other compatible programs." .

NCIT:C190175 a owl:Class ;
    rdfs:label "GFF3" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A tab-separated format for sequence data. It uses one line per feature, each containing 9 columns of data, plus optional track definition lines." .

NCIT:C190177 a owl:Class ;
    rdfs:label "GTF" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A tab-delimited text format based on the general feature format (GFF) but which also contains some additional information for each gene." .

NCIT:C190184 a owl:Class ;
    rdfs:label "Python Script" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A plain text file that stores python code." .

NCIT:C190186 a owl:Class ;
    rdfs:label "R File Format" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "R is a tool for data manipulation and analysis, both a programming language and a working environment; the format is used for writing and executing scripts, typically for statistical computation and graphics, and for storing complete R workspaces or selected R objects." .

NCIT:C190189 a owl:Class ;
    rdfs:label "TAR Format" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A file format generated by the Unix command-line utility tar (tape archive). It is used for collecting many files into one archive file." .

NCIT:C190190 a owl:Class ;
    rdfs:label "RAW" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A proprietary file format developed by Thermo Scientific to capture mass spectrometry data produced by Thermo mass spectrometers." .

NCIT:C190191 a owl:Class ;
    rdfs:label "xls" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A proprietary binary file format used to store spreadsheet data in Microsoft Excel." .

NCIT:C190192 a owl:Class ;
    rdfs:label "ZIP" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "An archive file format that supports lossless data compression. It is used to compress one or more files together into a single location." .

NCIT:C19095 a owl:Class ;
    rdfs:label "Tumor-Immune" ;
    rdfs:subClassOf mc2:GrantThemeNameEnum,
        mc2:ResourceTopicEnum ;
    skos:definition "The study of the interactions between the immune system and tumor cells, including immune surveillance, immune evasion, and immune-based responses to cancer." .

NCIT:C191737 a owl:Class ;
    rdfs:label "cel" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A type of file that stores the results of intensity calculations of pixel values for DNA microarray image analysis, including intensity values, standard deviation, pixel counts, and outlier/exclusion flags for each feature on the probe array." .

NCIT:C19536 a owl:Class ;
    rdfs:label "Metabolism" ;
    rdfs:subClassOf mc2:GrantThemeNameEnum,
        mc2:ResourceTopicEnum ;
    skos:definition "The organic biochemical processes within a cell or organism that are necessary to sustain life, encompassing both anabolic (biosynthetic) and catabolic (degradative) reactions." .

NCIT:C19590 a owl:Class ;
    rdfs:label "MDA",
        "WGA" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum,
        mc2:NGSLibraryStrategyEnum ;
    skos:definition "Multiple displacement amplification",
        "Random sequencing of the whole genome following non-pcr amplification" .

NCIT:C19697 a owl:Class ;
    rdfs:label "Tissue" ;
    rdfs:subClassOf mc2:BiospecimenCompositionEnum,
        mc2:BiospecimenTypeCategoryEnum ;
    skos:definition "A piece of tissue removed from an organism for examination, analysis, or propagation." .

NCIT:C200667 a owl:Class ;
    rdfs:label "New Tumor Event" ;
    rdfs:subClassOf mc2:BiospecimenLastKnownDiseaseStatusEnum,
        mc2:IndividualLastKnownDiseaseStatusEnum ;
    skos:definition "The presence of a primary, recurrent or metastatic neoplasm which has not been previously noted." .

NCIT:C201789 a owl:Class ;
    rdfs:label "MTX" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A format for the storage of numerical or pattern matrices in a dense (array format) or sparse (coordinate format) representation." .

NCIT:C204821 a owl:Class ;
    rdfs:label "5-methylcytidine antibody",
        "MeDIP-Seq" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum,
        mc2:NGSLibraryStrategyEnum ;
    skos:definition "Methylated DNA Immunoprecipitation Sequencing strategy",
        "Selection of methylated DNA fragments using an antibody raised against 5-methylcytosine or 5-methylcytidine (m5C)" .

NCIT:C209896 a owl:Class ;
    rdfs:label "RTF" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A file format that contains various formatting elements and enables exchanges of text files across different word processing platforms and applications." .

NCIT:C224009 a owl:Class ;
    rdfs:label "pptx" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A visual design format that includes layout, fonts, colors, and aspect ratios for slide-based presentations. PPTX is an XML-based format that is the default for modern Microsoft PowerPoint files." .

NCIT:C224011 a owl:Class ;
    rdfs:label "PZFX" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "An XML-based file format used by GraphPad Prism software to store analysis projects, including data tables, graphs, and statistical results." .

NCIT:C28077 a owl:Class ;
    rdfs:label "G1" ;
    rdfs:subClassOf mc2:BiospecimenTumorGradeEnum,
        mc2:IndividualTumorGradeEnum ;
    skos:definition "A morphologic qualifier indicating that a cancerous lesion is well differentiated." .

NCIT:C28078 a owl:Class ;
    rdfs:label "G2" ;
    rdfs:subClassOf mc2:BiospecimenTumorGradeEnum,
        mc2:IndividualTumorGradeEnum ;
    skos:definition "A morphologic qualifier indicating that a cancerous lesion is moderately differentiated." .

NCIT:C28079 a owl:Class ;
    rdfs:label "G3" ;
    rdfs:subClassOf mc2:BiospecimenTumorGradeEnum,
        mc2:IndividualTumorGradeEnum ;
    skos:definition "A morphologic qualifier indicating that a cancerous lesion is poorly differentiated." .

NCIT:C28082 a owl:Class ;
    rdfs:label "G4" ;
    rdfs:subClassOf mc2:BiospecimenTumorGradeEnum,
        mc2:IndividualTumorGradeEnum ;
    skos:definition "A morphologic qualifier indicating that a cancerous lesion is undifferentiated." .

NCIT:C28359 a owl:Class ;
    rdfs:label "Heterogeneity" ;
    rdfs:subClassOf mc2:GrantThemeNameEnum,
        mc2:ResourceTopicEnum ;
    skos:definition "The quality or state of consisting of elements that are not of the same kind or nature, such as variability among cells, tissues, or tumors within a biological system." .

NCIT:C3261 a owl:Class ;
    rdfs:label "Metastatic",
        "Metastatic Neoplasm" ;
    rdfs:subClassOf mc2:BiospecimenCompositionEnum,
        mc2:BiospecimenPathologyEnum ;
    skos:definition "A malignant tumor that has spread from its original site of growth to another anatomic location.",
        "A tumor that has spread from its original site of growth to another anatomic site." .

NCIT:C36162 a owl:Class ;
    rdfs:label "Localized Disease" ;
    rdfs:subClassOf mc2:BiospecimenLastKnownDiseaseStatusEnum,
        mc2:IndividualLastKnownDiseaseStatusEnum ;
    skos:definition "A disease that is confined to a specific organ or tissue and has not spread to other anatomic sites." .

NCIT:C41132 a owl:Class ;
    rdfs:label "None" ;
    rdfs:subClassOf mc2:BiospecimenEmbeddingMediumEnum,
        mc2:BiospecimenFixativeEnum ;
    skos:definition "No person or thing, nobody, not any." .

NCIT:C41844 a owl:Class ;
    rdfs:label "Regional Disease" ;
    rdfs:subClassOf mc2:BiospecimenLastKnownDiseaseStatusEnum,
        mc2:IndividualLastKnownDiseaseStatusEnum ;
    skos:definition "A disease or condition that extends beyond the site of origin and spreads into adjacent tissues and regional lymph nodes." .

NCIT:C4798 a owl:Class ;
    rdfs:label "Recurrent Neoplasm",
        "Recurrent Tumor" ;
    rdfs:subClassOf mc2:BiospecimenPathologyEnum,
        mc2:BiospecimenTypeEnum ;
    skos:definition "A lesion that has reappeared at the original site of a neoplasm after a period of remission.",
        "A tumor specimen collected after the reemergence of cancer at the original or a related site following a period of remission." .

NCIT:C49487 a owl:Class ;
    rdfs:label "No",
        "No - Channel Failed QC" ;
    rdfs:subClassOf mc2:ChannelPassedQCEnum,
        mc2:IndividualRecurrenceStatusEnum ;
    skos:definition "The non-affirmative response to a question." .

NCIT:C49488 a owl:Class ;
    rdfs:label "Yes" ;
    rdfs:subClassOf mc2:ChannelPassedQCEnum,
        mc2:IndividualRecurrenceStatusEnum ;
    skos:definition "The affirmative response to a question." .

NCIT:C52095 a owl:Class ;
    rdfs:label "Metadata" ;
    rdfs:subClassOf mc2:DSPDatasetLevelEnum,
        mc2:FileLevelEnum ;
    skos:definition "Files that are or will be stored and shared as metadata." .

NCIT:C63513 a owl:Class ;
    rdfs:label "Manual" ;
    rdfs:subClassOf mc2:DeidentificationTypeEnum,
        mc2:StudyDeidentificationMethodTypeEnum ;
    skos:definition "Of or related to the hands; reference to a method, process, task, or activity being done by hand (as opposed as being performed with the assistance of automation or other supportive means)." .

NCIT:C63523 a owl:Class ;
    rdfs:label "OCT",
        "OCT media" ;
    rdfs:subClassOf mc2:BiospecimenFixativeEnum,
        mc2:BiospecimenPreservationMethodEnum ;
    skos:definition "A solution of water soluble glycols and resins that provide a specimen support matrix for cryostat sectioning at temperatures of -10 degrees C and below." .

NCIT:C63805 a owl:Class ;
    rdfs:label "PDF" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "An open file format created and controlled by Adobe Systems for representing two-dimensional documents in a device-independent and resolution-independent fixed-layout format that encapsulates text, fonts, images, and vector graphics." .

NCIT:C70669 a owl:Class ;
    rdfs:label "Automatic" ;
    rdfs:subClassOf mc2:DeidentificationTypeEnum,
        mc2:StudyDeidentificationMethodTypeEnum ;
    skos:definition "Operating with minimal human intervention; independent of external control." .

NCIT:C80220 a owl:Class ;
    rdfs:label "GZIP Format" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A file format consisting of a 10-byte header containing a magic number, a version number, and a timestamp, a Deflate-compressed body, and an 8-byte footer containing a checksum and the length of the original uncompressed data." .

NCIT:C85437 a owl:Class ;
    rdfs:label "PNG" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "An extensible file format for lossless data compression of images." .

NCIT:C85873 a owl:Class ;
    rdfs:label "TXT" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A data format consisting of readable textual material maintained as a sequential file." .

NCIT:C94498 a owl:Class ;
    rdfs:label "Microenvironment" ;
    rdfs:subClassOf mc2:GrantThemeNameEnum,
        mc2:ResourceTopicEnum ;
    skos:definition "The cellular and molecular environment surrounding a tumor or biological system, including neighboring cells, blood vessels, immune cells, signaling molecules, and the extracellular matrix, that influences its growth and behavior." .

EFO:0004155 a owl:Class ;
    rdfs:label "FASTQ" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "FASTQ format is a text-based format for storing both a biological sequence (usually nucleotide sequence) and its corresponding quality scores." .

mc2:GeoMxDSPAssayTypeEnum a owl:Class ;
    rdfs:label "GeoMx DSP Assay Type Enum" ;
    owl:unionOf ( NCIT:C198498 NCIT:C198498 <https://w3id.org/mc2-center/mc2-model/GeoMxDSPAssayTypeEnum#Protein%20NGS> <https://w3id.org/mc2-center/mc2-model/GeoMxDSPAssayTypeEnum#RNA%20NGS> ) ;
