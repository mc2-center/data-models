    owl:unionOf ( BAO:0002643 BAO:0002644 ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values BAO:0002643,
        BAO:0002644 .

mc2:ChannelPassedQCEnum a owl:Class ;
    rdfs:label "Channel Passed QC Enum" ;
    owl:unionOf ( NCIT:C49488 NCIT:C49487 ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values NCIT:C49487,
        NCIT:C49488 .

