            owl:cardinality 1 ;
            owl:onProperty mc2:NGS_Library_Strategy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:NGS_Library_Preparation_Kit_Version ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Assay ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Design ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:File_Alias ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "\\d+$|Not\\sApplicable$|unknown$" ] ) ] ;
            owl:onProperty mc2:NGS_Library_Preparation_Days_from_Index ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:NGS_Read_Indicator ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Longitudinal_Total_Time_Elapsed ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:NGS_RNA_End_Bias ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:NGS_Library_Layout ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:NGS_Library_Source_Molecule ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:NGS_Library_Preparation_Days_from_Index ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:File_Level ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^syn\\d{7,8}$" ] ) ] ;
            owl:onProperty mc2:SequencingRNALevel1_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "-B\\d{1,9}" ] ) ] ;
            owl:onProperty mc2:Biospecimen_Key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Biospecimen_Key ] ;
    skos:definition "Unaligned/unprocessed RNA sequencing data" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:SequencingRNALevel1_Key a owl:DatatypeProperty ;
    rdfs:label "SequencingRNALevel1 Key" ;
    skos:definition "Unique SequencingRNALevel1_id foreign key(s) that link metadata entries as part of the same Dataset. Please provide multiple values as a comma-separate list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

mc2:Study a owl:Class ;
    rdfs:label "Study" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Study_Deidentification_Method_Description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:GrantView_Key ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Study_Deidentification_Method_Type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Study_dbGaP_Accession_Id ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Study_Number_of_Samples ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Study_Index_Date ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Study_Number_of_Participants ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Investigator ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Study_Short_Name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Study_Deidentification_Method_Software ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Study_Description ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Study_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:ProjectView_Key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:PersonView_Key ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Study_Name ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "syn[0-9]+" ] ) ] ;
            owl:onProperty mc2:Study_Project_Identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "CA\\d{6}" ] ) ] ;
            owl:onProperty mc2:GrantView_Key ] ;
    skos:definition "Studies associated with a grant" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Theme a owl:Class ;
    rdfs:label "Theme" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Theme_Display_Name ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Theme_Description ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Theme_Name ] ;
    skos:definition "Themes associated with resources derived from consortia activities" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Therapeutic_Agent a owl:DatatypeProperty ;
    rdfs:label "Therapeutic Agent" ;
    skos:definition "The name of the individual agent(s) used as part of a treatment regimen or experimental protocol (NCI Thesaurus concept name -- reference-validated, not a fixed list; see https://ncithesaurus.nci.nih.gov/)." ;
    skos:exactMatch CRDC_CDE:14913015 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Tissue a owl:ObjectProperty ;
    rdfs:label "Tissue" ;
    rdfs:range mc2:TissueEnum ;
    skos:definition "Tissue type(s) associated with the dataset, file, or publication. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:ToolView a owl:Class ;
    rdfs:label "Tool View" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Documentation_Url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Cmd ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Tool_Homepage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Date_Last_Modified ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Tool_Input_Format ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Study_Key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Link_Url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Documentation_Note ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Tool_Release_Date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:DatasetView_Key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Download_Url ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Tool_Entity_Role ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Tool_Input_Data ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Version ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Tool_Entity_Type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "CA\\d{6}" ] ) ] ;
            owl:onProperty mc2:GrantView_Key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:PublicationView_Key ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Tool_Output_Data ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Function_Note ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Tool_Description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Accessibility ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Download_Version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Download_Type ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Tool_Doi ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Tool_Name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:GrantView_Key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Download_Note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Cost ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Tool_Operation ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Tool_Package_Dependencies_Present ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:ToolView_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Tool_Output_Format ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Link_Note ] ;
    skos:definition "The denormalized manifest for tool submission." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Tool_Compute_Requirements a owl:DatatypeProperty ;
    rdfs:label "Tool Compute Requirements" ;
    skos:definition "Component dependency requirements for application. This includes runtime environments and shared libraries that are not included in the application distribution package, but required to run the application (examples: DirectX, Java or .NET runtime)." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: schema.org" .

mc2:Tool_Documentation_Type a owl:ObjectProperty ;
    rdfs:label "Tool Documentation Type" ;
    rdfs:range mc2:ToolDocumentationTypeEnum ;
    skos:definition "Type of documentation that is linked to. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Entity_Name a owl:DatatypeProperty ;
    rdfs:label "Tool Entity Name" ;
    skos:definition "Name of the entities that may be credited" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Tool_Language a owl:ObjectProperty ;
    rdfs:label "Tool Language" ;
    rdfs:range mc2:ToolLanguageEnum ;
    skos:definition "Name of programming language the software source code was written in. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Link_Type a owl:ObjectProperty ;
    rdfs:label "Tool Link Type" ;
    rdfs:range mc2:ToolLinkTypeEnum ;
    skos:definition "The type of data, information or system that is obtained when the link is resolved. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Operating_System a owl:ObjectProperty ;
    rdfs:label "Tool Operating System" ;
    rdfs:range mc2:ToolOperatingSystemEnum ;
    skos:definition "The operating system supported by a downloadable software package. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Package_Dependencies a owl:DatatypeProperty ;
    rdfs:label "Tool Package Dependencies" ;
    skos:definition "Specifies the software libraries, frameworks, or other components that a tool or package relies on for its proper functioning. This attribute helps users understand the prerequisites needed for installation and usage of the tool within a given computational environment" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: CWL" .

mc2:Tool_Topic a owl:ObjectProperty ;
    rdfs:label "Tool Topic" ;
    rdfs:range mc2:ToolTopicEnum ;
    skos:definition "General scientific domain the software serves, or other general category. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Type a owl:ObjectProperty ;
    rdfs:label "Tool Type" ;
    rdfs:range mc2:ToolTypeEnum ;
    skos:definition "A type of application software: a discrete software entity can have more than one type. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Treatment_Type a owl:ObjectProperty ;
    rdfs:label "Treatment Type" ;
    rdfs:range mc2:TreatmentTypeEnum ;
    skos:definition "Text term that describes the kind of treatment administered to the individual, biospecimen donor, or model." ;
    skos:exactMatch CRDC_CDE:14737565 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "14737565" .

mc2:Tumor_Subtype a owl:DatatypeProperty ;
    rdfs:label "Tumor Subtype" ;
    skos:definition "The molecular or histologic subtype of the tumor associated with the individual, biospecimen, or model." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Tumor_Type a owl:ObjectProperty ;
    rdfs:label "Tumor Type" ;
    rdfs:range mc2:TumorTypeEnum ;
    skos:definition "The tumor type(s), if applicable, associated with the dataset, file, or publication. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:attribution a owl:DatatypeProperty ;
    rdfs:label "attribution" ;
    skos:definition "The attribution statement for the data associated with the access requirement. Equivalent to DUOPlus7." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:authors a owl:DatatypeProperty ;
    rdfs:label "authors" ;
    skos:definition "Author list for the dataset's associated publication. Distinct from creator, which captures the person(s)/organization(s) that generated or deposited the data itself." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:collaborationRequired a owl:DatatypeProperty ;
    rdfs:label "collaborationRequired" ;
    skos:definition "If collaboration is required for the access requirement, provide the PI email address. Provide multiple as a comma-separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:contributor a owl:DatatypeProperty ;
    rdfs:label "contributor" ;
    skos:definition "Organization(s), insitution(s), or person(s) that generated and/or deposited the data in Synapse. Can be identical to Grant Institution Name." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:countryOfOrigin a owl:ObjectProperty ;
    rdfs:label "countryOfOrigin" ;
    rdfs:range mc2:CountryOfOriginEnum ;
    skos:definition "Origin of individuals from which data were generated. Omit if not applicable/unknown." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:dataCatalogDataUseModifiers a owl:ObjectProperty ;
    rdfs:label "dataCatalogDataUseModifiers" ;
    rdfs:range mc2:DataCatalogDataUseModifiersEnum ;
    skos:definition "List of data use ontology (DUO) terms that are true for dataset, which describes the allowable scope and terms for data use. Omit property if not applicable/unknown." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:dataPermission a owl:ObjectProperty ;
    rdfs:label "dataPermission" ;
    rdfs:range mc2:DataPermissionEnum ;
    skos:definition "The permissions associated with the data under the access requirement. Equivalent to DUOPlus4." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:dataTier a owl:ObjectProperty ;
    rdfs:label "dataTier" ;
    rdfs:range mc2:DataTierEnum ;
    skos:definition "The tier of data access associated with the access requirement. Equivalent to DUOPlus5." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:dataType a owl:ObjectProperty ;
    rdfs:label "dataType" ;
    rdfs:range mc2:DataTypeEnum ;
    skos:definition "Broad data-type category for the dataset (e.g. gene expression, chromatin activity, genomic variants). Aligned with modules/shared/mc2_iconTag_map_3-4-25.csv's label taxonomy." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:dataUseModifiers a owl:ObjectProperty ;
    rdfs:label "dataUseModifiers" ;
    rdfs:range mc2:DataUseModifiersEnum ;
    skos:definition "A list of data use modifiers that apply to the access requirement. Examples include GRU, IRB, etc." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "00002002" .

mc2:deidentificationType a owl:ObjectProperty ;
    rdfs:label "deidentificationType" ;
    rdfs:range mc2:DeidentificationTypeEnum ;
    skos:definition "The type of de-identification applied to the data associated with the access requirement. Equivalent to DUOPlus3." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:diseaseSpecificResearch a owl:DatatypeProperty ;
    rdfs:label "diseaseSpecificResearch" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "MONDO:\\d{7}" ] ) ] ;
    skos:definition "The type(s) of disease research allowed by this access requirement. Provide the MONDO ID in format MONDO:id. Provide multiple values as a comma-separated list. MONDO terms can be found here: https://ols.monarchinitiative.org/ontologies/mondo" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:externalRepositoryUri a owl:DatatypeProperty ;
    rdfs:label "externalRepositoryUri" ;
    skos:definition "External repository identifier(s) for the dataset, as CURIE-shaped references (e.g. geo:GSE12345, sra:SRP12345, bioproject:PRJNA12345)." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:funder a owl:ObjectProperty ;
    rdfs:label "funder" ;
    rdfs:range mc2:FunderEnum ;
    skos:definition "The entity(ies) responsible for funding the data contributors." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:geographicalRestriction a owl:ObjectProperty ;
    rdfs:label "geographicalRestriction" ;
    rdfs:range mc2:GeographicalRestrictionEnum ;
    skos:definition "The specific geographic region(s) to which use is limited by the access requirement." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:institutionSpecificRestriction a owl:DatatypeProperty ;
    rdfs:label "institutionSpecificRestriction" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "ROR:[a-z0-9]{9}" ] ) ] ;
    skos:definition "Institutions with specific restrictions associated with the access requirement. Provide the institution ROR ID in format ROR:id. Provide multiple entries as a comma-separated list. ROR IDs can be found here: https://ror.org/search" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:license a owl:ObjectProperty ;
    rdfs:label "license" ;
    rdfs:range mc2:LicenseEnum ;
    skos:definition "The license under which the data associated with the access requirement is shared. Equivalent to DUOPlus6." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:measurementTechnique a owl:ObjectProperty ;
    rdfs:label "measurementTechnique" ;
    rdfs:range mc2:MeasurementTechniqueEnum ;
    skos:definition "Assay used to generate original data. Omit if not applicable (e.g. for curated dataset such as a list compounds from a database or text extracted from Wikipedia). Can be identical to Dataset Assay." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:populationType a owl:DatatypeProperty ;
    rdfs:label "populationType" ;
    skos:definition "The population studied in the research associated with the access requirement. Equivalent to DUOPlus2" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:publicationMoratorium a owl:DatatypeProperty ;
    rdfs:label "publicationMoratorium" ;
    skos:definition "End date of the publication moratorium associated with the access requirement." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic Format: date" .

mc2:researchSpecificRestrictions a owl:DatatypeProperty ;
    rdfs:label "researchSpecificRestrictions" ;
    skos:definition "Research-specific restrictions associated with the access requirement." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:sourceGeography a owl:ObjectProperty ;
    rdfs:label "sourceGeography" ;
    rdfs:range mc2:SourceGeographyEnum ;
    skos:definition "The geographical source of the data associated with the access requirement. Equivalent to DUOPlus1." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:species a owl:ObjectProperty ;
    rdfs:label "species" ;
    rdfs:range mc2:SpeciesEnum ;
    skos:definition "Species of the organism(s) from which the data were generated. Omit property if not applicable, such as for data like compounds or other non-biological data. Can be identical to Dataset Species." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:subject a owl:DatatypeProperty ;
    rdfs:label "subject" ;
    skos:definition "Applicable subject term(s) for dataset cataloging - in practice, a free-text model-system/specimen descriptor (e.g. C57BL/6, NOD SCID), not a Library of Congress Subject Heading." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:timeLimitOnUse a owl:DatatypeProperty ;
    rdfs:label "timeLimitOnUse" ;
    rdfs:range xsd:float ;
    skos:definition "Time limit on the use of the data associated with the access requirement." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:userSpecificRestriction a owl:DatatypeProperty ;
    rdfs:label "userSpecificRestriction" ;
    skos:definition "The user-specific restrictions associated with the access requirement." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

<mc2:DUO:0000007> a owl:DatatypeProperty ;
    rdfs:label "DUO:0000007" ;
    skos:definition "This data use permission indicates that use is allowed provided it is related to the specified disease." ;
    skos:exactMatch DUO:0000007 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic DependsOn (conditional requirement on sibling attributes, not represented as a LinkML rule): diseaseSpecificResearch" .

<mc2:DUO:0000012> a owl:DatatypeProperty ;
    rdfs:label "DUO:0000012" ;
    skos:definition "This data use modifier indicates that use is limited to studies of a certain research type." ;
    skos:exactMatch DUO:0000012 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic DependsOn (conditional requirement on sibling attributes, not represented as a LinkML rule): researchSpecificRestrictions" .

<mc2:DUO:0000020> a owl:DatatypeProperty ;
    rdfs:label "DUO:0000020" ;
    skos:definition "This data use modifier indicates that the requestor must agree to collaboration with the primary study investigator(s)." ;
    skos:exactMatch DUO:0000020 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
