mc2:Biospecimen_Table_Id a owl:DatatypeProperty ;
    rdfs:label "Biospecimen Table Id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^syn\\d{7,8}$" ] ) ] ;
    skos:definition "The Synapse Id corresponding to a Biospecimen metadata table associated with the Dataset(s)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Biospecimen_id a owl:DatatypeProperty ;
    rdfs:label "Biospecimen_id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "B\\d{1,9}$" ] ) ] ;
    skos:definition "Unique row identifier, used as a primary key for record updates. This should terminate in ModelKey-Bxxx or IndividualKey-Bxxx format, unless directed otherwise." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "15100774" .

