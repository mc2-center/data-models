mc2:Institution_Key a owl:DatatypeProperty ;
    rdfs:label "Institution Key" ;
    skos:definition "Unique Institution_id foreign key(s) that group the resource with other components, as part of the same institution-associated grants. Please provide multiple values as a comma-separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

mc2:Known_Metastasis_Sites a owl:DatatypeProperty ;
    rdfs:label "Known Metastasis Sites" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^UBERON:\\d+$" ] ) ] ;
    skos:definition "The UBERON identifier(s) of the anatomic site(s) of metastasis associated with the malignant disease of the individual or biospecimen donor (see https://www.ebi.ac.uk/ols4/ontologies/uberon). Provide multiple values as a comma-separated list." ;
    skos:exactMatch CRDC_CDE:15114457 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "2856440" .

mc2:Last_Known_Disease_Status a owl:ObjectProperty ;
    rdfs:label "Last Known Disease Status" ;
    rdfs:range mc2:LastKnownDiseaseStatusEnum ;
    skos:definition "Text term that describes the last known disease status of the individual, biospecimen donor, or model." ;
    skos:exactMatch CRDC_CDE:12447172 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "12447172" .

<https://w3id.org/mc2-center/mc2-model/LicenseEnum#Apache_2> a owl:Class ;
    rdfs:label "Apache_2" ;
    rdfs:subClassOf mc2:LicenseEnum ;
    skos:definition "Apache License 2.0, a permissive license allowing for use, modification, and distribution." .

<https://w3id.org/mc2-center/mc2-model/LicenseEnum#BSD_3_Clause> a owl:Class ;
    rdfs:label "BSD_3_Clause" ;
    rdfs:subClassOf mc2:LicenseEnum ;
    skos:definition "BSD 3-Clause License, a permissive license allowing for use, modification, and distribution with attribution." .

<https://w3id.org/mc2-center/mc2-model/LicenseEnum#CC0> a owl:Class ;
    rdfs:label "CC0" ;
    rdfs:subClassOf mc2:LicenseEnum ;
    skos:definition "Creative Commons Zero license, allowing for the free use of the data." .

<https://w3id.org/mc2-center/mc2-model/LicenseEnum#CC_BY_NC_ND> a owl:Class ;
    rdfs:label "CC_BY_NC_ND" ;
    rdfs:subClassOf mc2:LicenseEnum ;
    skos:definition "Creative Commons Attribution-NonCommercial-NoDerivatives license, allowing for non-commercial use with attribution but no modifications." .

<https://w3id.org/mc2-center/mc2-model/LicenseEnum#CC_BY_NC_SA> a owl:Class ;
    rdfs:label "CC_BY_NC_SA" ;
    rdfs:subClassOf mc2:LicenseEnum ;
    skos:definition "Creative Commons Attribution-NonCommercial-ShareAlike license, allowing for non-commercial modifications with attribution and sharing under the same license." .

<https://w3id.org/mc2-center/mc2-model/LicenseEnum#CC_BY_ND> a owl:Class ;
    rdfs:label "CC_BY_ND" ;
    rdfs:subClassOf mc2:LicenseEnum ;
    skos:definition "Creative Commons Attribution-NoDerivatives license, allowing for redistribution with attribution but no modifications." .

<https://w3id.org/mc2-center/mc2-model/LicenseEnum#CC_BY_SA> a owl:Class ;
    rdfs:label "CC_BY_SA" ;
    rdfs:subClassOf mc2:LicenseEnum ;
    skos:definition "Creative Commons Attribution-ShareAlike license, allowing for modifications with attribution and sharing under the same license." .

<https://w3id.org/mc2-center/mc2-model/LicenseEnum#GPL_3> a owl:Class ;
    rdfs:label "GPL_3" ;
    rdfs:subClassOf mc2:LicenseEnum ;
    skos:definition "GNU General Public License v3.0, a copyleft license requiring derivative works to be licensed under the same terms." .

<https://w3id.org/mc2-center/mc2-model/LicenseEnum#MIT> a owl:Class ;
    rdfs:label "MIT" ;
    rdfs:subClassOf mc2:LicenseEnum ;
    skos:definition "MIT License, a permissive license allowing for use, modification, and distribution." .

<https://w3id.org/mc2-center/mc2-model/LicenseEnum#Not%20licensed> a owl:Class ;
    rdfs:label "Not licensed" ;
    rdfs:subClassOf mc2:LicenseEnum .

<https://w3id.org/mc2-center/mc2-model/ManifestationEnum#Pan-cancer> a owl:Class ;
    rdfs:label "Pan-cancer" ;
    rdfs:subClassOf mc2:ManifestationEnum ;
    skos:definition "A term describing analyses, datasets, or studies that span and compare multiple different cancer/tumor types together, rather than being limited to a single cancer type, in order to identify shared or distinguishing molecular and clinical features across cancers." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#3D%20ATAC-PALM> a owl:Class ;
    rdfs:label "3D ATAC-PALM" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "A super-resolution imaging technique that combines ATAC-see (a fluorescence-based chromatin accessibility assay) with photoactivated localization microscopy (PALM) to visualize the 3D spatial organization of accessible chromatin in single cells." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#Angiogenesis%20Assay> a owl:Class ;
    rdfs:label "Angiogenesis Assay" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "An assay used to measure the formation of new blood vessels from existing vasculature, typically by quantifying endothelial cell tube formation, migration, or sprouting in vitro or in vivo." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#CRISPR> a owl:Class ;
    rdfs:label "CRISPR" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "A genome-editing and functional-screening technology based on the Clustered Regularly Interspaced Short Palindromic Repeats (CRISPR)-Cas system, used here as a general assay category for CRISPR-based perturbation experiments." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#Co-Immunoprecipitation%20Mass%20Spectrometry> a owl:Class ;
    rdfs:label "Co-Immunoprecipitation Mass Spectrometry" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "A method that combines co-immunoprecipitation (using an antibody to pull down a protein and its binding partners) with mass spectrometry to identify protein-protein interaction partners." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#DRIP-seq> a owl:Class ;
    rdfs:label "DRIP-seq" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "A molecular genetic technique that combines chromatin immunoprecipitation (ChIP) with massively parallel DNA sequencing to map the binding sites of DNA-associated proteins in a sample of cells. First, crosslinked protein-DNA complexes are isolated using ChIP. Next, the crosslinks are broken, the proteins are removed and the purified DNA is modified with adaptor oligonucleotides to facilitate massively parallel DNA sequencing. Following sequencing, the DNA sequences that are obtained can be mapped to their genomic locations." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#Dye%20Endocytosis%20Assay> a owl:Class ;
    rdfs:label "Dye Endocytosis Assay" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "An assay that measures cellular endocytic activity by quantifying the uptake of a fluorescent or otherwise detectable dye into cells." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#Human%20Induced%20Pluripotent%20Stem%20Cell-derived%20Cardiomyocytes%20Culture> a owl:Class ;
    rdfs:label "Human Induced Pluripotent Stem Cell-derived Cardiomyocytes Culture" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "The in vitro culture of cardiomyocytes (heart muscle cells) that have been differentiated from human induced pluripotent stem cells (iPSCs), used to model cardiac biology and disease." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#Macrophage%20Polarization%20Assay> a owl:Class ;
    rdfs:label "Macrophage Polarization Assay" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "An assay that measures the differentiation of macrophages into functional phenotypes (e.g., M1 pro-inflammatory or M2 anti-inflammatory) in response to specific stimuli, typically via marker expression or cytokine profiling." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#Metastatic%20Colonization%20Assay> a owl:Class ;
    rdfs:label "Metastatic Colonization Assay" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "An in vivo assay that measures the ability of tumor cells to establish and grow secondary colonies at a distant site after introduction into a host organism, modeling the colonization step of metastasis." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#Micropipette%20Aspiration> a owl:Class ;
    rdfs:label "Micropipette Aspiration" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "A biophysical technique that uses a fine glass micropipette and controlled suction pressure to measure the mechanical properties (e.g., membrane tension, cortical stiffness) of individual cells." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#Monolayer%20Stress%20Microscopy> a owl:Class ;
    rdfs:label "Monolayer Stress Microscopy" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "The use of various technologies to resolve the structure or features of objects too small or fine to naturally be seen by eye." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#Nanopatterning> a owl:Class ;
    rdfs:label "Nanopatterning" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "A fabrication technique that creates nanoscale surface features or patterns, used e.g. to control cell adhesion, shape, or substrate mechanics in cell-biology experiments." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#Paraquat%20Survival%20Assay> a owl:Class ;
    rdfs:label "Paraquat Survival Assay" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "A survival assay that exposes an organism (commonly Caenorhabditis elegans) to the oxidative-stress-inducing herbicide paraquat to measure resistance to oxidative stress and longevity." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#Partial%20Wave%20Spectroscopy> a owl:Class ;
    rdfs:label "Partial Wave Spectroscopy" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "The technique of measuring the emission and absorption of different wavelengths (spectra) of visible and non-visible light. This can be done via a spectroscope, which consists of a slit, prism, collimator lens, object lens, and a grating." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#RNA%20array> a owl:Class ;
    rdfs:label "RNA array" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "A microarray platform used to measure RNA expression levels." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#Scanning%20Angle%20Interference%20Microscopy> a owl:Class ;
    rdfs:label "Scanning Angle Interference Microscopy" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "Technique of electron microscopy in which the specimen is coated with heavy metal and then scanned by an electron beam. The resolution is not as great as with transmission electron microscopy, but preparation is easier (often by fixation followed by critical point drying), the depth of focus is relatively enormous, the surface of a specimen can be seen (though not the interior unless the specimen is cracked open) and the image is aesthetically pleasing." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#Single-Cell%20Barcode%20Chip> a owl:Class ;
    rdfs:label "Single-Cell Barcode Chip" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "A molecular genetic technique that combines chromatin immunoprecipitation (ChIP) with massively parallel DNA sequencing to map the binding sites of DNA-associated proteins in a sample of cells. First, crosslinked protein-DNA complexes are isolated using ChIP. Next, the crosslinks are broken, the proteins are removed and the purified DNA is modified with adaptor oligonucleotides to facilitate massively parallel DNA sequencing. Following sequencing, the DNA sequences that are obtained can be mapped to their genomic locations." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#Single-Molecule%20Localization%20Microscopy> a owl:Class ;
    rdfs:label "Single-Molecule Localization Microscopy" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "A super-resolution fluorescence microscopy technique that localizes individual fluorophore molecules with high precision over many imaging cycles to reconstruct an image beyond the diffraction limit." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#Structural%20Variant%20Analysis> a owl:Class ;
    rdfs:label "Structural Variant Analysis" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "The computational analysis of sequencing or array data to detect large-scale genomic alterations such as deletions, duplications, insertions, inversions, and translocations." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#Surveyor%20Nuclease%20Assay> a owl:Class ;
    rdfs:label "Surveyor Nuclease Assay" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "An assay that uses the Surveyor nuclease to detect and cleave DNA at sites of sequence mismatch, commonly used to quantify genome-editing efficiency (e.g., after CRISPR/TALEN treatment)." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#Synthetic%20Genetic%20Array> a owl:Class ;
    rdfs:label "Synthetic Genetic Array" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "A molecular biology device that utilizes a set of defined cDNA clones attached in a specific grid arrangement to a solid support for nucleic acid hybridization assays in gene mapping studies or in determining gene sequences, sequence variations, or gene expression patterns." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#Targeted%20Error%20Correction%20Sequencing> a owl:Class ;
    rdfs:label "Targeted Error Correction Sequencing" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "A targeted sequencing approach that incorporates molecular barcoding or redundant sequencing of the same DNA molecule to computationally distinguish true low-frequency variants from sequencing errors." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#Traction%20Force%20Microscopy> a owl:Class ;
    rdfs:label "Traction Force Microscopy" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "A technique utilizing a scanning probe to image and analyze the surface of a material with atomic-level resolution." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#compound%20screen> a owl:Class ;
    rdfs:label "compound screen" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "A screening assay testing multiple chemical compounds for a biological effect." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#histology> a owl:Class ;
    rdfs:label "histology" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "Microscopic examination of tissue structure via sectioning and staining." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#in%20silico%20synthesis> a owl:Class ;
    rdfs:label "in silico synthesis" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "Computational/simulation-based synthesis of a molecule or construct rather than a wet-lab technique." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#in%20vivo%20PDX%20viability> a owl:Class ;
    rdfs:label "in vivo PDX viability" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "A functional viability readout from a patient-derived xenograft (PDX) model." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#in%20vivo%20tumor%20growth> a owl:Class ;
    rdfs:label "in vivo tumor growth" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "Monitoring of tumor growth (e.g. volume/size over time) in a live animal model, typically as a functional readout rather than a molecular assay." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#metabolic%20screening> a owl:Class ;
    rdfs:label "metabolic screening" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "A screening assay assessing metabolic activity or metabolite profiles." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#proximity%20extension%20assay> a owl:Class ;
    rdfs:label "proximity extension assay" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "An antibody-based protein detection method (e.g. Olink) in which paired antibodies with attached DNA oligonucleotides bind a target protein, allowing proximity-dependent DNA amplification and readout." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#scCGI-seq> a owl:Class ;
    rdfs:label "scCGI-seq" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "A molecular genetic technique that combines chromatin immunoprecipitation (ChIP) with massively parallel DNA sequencing to map the binding sites of DNA-associated proteins in a sample of cells. First, crosslinked protein-DNA complexes are isolated using ChIP. Next, the crosslinks are broken, the proteins are removed and the purified DNA is modified with adaptor oligonucleotides to facilitate massively parallel DNA sequencing. Following sequencing, the DNA sequences that are obtained can be mapped to their genomic locations." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#shRNA-seq> a owl:Class ;
    rdfs:label "shRNA-seq" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "A pooled shRNA screening assay read out by sequencing to identify short hairpin RNA constructs enriched or depleted under a selection condition." .

<https://w3id.org/mc2-center/mc2-model/MeasurementTechniqueEnum#spatial%20transcriptomics> a owl:Class ;
    rdfs:label "spatial transcriptomics" ;
    rdfs:subClassOf mc2:MeasurementTechniqueEnum ;
    skos:definition "A general term for assays that measure RNA expression while preserving spatial location information within a tissue section." .

mc2:Model_Key a owl:DatatypeProperty ;
    rdfs:label "Model Key" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "CA\\d{6}-M\\d{1,9}" ] ) ] ;
    skos:definition "Unique Model_id foreign key(s) that link metadata entries as part of the same collection. Please provide multiple values as a comma-separate list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

mc2:Model_Table_Id a owl:DatatypeProperty ;
    rdfs:label "Model Table Id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^syn\\d{7,8}$" ] ) ] ;
    skos:definition "The Synapse Id corresponding to a Model metadata table associated with the Dataset(s)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Model_id a owl:DatatypeProperty ;
    rdfs:label "Model_id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^CA\\d{6}-M\\d{1,9}$" ] ) ] ;
    skos:definition "Unique row identifier, used as a primary key for record updates. This should use the GrantNumber-Mxxx format unless directed otherwise." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "12220014" .

<https://w3id.org/mc2-center/mc2-model/NGSLibrarySelectionMethodEnum#Inverse%20rRNA> a owl:Class ;
    rdfs:label "Inverse rRNA" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "depletion of ribosomal RNA by oligo hybridization." .

<https://w3id.org/mc2-center/mc2-model/NGSLibrarySelectionMethodEnum#Padlock%20probes%20capture%20method> a owl:Class ;
    rdfs:label "Padlock probes capture method" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Circularized oligonucleotide probes" .

<https://w3id.org/mc2-center/mc2-model/NGSMatrixTypeEnum#Batch%20Corrected%20Counts> a owl:Class ;
    rdfs:label "Batch Corrected Counts" ;
    rdfs:subClassOf mc2:NGSMatrixTypeEnum ;
    skos:definition "A matrix of counts that has been adjusted to remove technical variation introduced by differences between sequencing batches or experimental runs, while preserving true biological signal." .

<https://w3id.org/mc2-center/mc2-model/NGSMatrixTypeEnum#Scaled%20Counts> a owl:Class ;
    rdfs:label "Scaled Counts" ;
    rdfs:subClassOf mc2:NGSMatrixTypeEnum ;
    skos:definition "A matrix of counts that has been further transformed (e.g., centered and/or scaled to unit variance) after normalization, typically used as input for downstream analyses such as dimensionality reduction or clustering." .

<https://w3id.org/mc2-center/mc2-model/NGSReadIndicatorEnum#I1> a owl:Class ;
    rdfs:label "I1" ;
    rdfs:subClassOf mc2:NGSReadIndicatorEnum ;
    skos:definition "The first index read in a sequencing run, used to identify the sample-specific barcode (e.g., i7 index) for demultiplexing pooled libraries." .

<https://w3id.org/mc2-center/mc2-model/NGSReadIndicatorEnum#R1%26R2> a owl:Class ;
    rdfs:label "R1&R2" ;
    rdfs:subClassOf mc2:NGSReadIndicatorEnum ;
    skos:definition "Indicates that both Read 1 and Read 2, the forward and reverse reads of a paired-end sequencing reaction, are represented or applicable." .

<https://w3id.org/mc2-center/mc2-model/NGSSequencingPlatformEnum#AB%20SOLiD%203%20Plus%20System> a owl:Class ;
    rdfs:label "AB SOLiD 3 Plus System" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A proprietary next-generation DNA sequencing system from Applied Biosystems that utilizes DNA ligase. DNA fragments attached to beads are clonally amplified and ligated to fluorescently labeled \"interrogation probes\". Ligation frees the fluor, which is detected and identifies the specific probe. The marker of the attached probe is then removed and a 5'-phosphate group is regenerated. Multiple cycles of ligation, detection, and cleavage are performed." .

<https://w3id.org/mc2-center/mc2-model/NGSSequencingPlatformEnum#Illumina%20NextSeq%202500> a owl:Class ;
    rdfs:label "Illumina NextSeq 2500" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "This name does not correspond to a standard commercially released Illumina platform; it appears to conflate the Illumina NextSeq (500/550) benchtop sequencer series with the HiSeq 2500. If used, it should be treated as an Illumina sequencing-by-synthesis benchtop instrument similar to the NextSeq 500/550." .

mc2:NGS_Matrix_Type a owl:ObjectProperty ;
    rdfs:label "NGS Matrix Type" ;
    rdfs:range mc2:NGSMatrixTypeEnum ;
    skos:definition "Type of count data stored in matrix." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:NGS_RNA_DV200 a owl:DatatypeProperty ;
    rdfs:label "NGS RNA DV200" ;
    rdfs:range xsd:float ;
    skos:definition "Represents the percentage of RNA fragments that are >200 nucleotides in size. Number" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:NGS_RNA_End_Bias a owl:ObjectProperty ;
    rdfs:label "NGS RNA End Bias" ;
    rdfs:range mc2:NGSRNAEndBiasEnum ;
    skos:definition "The end of the cDNA molecule that is preferentially sequenced, e.g. 3/5 prime tag/end or the full length transcript" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:NGS_RNA_RIN a owl:DatatypeProperty ;
    rdfs:label "NGS RNA RIN" ;
    rdfs:range xsd:float ;
    skos:definition "A numerical assessment of the integrity of RNA based on the entire electrophoretic trace of the RNA sample including the presence or absence of degradation products. Number" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:NGS_RNA_Reverse_Transcription_Primer a owl:ObjectProperty ;
    rdfs:label "NGS RNA Reverse Transcription Primer" ;
    rdfs:range mc2:NGSRNAReverseTranscriptionPrimerEnum ;
    skos:definition "An oligo to which new deoxyribonucleotides can be added by DNA polymerase [SO_0000112]. The type of primer used for reverse transcription, e.g. oligo-dT or random primer. This allows users to identify content of the cDNA library input e.g. enriched for mRNA" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:NGS_Unique_Probe_Count a owl:DatatypeProperty ;
    rdfs:label "NGS Unique Probe Count" ;
    rdfs:range xsd:float ;
    skos:definition "Total number of unique probes reported." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:NGS_Unique_Target_Count a owl:DatatypeProperty ;
    rdfs:label "NGS Unique Target Count" ;
    rdfs:range xsd:float ;
    skos:definition "Total number of unique genes reported." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

