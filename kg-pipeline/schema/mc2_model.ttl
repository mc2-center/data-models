mesh:D000079265 a owl:Class ;
    rdfs:label "Environmental Science" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The interdisciplinary scientific study of external biotic and abiotic factors to which an organism is exposed, and their effects on health and ecosystems." .

mesh:D000089862 a owl:Class ;
    rdfs:label "Haptic" ;
    rdfs:subClassOf mc2:ResourceMediaAccessibilityEnum ;
    skos:definition "Indicates that the resource provides touch-based (haptic) feedback, such as vibration, force, or tactile cues, as an alternative or supplement to visual or auditory information." .

mesh:D000092783 a owl:Class ;
    rdfs:label "Diversity/Equity/Inclusion" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "Efforts and practices that promote fair representation, equal opportunity, and inclusion of individuals from diverse backgrounds, identities, and abilities within research and educational communities." .

mesh:D000362 a owl:Class ;
    rdfs:label "Agar embedding" ;
    rdfs:subClassOf mc2:BiospecimenEmbeddingMediumEnum ;
    skos:definition "Use of agar, a gelatinous polysaccharide extracted from red algae, as a supporting medium to consolidate small, fragmented, or friable tissue specimens prior to histological processing and sectioning." .

mesh:D003101 a owl:Class ;
    rdfs:label "Celloidin media" ;
    rdfs:subClassOf mc2:BiospecimenEmbeddingMediumEnum ;
    skos:definition "A purified nitrocellulose (collodion) solution in ether and alcohol; historically used as an embedding medium for sectioning large, hard, or heterogeneous specimens (e.g., whole organs, decalcified bone) that are poorly suited to paraffin embedding." .

mesh:D003479 a owl:Class ;
    rdfs:label "Curriculum/Instruction" ;
    rdfs:subClassOf mc2:ResourceIntendedUseEnum ;
    skos:definition "A structured course of study or instructional material intended for use in classroom teaching or curriculum-based instruction." .

mesh:D004500 a owl:Class ;
    rdfs:label "Graduate / Profession" ;
    rdfs:subClassOf mc2:ResourceEducationalLevelEnum ;
    skos:definition "Studies beyond the bachelor's degree at an institution having graduate or professional programs, undertaken to prepare for entrance into a specific field or to obtain a higher degree." .

mesh:D004521 a owl:Class ;
    rdfs:label "Assessment" ;
    rdfs:subClassOf mc2:ResourceActivityTypeEnum ;
    skos:definition "A resource used to evaluate learner understanding or performance, such as a quiz, test, or other measurement of academic achievement." .

mesh:D004853 a owl:Class ;
    rdfs:label "Epoxy Resin (Araldite)" ;
    rdfs:subClassOf mc2:BiospecimenEmbeddingMediumEnum ;
    skos:definition "A class of thermosetting polymer resins (e.g., Araldite) formed by curing epoxide monomers with a hardener; used as a hard, transparent embedding medium for ultrathin sectioning in transmission electron microscopy." .

mesh:D007254 a owl:Class ;
    rdfs:label "Information Science" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The field of knowledge, theory, and technology concerned with the collection, organization, storage, retrieval, and dissemination of facts and data, including aspects of communication, publishing, and informatics." .

mesh:D010344 a owl:Class ;
    rdfs:label "Patient Advocacy" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "Efforts to promote, protect, and represent the rights, needs, and interests of patients, often through education, support services, or engagement in research and health policy processes." .

mesh:D018961 a owl:Class ;
    rdfs:label "Educational Technology" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The systematic identification, development, organization, and use of educational resources, tools, and equipment, including audiovisual and digital aids, to support teaching and learning." .

mesh:D019528 a owl:Class ;
    rdfs:label "Lecture Notes" ;
    rdfs:subClassOf mc2:ResourceActivityTypeEnum ;
    skos:definition "Written notes, outlines, or summaries prepared for or derived from a lecture, used to supplement or review instructional content." .

mesh:D019531 a owl:Class ;
    rdfs:label "Lecture" ;
    rdfs:subClassOf mc2:ResourceActivityTypeEnum ;
    skos:definition "A recorded or transcribed instructional talk delivered to an audience or class, typically used to present or explain subject matter." .

mesh:D022923 a owl:Class ;
    rdfs:label "Textbook" ;
    rdfs:subClassOf mc2:ResourceActivityTypeEnum ;
    skos:definition "A book intended for use in the study of a specific subject, providing a systematic presentation of its principles and essential knowledge." .

mesh:D061108 a owl:Class ;
    rdfs:label "Social Media" ;
    rdfs:subClassOf mc2:ToolLinkTypeEnum .

APOLLO_SV:00000522 a owl:Class ;
    rdfs:label "Repository" ;
    rdfs:subClassOf mc2:ToolLinkTypeEnum ;
    skos:definition "A place where source code, data and other files can be retrieved from, typically via platforms like GitHub which provide version control and other features, or something simpler, e.g. an FTP site." .

BTO:0006181 a owl:Class ;
    rdfs:label "Blood Buffy Coat" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "The fraction of an anticoagulated blood sample that contains most of the white blood cells and platelets following density gradient centrifugation of whole blood." .

CHEBI:17754 a owl:Class ;
    rdfs:label "Glycerol" ;
    rdfs:subClassOf mc2:ImageImmersionTypeEnum ;
    skos:definition "An imaging immersion condition in which glycerol, a triol with a refractive index intermediate between water and oil, is applied between the objective lens and the specimen; glycerol-immersion objectives are often used for tissue-clearing or deep-imaging applications." .

CRO:0000091 a owl:Class ;
    rdfs:label "Documentor" ;
    rdfs:subClassOf mc2:ToolEntityRoleEnum .

EMAPA:37441 a owl:Class ;
    rdfs:label "Body Fluid" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A liquid substance derived from the body, such as blood, urine, cerebrospinal fluid, or pleural effusion, that is collected as a biospecimen." .

GENEPIO:0001943 a owl:Class ;
    rdfs:label "CF-H" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Cot-filtered highly repetitive genomic DNA" .

GENEPIO:0001944 a owl:Class ;
    rdfs:label "CF-M" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Cot-filtered moderately repetitive genomic DNA" .

GENEPIO:0001945 a owl:Class ;
    rdfs:label "CF-S" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Cot-filtered single/low-copy genomic DNA" .

GENEPIO:0001946 a owl:Class ;
    rdfs:label "CF-T" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Cot-filtered theoretical single-copy genomic DNA" .

GENEPIO:0001948 a owl:Class ;
    rdfs:label "DNAse" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Deoxyribonuclease (MNase) digestion" .

GENEPIO:0001949 a owl:Class ;
    rdfs:label "HMPR" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Hypo-methylated partial restriction digest" .

GENEPIO:0001950 a owl:Class ;
    rdfs:label "Hybrid Selection" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Selection by hybridization in array or solution" .

GENEPIO:0001951 a owl:Class ;
    rdfs:label "MBD2 protein methyl-CpG binding domain" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Enrichment by methyl-CpG binding domain" .

GENEPIO:0001952 a owl:Class ;
    rdfs:label "MF" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Methyl Filtrated" .

GENEPIO:0001953 a owl:Class ;
    rdfs:label "MNase" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Micrococcal Nuclease (MNase) digestion" .

GENEPIO:0001954 a owl:Class ;
    rdfs:label "MSLL" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Methylation Spanning Linking Library" .

GENEPIO:0001961 a owl:Class ;
    rdfs:label "Restriction Digest" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "DNA fractionation using restriction enzymes" .

GENEPIO:0001963 a owl:Class ;
    rdfs:label "Size fractionation" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Physical selection of size appropriate targets" .

GENEPIO:0100106 a owl:Class ;
    rdfs:label "Illumina Genome Analyzer" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A DNA sequencer manufactured by Solexa (later acquired by Illumina) as one of its first sequencer lines, launched in 2006, capable of sequencing 1 gigabase (Gb) of data in a single run." .

GENEPIO:0100109 a owl:Class ;
    rdfs:label "Illumina HiScanSQ" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A DNA sequencer manufactured by Illumina using sequencing-by-synthesis chemistry, containing a HiScan Reader for sequencing and microarray-based analyses as well as an SQ Module supporting microfluidics." .

GENEPIO:0100112 a owl:Class ;
    rdfs:label "Illumina HiSeq X Five" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A DNA sequencer manufactured by Illumina using sequencing-by-synthesis chemistry, consisting of a set of five HiSeq X ultra-high-throughput sequencing systems configured for population-scale whole-genome sequencing." .

GENEPIO:0100113 a owl:Class ;
    rdfs:label "Illumina HiSeq X Ten" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A DNA sequencer manufactured by Illumina consisting of a set of ten HiSeq X ultra-high-throughput sequencing systems configured for population-scale whole-genome sequencing." .

GENEPIO:0100121 a owl:Class ;
    rdfs:label "Illumina iSeq 100" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The Illumina iSeq 100 is a model type of the Illumina sequencing library platform." .

GENEPIO:0100122 a owl:Class ;
    rdfs:label "Illumina NovaSeq" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A DNA sequencer manufactured by Illumina using sequencing-by-synthesis chemistry with an output capacity of up to 6 Tb and 20 billion reads in dual flow-cell mode." .

GENEPIO:0100124 a owl:Class ;
    rdfs:label "Illumina MiniSeq" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A benchtop DNA sequencer manufactured by Illumina using sequencing-by-synthesis chemistry, with an output capacity of approximately 1.65-7.5 Gb per run." .

GENEPIO:0100126 a owl:Class ;
    rdfs:label "Illumina NextSeq" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A benchtop DNA sequencer manufactured by Illumina using sequencing-by-synthesis chemistry; the NextSeq series succeeded the HiSeq/MiSeq lines with high throughput in a compact benchtop format." .

GENEPIO:0100131 a owl:Class ;
    rdfs:label "PacBio RS" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A DNA sequencer manufactured by Pacific Biosciences that utilizes SMRT (single-molecule real-time) cells for sequencing; the first commercial model produced by the company." .

GENEPIO:0100133 a owl:Class ;
    rdfs:label "PacBio Sequel" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The PacBio Sequel is a model type of the PacBio SMRT sequencing library platform." .

GENEPIO:0100134 a owl:Class ;
    rdfs:label "PacBio Sequel II" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The PacBio Sequel II is a model type of the PacBio SMRT sequencing library platform." .

GENEPIO:0100136 a owl:Class ;
    rdfs:label "Ion Torrent PGM" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A DNA sequencer manufactured by Ion Torrent (Thermo Fisher) that utilizes ion semiconductor sequencing and has an output capacity of 300 Mb to 1 Gb." .

GENEPIO:0100137 a owl:Class ;
    rdfs:label "Ion Torrent Proton" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A DNA sequencer manufactured by Ion Torrent (Thermo Fisher) that utilizes ion semiconductor sequencing and has an output capacity of up to 15 Gb." .

GENEPIO:0100138 a owl:Class ;
    rdfs:label "Ion Torrent S5 XL" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A DNA sequencer manufactured by Ion Torrent (Thermo Fisher) that utilizes ion semiconductor sequencing, requiring only a small amount of input material while producing data faster than the standard S5 model." .

GENEPIO:0100139 a owl:Class ;
    rdfs:label "Ion Torrent S5" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A DNA sequencer manufactured by Ion Torrent (Thermo Fisher) that utilizes ion semiconductor sequencing and requires only a small amount of input material." .

GENEPIO:0100141 a owl:Class ;
    rdfs:label "GridION" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A DNA sequencer manufactured by Oxford Nanopore Technologies that can run and analyze up to five individual flow cells, producing up to 150 Gb of data per run, using real-time nanopore sequencing." .

GENEPIO:0100142 a owl:Class ;
    rdfs:label "MinION" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A portable DNA sequencer manufactured by Oxford Nanopore Technologies that uses consumable flow cells producing up to 30 Gb of sequence data per flow cell, generating real-time results via nanopore sequencing." .

GENEPIO:0100145 a owl:Class ;
    rdfs:label "BGISEQ-500" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The BGISEQ-500 is a model type of the BGISEQ sequencing library platform." .

GENEPIO:0100147 a owl:Class ;
    rdfs:label "DNBSEQ-T7" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The DNBSEQ-T7 is a model type of the BGISEQ sequencing library platform." .

GENEPIO:0100148 a owl:Class ;
    rdfs:label "DNBSEQ-G400" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The DNBSEQ-G400 is a model type of the BGISEQ sequencing library platform." .

GENEPIO:0100150 a owl:Class ;
    rdfs:label "DNBSEQ-G50" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The DNBSEQ-G50 is a model type of the BGISEQ sequencing library platform." .

GENEPIO:0100968 a owl:Class ;
    rdfs:label "454 GS FLX+" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The 454 GS FLX+ is an upgraded version of the 454 GS FLX Titanium pyrosequencing instrument from 454 Life Sciences (Roche), offering extended read lengths of up to approximately 1,000 bp." .

GENEPIO:0100970 a owl:Class ;
    rdfs:label "AB 5500x-Wl Genetic Analyzer" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A proprietary next-generation DNA sequencing system from Applied Biosystems that utilizes DNA ligase. DNA fragments attached to beads are clonally amplified and ligated to fluorescently labeled \"interrogation probes\". Ligation frees the fluor, which is detected and identifies the specific probe. The marker of the attached probe is then removed and a 5'-phosphate group is regenerated. Multiple cycles of ligation, detection, and cleavage are performed." .

GENEPIO:0100975 a owl:Class ;
    rdfs:label "AB 310 Genetic Analyzer" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "An Applied Biosystems sequencing instrument that uses a single-capillary electrophoresis system to perform automated Sanger sequencing and fragment analysis." .

GENEPIO:0100976 a owl:Class ;
    rdfs:label "AB 3130 Genetic Analyzer" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "An Applied Biosystems sequencing instrument that performs capillary electrophoresis-based Sanger sequencing using 4 capillaries; successor to the AB PRISM 310." .

GENEPIO:0100977 a owl:Class ;
    rdfs:label "AB 3130xL Genetic Analyzer" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "An Applied Biosystems sequencing instrument that performs capillary electrophoresis-based Sanger sequencing using 16 capillaries; successor to the AB PRISM 310." .

GENEPIO:0100978 a owl:Class ;
    rdfs:label "AB 3500 Genetic Analyzer" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "An Applied Biosystems sequencing instrument that performs capillary electrophoresis-based Sanger sequencing using 8 capillaries and can run 96-well plates; successor to the 3130 series." .

GENEPIO:0100979 a owl:Class ;
    rdfs:label "AB 3500xL Genetic Analyzer" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "An Applied Biosystems sequencing instrument that performs capillary electrophoresis-based Sanger sequencing using 24 capillaries and can run 384-well plates; successor to the 3130 series." .

GENEPIO:0100980 a owl:Class ;
    rdfs:label "AB 3730 Genetic Analyzer" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "An Applied Biosystems sequencing instrument that uses a 48-capillary array electrophoresis system for Sanger sequencing; successor to the 3500 series." .

GENEPIO:0100981 a owl:Class ;
    rdfs:label "AB 3730xL Genetic Analyzer" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "An Applied Biosystems sequencing instrument that uses a 96-capillary array electrophoresis system for Sanger sequencing; successor to the 3500 series." .

GENEPIO:0101020 a owl:Class ;
    rdfs:label "rRNA Depletion" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "A library selection method in which ribosomal RNA (rRNA) is selectively removed from a nucleic acid sample prior to sequencing, enriching for non-ribosomal RNA species such as messenger RNA and other transcripts." .

GENEPIO:0102191 a owl:Class ;
    rdfs:label "PolyA" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "PolyA selection or enrichment for messenger RNA (mRNA); should replace cDNA enumeration." .

GSSO:003578 a owl:Class ;
    rdfs:label "Mobile" ;
    rdfs:subClassOf mc2:ResourcePrimaryFormatEnum ;
    skos:definition "A computer program or software application designed to run on a mobile device such as a phone or tablet." .

GSSO:005459 a owl:Class ;
    rdfs:label "Discussion Forum" ;
    rdfs:subClassOf mc2:ToolLinkTypeEnum .

IAO:0000593 a owl:Class ;
    rdfs:label "Library" ;
    rdfs:subClassOf mc2:ToolTypeEnum ;
    skos:definition "A collection of components that are used to construct other tools. bio.tools scope includes component libraries performing high-level bioinformatics functions but excludes lower-level programming libraries." .

MAMO:0000024 a owl:Class ;
    rdfs:label "Agent-Based Cell Modelling" ;
    rdfs:subClassOf mc2:ToolOperationEnum .

MONDO:0005165 a owl:Class ;
    rdfs:label "Benign Neoplasms" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A neoplasm that lacks the morphologic features of malignancy, such as severe cytologic atypia or tumor cell necrosis, and remains confined to its site of origin without metastasizing." .

NCIT:C102873 a owl:Class ;
    rdfs:label "Teacher" ;
    rdfs:subClassOf mc2:ResourcePrimaryAudienceEnum ;
    skos:definition "One who instructs or educates others." .

NCIT:C104914 a owl:Class ;
    rdfs:label "Photon Beam Radiation Therapy" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "Radiation therapy using a photon beam." .

NCIT:C106049 a owl:Class ;
    rdfs:label "ChIP-Seq" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Direct sequencing of chromatin immunoprecipitates" .

NCIT:C106056 a owl:Class ;
    rdfs:label "MNase-Seq" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Direct sequencing following MNase digestion" .

NCIT:C113729 a owl:Class ;
    rdfs:label "GB Borderline" ;
    rdfs:subClassOf mc2:TumorGradeEnum ;
    skos:definition "A morphologic qualifier indicating that a neoplasm is of borderline malignancy." .

NCIT:C113730 a owl:Class ;
    rdfs:label "GX Grade Cannot Be Assessed" ;
    rdfs:subClassOf mc2:TumorGradeEnum ;
    skos:definition "A morphologic qualifier indicating that the grade of a neoplasm cannot be assessed." .

NCIT:C118286 a owl:Class ;
    rdfs:label "Stereotactic Body Radiation Therapy" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "Stereotactic radiation therapy in which one or several maximum dose radiation treatments are delivered targeting cancers of the body, excluding the brain or spine." .

NCIT:C118962 a owl:Class ;
    rdfs:label "Censored" ;
    rdfs:subClassOf mc2:IndividualRecurrenceStatusEnum ;
    skos:definition "When information on time-to-event is not available due to loss to follow-up or non-occurrence of outcome event before the trial end." .

NCIT:C119010 a owl:Class ;
    rdfs:label "Peritumoral" ;
    rdfs:subClassOf mc2:BiospecimenTumorStatusEnum ;
    skos:definition "Located in tissues surrounding a tumor." .

NCIT:C12482 a owl:Class ;
    rdfs:label "Fibroblasts from Bone Marrow Normal" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "Fibroblast cells isolated from a normal (non-malignant) bone marrow specimen." .

NCIT:C12530 a owl:Class ;
    rdfs:label "Granulocytes" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A type of leukocyte with a multilobed nucleus and cytoplasmic granules, subdivided into eosinophils, basophils, and neutrophils based on the staining properties of their granules." .

NCIT:C127533 a owl:Class ;
    rdfs:label "Primary Contact" ;
    rdfs:subClassOf mc2:ToolEntityRoleEnum .

NCIT:C12801 a owl:Class ;
    rdfs:label "Tissue" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "An anatomical structure consisting of similarly specialized cells and intercellular matrix, aggregated according to genetically determined spatial relationships, that performs a specific function." .

NCIT:C130177 a owl:Class ;
    rdfs:label "Targeted-Capture" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "A technique that determines the nucleotide sequence of a pre-specified region of DNA or RNA by using primers that are specific for that region." .

NCIT:C13197 a owl:Class ;
    rdfs:label "Nucleus" ;
    rdfs:subClassOf mc2:ImageObjectClassEnum ;
    skos:definition "A body within the cell, surrounded by a membrane, within which lie the chromosomes, one or more nucleoli, combined with proteins, and exhibits mitosis." .

NCIT:C132010 a owl:Class ;
    rdfs:label "T5" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "An antiquated primary tumor finding term that refers to colorectal cancer which has spread by direct extension beyond the immediately adjacent organs or tissues (AJCC 1st Ed.)." .

NCIT:C132222 a owl:Class ;
    rdfs:label "Prefer not to answer" ;
    rdfs:subClassOf mc2:SexEnum ;
    skos:definition "A response indicating that an individual prefers or preferred not to answer." .

NCIT:C13226 a owl:Class ;
    rdfs:label "Cytoplasm" ;
    rdfs:subClassOf mc2:ImageObjectClassEnum ;
    skos:definition "The protoplasm of a cell outside the nucleus, bounded by the plasma membrane and containing all of the cell's organelles except the nucleus." .

NCIT:C13275 a owl:Class ;
    rdfs:label "Saliva" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "The watery fluid in the mouth produced by the salivary glands that moistens food to aid digestion and helps protect the mouth against infection." .

NCIT:C135727 a owl:Class ;
    rdfs:label "Blood Derived Liquid Biopsy" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A blood-based liquid biopsy specimen used to sample circulating tumor cells, cell-free nucleic acids, or other tumor-derived material without a solid tissue biopsy." .

NCIT:C13735 a owl:Class ;
    rdfs:label "Plasma Membrane" ;
    rdfs:subClassOf mc2:ImageObjectClassEnum ;
    skos:definition "The semipermeable membrane that encloses the cytoplasm of a cell." .

NCIT:C139414 a owl:Class ;
    rdfs:label "Tis (DCIS)" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "Breast cancer with a finding of ductal carcinoma in situ." .

NCIT:C139415 a owl:Class ;
    rdfs:label "Tis (Paget's)" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "Paget disease of the nipple not associated with invasive carcinoma and/or carcinoma in situ in the underlying breast parenchyma." .

NCIT:C141342 a owl:Class ;
    rdfs:label "Concurrent Chemoradiation" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "Treatment in which radiation therapy is administered at the same time as chemotherapy." .

NCIT:C14174 a owl:Class ;
    rdfs:label "Metastatic" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A term referring to the clinical or pathologic observation of a tumor extension from its original site of growth to another anatomic site." .

NCIT:C142380 a owl:Class ;
    rdfs:label "HTML" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "HTML (Hypertext Markup Language) is a standard markup language used to structure and display content on web pages, as specified by the World Wide Web Consortium (W3C)." .

NCIT:C143028 a owl:Class ;
    rdfs:label "FFPE" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMediumEnum ;
    skos:definition "Formalin-Fixed Paraffin-Embedded" .

NCIT:C1446 a owl:Class ;
    rdfs:label "Radiopharmaceutical" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "An agent that contains a radioactive isotope and is used for diagnostic or therapeutic purposes." .

NCIT:C147937 a owl:Class ;
    rdfs:label "Preschool" ;
    rdfs:subClassOf mc2:ResourceEducationalLevelEnum ;
    skos:definition "An educational institution for children that precedes kindergarten." .

NCIT:C148411 a owl:Class ;
    rdfs:label "T2d" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A TNM stage finding term for ophthalmic sites melanoma staging, indicating tumor size category 2 with specific extension or caruncular criteria." .

NCIT:C148412 a owl:Class ;
    rdfs:label "T3d" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A TNM finding term for melanoma or retinoblastoma staging, indicating tumor size category 3 with ciliary body involvement, specific conjunctival extension, or scleral invasion criteria." .

NCIT:C150423 a owl:Class ;
    rdfs:label "Paired-end" ;
    rdfs:subClassOf mc2:NGSLibraryLayoutEnum ;
    skos:definition "A DNA sequencing strategy where a single read is initiated from each end of a DNA fragment." .

NCIT:C15189 a owl:Class ;
    rdfs:label "Biopsy" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "The removal of tissue specimens or fluid from the living body for microscopic examination, performed to establish a diagnosis." .

NCIT:C15195 a owl:Class ;
    rdfs:label "Brachytherapy" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "A type of radiation therapy in which radioactive material is placed inside the body, into a tumor or body cavity." .

NCIT:C151961 a owl:Class ;
    rdfs:label "Less than Partial Response" ;
    rdfs:subClassOf mc2:TreatmentResponseEnum ;
    skos:definition "Less than Partial Clinical Response" .

NCIT:C15275 a owl:Class ;
    rdfs:label "Lymphadenectomy (regional nodes)" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "Surgical removal of lymph nodes, usually done to assess the spread of cancer." .

NCIT:C15289 a owl:Class ;
    rdfs:label "Organ Transplantation" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "The transfer of an organ, organ part, or tissue from one body to another, for the purpose of replacing the recipient's damaged or failing organ with a working one from the donor. Donors can be living, or cadaveric (dead)." .

NCIT:C15292 a owl:Class ;
    rdfs:label "Palliative Care" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "The patient- and family-centered active holistic care of patients with advanced, progressive disease, encompassing pain and symptom control, communication about treatment and prognosis, and psychosocial and spiritual support, with the goal of achieving the best quality of life for patients and their families." .

NCIT:C15313 a owl:Class ;
    rdfs:label "Radiation Therapy" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "Treatment of a disease by means of exposure of the target or the whole body to radiation. Radiation therapy is often used as part of curative therapy and occasionally as a component of palliative treatment for cancer." .

NCIT:C153194 a owl:Class ;
    rdfs:label "Transcriptome" ;
    rdfs:subClassOf mc2:NGSLibrarySourceMoleculeEnum ;
    skos:definition "The complete set of RNA transcripts that are produced by the genome, under specific circumstances or in a specific cell." .

NCIT:C15329 a owl:Class ;
    rdfs:label "Surgical Procedure" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "A diagnostic or treatment procedure performed by manual and/or instrumental means, often involving an incision and the removal or replacement of a diseased organ or tissue." .

NCIT:C15358 a owl:Class ;
    rdfs:label "Stereotactic Radiosurgery" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "A non-surgical procedure that was developed to deliver one or several maximum dose targeted radiation treatments for cancers in the brain or spine." .

NCIT:C15361 a owl:Class ;
    rdfs:label "Fine needle aspirate" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "The removal of tissue or fluid with a thin needle for examination under a microscope." .

NCIT:C15385 a owl:Class ;
    rdfs:label "Excisional Biopsy" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "A surgical procedure in which an entire lesion is removed for microscopic examination." .

NCIT:C15386 a owl:Class ;
    rdfs:label "Incisional Biopsy" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "A surgical procedure in which part of a lesion is removed for microscopic examination." .

NCIT:C15387 a owl:Class ;
    rdfs:label "Shave biopsy" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "Removal skin tissue, for microscopic examination, using a blade oriented in the horizontal plane of the skin surface." .

NCIT:C15431 a owl:Class ;
    rdfs:label "Stem Cell Transplant" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "A therapeutic procedure that involves the transplantation of hematopoietic stem cells, either with the patient as their own donor or from a donor to the patient, used for the treatment of malignant and non-malignant diseases." .

NCIT:C15445 a owl:Class ;
    rdfs:label "Hormone Therapy" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "Various treatment modalities that produce the desired therapeutic effect by means of a change of hormone/hormones level." .

NCIT:C15632 a owl:Class ;
    rdfs:label "Chemotherapy" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "The use of synthetic or naturally-occurring chemicals for the treatment of diseases." .

NCIT:C156437 a owl:Class ;
    rdfs:label "Repli-G (Qiagen) DNA" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A genomic DNA specimen that has been amplified from a limited-quantity sample using the REPLI-g (Qiagen) whole genome amplification technology." .

NCIT:C156439 a owl:Class ;
    rdfs:label "Repli-G X (Qiagen) DNA" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A genomic DNA specimen amplified from an ultra-low-input sample using the REPLI-g X (Qiagen) whole genome amplification kit, designed for single-cell or trace-quantity starting material." .

NCIT:C156440 a owl:Class ;
    rdfs:label "Additional Metastatic" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A biospecimen derived from an additional metastatic tumor site, collected separately from the first-sampled metastatic lesion." .

NCIT:C156441 a owl:Class ;
    rdfs:label "Additional - New Primary" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A biospecimen collected from a new primary malignancy that arose in a patient in addition to a previously diagnosed primary tumor." .

NCIT:C156442 a owl:Class ;
    rdfs:label "Control Analyte" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A biospecimen or analyte that is used as a comparator or reference against an experimental sample." .

NCIT:C15650 a owl:Class ;
    rdfs:label "Electron Beam Radiation Therapy" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "Radiation therapy using an electron beam." .

NCIT:C15651 a owl:Class ;
    rdfs:label "High-Dose Rate Brachytherapy" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "Internal radiation treatment that targets a cancerous tissue with accurate, high doses of radiation through the use of inserted temporary implants." .

NCIT:C15666 a owl:Class ;
    rdfs:label "Radiofrequency Ablation" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "A therapeutic procedure to kill tissue using radiowaves to generate heat. The procedure is performed by the insertion of an electrode into a target tissue; electrical energy delivered to the electrode heats and destroys the tissue." .

NCIT:C15667 a owl:Class ;
    rdfs:label "Sentinel node biopsy" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "Surgical removal and examination of the sentinel node, the lymph node which is first in receiving the lymphatic drainage of a specified anatomic location and is most likely to be affected by the lymphatic spread of cancer." .

NCIT:C15680 a owl:Class ;
    rdfs:label "Core needle biopsy" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "The removal of a tissue sample using a needle with a relatively large diameter, for microscopic examination." .

NCIT:C156848 a owl:Class ;
    rdfs:label "Tumor Free" ;
    rdfs:subClassOf mc2:LastKnownDiseaseStatusEnum ;
    skos:definition "There is no evidence of a tumor in the individual." .

NCIT:C156849 a owl:Class ;
    rdfs:label "With Tumor" ;
    rdfs:subClassOf mc2:LastKnownDiseaseStatusEnum ;
    skos:definition "There is evidence of a tumor in an individual." .

NCIT:C15751 a owl:Class ;
    rdfs:label "External Beam Radiation Therapy" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "Radiation therapy in which high-energy beams are delivered to the tumor from outside of the body." .

NCIT:C158417 a owl:Class ;
    rdfs:label "Frozen" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMethodEnum ;
    skos:definition "A tissue sample that has been frozen prior to analysis." .

NCIT:C158758 a owl:Class ;
    rdfs:label "Surgical Resection" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "The surgical removal of all or part of an organ or tissue structure that may include a lesion." .

NCIT:C15986 a owl:Class ;
    rdfs:label "Pharmacotherapy" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "Treatment of disease through the use of drugs." .

NCIT:C16035 a owl:Class ;
    rdfs:label "3-Dimensional Conformal Radiation Therapy" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "A process by which a dose of radiation is automatically shaped to closely conform to the entire volume of the tumor, so that surrounding normal tissue is spared and treatment toxicity is decreased." .

NCIT:C16135 a owl:Class ;
    rdfs:label "Intensity-Modulated Radiation Therapy" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "An advanced form of 3-Dimensional Conformal Radiation Therapy (3D CRT) that involves the use of varying intensities of small radiation beams to produce dosage distributions that are more precise than those possible with 3D CRT." .

NCIT:C162704 a owl:Class ;
    rdfs:label "No Response" ;
    rdfs:subClassOf mc2:TreatmentResponseEnum ;
    skos:definition "No apparent pathologic and/or clinical changes resulting from treatment." .

NCIT:C16345 a owl:Class ;
    rdfs:label "Biology" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The scientific study of living organisms, including their structure, function, growth, evolution, and interactions with their environment." .

NCIT:C163987 a owl:Class ;
    rdfs:label "Affinity Enrichment" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "A library selection method that enriches for specific nucleic acid or protein targets through binding to an antibody, protein, or other affinity reagent prior to sequencing or analysis." .

NCIT:C163991 a owl:Class ;
    rdfs:label "miRNA Size Fractionation" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "A library selection method that isolates small RNA species, such as microRNAs, from a nucleic acid sample based on their characteristically small size, typically using gel- or column-based size-exclusion techniques." .

NCIT:C163993 a owl:Class ;
    rdfs:label "EBV Immortalized Normal" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A biospecimen consisting of normal lymphocytes that have been infected in vitro with Epstein-Barr virus (EBV) and cultured to establish an indefinitely proliferating cell line." .

NCIT:C163995 a owl:Class ;
    rdfs:label "Total RNA" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A biological sample comprised of all of the RNA collected from an experimental subject." .

NCIT:C164009 a owl:Class ;
    rdfs:label "Bone Marrow Normal" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A bone marrow specimen collected from a subject that does not contain malignant cells and is used as a normal reference sample." .

NCIT:C164011 a owl:Class ;
    rdfs:label "Mononuclear Cells from Bone Marrow Normal" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A biological sample containing mononuclear cells isolated from a normal (non-malignant) bone marrow specimen." .

NCIT:C164014 a owl:Class ;
    rdfs:label "Solid Tissue Normal" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A specimen of morphologically normal solid tissue collected from a subject, typically used as a matched normal control for a tumor specimen." .

NCIT:C16403 a owl:Class ;
    rdfs:label "Cell Lines" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A permanently established cell culture that will proliferate indefinitely given appropriate fresh medium and growth space." .

NCIT:C164032 a owl:Class ;
    rdfs:label "Normal adjacent" ;
    rdfs:subClassOf mc2:BiospecimenCompositionEnum ;
    skos:definition "A specimen comprised of morphologically normal tissue collected from the area immediately surrounding a tumor in an experimental subject." .

NCIT:C164033 a owl:Class ;
    rdfs:label "Tumor Adjacent Normal - Post Neo-adjuvant Therapy" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A specimen of morphologically normal tissue collected from the area immediately surrounding a tumor, obtained from a subject after treatment with a neoadjuvant therapeutic." .

NCIT:C16414 a owl:Class ;
    rdfs:label "Chemistry" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The scientific study of the composition, structure, properties, and reactions of matter, especially atomic and molecular systems." .

NCIT:C164339 a owl:Class ;
    rdfs:label "Diagnosis Date" ;
    rdfs:subClassOf mc2:StudyIndexDateEnum ;
    skos:definition "The date on which a diagnosis of disease was made." .

NCIT:C165189 a owl:Class ;
    rdfs:label "Conventional Radiotherapy" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "A course of radiotherapy where minimal imaging support (i.e. X-ray films) is used to determine the positioning of radiotherapy." .

NCIT:C165197 a owl:Class ;
    rdfs:label "Biochemical evidence of disease without structural correlate" ;
    rdfs:subClassOf mc2:LastKnownDiseaseStatusEnum ;
    skos:definition "An indication that biochemical markers of a disease are present but morphological markers are absent." .

NCIT:C16523 a owl:Class ;
    rdfs:label "Drug Resistance/Sensitivity" ;
    rdfs:subClassOf mc2:GrantThemeNameEnum .

NCIT:C16526 a owl:Class ;
    rdfs:label "Ecology" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The branch of biology concerned with the relationships between organisms and their environment." .

NCIT:C165444 a owl:Class ;
    rdfs:label "Single-indexed" ;
    rdfs:subClassOf mc2:NGSLibraryLayoutEnum ;
    skos:definition "An indexed sequencing method that includes one index read." .

NCIT:C16624 a owl:Class ;
    rdfs:label "Genetics" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The branch of biology that deals with heredity, especially the mechanisms of hereditary transmission and the variation of inherited characteristics among similar or related organisms." .

NCIT:C16989 a owl:Class ;
    rdfs:label "Physics" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The scientific study of matter, energy, and the fundamental forces and laws governing their interactions and behavior in nature." .

NCIT:C172264 a owl:Class ;
    rdfs:label "Buccal Cell Normal" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A sample of normal (non-tumor) cells collected by scraping or swabbing the inside of a subject's cheek, commonly used as a source of germline DNA." .

NCIT:C172265 a owl:Class ;
    rdfs:label "Formalin fixed paraffin embedded - FFPE" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMethodEnum ;
    skos:definition "A tissue sample that has been fixed with formalin and embedded in paraffin for long-term preservation and histological analysis." .

NCIT:C172267 a owl:Class ;
    rdfs:label "FFPE Recurrent" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A formalin-fixed, paraffin-embedded tissue sample derived from tissue isolated from a subject with recurrent disease." .

NCIT:C172268 a owl:Class ;
    rdfs:label "FFPE Scrolls" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A formalin-fixed, paraffin-embedded tissue sample that has been cut on a microtome into a thin section that rolls up on itself, forming a scroll." .

NCIT:C172293 a owl:Class ;
    rdfs:label "Human Tumor Original Cells" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A sample comprised of cells that were isolated from a human tumor and have not been cultured or expanded." .

NCIT:C172295 a owl:Class ;
    rdfs:label "Next Generation Cancer Model" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "An approach to cancer modeling that utilizes clinical data as well as the genomic and transcriptomic profiles of the parent tumor, metastases, if present, and case-matched normal tissues from individual patients." .

NCIT:C172301 a owl:Class ;
    rdfs:label "R1" ;
    rdfs:subClassOf mc2:NGSReadIndicatorEnum ;
    skos:definition "The read direction identified as number 1 in a paired-end nucleotide sequencing reaction." .

NCIT:C172302 a owl:Class ;
    rdfs:label "R2" ;
    rdfs:subClassOf mc2:NGSReadIndicatorEnum ;
    skos:definition "The read direction identified as number 2 in a paired-end nucleotide sequencing reaction." .

NCIT:C172305 a owl:Class ;
    rdfs:label "Web Application" ;
    rdfs:subClassOf mc2:ToolTypeEnum .

NCIT:C172858 a owl:Class ;
    rdfs:label "ncRNA-Seq" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Capture of other non-coding RNA types, including post-translation modification types such as snRNA (small nuclear RNA) or snoRNA (small nucleolar RNA), or expression regulation types such as siRNA (small interfering RNA) or piRNA/piwi/RNA (piwi-interacting RNA)." .

NCIT:C172859 a owl:Class ;
    rdfs:label "ssRNA-seq" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "strand-specific RNA sequencing" .

NCIT:C174118 a owl:Class ;
    rdfs:label "Mixed Adherent Suspension" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A sample comprised of a mixture of cells or clumps of cells, which may have been isolated from normal or tumor tissue, that are maintained together in a suspension culture." .

NCIT:C174159 a owl:Class ;
    rdfs:label "Liquid Nitrogen Vapor" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMediumEnum .

NCIT:C17610 a owl:Class ;
    rdfs:label "Blood Derived Normal" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A peripheral blood specimen collected from a subject that is used as a source of germline (non-tumor) DNA or as a matched normal control for genomic comparisons." .

NCIT:C177109 a owl:Class ;
    rdfs:label "None of these describe me" ;
    rdfs:subClassOf mc2:SexEnum ;
    skos:definition "A response indicating that none of the provided response options accurately describe the respondent." .

NCIT:C177206 a owl:Class ;
    rdfs:label "Forceps Biopsy" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "The removal of a tissue sample using a specially-designed endoscope consisting of a slender flexible forceps with movable cup-shaped jaws." .

NCIT:C178223 a owl:Class ;
    rdfs:label "Bulk Cells" ;
    rdfs:subClassOf mc2:NGSLibrarySourceMaterialEnum ;
    skos:definition "A biospecimen consisting of multiple cells intended to be analyzed as a pool." .

NCIT:C178224 a owl:Class ;
    rdfs:label "Bulk Nuclei" ;
    rdfs:subClassOf mc2:NGSLibrarySourceMaterialEnum ;
    skos:definition "A biospecimen consisting of multiple nuclei intended to be analyzed as a pool." .

NCIT:C178225 a owl:Class ;
    rdfs:label "Bulk Tissue" ;
    rdfs:subClassOf mc2:NGSLibrarySourceMaterialEnum ;
    skos:definition "A biospecimen either derived from a whole tissue specimen or tissue section, which may consist of heterogeneous cells or tissues." .

NCIT:C178226 a owl:Class ;
    rdfs:label "Single-cells" ;
    rdfs:subClassOf mc2:NGSLibrarySourceMaterialEnum ;
    skos:definition "A biospecimen that contains the contents of a single cell." .

NCIT:C178227 a owl:Class ;
    rdfs:label "Single-nuclei" ;
    rdfs:subClassOf mc2:NGSLibrarySourceMaterialEnum ;
    skos:definition "A biospecimen that contains the contents of a single nucleus." .

NCIT:C178955 a owl:Class ;
    rdfs:label "Negative 80 Deg C" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMethodEnum ;
    skos:definition "An indication that a specimen has been stored at a temperature of negative 80 degrees Celsius." .

NCIT:C18009 a owl:Class ;
    rdfs:label "Tumor" ;
    rdfs:subClassOf mc2:BiospecimenTumorStatusEnum ;
    skos:definition "Tissue sample that contains an abnormal cellular infiltrate forming a solid mass." .

NCIT:C18058 a owl:Class ;
    rdfs:label "Partial Response" ;
    rdfs:subClassOf mc2:TreatmentResponseEnum ;
    skos:definition "A finding indicating that there is a decrease in the size and the extent of tissue involvement by a malignant tumor in a patient." .

NCIT:C180633 a owl:Class ;
    rdfs:label "Trophoblastic neoplasms" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "A group of pregnancy-related proliferative disorders including non-neoplastic conditions and trophoblastic neoplasms such as invasive hydatidiform mole, gestational choriocarcinoma, and epithelioid trophoblastic tumor." .

NCIT:C180697 a owl:Class ;
    rdfs:label "CAGE" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Cap-analysis gene expression" .

NCIT:C180698 a owl:Class ;
    rdfs:label "RACE" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Rapid Amplification of cDNA Ends" .

NCIT:C18141 a owl:Class ;
    rdfs:label "Computer Science" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The study of the structure, theory, and application of computational systems, algorithms, and information processing using mathematical, logical, and empirical methods." .

NCIT:C18155 a owl:Class ;
    rdfs:label "EST" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Single pass sequencing of cDNA templates" .

NCIT:C181933 a owl:Class ;
    rdfs:label "GeoMX-DSP" ;
    rdfs:subClassOf mc2:ImageAssayTypeEnum ;
    skos:definition "GeoMx Digital Spatial Profiler (DSP): a method to profile RNA or protein from tissue sections that combines spatial and molecular profiling by generating a whole-tissue image at single-cell resolution alongside digital profiling data from photocleavable-oligonucleotide-barcoded probes imaged from selected regions of interest." .

NCIT:C18206 a owl:Class ;
    rdfs:label "Distant Metastasis" ;
    rdfs:subClassOf mc2:LastKnownDiseaseStatusEnum ;
    skos:definition "The presence of cancer cells that have spread from the primary tumor site and been detected at a distal anatomic site." .

NCIT:C18213 a owl:Class ;
    rdfs:label "Stable Disease" ;
    rdfs:subClassOf mc2:TreatmentResponseEnum ;
    skos:definition "A disease that is neither decreasing nor increasing in extent or severity." .

NCIT:C18246 a owl:Class ;
    rdfs:label "Remission" ;
    rdfs:subClassOf mc2:BiospecimenIncidenceTypeEnum ;
    skos:definition "A state in which the signs and symptoms of a disease are reduced or absent." .

NCIT:C184729 a owl:Class ;
    rdfs:label "Control" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "A negative control in which the subject or specimen received no active treatment, used as a comparator." .

NCIT:C184757 a owl:Class ;
    rdfs:label "Expanded Next Generation Cancer Model" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A next generation cancer model that has been expanded using tissue culture or other propagation methods." .

NCIT:C184781 a owl:Class ;
    rdfs:label "Next Generation Cancer Model Expanded Under Non-conforming Conditions" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A next generation cancer model that has been expanded using unconventional or non-standard culturing methods." .

NCIT:C185118 a owl:Class ;
    rdfs:label "Captions" ;
    rdfs:subClassOf mc2:ResourceMediaAccessibilityEnum ;
    skos:definition "A synchronized, on-screen text display of spoken dialogue and other audio content within a video, providing an optional transcript of the audio for viewers who are deaf or hard of hearing." .

NCIT:C185338 a owl:Class ;
    rdfs:label "Liquid Nitrogen" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMethodEnum ;
    skos:definition "An indication that a material has been stored in liquid nitrogen." .

NCIT:C185404 a owl:Class ;
    rdfs:label "Fresh dissociated" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMethodEnum ;
    skos:definition "A tissue preparation process that takes fresh tissue and dissociates it into single cell suspensions." .

NCIT:C185405 a owl:Class ;
    rdfs:label "Fresh dissociated and single cell sorted" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMethodEnum ;
    skos:definition "A tissue preparation process that separates fresh dissociated tissue cells into cell populations by single cell sorting." .

NCIT:C188292 a owl:Class ;
    rdfs:label "T1a1" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of a primary tumor limited to the site of growth; the specific definition of T1a1 depends on the type of cancer." .

NCIT:C188293 a owl:Class ;
    rdfs:label "T1a2" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of a primary tumor limited to the site of growth; the specific definition of T1a2 depends on the type of cancer." .

NCIT:C188294 a owl:Class ;
    rdfs:label "T1b1" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of a primary tumor limited to the site of growth; the specific definition of T1b1 depends on the type of cancer." .

NCIT:C188295 a owl:Class ;
    rdfs:label "T1b2" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of a primary tumor limited to the site of growth; the specific definition of T1b2 depends on the type of cancer." .

NCIT:C188296 a owl:Class ;
    rdfs:label "T2a1" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of a primary tumor; the specific definition of T2a1 depends on the type of cancer." .

NCIT:C188297 a owl:Class ;
    rdfs:label "T2a2" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of a primary tumor; the specific definition of T2a2 depends on the type of cancer." .

NCIT:C188298 a owl:Class ;
    rdfs:label "T4e" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of a primary tumor with direct invasion of adjacent structures; the specific definition of T4e depends on the type of cancer." .

NCIT:C190168 a owl:Class ;
    rdfs:label "Binaries" ;
    rdfs:subClassOf mc2:ToolDownloadTypeEnum ;
    skos:definition "Binaries for the software; compiled code that allow a program to be installed without having to compile the source code." .

NCIT:C194803 a owl:Class ;
    rdfs:label "Immunoproliferative Diseases" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "A category of disorders characterized by the abnormal, uncontrolled proliferation of cells of the immune system, including conditions such as heavy chain disease and Waldenstrom macroglobulinemia." .

NCIT:C19697 a owl:Class ;
    rdfs:label "Tissue" ;
    rdfs:subClassOf mc2:BiospecimenCompositionEnum ;
    skos:definition "A piece of tissue removed from an organism for examination, analysis, or propagation." .

NCIT:C198496 a owl:Class ;
    rdfs:label "snATAC-Seq" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "A molecular genetic technique where DNA is harvested from a single cell nucleus and subjected to ATAC-seq to isolate and sequence regions rich in open chromatin." .

NCIT:C198568 a owl:Class ;
    rdfs:label "RNA" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A biospecimen created to contain an isolated or enriched ribonucleic acid (RNA) sample." .

NCIT:C198569 a owl:Class ;
    rdfs:label "GenomePlex (Rubicon) Amplified DNA" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A DNA specimen that has been amplified using the GenomePlex (Rubicon Genomics) whole genome amplification method." .

NCIT:C19975 a owl:Class ;
    rdfs:label "Research Consortium" ;
    rdfs:subClassOf mc2:ToolEntityTypeEnum .

NCIT:C200588 a owl:Class ;
    rdfs:label "X" ;
    rdfs:subClassOf mc2:SexEnum ;
    skos:definition "A designation used when biological sex is recorded as 'X', typically indicating a non-binary, indeterminate, or unspecified sex designation." .

NCIT:C200667 a owl:Class ;
    rdfs:label "New Tumor Event" ;
    rdfs:subClassOf mc2:LastKnownDiseaseStatusEnum ;
    skos:definition "The presence of a primary, recurrent or metastatic neoplasm which has not been previously noted." .

NCIT:C200862 a owl:Class ;
    rdfs:label "Formalin Fixed Tissue" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMediumEnum ;
    skos:definition "Formalin-Fixed Tissue" .

NCIT:C201465 a owl:Class ;
    rdfs:label "Autologous Stem Cell Transplantation" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "Stem cell transfer or transplantation in which the patient is their own donor." .

NCIT:C201530 a owl:Class ;
    rdfs:label "Mask" ;
    rdfs:subClassOf mc2:ImageSegmentationDataTypeEnum ;
    skos:definition "A segmentation output represented as a binary or labeled raster image in which pixels belonging to a segmented object (e.g., a cell or nucleus) are assigned a non-zero/class value and background pixels are assigned zero." .

NCIT:C201925 a owl:Class ;
    rdfs:label "Metagenomic" ;
    rdfs:subClassOf mc2:NGSLibrarySourceMoleculeEnum ;
    skos:definition "Derived from or associated with material collected from an environmental sample." .

NCIT:C201926 a owl:Class ;
    rdfs:label "Metatranscriptomic" ;
    rdfs:subClassOf mc2:NGSLibrarySourceMoleculeEnum ;
    skos:definition "Derived from or associated with transcripts from an environmental sample." .

NCIT:C202255 a owl:Class ;
    rdfs:label "Feature barcoding" ;
    rdfs:subClassOf mc2:NGSRNAReverseTranscriptionPrimerEnum ;
    skos:definition "A technology platform that uses oligonucleotide barcodes to simultaneously measure gene expression and other cellular features (surface proteins, T/B cell receptors, CRISPR perturbations) at single-cell resolution." .

NCIT:C202270 a owl:Class ;
    rdfs:label "3 Prime" ;
    rdfs:subClassOf mc2:NGSRNAEndBiasEnum ;
    skos:definition "An artifact of cDNA amplification and cloning where the 3' end of transcripts is over-represented in the final sample or library." .

NCIT:C202271 a owl:Class ;
    rdfs:label "5 Prime" ;
    rdfs:subClassOf mc2:NGSRNAEndBiasEnum ;
    skos:definition "An artifact of cDNA amplification and cloning where the 5' end of transcripts is over-represented in the final sample or library." .

NCIT:C202272 a owl:Class ;
    rdfs:label "Full Length Transcript" ;
    rdfs:subClassOf mc2:NGSRNAEndBiasEnum ;
    skos:definition "A cDNA molecule that spans the entire length of an RNA transcript, from its 5' end to its 3' end." .

NCIT:C204811 a owl:Class ;
    rdfs:label "Viral RNA" ;
    rdfs:subClassOf mc2:NGSLibrarySourceMoleculeEnum ;
    skos:definition "The RNA that originates from a virus." .

NCIT:C204813 a owl:Class ;
    rdfs:label "AMPLICON" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Sequencing of overlapping or distinct PCR or RT-PCR products" .

NCIT:C204814 a owl:Class ;
    rdfs:label "CLONE" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Genomic clone based (hierarchical) sequencing" .

NCIT:C204815 a owl:Class ;
    rdfs:label "CLONEEND" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Clone end (5', 3', or both) sequencing" .

NCIT:C204816 a owl:Class ;
    rdfs:label "CTS" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Concatenated Tag Sequencing" .

NCIT:C204817 a owl:Class ;
    rdfs:label "FL-cDNA" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Full-length sequencing of cDNA templates" .

NCIT:C204818 a owl:Class ;
    rdfs:label "FINISHING" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Sequencing intended to finish (close) gaps in existing coverage" .

NCIT:C204819 a owl:Class ;
    rdfs:label "Hi-C" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Chromosome Conformation Capture technique where a biotin-labeled nucleotide is incorporated at the ligation junction, enabling selective purification of chimeric DNA ligation junctions followed by deep sequencing" .

NCIT:C204820 a owl:Class ;
    rdfs:label "MBD-Seq" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Direct sequencing of methylated fractions sequencing strategy" .

NCIT:C204822 a owl:Class ;
    rdfs:label "MRE-Seq" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Methylation-Sensitive Restriction Enzyme Sequencing strategy" .

NCIT:C204823 a owl:Class ;
    rdfs:label "POOLCLONE" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Shotgun of pooled clones (usually BACs and Fosmids)" .

NCIT:C204824 a owl:Class ;
    rdfs:label "RAD-Seq" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "A type of genome-wide sampling sequencing that reduces the complexity of the genome by subsampling only at specific sites defined by restriction enzymes." .

NCIT:C204825 a owl:Class ;
    rdfs:label "RIP-Seq" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Direct sequencing of RNA immunoprecipitates (includes CLIP-Seq, HITS-CLIP and PAR-CLIP)." .

NCIT:C204826 a owl:Class ;
    rdfs:label "SELEX" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Systematic Evolution of Ligands by EXponential enrichment" .

NCIT:C204827 a owl:Class ;
    rdfs:label "Synthetic-Long-Read" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "A sequencing strategy that uses specialized sample processing combined with conventional short-read sequencing to computationally reconstruct long sequencing reads." .

NCIT:C204829 a owl:Class ;
    rdfs:label "Tethered Chromatin Conformation Capture" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "A method for genome-wide mapping of chromatin interactions, similar to Hi-C sequencing except that the ligations are performed on a solid substrate rather than in solution, enhancing the signal-to-noise ratio." .

NCIT:C204830 a owl:Class ;
    rdfs:label "Tn-Seq" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Sequencing from transposon insertion sites" .

NCIT:C204831 a owl:Class ;
    rdfs:label "WCS" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Random sequencing of a whole chromosome or other replicon isolated from a genome" .

NCIT:C205121 a owl:Class ;
    rdfs:label "Spatial-tx" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "A method that measures and maps gene expression in a biological sample while preserving the spatial context of the cells." .

NCIT:C205123 a owl:Class ;
    rdfs:label "scMultiome" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "A sequencing strategy that simultaneously profiles two or more molecular modalities, such as the transcriptome and chromatin accessibility, from the same individual cell to capture a more complete picture of cellular state." .

NCIT:C210697 a owl:Class ;
    rdfs:label "MERFISH" ;
    rdfs:subClassOf mc2:ImageAssayTypeEnum ;
    skos:definition "Multiplexed Error-Robust Fluorescence In Situ Hybridization (MERFISH): an image-based approach to single-cell transcriptomics in which RNAs are identified via a combinatorial labeling approach that encodes RNA species with error-robust barcodes, followed by sequential rounds of single-molecule FISH to read out the barcodes." .

NCIT:C210700 a owl:Class ;
    rdfs:label "CyCIF" ;
    rdfs:subClassOf mc2:ImageAssayTypeEnum ;
    skos:definition "Cyclic Immunofluorescence (CyCIF): a method for highly multiplexed immunofluorescent imaging of cells using an iterative, cycling process in which images of expressed fluorescently-tagged proteins, fluorescent dyes, or fluorescently-tagged antibodies are serially collected from the same sample and assembled into a high-dimensional representation of the spatial relationships between targets of interest." .

NCIT:C212119 a owl:Class ;
    rdfs:label "Adnexal and Skin Appendage Neoplasms" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "A neoplasm arising from skin appendage structures, including hair follicles, sebaceous glands, and eccrine or apocrine sweat glands." .

NCIT:C213680 a owl:Class ;
    rdfs:label "TRIzol" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMediumEnum ;
    skos:definition "Phenol and Guanidine Isothiocyanate Solution" .

NCIT:C214799 a owl:Class ;
    rdfs:label "Myomatous Neoplasms" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "A neoplasm arising from or exhibiting differentiation toward muscle tissue, encompassing tumors of smooth, skeletal, or cardiac muscle." .

NCIT:C215818 a owl:Class ;
    rdfs:label "Complete Genomics" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A life sciences subsidiary of a Chinese biotechnology company that has developed and commercialized a DNA sequencing platform for human genome sequencing and analysis." .

NCIT:C219695 a owl:Class ;
    rdfs:label "Desiccant" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMediumEnum .

NCIT:C222061 a owl:Class ;
    rdfs:label "Too Early" ;
    rdfs:subClassOf mc2:TreatmentResponseEnum ;
    skos:definition "Too Early to be Assessed" .

NCIT:C222473 a owl:Class ;
    rdfs:label "Enrollment Date" ;
    rdfs:subClassOf mc2:StudyIndexDateEnum ;
    skos:definition "The date a subject is formally enrolled in a study." .

NCIT:C25153 a owl:Class ;
    rdfs:label "Autopsy" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "A postmortem examination of the body that includes an examination of the internal organs and structures after dissection to determine the cause of death and the nature of pathological changes." .

NCIT:C25190 a owl:Class ;
    rdfs:label "Person" ;
    rdfs:subClassOf mc2:ToolEntityTypeEnum .

NCIT:C25213 a owl:Class ;
    rdfs:label "Baseline" ;
    rdfs:subClassOf mc2:FileLongitudinalEventTypeEnum ;
    skos:definition "A starting point to which things may be compared." .

NCIT:C25217 a owl:Class ;
    rdfs:label "Assessment" ;
    rdfs:subClassOf mc2:ResourceIntendedUseEnum ;
    skos:definition "The process of evaluating or measuring the value, significance, or extent of a learner's knowledge, skills, or performance." .

NCIT:C25251 a owl:Class ;
    rdfs:label "Primary" ;
    rdfs:subClassOf mc2:BiospecimenIncidenceTypeEnum ;
    skos:definition "Occurring first in time or sequence; original; of greatest rank or importance or value." .

NCIT:C28007 a owl:Class ;
    rdfs:label "Median" ;
    rdfs:subClassOf mc2:ImageSummaryStatisticEnum ;
    skos:definition "The value which has an equal number of values greater and less than it." .

NCIT:C28077 a owl:Class ;
    rdfs:label "G1 Low Grade" ;
    rdfs:subClassOf mc2:TumorGradeEnum ;
    skos:definition "A morphologic qualifier indicating that a cancerous lesion is well differentiated (Grade 1)." .

NCIT:C28078 a owl:Class ;
    rdfs:label "G2 Intermediate Grade" ;
    rdfs:subClassOf mc2:TumorGradeEnum ;
    skos:definition "A morphologic qualifier indicating that a cancerous lesion is moderately differentiated (Grade 2)." .

NCIT:C28079 a owl:Class ;
    rdfs:label "G3 High Grade" ;
    rdfs:subClassOf mc2:TumorGradeEnum ;
    skos:definition "A morphologic qualifier indicating that a cancerous lesion is poorly differentiated (Grade 3)." .

NCIT:C28082 a owl:Class ;
    rdfs:label "G4 Anaplastic" ;
    rdfs:subClassOf mc2:TumorGradeEnum ;
    skos:definition "A morphologic qualifier indicating that a cancerous lesion is undifferentiated (Grade 4)." .

NCIT:C28221 a owl:Class ;
    rdfs:label "Blood draw" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "The collection of blood from a vein, most commonly via needle venipuncture." .

NCIT:C28294 a owl:Class ;
    rdfs:label "Nutrition" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The processes by which an organism consumes and utilizes food, water, and other nourishment necessary to sustain its life processes." .

NCIT:C28554 a owl:Class ;
    rdfs:label "Dead" ;
    rdfs:subClassOf mc2:IndividualVitalStatusEnum ;
    skos:definition "The cessation of life." .

NCIT:C28743 a owl:Class ;
    rdfs:label "Punch biopsy" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "Removal of a disk of skin tissue, for microscopic examination, using a punch." .

NCIT:C3042 a owl:Class ;
    rdfs:label "Fibromatous Neoplasms" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "A poorly circumscribed neoplasm arising from the soft tissues, characterized by the presence of spindle-shaped fibroblasts and an infiltrative growth pattern." .

NCIT:C3247 a owl:Class ;
    rdfs:label "Myelodysplastic Syndromes" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "A heterogeneous group of clonal hematopoietic stem cell disorders characterized by ineffective blood cell production, peripheral blood cytopenias, and risk of progression to acute myeloid leukemia." .

NCIT:C3286 a owl:Class ;
    rdfs:label "Odontogenic Tumors" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "A neoplasm arising from tissues involved in tooth formation, including enamel organ, dental papilla, and dental follicle, most commonly arising in the jaw." .

NCIT:C3308 a owl:Class ;
    rdfs:label "Paragangliomas and Glomus Tumors" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "A neoplasm arising from paraganglia, specialized clusters of neuroendocrine cells that are part of the autonomic nervous system, located at various sites outside the adrenal medulla." .

NCIT:C3331 a owl:Class ;
    rdfs:label "Pleural Effusion" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "Increased amounts of fluid within the pleural cavity, usually caused by lung infections, congestive heart failure, pleural or lung tumors, connective tissue disorders, or trauma." .

NCIT:C3377 a owl:Class ;
    rdfs:label "Soft Tissue Tumors and Sarcomas; NOS" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "A neoplasm arising from the non-epithelial, non-osseous supporting tissues of the body, including fat, fibrous tissue, muscle, peripheral nerves, and blood and lymph vessels." .

NCIT:C35427 a owl:Class ;
    rdfs:label "Synchronous Primary" ;
    rdfs:subClassOf mc2:BiospecimenCompositionEnum ;
    skos:definition "Malignant Neoplasm of Multiple Primary Sites" .

NCIT:C36118 a owl:Class ;
    rdfs:label "In Situ Neoplasms" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "Neoplasms confined to the site of origin without invasion beyond the basement membrane or into surrounding tissue, such as carcinoma in situ." .

NCIT:C36162 a owl:Class ;
    rdfs:label "Localized Disease" ;
    rdfs:subClassOf mc2:LastKnownDiseaseStatusEnum ;
    skos:definition "A disease that is confined to a specific organ or tissue and has not spread to other anatomic sites." .

NCIT:C3708 a owl:Class ;
    rdfs:label "Germ Cell Neoplasms" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "A neoplasm arising from germ cells, the primordial cells that give rise to eggs and sperm." .

NCIT:C3709 a owl:Class ;
    rdfs:label "Epithelial Neoplasms; NOS" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "A neoplasm derived from epithelial cells, the cells lining the surfaces and cavities of the body." .

NCIT:C3723 a owl:Class ;
    rdfs:label "Lymphatic Vessel Tumors" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "A benign or malignant neoplasm arising from the lymphatic vessels." .

NCIT:C3743 a owl:Class ;
    rdfs:label "Fibroepithelial Neoplasms" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "A benign, borderline, or malignant neoplasm characterized by the presence of an epithelial and a fibrous component. Representative examples are fibroadenoma and phyllodes tumor." .

NCIT:C3772 a owl:Class ;
    rdfs:label "Mucoepidermoid Neoplasms" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "Neoplasms morphologically characterized by the presence of cuboidal mucous cells, goblet-like mucous cells, squamoid cells, cystic changes, and a fibrotic stromal formation; they can occur in several anatomic sites, including the parotid gland, oral cavity, paranasal sinus, skin, breast, lung, larynx, and lacrimal ducts." .

NCIT:C3786 a owl:Class ;
    rdfs:label "Mesothelial Neoplasms" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "A neoplasm arising from mesothelial cells, which line the body cavities including the pleura, peritoneum, and pericardium." .

NCIT:C3792 a owl:Class ;
    rdfs:label "Squamous Cell Neoplasms" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "A neoplasm arising from or exhibiting the features of squamous epithelium, ranging from benign squamous papillomas to squamous cell carcinomas." .

NCIT:C37948 a owl:Class ;
    rdfs:label "Enrollment" ;
    rdfs:subClassOf mc2:FileLongitudinalEventTypeEnum ;
    skos:definition "The act of registration, entering in a list, catalog, group, study; also, the number of subjects enrolled." .

NCIT:C37987 a owl:Class ;
    rdfs:label "Alive" ;
    rdfs:subClassOf mc2:IndividualVitalStatusEnum ;
    skos:definition "Showing characteristics of life; displaying signs of life." .

NCIT:C39409 a owl:Class ;
    rdfs:label "Funding Agency" ;
    rdfs:subClassOf mc2:ToolEntityTypeEnum .

NCIT:C41067 a owl:Class ;
    rdfs:label "Whole Blood" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "Blood that has not been separated into its various components, other than the addition of an anticoagulant." .

NCIT:C41132 a owl:Class ;
    rdfs:label "None" ;
    rdfs:subClassOf mc2:BiospecimenEmbeddingMediumEnum ;
    skos:definition "No person or thing, nobody, not any." .

NCIT:C41844 a owl:Class ;
    rdfs:label "Regional Disease" ;
    rdfs:subClassOf mc2:LastKnownDiseaseStatusEnum ;
    skos:definition "A disease or condition that extends beyond the site of origin and spreads into adjacent tissues and regional lymph nodes." .

NCIT:C4197 a owl:Class ;
    rdfs:label "Acinar Cell Neoplasms" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "A neoplasm with acinar cell differentiation, arising from the secretory cells of exocrine glands such as the pancreas, salivary glands, or lungs." .

NCIT:C4248 a owl:Class ;
    rdfs:label "Lipomatous Neoplasms" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "A neoplasm arising from adipose (fat) tissue, ranging from benign lipomas to malignant liposarcomas." .

NCIT:C42709 a owl:Class ;
    rdfs:label "Parent" ;
    rdfs:subClassOf mc2:ResourcePrimaryAudienceEnum ;
    skos:definition "A mother or a father; an immediate progenitor." .

NCIT:C42753 a owl:Class ;
    rdfs:label "Workflow" ;
    rdfs:subClassOf mc2:ToolTypeEnum ;
    skos:definition "A set of tools which have been composed together into a pipeline of some sort. Such tools are (typically) standalone, but are composed for convenience, for instance for batch execution via some workflow engine or script." .

NCIT:C449 a owl:Class ;
    rdfs:label "DNA" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A long, linear, double-stranded polymer of nucleotides attached to a deoxyribose backbone that carries an organism's genetic information; used here to denote a specimen consisting of extracted DNA." .

NCIT:C45412 a owl:Class ;
    rdfs:label "Web Service" ;
    rdfs:subClassOf mc2:ToolTypeEnum .

NCIT:C46089 a owl:Class ;
    rdfs:label "Allogeneic Hematopoietic Stem Cell Transplantation" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "A clinical treatment in which hematopoietic stem cells (HSCs) are transferred from one genetically dissimilar individual to another." .

NCIT:C4665 a owl:Class ;
    rdfs:label "Plasma Cell Neoplasm" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "A neoplasm characterized by the clonal proliferation of plasma cells, the antibody-secreting terminally differentiated B-cells." .

NCIT:C47615 a owl:Class ;
    rdfs:label "Methacrylate" ;
    rdfs:subClassOf mc2:BiospecimenEmbeddingMediumEnum ;
    skos:definition "A methyl ester of methacrylic acid; a reactive resin used as cement in dentistry, orthopaedic surgery, and ophthalmology, and as a hard plastic embedding medium for electron microscopy." .

NCIT:C47824 a owl:Class ;
    rdfs:label "Data Set" ;
    rdfs:subClassOf mc2:ResourceActivityTypeEnum ;
    skos:definition "A structured collection of related data records provided as an educational resource for analysis, exploration, or hands-on learning exercises." .

NCIT:C47885 a owl:Class ;
    rdfs:label "Project" ;
    rdfs:subClassOf mc2:ToolEntityTypeEnum .

NCIT:C47901 a owl:Class ;
    rdfs:label "Source Code" ;
    rdfs:subClassOf mc2:ToolDownloadTypeEnum .

NCIT:C4809 a owl:Class ;
    rdfs:label "Persistent Disease" ;
    rdfs:subClassOf mc2:TreatmentResponseEnum ;
    skos:definition "The persistence of tumor cells in the body following cancer treatment." .

NCIT:C48600 a owl:Class ;
    rdfs:label "Re-excision" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "A surgical procedure to remove the remaining abnormal tissues from the body, not completely removed in an earlier attempt." .

NCIT:C48699 a owl:Class ;
    rdfs:label "M0" ;
    rdfs:subClassOf mc2:IndividualMetastasisStageEnum ;
    skos:definition "No distant metastasis (cancer has not spread to other parts of the body)" .

NCIT:C4870 a owl:Class ;
    rdfs:label "Complete Response" ;
    rdfs:subClassOf mc2:TreatmentResponseEnum ;
    skos:definition "The disappearance of all signs of cancer in response to treatment." .

NCIT:C48700 a owl:Class ;
    rdfs:label "M1" ;
    rdfs:subClassOf mc2:IndividualMetastasisStageEnum ;
    skos:definition "A clinical and/or pathologic distant metastasis TNM finding indicating the spread of cancer to distant anatomic sites." .

NCIT:C48701 a owl:Class ;
    rdfs:label "M1a" ;
    rdfs:subClassOf mc2:IndividualMetastasisStageEnum ;
    skos:definition "A distant metastasis TNM finding indicating the spread of cancer to a single distant organ or site; the specific meaning varies by cancer type." .

NCIT:C48702 a owl:Class ;
    rdfs:label "M1b" ;
    rdfs:subClassOf mc2:IndividualMetastasisStageEnum ;
    skos:definition "A distant metastasis TNM finding indicating the spread of cancer to multiple distant organs or sites; the specific meaning varies by cancer type." .

NCIT:C48703 a owl:Class ;
    rdfs:label "M1c" ;
    rdfs:subClassOf mc2:IndividualMetastasisStageEnum ;
    skos:definition "A distant metastasis TNM finding indicating the spread of cancer to additional distant anatomic sites; the specific meaning varies by cancer type." .

NCIT:C48704 a owl:Class ;
    rdfs:label "MX" ;
    rdfs:subClassOf mc2:IndividualMetastasisStageEnum ;
    skos:definition "A distant metastasis TNM finding indicating that the status of distant metastasis cannot be assessed." .

NCIT:C48705 a owl:Class ;
    rdfs:label "N0" ;
    rdfs:subClassOf mc2:IndividualTumorLymphNodeStageEnum ;
    skos:definition "No regional lymph node involvement (no cancer found in the lymph nodes)" .

NCIT:C48706 a owl:Class ;
    rdfs:label "N1" ;
    rdfs:subClassOf mc2:IndividualTumorLymphNodeStageEnum .

NCIT:C48707 a owl:Class ;
    rdfs:label "N1a" ;
    rdfs:subClassOf mc2:IndividualTumorLymphNodeStageEnum .

NCIT:C48708 a owl:Class ;
    rdfs:label "N1b" ;
    rdfs:subClassOf mc2:IndividualTumorLymphNodeStageEnum .

NCIT:C48709 a owl:Class ;
    rdfs:label "N1c" ;
    rdfs:subClassOf mc2:IndividualTumorLymphNodeStageEnum .

NCIT:C48711 a owl:Class ;
    rdfs:label "N2a" ;
    rdfs:subClassOf mc2:IndividualTumorLymphNodeStageEnum .

NCIT:C48712 a owl:Class ;
    rdfs:label "N2b" ;
    rdfs:subClassOf mc2:IndividualTumorLymphNodeStageEnum .

NCIT:C48713 a owl:Class ;
    rdfs:label "N2c" ;
    rdfs:subClassOf mc2:IndividualTumorLymphNodeStageEnum .

NCIT:C48714 a owl:Class ;
    rdfs:label "N3" ;
    rdfs:subClassOf mc2:IndividualTumorLymphNodeStageEnum .

NCIT:C48715 a owl:Class ;
    rdfs:label "N3a" ;
    rdfs:subClassOf mc2:IndividualTumorLymphNodeStageEnum .

NCIT:C48716 a owl:Class ;
    rdfs:label "N3b" ;
    rdfs:subClassOf mc2:IndividualTumorLymphNodeStageEnum .

NCIT:C48717 a owl:Class ;
    rdfs:label "N3c" ;
    rdfs:subClassOf mc2:IndividualTumorLymphNodeStageEnum .

NCIT:C48718 a owl:Class ;
    rdfs:label "NX" ;
    rdfs:subClassOf mc2:IndividualTumorLymphNodeStageEnum ;
    skos:definition "Regional lymph nodes cannot be evaluated" .

NCIT:C48719 a owl:Class ;
    rdfs:label "T0" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "No evidence of primary tumor" .

NCIT:C48720 a owl:Class ;
    rdfs:label "T1" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A clinical and/or pathologic primary tumor TNM finding indicating that the cancer is limited to the site of growth." .

NCIT:C48721 a owl:Class ;
    rdfs:label "T1a" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of a primary tumor limited to the site of growth; the specific definition of T1a depends on the type of cancer." .

NCIT:C48722 a owl:Class ;
    rdfs:label "T1b" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of a primary tumor limited to the site of growth; the specific definition of T1b depends on the type of cancer." .

NCIT:C48723 a owl:Class ;
    rdfs:label "T1c" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of a primary tumor limited to the site of growth; the specific definition of T1c depends on the type of cancer." .

NCIT:C48724 a owl:Class ;
    rdfs:label "T2" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of primary tumor growth beyond the level of in situ cancer, minimal subepithelial invasion, or minimal greatest diameter; the specific definition depends on the type of cancer." .

NCIT:C48725 a owl:Class ;
    rdfs:label "T2a" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of primary tumor growth beyond the level of in situ cancer; the specific definition of T2a depends on the type of cancer." .

NCIT:C48726 a owl:Class ;
    rdfs:label "T2b" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of primary tumor growth beyond the level of in situ cancer; the specific definition of T2b depends on the type of cancer." .

NCIT:C48727 a owl:Class ;
    rdfs:label "T2c" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of primary tumor growth beyond the level of in situ cancer; the specific definition of T2c depends on the type of cancer." .

NCIT:C48728 a owl:Class ;
    rdfs:label "T3" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A clinical and/or pathologic primary tumor TNM finding usually indicating that the cancer is locally invasive, without infiltration of adjacent structures." .

NCIT:C48729 a owl:Class ;
    rdfs:label "T3a" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of a primary tumor usually indicating that the cancer is locally invasive; the specific definition of T3a depends on the type of cancer." .

NCIT:C48730 a owl:Class ;
    rdfs:label "T3b" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of a primary tumor usually indicating that the cancer is locally invasive; the specific definition of T3b depends on the type of cancer." .

NCIT:C48731 a owl:Class ;
    rdfs:label "T3c" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of a primary tumor usually indicating that the cancer is locally invasive; the specific definition of T3c depends on the type of cancer." .

NCIT:C48732 a owl:Class ;
    rdfs:label "T4" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A clinical and/or pathologic primary tumor TNM finding indicating direct invasion of adjacent structures by cancer." .

NCIT:C48733 a owl:Class ;
    rdfs:label "T4a" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of a primary tumor with direct invasion of adjacent structures; the specific definition of T4a depends on the type of cancer." .

NCIT:C48734 a owl:Class ;
    rdfs:label "T4b" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of a primary tumor with direct invasion of adjacent structures; the specific definition of T4b depends on the type of cancer." .

NCIT:C48735 a owl:Class ;
    rdfs:label "T4c" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of a primary tumor with direct invasion of adjacent structures; the specific definition of T4c depends on the type of cancer." .

NCIT:C48736 a owl:Class ;
    rdfs:label "T4d" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of a primary tumor with direct invasion of adjacent structures; the specific definition of T4d depends on the type of cancer." .

NCIT:C48737 a owl:Class ;
    rdfs:label "TX" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "Primary tumor cannot be evaluated" .

NCIT:C48738 a owl:Class ;
    rdfs:label "Tis" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "Carcinoma in situ (early cancer that has not spread to neighboring tissue)" .

NCIT:C48786 a owl:Class ;
    rdfs:label "N2" ;
    rdfs:subClassOf mc2:IndividualTumorLymphNodeStageEnum .

NCIT:C48976 a owl:Class ;
    rdfs:label "Tis (LCIS)" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "Breast cancer with a finding of lobular carcinoma in situ (per AJCC 6th and 7th editions; LCIS was removed from TNM staging in the 8th edition)." .

NCIT:C4972 a owl:Class ;
    rdfs:label "Nerve Sheath Tumors" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "A benign or malignant neoplasm arising from the perineural cells in the sheaths surrounding the nerves. Representative examples include neurofibroma, schwannoma, and malignant peripheral nerve sheath tumor." .

NCIT:C51024 a owl:Class ;
    rdfs:label "Decline to answer" ;
    rdfs:subClassOf mc2:SexEnum ;
    skos:definition "Used to indicate when a respondent makes a decision to not answer a question." .

NCIT:C51278 a owl:Class ;
    rdfs:label "Sign Language" ;
    rdfs:subClassOf mc2:ResourceMediaAccessibilityEnum ;
    skos:definition "A system of hand gestures, facial expressions, and body movements used for communication, provided here as a video-based interpretation of content for users who are deaf or hard of hearing." .

NCIT:C51933 a owl:Class ;
    rdfs:label "Pancreaticoduodenectomy" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "Surgical excision of all or part of the pancreas and duodenum." .

NCIT:C51944 a owl:Class ;
    rdfs:label "IHC" ;
    rdfs:subClassOf mc2:ImageAssayTypeEnum ;
    skos:definition "Immunohistochemistry (IHC): a diagnostic or research technique in which an antibody is used to link a cellular antigen specifically to a stain that can be visualized with a microscope." .

NCIT:C53319 a owl:Class ;
    rdfs:label "Mean" ;
    rdfs:subClassOf mc2:ImageSummaryStatisticEnum ;
    skos:definition "The sum of a set of values divided by the number of values in the set." .

NCIT:C54108 a owl:Class ;
    rdfs:label "SQL" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "SQL (Structured Query Language) is an industry-standard language for creating, updating, and querying relational database management systems." .

NCIT:C55072 a owl:Class ;
    rdfs:label "Prior Primary" ;
    rdfs:subClassOf mc2:BiospecimenCompositionEnum ;
    skos:definition "Recurrent Disease, Primary Site" .

NCIT:C61742 a owl:Class ;
    rdfs:label "EDTA" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMediumEnum ;
    skos:definition "Edetic Acid" .

NCIT:C62755 a owl:Class ;
    rdfs:label "Slides" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A biospecimen consisting of a tissue section or cell preparation mounted on a glass slide for microscopic examination." .

NCIT:C63348 a owl:Class ;
    rdfs:label "RNALater" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMediumEnum .

NCIT:C63387 a owl:Class ;
    rdfs:label "Isopentane" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMediumEnum .

NCIT:C63521 a owl:Class ;
    rdfs:label "Snap Frozen" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMethodEnum ;
    skos:definition "To freeze rapidly so as to preserve structure and prevent ice crystal formation." .

NCIT:C6450 a owl:Class ;
    rdfs:label "Thymic Epithelial Neoplasms" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "A neoplasm arising from the epithelial cells of the thymus gland, spanning a spectrum from thymoma to thymic carcinoma." .

NCIT:C65157 a owl:Class ;
    rdfs:label "Neoplasms of Uncertain and Unknown Behavior" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "Neoplasms that, on morphologic grounds, cannot be classified with certainty as benign or malignant." .

NCIT:C6577 a owl:Class ;
    rdfs:label "Myxomatous Neoplasms" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "An ICD-O-3 morphology category comprising benign and malignant neoplasms characterized by an abundant myxoid (mucin-rich) stroma, such as myxoma and myxosarcoma." .

NCIT:C65802 a owl:Class ;
    rdfs:label "Gelatin" ;
    rdfs:subClassOf mc2:BiospecimenEmbeddingMediumEnum ;
    skos:definition "A translucent, colorless, water-soluble protein derived from collagen; used as an embedding medium for cryosectioning and to orient or support small, friable tissue specimens." .

NCIT:C66897 a owl:Class ;
    rdfs:label "Proton Beam Radiation Therapy" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "A type of external beam radiation therapy using a beam of protons. It has the advantage of precisely localizing the radiation dose on the targeted tissue and avoiding damage to the healthy surrounding tissue." .

NCIT:C6784 a owl:Class ;
    rdfs:label "Cystic; Mucinous and Serous Neoplasms" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "A benign or malignant neoplasm that contains a single or multiple cystic spaces. Examples include cystadenoma, mucinous cystadenocarcinoma, and serous cystadenocarcinoma." .

NCIT:C68615 a owl:Class ;
    rdfs:label "Birth Date" ;
    rdfs:subClassOf mc2:StudyIndexDateEnum ;
    skos:definition "The calendar date on which a person was born." .

NCIT:C68796 a owl:Class ;
    rdfs:label "Liquid Nitrogen" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMediumEnum .

NCIT:C69170 a owl:Class ;
    rdfs:label "Professor" ;
    rdfs:subClassOf mc2:ResourcePrimaryAudienceEnum ;
    skos:definition "A courtesy title for a teacher of the highest academic rank in a college or university." .

NCIT:C7058 a owl:Class ;
    rdfs:label "Nevi and Melanomas" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "A neoplasm arising from melanocytes, the pigment-producing cells found primarily in the skin and eye; includes both benign lesions (nevi) and malignant melanomas." .

NCIT:C70601 a owl:Class ;
    rdfs:label "Cellular Therapy" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "Utilization of specific cells, modified or not, for treatment of diseases. Donor lymphocyte infusion is a type of cellular therapy." .

NCIT:C70749 a owl:Class ;
    rdfs:label "Outline" ;
    rdfs:subClassOf mc2:ImageSegmentationDataTypeEnum ;
    skos:definition "A segmentation output represented as the boundary contour line surrounding a segmented object, as opposed to a filled area (mask) or a single coordinate (point)." .

NCIT:C7132 a owl:Class ;
    rdfs:label "Adenomas and Adenocarcinomas" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "A neoplasm arising from or exhibiting the features of glandular epithelium; encompasses a broad morphological category including adenomas, adenocarcinomas, and related glandular tumors." .

NCIT:C71609 a owl:Class ;
    rdfs:label "MathML" ;
    rdfs:subClassOf mc2:ResourceMediaAccessibilityEnum ;
    skos:definition "An XML-based markup language for describing mathematical notation and expressions, capturing both structure and content to enable accessible rendering of formulas in web documents." .

NCIT:C727 a owl:Class ;
    rdfs:label "Paraffin wax" ;
    rdfs:subClassOf mc2:BiospecimenEmbeddingMediumEnum ;
    skos:definition "A common name for a group of high molecular weight alkane hydrocarbons; a white, odorless, tasteless, waxy solid widely used as an embedding medium for tissue processing in histology." .

NCIT:C75301 a owl:Class ;
    rdfs:label "Web API" ;
    rdfs:subClassOf mc2:ToolTypeEnum ;
    skos:definition "An application programming interface (API) consisting of endpoints to a request-response message system accessible via HTTP. Includes everything from simple data-access URLs to RESTful APIs." .

NCIT:C75561 a owl:Class ;
    rdfs:label "Student" ;
    rdfs:subClassOf mc2:ResourcePrimaryAudienceEnum ;
    skos:definition "A person who is enrolled in an educational institution." .

NCIT:C762 a owl:Class ;
    rdfs:label "Carbowax" ;
    rdfs:subClassOf mc2:BiospecimenEmbeddingMediumEnum ;
    skos:definition "A trade name for polyethylene glycol (PEG), a water-soluble, wax-like polymer historically used as an embedding medium for light microscopy that allows sections to be stained without prior dewaxing." .

NCIT:C76243 a owl:Class ;
    rdfs:label "Targeted Molecular Therapy" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "Cancer therapies designed to act upon specific molecules in metabolic pathways or processes involved in carcinogenesis, tumor growth, or tumor spread." .

NCIT:C77665 a owl:Class ;
    rdfs:label "Whole Animal" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "Referring to the entire body of an experimental animal; used when a biospecimen consists of or is derived from an entire organism." .

NCIT:C80736 a owl:Class ;
    rdfs:label "Service" ;
    rdfs:subClassOf mc2:ToolLinkTypeEnum ;
    skos:definition "An online service (other than Galaxy) that provides access (an interface) to the software." .

NCIT:C80930 a owl:Class ;
    rdfs:label "Glutaraldehyde" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMediumEnum .

NCIT:C81286 a owl:Class ;
    rdfs:label "Collection Date" ;
    rdfs:subClassOf mc2:StudyIndexDateEnum ;
    skos:definition "The date on which the sample or data was collected." .

NCIT:C84517 a owl:Class ;
    rdfs:label "Fresh" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMethodEnum ;
    skos:definition "Tissue which has not been exposed to a fixative solution." .

NCIT:C85254 a owl:Class ;
    rdfs:label "Low-Dose Rate Brachytherapy" ;
    rdfs:subClassOf mc2:TreatmentTypeEnum ;
    skos:definition "Internal radiation treatment that targets a cancerous tissue with low doses of radiation through the use of inserted temporary or permanent implants." .

NCIT:C85531 a owl:Class ;
    rdfs:label "Division" ;
    rdfs:subClassOf mc2:ToolEntityTypeEnum .

NCIT:C89269 a owl:Class ;
    rdfs:label "Homework/Assignment" ;
    rdfs:subClassOf mc2:ResourceActivityTypeEnum ;
    skos:definition "Work or tasks assigned to learners for completion outside of the primary instructional setting, used to reinforce or extend learning." .

NCIT:C89278 a owl:Class ;
    rdfs:label "High School" ;
    rdfs:subClassOf mc2:ResourceEducationalLevelEnum ;
    skos:definition "A secondary school that usually includes grades 9 through 12." .

NCIT:C8964 a owl:Class ;
    rdfs:label "Synovial-like Neoplasms" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "A neoplasm arising from the synovial tissue lining joint cavities, tendon sheaths, and bursae." .

NCIT:C91063 a owl:Class ;
    rdfs:label "Video" ;
    rdfs:subClassOf mc2:ResourcePrimaryFormatEnum ;
    skos:definition "The storing or preserving of video images to be displayed later." .

NCIT:C9295 a owl:Class ;
    rdfs:label "Mast Cell Neoplasm" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "A heterogeneous group of disorders characterized by the abnormal growth and accumulation of mast cells in one or more organ systems; most variants of mast cell neoplasms are clonal disorders. (WHO, 2001)" .

NCIT:C95606 a owl:Class ;
    rdfs:label "Additional Primary" ;
    rdfs:subClassOf mc2:BiospecimenCompositionEnum ;
    skos:definition "A primary malignant neoplasm in a patient who has been already diagnosed with a primary malignant neoplasm in another anatomic site." .

NCIT:C95805 a owl:Class ;
    rdfs:label "T1mi" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A term that refers to a TNM finding of a primary tumor limited to the site of growth and indicates microinvasion only." .

NCIT:C95921 a owl:Class ;
    rdfs:label "N0 (i-)" ;
    rdfs:subClassOf mc2:IndividualTumorLymphNodeStageEnum .

NCIT:C95922 a owl:Class ;
    rdfs:label "N0 (i+)" ;
    rdfs:subClassOf mc2:IndividualTumorLymphNodeStageEnum .

NCIT:C95923 a owl:Class ;
    rdfs:label "N0 (mol-)" ;
    rdfs:subClassOf mc2:IndividualTumorLymphNodeStageEnum .

NCIT:C95925 a owl:Class ;
    rdfs:label "N0 (mol+)" ;
    rdfs:subClassOf mc2:IndividualTumorLymphNodeStageEnum .

NCIT:C95929 a owl:Class ;
    rdfs:label "N1bI" ;
    rdfs:subClassOf mc2:IndividualTumorLymphNodeStageEnum .

NCIT:C95935 a owl:Class ;
    rdfs:label "N1bII" ;
    rdfs:subClassOf mc2:IndividualTumorLymphNodeStageEnum .

NCIT:C95936 a owl:Class ;
    rdfs:label "N1bIII" ;
    rdfs:subClassOf mc2:IndividualTumorLymphNodeStageEnum .

NCIT:C95937 a owl:Class ;
    rdfs:label "N1bIV" ;
    rdfs:subClassOf mc2:IndividualTumorLymphNodeStageEnum .

NCIT:C95940 a owl:Class ;
    rdfs:label "Genomic DNA" ;
    rdfs:subClassOf mc2:NGSLibrarySourceMoleculeEnum ;
    skos:definition "The DNA that is part of the normal chromosomal complement of an organism." .

NCIT:C95955 a owl:Class ;
    rdfs:label "N1mi" ;
    rdfs:subClassOf mc2:IndividualTumorLymphNodeStageEnum .

NCIT:C95956 a owl:Class ;
    rdfs:label "cM0 (i+)" ;
    rdfs:subClassOf mc2:IndividualMetastasisStageEnum ;
    skos:definition "A distant metastasis TNM finding indicating that there is no evidence of distant metastasis clinically or by radiologic studies, but there are small numbers of cells detected by special studies in the blood and bone marrow, or there is tiny metastasis (no larger than 0.2 mm) detected in nonregional lymph nodes." .

NCIT:C96025 a owl:Class ;
    rdfs:label "Ta" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A term that refers to a TNM finding of a primary, non-invasive papillary carcinoma." .

NCIT:C96026 a owl:Class ;
    rdfs:label "N4" ;
    rdfs:subClassOf mc2:IndividualTumorLymphNodeStageEnum .

NCIT:C96999 a owl:Class ;
    rdfs:label "Script" ;
    rdfs:subClassOf mc2:ToolTypeEnum ;
    skos:definition "A tool written for some run-time environment (e.g. other applications or an OS shell) that automates the execution of tasks. Often a small program written in a general-purpose languages (e.g. Perl, Python) or some domain-specific languages (e.g. sed)." .

OBI:0000696 a owl:Class ;
    rdfs:label "AB SOLiD System" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A proprietary next-generation DNA sequencing system from Applied Biosystems that utilizes DNA ligase. DNA fragments attached to beads are clonally amplified and ligated to fluorescently labeled \"interrogation probes\". Ligation frees the fluor, which is detected and identifies the specific probe. The marker of the attached probe is then removed and a 5'-phosphate group is regenerated. Multiple cycles of ligation, detection, and cleavage are performed." .

OBI:0000717 a owl:Class ;
    rdfs:label "Helicos HeliScope" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The HeliScope is a DNA sequencer manufactured by Helicos BioSciences that performs single-molecule sequencing of unamplified DNA templates using reversible-terminator chemistry." .

OBI:0000947 a owl:Class ;
    rdfs:label "Provider" ;
    rdfs:subClassOf mc2:ToolEntityRoleEnum .

OBI:0002000 a owl:Class ;
    rdfs:label "Illumina Genome Analyzer IIx" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "An upgraded Illumina Genome Analyzer II model that supports sequencing of single, long, or short-insert paired-end clone libraries using sequencing-by-synthesis technology; one of the most widely adopted early next-generation sequencing platforms." .

OCCO:00000030 a owl:Class ;
    rdfs:label "Teaching/Learning Strategy" ;
    rdfs:subClassOf mc2:ResourceActivityTypeEnum ;
    skos:definition "An instructional method, technique, or procedure used by educators to facilitate teaching or by learners to facilitate learning of new material." .

OMIT:0024179 a owl:Class ;
    rdfs:label "Systems Biology" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "An interdisciplinary field that studies complex interactions within biological systems using a holistic approach, integrating computational and mathematical modeling with experimental data to understand emergent properties of the system as a whole." .

UBERON:0010210 a owl:Class ;
    rdfs:label "Blood Clot" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A semisolid gelatinous mass of coagulated blood consisting of red blood cells, white blood cells, and platelets entrapped in a fibrin network." .

UO:0000015 a owl:Class ;
    rdfs:label "cm" ;
    rdfs:subClassOf mc2:ImageWorkingDistanceUnitEnum ;
    skos:definition "A length unit which is equal to one hundredth of a meter or 10^[-2] m." .

UO:0000016 a owl:Class ;
    rdfs:label "mm" ;
    rdfs:subClassOf mc2:ImageWorkingDistanceUnitEnum ;
    skos:definition "A length unit which is equal to one thousandth of a meter or 10^[-3] m." .

UO:0000017 a owl:Class ;
    rdfs:label "µm" ;
    rdfs:subClassOf mc2:ImageWorkingDistanceUnitEnum ;
    skos:definition "A length unit which is equal to one millionth of a meter or 10^[-6] m." .

UO:0000018 a owl:Class ;
    rdfs:label "nm" ;
    rdfs:subClassOf mc2:ImageWorkingDistanceUnitEnum ;
    skos:definition "A length unit which is equal to one billionth of a meter or 10^[-9] m." .

UO:0000019 a owl:Class ;
    rdfs:label "Å" ;
    rdfs:subClassOf mc2:ImageWorkingDistanceUnitEnum ;
    skos:definition "A length unit which is equal to 10^[-10] m." .

DCTERMS:contributor a owl:Class ;
    rdfs:label "Contributor" ;
    rdfs:subClassOf mc2:ToolEntityRoleEnum .

<http://schema.org/APIReference> a owl:Class ;
    rdfs:label "API Documentation" ;
    rdfs:subClassOf mc2:ToolDocumentationTypeEnum .

<http://schema.org/FAQPage> a owl:Class ;
    rdfs:label "FAQ" ;
    rdfs:subClassOf mc2:ToolDocumentationTypeEnum ;
    skos:definition "Frequently Asked Questions (and answers) about the software." .

<http://schema.org/Syllabus> a owl:Class ;
    rdfs:label "Syllabus" ;
    rdfs:subClassOf mc2:ResourceActivityTypeEnum ;
    skos:definition "A document describing the material, structure, objectives, and requirements covered in a course." .

<http://schema.org/maintainer> a owl:Class ;
    rdfs:label "Maintainer" ;
    rdfs:subClassOf mc2:ToolEntityRoleEnum .

<http://schema.org/screenshot> a owl:Class ;
    rdfs:label "Screenshot" ;
    rdfs:subClassOf mc2:ToolDownloadTypeEnum ;
    skos:definition "Screenshot of the software." .

SIO:000688 a owl:Class ;
    rdfs:label "Institute" ;
    rdfs:subClassOf mc2:ToolEntityTypeEnum .

SIO:001378 a owl:Class ;
    rdfs:label "Analyte" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A substance or chemical constituent extracted or purified from a biospecimen that serves as the target of an analytical procedure, such as a nucleic acid or protein preparation." .

SIO:010019 a owl:Class ;
    rdfs:label "Biological Data" ;
    rdfs:subClassOf mc2:ToolDownloadTypeEnum .

SNOMED:115218002 a owl:Class ;
    rdfs:label "Ductal and Lobular Neoplasms" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "An ICD-O-3 morphology category comprising neoplasms that arise from the ductal or lobular epithelium of glandular organs, most commonly the breast, including ductal carcinoma in situ, invasive ductal carcinoma, and lobular carcinoma." .

SNOMED:115229003 a owl:Class ;
    rdfs:label "Complex Mixed and Stromal Neoplasms" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "An ICD-O-3 morphology category comprising neoplasms with complex mixed epithelial and stromal or mesenchymal components, such as adenomyoma, adenofibroma, and mixed mesodermal (Mullerian) tumors." .

SNOMED:115237006 a owl:Class ;
    rdfs:label "Osseous and Chondromatous Neoplasms" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "An ICD-O-3 morphology category comprising neoplasms of bone (osseous) and cartilage (chondromatous) origin, such as osteoma, osteosarcoma, chondroma, and chondrosarcoma." .

SNOMED:115243008 a owl:Class ;
    rdfs:label "Granular Cell Tumors and Alveolar Soft Part Sarcomas" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "An ICD-O-3 morphology category comprising granular cell tumors, which are composed of cells with abundant granular eosinophilic cytoplasm, and alveolar soft part sarcoma, a rare malignant soft tissue neoplasm with a distinctive alveolar growth pattern." .

SNOMED:161125007 a owl:Class ;
    rdfs:label "Adult Education" ;
    rdfs:subClassOf mc2:ResourceEducationalLevelEnum ;
    skos:definition "Educational programs and instructional resources designed for adult learners pursuing education outside the traditional K-12 or college-age system." .

SNOMED:224870001 a owl:Class ;
    rdfs:label "Community College / Lower Division" ;
    rdfs:subClassOf mc2:ResourceEducationalLevelEnum ;
    skos:definition "A two-year postsecondary institution offering associate degrees and lower-division (freshman and sophomore level) undergraduate coursework." .

SNOMED:84914008 a owl:Class ;
    rdfs:label "Administrator" ;
    rdfs:subClassOf mc2:ResourcePrimaryAudienceEnum ;
    skos:definition "An individual responsible for the operational, managerial, or administrative oversight of an educational institution or program." .

BAO:0002643 a owl:Class ;
    rdfs:label "Primary" ;
    rdfs:subClassOf mc2:ChannelAntibodyRoleEnum ;
    skos:definition "The role of an antibody to detect and bind a specific antigen in a sample (cell, tissue, protein blot)." .

BAO:0002644 a owl:Class ;
    rdfs:label "Secondary" ;
    rdfs:subClassOf mc2:ChannelAntibodyRoleEnum ;
    skos:definition "The role of an antibody to detect and bind a primary antibody in a sample (cell, tissue, protein blot)." .

BAO:0150017 a owl:Class ;
    rdfs:label "Air" ;
    rdfs:subClassOf mc2:ImageImmersionTypeEnum ;
    skos:definition "An imaging immersion condition in which no liquid or oil medium is used between the objective lens and the specimen or coverslip; the objective is separated from the sample only by air." .

BAO:0150019 a owl:Class ;
    rdfs:label "Oil" ;
    rdfs:subClassOf mc2:ImageImmersionTypeEnum ;
    skos:definition "An imaging immersion condition in which a specialized oil with a refractive index matched to glass is applied between the objective lens and the specimen or coverslip to increase numerical aperture and resolution." .

BAO:0150020 a owl:Class ;
    rdfs:label "Water" ;
    rdfs:subClassOf mc2:ImageImmersionTypeEnum ;
    skos:definition "An imaging immersion condition in which water is applied between the objective lens and the specimen or coverslip, commonly used with water-immersion objectives for live-cell or aqueous-sample imaging." .

EFO:0004201 a owl:Class ;
    rdfs:label "Illumina Genome Analyzer II" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A DNA sequencer developed by Illumina; an upgraded version of the original Genome Analyzer supporting single- or paired-end sequencing by synthesis." .

EFO:0004203 a owl:Class ;
    rdfs:label "Illumina HiSeq 2000" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The Illumina HiSeq 2000 is a sequencing machine developed by Illumina with two flow cells and a throughput of up to 55 Gb per day, optimized for multi-sample sequencing." .

EFO:0004204 a owl:Class ;
    rdfs:label "Illumina HiSeq 1000" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The Illumina HiSeq 1000 is a sequencing machine developed by Illumina with a single flow cell and a throughput of up to 35 Gb per day." .

EFO:0004205 a owl:Class ;
    rdfs:label "Illumina MiSeq" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The Illumina MiSeq is a high-throughput sequencing machine developed by Illumina; primary applications include small whole-genome sequencing, targeted gene sequencing, and 16S metagenomic sequencing." .

EFO:0004206 a owl:Class ;
    rdfs:label "454 GS 20" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The 454 GS 20 is a high-throughput pyrosequencing instrument developed by 454 Life Sciences, the first commercially released model in the GS sequencer line." .

EFO:0004431 a owl:Class ;
    rdfs:label "454 GS" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The Roche/454 GS (Genome Sequencer) is a high-throughput pyrosequencing instrument developed by 454 Life Sciences, one of the first commercially available next-generation DNA sequencing platforms." .

EFO:0004432 a owl:Class ;
    rdfs:label "454 GS FLX" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The 454 GS FLX is a next-generation pyrosequencing instrument developed by 454 Life Sciences (later Roche) that uses emulsion PCR-amplified beads and sequencing-by-synthesis with bioluminescent detection." .

EFO:0004433 a owl:Class ;
    rdfs:label "454 GS FLX Titanium" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The 454 GS FLX Titanium sequencer is a GS high-throughput sequencing machine developed by 454 Life Sciences, an upgraded version of the GS FLX offering increased read length and throughput." .

EFO:0004434 a owl:Class ;
    rdfs:label "454 GS Junior" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The 454 GS Junior is a benchtop high-throughput pyrosequencing machine developed by 454 Life Sciences, a smaller-scale version of the GS FLX system." .

EFO:0004436 a owl:Class ;
    rdfs:label "AB 5500xl Genetic Analyzer" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A proprietary next-generation DNA sequencing system from Applied Biosystems that utilizes DNA ligase. DNA fragments attached to beads are clonally amplified and ligated to fluorescently labeled \"interrogation probes\". Ligation frees the fluor, which is detected and identifies the specific probe. The marker of the attached probe is then removed and a 5'-phosphate group is regenerated. Multiple cycles of ligation, detection, and cleavage are performed." .

EFO:0004437 a owl:Class ;
    rdfs:label "AB SOLiD PI System" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A proprietary next-generation DNA sequencing system from Applied Biosystems that utilizes DNA ligase. DNA fragments attached to beads are clonally amplified and ligated to fluorescently labeled \"interrogation probes\". Ligation frees the fluor, which is detected and identifies the specific probe. The marker of the attached probe is then removed and a 5'-phosphate group is regenerated. Multiple cycles of ligation, detection, and cleavage are performed." .

EFO:0004438 a owl:Class ;
    rdfs:label "AB SOLiD 4" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A proprietary next-generation DNA sequencing system from Applied Biosystems (the fourth-generation SOLiD platform) that utilizes DNA ligase-based sequencing-by-ligation chemistry on clonally amplified, bead-attached DNA fragments." .

EFO:0004439 a owl:Class ;
    rdfs:label "AB SOLiD 3" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A proprietary next-generation DNA sequencing system from Applied Biosystems (the third-generation SOLiD platform) that utilizes DNA ligase-based sequencing-by-ligation chemistry on clonally amplified, bead-attached DNA fragments." .

EFO:0004440 a owl:Class ;
    rdfs:label "AB 5500 Genetic Analyzer" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A proprietary next-generation DNA sequencing system from Applied Biosystems that utilizes DNA ligase. DNA fragments attached to beads are clonally amplified and ligated to fluorescently labeled \"interrogation probes\". Ligation frees the fluor, which is detected and identifies the specific probe. The marker of the attached probe is then removed and a 5'-phosphate group is regenerated. Multiple cycles of ligation, detection, and cleavage are performed." .

EFO:0004441 a owl:Class ;
    rdfs:label "AB SOLiD 4hq System" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A proprietary next-generation DNA sequencing system from Applied Biosystems that utilizes DNA ligase. DNA fragments attached to beads are clonally amplified and ligated to fluorescently labeled \"interrogation probes\". Ligation frees the fluor, which is detected and identifies the specific probe. The marker of the attached probe is then removed and a 5'-phosphate group is regenerated. Multiple cycles of ligation, detection, and cleavage are performed." .

EFO:0004442 a owl:Class ;
    rdfs:label "AB SOLiD 2" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A proprietary next-generation DNA sequencing system from Applied Biosystems (the second-generation SOLiD platform) that utilizes DNA ligase-based sequencing-by-ligation chemistry on clonally amplified, bead-attached DNA fragments." .

EFO:0004455 a owl:Class ;
    rdfs:label "Repeat fractionation" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Selection for less repetitive (and more gene rich) sequence through Cot filtration (CF) or other fractionation techniques based on DNA kinetics." .

EFO:0008563 a owl:Class ;
    rdfs:label "Illumina HiSeq 4000" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The Illumina HiSeq 4000 is a high-throughput sequencing machine developed by Illumina with two flow cells and a throughput of more than 400 Gb per day." .

EFO:0008564 a owl:Class ;
    rdfs:label "Illumina HiSeq 3000" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The Illumina HiSeq 3000 is a high-throughput sequencing machine developed by Illumina with a single flow cell and a throughput of more than 200 Gb per day." .

EFO:0008565 a owl:Class ;
    rdfs:label "Illumina HiSeq 2500" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The Illumina HiSeq 2500 is a sequencing machine developed by Illumina with two flow cells and a throughput of up to 160 Gb per day, supporting both high-output batch runs and rapid-run modes." .

EFO:0008566 a owl:Class ;
    rdfs:label "Illumina NextSeq 550" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The Illumina NextSeq 550 is a benchtop high-throughput sequencing machine developed by Illumina; primary applications include exome sequencing, targeted gene sequencing, whole-transcriptome sequencing, and cytogenomic arrays." .

EFO:0008631 a owl:Class ;
    rdfs:label "PacBio RS II" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The PacBio RS II is a high-throughput sequencing machine developed by Pacific Biosciences; primary applications are whole-genome sequencing of smaller organisms and targeted sequencing of DNA and RNA." .

EFO:0008634 a owl:Class ;
    rdfs:label "PromethION" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The ONT PromethION is a high-throughput, high-sample-number benchtop sequencing machine developed by Oxford Nanopore Technologies." .

EFO:0008637 a owl:Class ;
    rdfs:label "Illumina NovaSeq 6000" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The Illumina NovaSeq 6000 is a high-throughput sequencing machine developed by Illumina, with two flow cells and an output of up to 6000 Gb using patterned flow-cell sequencing-by-synthesis technology." .

EFO:0008931 a owl:Class ;
    rdfs:label "Smart-seq2" ;
    rdfs:subClassOf mc2:VisiumSpatialLibraryConstructionMethodEnum ;
    skos:definition "Switching mechanism at the 5' end of RNA templates (SMART)-based library construction method; Smart-seq2 transcriptome libraries have improved detection, coverage, and accuracy compared to the original Smart-seq method, and are generated with off-the-shelf reagents at lower cost." .

EFO:0009173 a owl:Class ;
    rdfs:label "Illumina NextSeq 500" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The Illumina NextSeq 500 is a benchtop high-throughput sequencing machine developed by Illumina using sequencing-by-synthesis chemistry." .

EFO:0009899 a owl:Class ;
    rdfs:label "10xV2" ;
    rdfs:subClassOf mc2:VisiumSpatialLibraryConstructionMethodEnum ;
    skos:definition "Second version (v2) of the 10x Genomics droplet-based single-cell 3' library construction chemistry, in which the poly(dT) sequence is part of the gel bead oligo (along with the cell barcode and UMI) and the template-switch oligo is supplied in the RT primer." .

EFO:0009901 a owl:Class ;
    rdfs:label "10xV1.0" ;
    rdfs:subClassOf mc2:VisiumSpatialLibraryConstructionMethodEnum ;
    skos:definition "First version (v1) of the 10x Genomics droplet-based single-cell 3' library construction chemistry, in which barcoded gel beads and cells are co-encapsulated in nanoliter droplets for parallel barcoding of transcripts." .

EFO:0009922 a owl:Class ;
    rdfs:label "10xV3" ;
    rdfs:subClassOf mc2:VisiumSpatialLibraryConstructionMethodEnum ;
    skos:definition "Third version (v3) of the 10x Genomics droplet-based single-cell 3' library construction chemistry." .

EFO:0011027 a owl:Class ;
    rdfs:label "Illumina HiSeq 1500" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The Illumina HiSeq 1500 is a sequencing machine developed by Illumina, with a single flow cell and dual surface imaging offering high-output and rapid-run modes." .

EFO:0022841 a owl:Class ;
    rdfs:label "Illumina NovaSeq X Plus" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The Illumina NovaSeq X Plus is a high-throughput sequencing machine developed by Illumina with a dual flow-cell configuration and an output of up to 16 Tb per run using XLEAP-SBS chemistry." .

EFO:0022857 a owl:Class ;
    rdfs:label "V1" ;
    rdfs:subClassOf mc2:VisiumSlideVersionEnum ;
    skos:definition "10x Genomics Visium Spatial Gene Expression slide, version 1 (the original, manually placed Visium slide format), with capture areas measuring 6.5mm x 6.5mm containing 4,992 spatially barcoded spots each." .

EFO:0022858 a owl:Class ;
    rdfs:label "V2" ;
    rdfs:subClassOf mc2:VisiumSlideVersionEnum ;
    skos:definition "10x Genomics Visium slide, version 2, compatible with the Visium CytAssist instrument for automated tissue transfer from a standard glass slide; available with capture areas of 6.5mm x 6.5mm or 11mm x 11mm." .

EFO:0022980 a owl:Class ;
    rdfs:label "10xV3.1" ;
    rdfs:subClassOf mc2:VisiumSpatialLibraryConstructionMethodEnum ;
    skos:definition "Minor revision (v3.1) of the third-generation 10x Genomics single-cell 3' library construction chemistry." .

EFO:0022998 a owl:Class ;
    rdfs:label "SABER" ;
    rdfs:subClassOf mc2:ImageAssayTypeEnum ;
    skos:definition "Signal Amplification By Exchange Reaction (SABER): a DNA-based in situ hybridization method that uses a primer exchange reaction to generate long, concatemeric single-stranded DNA amplification tails on oligonucleotide probes, enabling programmable, multiplexed signal amplification for imaging RNA, DNA, or protein targets without enzymatic or antibody-based amplification." .

EFO:0023019 a owl:Class ;
    rdfs:label "t-CyCIF" ;
    rdfs:subClassOf mc2:ImageAssayTypeEnum ;
    skos:definition "Tissue-based Cyclic Immunofluorescence (t-CyCIF): a multiplex immunofluorescence imaging assay that uses iterative cycles of antibody staining, fluorescence imaging, and fluorophore inactivation to enable highly multiplexed spatial detection and quantification of protein targets within the same tissue specimen while preserving tissue architecture and cellular context." .

EFO:0700006 a owl:Class ;
    rdfs:label "ExSeq" ;
    rdfs:subClassOf mc2:ImageAssayTypeEnum ;
    skos:definition "ExSeq (Expansion Sequencing): a spatial transcriptomics assay that involves physically expanding specimens with polymer- and hydrogel-based systems followed by in situ sequencing." .

EFO:0700010 a owl:Class ;
    rdfs:label "TruDrop" ;
    rdfs:subClassOf mc2:VisiumSpatialLibraryConstructionMethodEnum ;
    skos:definition "Droplet-based microfluidic single-cell library construction platform based on inDrop that incorporates dual indexing to detect index hopping, using standard Illumina sequencing primers for high-throughput sequencing." .

EFO:0700016 a owl:Class ;
    rdfs:label "Smart-SeqV4" ;
    rdfs:subClassOf mc2:VisiumSpatialLibraryConstructionMethodEnum ;
    skos:definition "Single-cell RNA-seq library construction method using SMART (Switching Mechanism At 5' end of RNA Template) chemistry to generate high-quality cDNA from ultra-low amounts of total RNA or directly from intact cells (<1,000 cells); improves on Smart-seq2 via locked nucleic acid (LNA) technology and an optimized template-switching oligo." .

EFO:0700018 a owl:Class ;
    rdfs:label "MGISEQ-2000RS" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The MGISEQ-2000RS is a model type of the BGISEQ sequencing library platform." .

EFO:0920005 a owl:Class ;
    rdfs:label "Ultima Genomics UG100" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The Ultima UG100 is a high-throughput sequencing machine developed by Ultima Genomics, designed for large-scale sequencing projects including single-cell RNA sequencing and human genome sequencing, using emulsion-based PCR amplification." .

SWO:0000005 a owl:Class ;
    rdfs:label "MATLAB" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "MATLAB is a high-level language and interactive environment that enables users to perform computationally intensive tasks faster than with traditional programming languages such as C, C++, and Fortran." .

SWO:0000008 a owl:Class ;
    rdfs:label "Racket" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Racket is a general-purpose, multi-paradigm programming language descended from Scheme, used both as a teaching language and for general software development." .

SWO:0000012 a owl:Class ;
    rdfs:label "Java" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Java is a general-purpose, class-based, object-oriented programming language designed to be portable across platforms via the 'write once, run anywhere' principle, executed on the Java Virtual Machine." .

SWO:0000022 a owl:Class ;
    rdfs:label "Linux" ;
    rdfs:subClassOf mc2:ToolOperatingSystemEnum ;
    skos:definition "All flavours of Linux/UNIX operating systems." .

SWO:0000030 a owl:Class ;
    rdfs:label "Command-Line Tool" ;
    rdfs:subClassOf mc2:ToolTypeEnum .

SWO:0000083 a owl:Class ;
    rdfs:label "Plug-In" ;
    rdfs:subClassOf mc2:ToolTypeEnum .

SWO:0000091 a owl:Class ;
    rdfs:label "ActionScript" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "ActionScript is an object-oriented programming language originally developed by Macromedia (later Adobe) for building interactive applications and animations on the Adobe Flash Platform." .

SWO:0000092 a owl:Class ;
    rdfs:label "Ada" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Ada is a structured, statically typed imperative programming language designed for reliability and maintainability, and widely used in embedded, real-time, and safety-critical systems such as aerospace and defense applications." .

SWO:0000093 a owl:Class ;
    rdfs:label "AppleScript" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "AppleScript is a scripting language created by Apple that allows users to directly control scriptable Mac applications and automate repetitive tasks on macOS." .

SWO:0000094 a owl:Class ;
    rdfs:label "Assembly Language" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Assembly language is a low-level programming language with a close, largely one-to-one correspondence to a computer's machine code instructions, specific to a particular processor architecture." .

SWO:0000095 a owl:Class ;
    rdfs:label "C" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "C is a general-purpose, procedural, statically typed programming language that provides low-level access to memory and hardware, and is widely used for operating systems, embedded systems, and performance-critical software." .

SWO:0000096 a owl:Class ;
    rdfs:label "C#" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "C# (C Sharp) is a general-purpose, object-oriented programming language developed by Microsoft as part of the .NET platform, commonly used for Windows applications, games, and web services." .

SWO:0000097 a owl:Class ;
    rdfs:label "C++" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "C++ is a general-purpose, statically typed programming language that extends the C language with object-oriented and generic programming features, widely used for systems software, games, and performance-critical applications." .

SWO:0000098 a owl:Class ;
    rdfs:label "COBOL" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "COBOL (Common Business-Oriented Language) is an imperative, procedural programming language designed for business, finance, and administrative data-processing applications." .

SWO:0000099 a owl:Class ;
    rdfs:label "ColdFusion" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "ColdFusion is a commercial rapid-application-development scripting language and platform, originally created by Allaire, used for building dynamic web applications." .

SWO:0000100 a owl:Class ;
    rdfs:label "D" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "D is a general-purpose, statically typed systems programming language that combines the efficiency of C++ with modern features such as garbage collection and built-in unit testing." .

SWO:0000101 a owl:Class ;
    rdfs:label "Delphi" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Delphi is an integrated development environment and associated Object Pascal-based programming language used primarily for rapid application development of Windows desktop and mobile applications." .

SWO:0000102 a owl:Class ;
    rdfs:label "Dylan" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Dylan is a multi-paradigm programming language that combines features of dynamic, object-oriented languages such as Lisp and Smalltalk with a more conventional syntax." .

SWO:0000103 a owl:Class ;
    rdfs:label "Eiffel" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Eiffel is an object-oriented programming language designed around the principle of Design by Contract, emphasizing software correctness and reliability." .

SWO:0000104 a owl:Class ;
    rdfs:label "Forth" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Forth is a stack-based, procedural programming language known for its simplicity, extensibility, and use of Reverse Polish Notation, historically popular for embedded and control systems." .

SWO:0000105 a owl:Class ;
    rdfs:label "Fortran" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Fortran (Formula Translation) is a general-purpose, imperative programming language especially suited for numeric computation and scientific computing." .

SWO:0000106 a owl:Class ;
    rdfs:label "Groovy" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Groovy is a dynamic, object-oriented programming language for the Java platform that adds scripting capabilities and syntactic sugar to Java-based applications." .

SWO:0000107 a owl:Class ;
    rdfs:label "Haskell" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Haskell is a statically typed, purely functional programming language known for its strong emphasis on lazy evaluation and mathematical rigor." .

SWO:0000108 a owl:Class ;
    rdfs:label "JavaScript" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "JavaScript is a high-level, dynamically typed scripting language most commonly used to add interactivity and dynamic behavior to web pages, and increasingly for server-side and application development." .

SWO:0000109 a owl:Class ;
    rdfs:label "LabVIEW" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "LabVIEW is a graphical, dataflow-based programming environment developed by National Instruments, primarily used for data acquisition, instrument control, and industrial automation." .

SWO:0000110 a owl:Class ;
    rdfs:label "Lisp" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Lisp is a family of programming languages characterized by a distinctive fully parenthesized syntax and support for symbolic computation, historically influential in artificial intelligence research." .

SWO:0000111 a owl:Class ;
    rdfs:label "Lua" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Lua is a lightweight, high-level, embeddable scripting language designed for extensibility, commonly used to add scripting capabilities to applications and games." .

SWO:0000112 a owl:Class ;
    rdfs:label "Maple" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Maple is a symbolic and numeric computing environment and programming language used for mathematical computation, modeling, and visualization." .

SWO:0000113 a owl:Class ;
    rdfs:label "Mathematica" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Mathematica is a computational software system and programming language developed by Wolfram Research, used for symbolic and numerical computation, data analysis, and visualization." .

SWO:0000114 a owl:Class ;
    rdfs:label "Pascal" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Pascal is a procedural, statically typed imperative programming language designed to encourage structured programming practices, historically widely used for teaching and application development." .

SWO:0000115 a owl:Class ;
    rdfs:label "Perl" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Perl is a high-level, general-purpose interpreted programming language known for its powerful text-processing capabilities, widely used for system administration, web development, and bioinformatics." .

SWO:0000116 a owl:Class ;
    rdfs:label "PHP" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "PHP is a general-purpose scripting language especially suited for server-side web development, used to create dynamic web pages and applications." .

SWO:0000117 a owl:Class ;
    rdfs:label "Prolog" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Prolog is a logic programming language based on formal logic, in which programs are expressed as facts and rules, widely used in artificial intelligence and computational linguistics." .

SWO:0000118 a owl:Class ;
    rdfs:label "Python" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Python is a widely used general-purpose, high-level programming language whose design philosophy emphasizes code readability, supporting object-oriented, imperative, and functional programming styles." .

SWO:0000119 a owl:Class ;
    rdfs:label "REXX" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "REXX (Restructured Extended Executor) is a structured, interpreted programming language originally developed by IBM for scripting and automating tasks on mainframe systems." .

SWO:0000120 a owl:Class ;
    rdfs:label "Ruby" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Ruby is a dynamic, object-oriented, general-purpose programming language designed for simplicity and productivity, with an elegant and readable syntax." .

SWO:0000121 a owl:Class ;
    rdfs:label "SAS" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "SAS is a proprietary software suite and programming language developed by SAS Institute for advanced analytics, statistical analysis, business intelligence, and data management." .

SWO:0000122 a owl:Class ;
    rdfs:label "Scala" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Scala is a general-purpose programming language that combines object-oriented and functional programming paradigms, and runs on the Java Virtual Machine." .

SWO:0000123 a owl:Class ;
    rdfs:label "Scheme" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Scheme is a minimalist, multi-paradigm programming language and dialect of Lisp known for its simple syntax and support for functional programming." .

SWO:0000124 a owl:Class ;
    rdfs:label "Shell" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Shell refers to a command-line interpreter and associated scripting language used to execute commands and automate tasks in Unix-like operating systems." .

SWO:0000127 a owl:Class ;
    rdfs:label "Turing" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Turing is a structured, general-purpose programming language developed at the University of Toronto, designed primarily for teaching programming concepts." .

SWO:0000128 a owl:Class ;
    rdfs:label "Verilog" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Verilog is a hardware description language used to model, design, and simulate digital and analog electronic systems." .

SWO:0000129 a owl:Class ;
    rdfs:label "VHDL" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "VHDL (VHSIC Hardware Description Language) is a hardware description language used to model and simulate the behavior and structure of digital electronic circuits." .

SWO:0000130 a owl:Class ;
    rdfs:label "Visual Basic" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Visual Basic is an event-driven, object-oriented programming language developed by Microsoft, historically used for rapid application development of Windows desktop applications." .

SWO:0000134 a owl:Class ;
    rdfs:label "MLXTRAN" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "MLXTRAN is a domain-specific modeling language used within the Monolix software suite to define pharmacometric and biological models for nonlinear mixed-effects analysis." .

SWO:0000136 a owl:Class ;
    rdfs:label "NMTRAN" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "NM-TRAN is the control-file language used by the NONMEM software package to specify nonlinear mixed-effects pharmacokinetic/pharmacodynamic models." .

SWO:0000151 a owl:Class ;
    rdfs:label "Mac" ;
    rdfs:subClassOf mc2:ToolOperatingSystemEnum ;
    skos:definition "All flavours of Apple Macintosh operating systems (primarily Mac OS X)." .

SWO:0000415 a owl:Class ;
    rdfs:label "R" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "R is a programming language and free software environment for statistical computing, data analysis, and graphics, widely used in bioinformatics and data science." .

SWO:3000024 a owl:Class ;
    rdfs:label "PostScript" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "PostScript is a page description and programming language developed by Adobe, used primarily for describing the layout, text, and graphics of printed documents." .

SWO:3000025 a owl:Class ;
    rdfs:label "Latex" ;
    rdfs:subClassOf mc2:ResourceMediaAccessibilityEnum ;
    skos:definition "Indicates that mathematical or scientific content is encoded using LaTeX, a document preparation and markup system, allowing accessible rendering of complex notation." .

SWO:9000072 a owl:Class ;
    rdfs:label "Windows" ;
    rdfs:subClassOf mc2:ToolOperatingSystemEnum ;
    skos:definition "All flavours of Microsoft Windows operating system." .

credit:software a owl:Class ;
    rdfs:label "Developer" ;
    rdfs:subClassOf mc2:ToolEntityRoleEnum .

UMLS:C1384509 a owl:Class ;
    rdfs:label "Transitional Cell Papillomas and Carcinomas" ;
    rdfs:subClassOf mc2:DiseaseTypeEnum ;
    skos:definition "An ICD-O-3 morphology category comprising benign transitional cell papillomas and malignant transitional cell (urothelial) carcinomas, which typically arise from the transitional epithelium lining the urinary tract." .

EVORAO:Audio a owl:Class ;
    rdfs:label "Audio" ;
    rdfs:subClassOf mc2:ResourcePrimaryFormatEnum ;
    skos:definition "A file representing sound recordings or audio tracks." .

EVORAO:Image a owl:Class ;
    rdfs:label "Diagram/Illustration" ;
    rdfs:subClassOf mc2:ResourceActivityTypeEnum ;
    skos:definition "A visual representation, such as a diagram, chart, or illustration, used to depict concepts, structures, or processes for instructional purposes." .

mc2:10xVisiumAuxiliaryFiles_id a owl:DatatypeProperty ;
    rdfs:label "10xVisiumAuxiliaryFiles_id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^syn\\d{7,8}$" ] ) ] ;
    skos:definition "Unique row identifier, used as a primary key for record updates. This should be equivalent to the file Synapse Id unless otherwise indicated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:10xVisiumRNALevel1_Key a owl:DatatypeProperty ;
    rdfs:label "10xVisiumRNALevel1 Key" ;
    skos:definition "Unique 10xVisiumRNALevel1_id foreign key(s) that link metadata entries as part of the same Dataset. Please provide multiple values as a comma-separate list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

