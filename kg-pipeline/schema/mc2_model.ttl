mesh:D000079265 a owl:Class ;
    rdfs:label "Environmental Science" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The interdisciplinary scientific study of external biotic and abiotic factors to which an organism is exposed, and their effects on health and ecosystems." .

mesh:D000089862 a owl:Class ;
    rdfs:label "Haptic" ;
    rdfs:subClassOf mc2:ResourceMediaAccessibilityEnum ;
    skos:definition "Indicates that the resource provides touch-based (haptic) feedback, such as vibration, force, or tactile cues, as an alternative or supplement to visual or auditory information." .

mesh:D000092783 a owl:Class ;
    rdfs:label "Diversity/Equity/Inclusion" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "Efforts and practices that promote fair representation, equal opportunity, and inclusion of individuals from diverse backgrounds, identities, and abilities within research and educational communities." .

mesh:D000362 a owl:Class ;
    rdfs:label "Agar embedding" ;
    rdfs:subClassOf mc2:BiospecimenEmbeddingMediumEnum ;
    skos:definition "Use of agar, a gelatinous polysaccharide extracted from red algae, as a supporting medium to consolidate small, fragmented, or friable tissue specimens prior to histological processing and sectioning." .

mesh:D003101 a owl:Class ;
    rdfs:label "Celloidin media" ;
    rdfs:subClassOf mc2:BiospecimenEmbeddingMediumEnum ;
    skos:definition "A purified nitrocellulose (collodion) solution in ether and alcohol; historically used as an embedding medium for sectioning large, hard, or heterogeneous specimens (e.g., whole organs, decalcified bone) that are poorly suited to paraffin embedding." .

mesh:D003479 a owl:Class ;
    rdfs:label "Curriculum/Instruction" ;
    rdfs:subClassOf mc2:ResourceIntendedUseEnum ;
    skos:definition "A structured course of study or instructional material intended for use in classroom teaching or curriculum-based instruction." .

mesh:D004500 a owl:Class ;
    rdfs:label "Graduate / Profession" ;
    rdfs:subClassOf mc2:ResourceEducationalLevelEnum ;
    skos:definition "Studies beyond the bachelor's degree at an institution having graduate or professional programs, undertaken to prepare for entrance into a specific field or to obtain a higher degree." .

mesh:D004521 a owl:Class ;
    rdfs:label "Assessment" ;
    rdfs:subClassOf mc2:ResourceActivityTypeEnum ;
    skos:definition "A resource used to evaluate learner understanding or performance, such as a quiz, test, or other measurement of academic achievement." .

mesh:D004853 a owl:Class ;
    rdfs:label "Epoxy Resin (Araldite)" ;
    rdfs:subClassOf mc2:BiospecimenEmbeddingMediumEnum ;
    skos:definition "A class of thermosetting polymer resins (e.g., Araldite) formed by curing epoxide monomers with a hardener; used as a hard, transparent embedding medium for ultrathin sectioning in transmission electron microscopy." .

mesh:D007254 a owl:Class ;
    rdfs:label "Information Science" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The field of knowledge, theory, and technology concerned with the collection, organization, storage, retrieval, and dissemination of facts and data, including aspects of communication, publishing, and informatics." .

mesh:D010344 a owl:Class ;
    rdfs:label "Patient Advocacy" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "Efforts to promote, protect, and represent the rights, needs, and interests of patients, often through education, support services, or engagement in research and health policy processes." .

mesh:D018961 a owl:Class ;
    rdfs:label "Educational Technology" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The systematic identification, development, organization, and use of educational resources, tools, and equipment, including audiovisual and digital aids, to support teaching and learning." .

mesh:D019528 a owl:Class ;
    rdfs:label "Lecture Notes" ;
    rdfs:subClassOf mc2:ResourceActivityTypeEnum ;
    skos:definition "Written notes, outlines, or summaries prepared for or derived from a lecture, used to supplement or review instructional content." .

mesh:D019531 a owl:Class ;
    rdfs:label "Lecture" ;
    rdfs:subClassOf mc2:ResourceActivityTypeEnum ;
    skos:definition "A recorded or transcribed instructional talk delivered to an audience or class, typically used to present or explain subject matter." .

mesh:D022923 a owl:Class ;
    rdfs:label "Textbook" ;
    rdfs:subClassOf mc2:ResourceActivityTypeEnum ;
    skos:definition "A book intended for use in the study of a specific subject, providing a systematic presentation of its principles and essential knowledge." .

mesh:D061108 a owl:Class ;
    rdfs:label "Social Media" ;
    rdfs:subClassOf mc2:ToolLinkTypeEnum .

APOLLO_SV:00000522 a owl:Class ;
    rdfs:label "Repository" ;
    rdfs:subClassOf mc2:ToolLinkTypeEnum ;
    skos:definition "A place where source code, data and other files can be retrieved from, typically via platforms like GitHub which provide version control and other features, or something simpler, e.g. an FTP site." .

BTO:0006181 a owl:Class ;
    rdfs:label "Blood Buffy Coat" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "The fraction of an anticoagulated blood sample that contains most of the white blood cells and platelets following density gradient centrifugation of whole blood." .

CHEBI:17754 a owl:Class ;
    rdfs:label "Glycerol" ;
    rdfs:subClassOf mc2:ImageImmersionTypeEnum ;
    skos:definition "An imaging immersion condition in which glycerol, a triol with a refractive index intermediate between water and oil, is applied between the objective lens and the specimen; glycerol-immersion objectives are often used for tissue-clearing or deep-imaging applications." .

CRO:0000091 a owl:Class ;
    rdfs:label "Documentor" ;
    rdfs:subClassOf mc2:ToolEntityRoleEnum .

EMAPA:37441 a owl:Class ;
    rdfs:label "Body Fluid" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A liquid substance derived from the body, such as blood, urine, cerebrospinal fluid, or pleural effusion, that is collected as a biospecimen." .

GENEPIO:0001943 a owl:Class ;
    rdfs:label "CF-H" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Cot-filtered highly repetitive genomic DNA" .

GENEPIO:0001944 a owl:Class ;
    rdfs:label "CF-M" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Cot-filtered moderately repetitive genomic DNA" .

GENEPIO:0001945 a owl:Class ;
    rdfs:label "CF-S" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Cot-filtered single/low-copy genomic DNA" .

GENEPIO:0001946 a owl:Class ;
    rdfs:label "CF-T" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Cot-filtered theoretical single-copy genomic DNA" .

GENEPIO:0001948 a owl:Class ;
    rdfs:label "DNAse" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Deoxyribonuclease (MNase) digestion" .

GENEPIO:0001949 a owl:Class ;
    rdfs:label "HMPR" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Hypo-methylated partial restriction digest" .

GENEPIO:0001950 a owl:Class ;
    rdfs:label "Hybrid Selection" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Selection by hybridization in array or solution" .

GENEPIO:0001951 a owl:Class ;
    rdfs:label "MBD2 protein methyl-CpG binding domain" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Enrichment by methyl-CpG binding domain" .

GENEPIO:0001952 a owl:Class ;
    rdfs:label "MF" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Methyl Filtrated" .

GENEPIO:0001953 a owl:Class ;
    rdfs:label "MNase" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Micrococcal Nuclease (MNase) digestion" .

GENEPIO:0001954 a owl:Class ;
    rdfs:label "MSLL" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Methylation Spanning Linking Library" .

GENEPIO:0001961 a owl:Class ;
    rdfs:label "Restriction Digest" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "DNA fractionation using restriction enzymes" .

GENEPIO:0001963 a owl:Class ;
    rdfs:label "Size fractionation" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Physical selection of size appropriate targets" .

GENEPIO:0100106 a owl:Class ;
    rdfs:label "Illumina Genome Analyzer" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A DNA sequencer manufactured by Solexa (later acquired by Illumina) as one of its first sequencer lines, launched in 2006, capable of sequencing 1 gigabase (Gb) of data in a single run." .

GENEPIO:0100109 a owl:Class ;
    rdfs:label "Illumina HiScanSQ" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A DNA sequencer manufactured by Illumina using sequencing-by-synthesis chemistry, containing a HiScan Reader for sequencing and microarray-based analyses as well as an SQ Module supporting microfluidics." .

GENEPIO:0100112 a owl:Class ;
    rdfs:label "Illumina HiSeq X Five" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A DNA sequencer manufactured by Illumina using sequencing-by-synthesis chemistry, consisting of a set of five HiSeq X ultra-high-throughput sequencing systems configured for population-scale whole-genome sequencing." .

GENEPIO:0100113 a owl:Class ;
    rdfs:label "Illumina HiSeq X Ten" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A DNA sequencer manufactured by Illumina consisting of a set of ten HiSeq X ultra-high-throughput sequencing systems configured for population-scale whole-genome sequencing." .

GENEPIO:0100121 a owl:Class ;
    rdfs:label "Illumina iSeq 100" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The Illumina iSeq 100 is a model type of the Illumina sequencing library platform." .

GENEPIO:0100122 a owl:Class ;
    rdfs:label "Illumina NovaSeq" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A DNA sequencer manufactured by Illumina using sequencing-by-synthesis chemistry with an output capacity of up to 6 Tb and 20 billion reads in dual flow-cell mode." .

GENEPIO:0100124 a owl:Class ;
    rdfs:label "Illumina MiniSeq" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A benchtop DNA sequencer manufactured by Illumina using sequencing-by-synthesis chemistry, with an output capacity of approximately 1.65-7.5 Gb per run." .

GENEPIO:0100126 a owl:Class ;
    rdfs:label "Illumina NextSeq" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A benchtop DNA sequencer manufactured by Illumina using sequencing-by-synthesis chemistry; the NextSeq series succeeded the HiSeq/MiSeq lines with high throughput in a compact benchtop format." .

GENEPIO:0100131 a owl:Class ;
    rdfs:label "PacBio RS" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A DNA sequencer manufactured by Pacific Biosciences that utilizes SMRT (single-molecule real-time) cells for sequencing; the first commercial model produced by the company." .

GENEPIO:0100133 a owl:Class ;
    rdfs:label "PacBio Sequel" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The PacBio Sequel is a model type of the PacBio SMRT sequencing library platform." .

GENEPIO:0100134 a owl:Class ;
    rdfs:label "PacBio Sequel II" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The PacBio Sequel II is a model type of the PacBio SMRT sequencing library platform." .

GENEPIO:0100136 a owl:Class ;
    rdfs:label "Ion Torrent PGM" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A DNA sequencer manufactured by Ion Torrent (Thermo Fisher) that utilizes ion semiconductor sequencing and has an output capacity of 300 Mb to 1 Gb." .

GENEPIO:0100137 a owl:Class ;
    rdfs:label "Ion Torrent Proton" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A DNA sequencer manufactured by Ion Torrent (Thermo Fisher) that utilizes ion semiconductor sequencing and has an output capacity of up to 15 Gb." .

GENEPIO:0100138 a owl:Class ;
    rdfs:label "Ion Torrent S5 XL" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A DNA sequencer manufactured by Ion Torrent (Thermo Fisher) that utilizes ion semiconductor sequencing, requiring only a small amount of input material while producing data faster than the standard S5 model." .

GENEPIO:0100139 a owl:Class ;
    rdfs:label "Ion Torrent S5" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A DNA sequencer manufactured by Ion Torrent (Thermo Fisher) that utilizes ion semiconductor sequencing and requires only a small amount of input material." .

GENEPIO:0100141 a owl:Class ;
    rdfs:label "GridION" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A DNA sequencer manufactured by Oxford Nanopore Technologies that can run and analyze up to five individual flow cells, producing up to 150 Gb of data per run, using real-time nanopore sequencing." .

GENEPIO:0100142 a owl:Class ;
    rdfs:label "MinION" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A portable DNA sequencer manufactured by Oxford Nanopore Technologies that uses consumable flow cells producing up to 30 Gb of sequence data per flow cell, generating real-time results via nanopore sequencing." .

GENEPIO:0100145 a owl:Class ;
    rdfs:label "BGISEQ-500" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The BGISEQ-500 is a model type of the BGISEQ sequencing library platform." .

GENEPIO:0100147 a owl:Class ;
    rdfs:label "DNBSEQ-T7" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The DNBSEQ-T7 is a model type of the BGISEQ sequencing library platform." .

GENEPIO:0100148 a owl:Class ;
    rdfs:label "DNBSEQ-G400" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The DNBSEQ-G400 is a model type of the BGISEQ sequencing library platform." .

GENEPIO:0100150 a owl:Class ;
    rdfs:label "DNBSEQ-G50" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The DNBSEQ-G50 is a model type of the BGISEQ sequencing library platform." .

GENEPIO:0100968 a owl:Class ;
    rdfs:label "454 GS FLX+" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "The 454 GS FLX+ is an upgraded version of the 454 GS FLX Titanium pyrosequencing instrument from 454 Life Sciences (Roche), offering extended read lengths of up to approximately 1,000 bp." .

GENEPIO:0100970 a owl:Class ;
    rdfs:label "AB 5500x-Wl Genetic Analyzer" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A proprietary next-generation DNA sequencing system from Applied Biosystems that utilizes DNA ligase. DNA fragments attached to beads are clonally amplified and ligated to fluorescently labeled \"interrogation probes\". Ligation frees the fluor, which is detected and identifies the specific probe. The marker of the attached probe is then removed and a 5'-phosphate group is regenerated. Multiple cycles of ligation, detection, and cleavage are performed." .

GENEPIO:0100975 a owl:Class ;
    rdfs:label "AB 310 Genetic Analyzer" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "An Applied Biosystems sequencing instrument that uses a single-capillary electrophoresis system to perform automated Sanger sequencing and fragment analysis." .

GENEPIO:0100976 a owl:Class ;
    rdfs:label "AB 3130 Genetic Analyzer" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "An Applied Biosystems sequencing instrument that performs capillary electrophoresis-based Sanger sequencing using 4 capillaries; successor to the AB PRISM 310." .

GENEPIO:0100977 a owl:Class ;
    rdfs:label "AB 3130xL Genetic Analyzer" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "An Applied Biosystems sequencing instrument that performs capillary electrophoresis-based Sanger sequencing using 16 capillaries; successor to the AB PRISM 310." .

GENEPIO:0100978 a owl:Class ;
    rdfs:label "AB 3500 Genetic Analyzer" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "An Applied Biosystems sequencing instrument that performs capillary electrophoresis-based Sanger sequencing using 8 capillaries and can run 96-well plates; successor to the 3130 series." .

GENEPIO:0100979 a owl:Class ;
    rdfs:label "AB 3500xL Genetic Analyzer" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "An Applied Biosystems sequencing instrument that performs capillary electrophoresis-based Sanger sequencing using 24 capillaries and can run 384-well plates; successor to the 3130 series." .

GENEPIO:0100980 a owl:Class ;
    rdfs:label "AB 3730 Genetic Analyzer" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "An Applied Biosystems sequencing instrument that uses a 48-capillary array electrophoresis system for Sanger sequencing; successor to the 3500 series." .

GENEPIO:0100981 a owl:Class ;
    rdfs:label "AB 3730xL Genetic Analyzer" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "An Applied Biosystems sequencing instrument that uses a 96-capillary array electrophoresis system for Sanger sequencing; successor to the 3500 series." .

GENEPIO:0101020 a owl:Class ;
    rdfs:label "rRNA Depletion" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "A library selection method in which ribosomal RNA (rRNA) is selectively removed from a nucleic acid sample prior to sequencing, enriching for non-ribosomal RNA species such as messenger RNA and other transcripts." .

GENEPIO:0102191 a owl:Class ;
    rdfs:label "PolyA" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "PolyA selection or enrichment for messenger RNA (mRNA); should replace cDNA enumeration." .

GSSO:003578 a owl:Class ;
    rdfs:label "Mobile" ;
    rdfs:subClassOf mc2:ResourcePrimaryFormatEnum ;
    skos:definition "A computer program or software application designed to run on a mobile device such as a phone or tablet." .

GSSO:005459 a owl:Class ;
    rdfs:label "Discussion Forum" ;
    rdfs:subClassOf mc2:ToolLinkTypeEnum .

IAO:0000593 a owl:Class ;
    rdfs:label "Library" ;
    rdfs:subClassOf mc2:ToolTypeEnum ;
    skos:definition "A collection of components that are used to construct other tools. bio.tools scope includes component libraries performing high-level bioinformatics functions but excludes lower-level programming libraries." .

MAMO:0000024 a owl:Class ;
    rdfs:label "Agent-Based Cell Modelling" ;
    rdfs:subClassOf mc2:ToolOperationEnum .

MONDO:0005165 a owl:Class ;
    rdfs:label "Benign Neoplasms" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A neoplasm that lacks the morphologic features of malignancy, such as severe cytologic atypia or tumor cell necrosis, and remains confined to its site of origin without metastasizing." .

NCIT:C102873 a owl:Class ;
    rdfs:label "Teacher" ;
    rdfs:subClassOf mc2:ResourcePrimaryAudienceEnum ;
    skos:definition "One who instructs or educates others." .

NCIT:C106049 a owl:Class ;
    rdfs:label "ChIP-Seq" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Direct sequencing of chromatin immunoprecipitates" .

NCIT:C106056 a owl:Class ;
    rdfs:label "MNase-Seq" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Direct sequencing following MNase digestion" .

NCIT:C118962 a owl:Class ;
    rdfs:label "Censored" ;
    rdfs:subClassOf mc2:IndividualRecurrenceStatusEnum ;
    skos:definition "When information on time-to-event is not available due to loss to follow-up or non-occurrence of outcome event before the trial end." .

NCIT:C119010 a owl:Class ;
    rdfs:label "Peritumoral" ;
    rdfs:subClassOf mc2:BiospecimenTumorStatusEnum ;
    skos:definition "Located in tissues surrounding a tumor." .

NCIT:C12482 a owl:Class ;
    rdfs:label "Fibroblasts from Bone Marrow Normal" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "Fibroblast cells isolated from a normal (non-malignant) bone marrow specimen." .

NCIT:C12530 a owl:Class ;
    rdfs:label "Granulocytes" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A type of leukocyte with a multilobed nucleus and cytoplasmic granules, subdivided into eosinophils, basophils, and neutrophils based on the staining properties of their granules." .

NCIT:C127533 a owl:Class ;
    rdfs:label "Primary Contact" ;
    rdfs:subClassOf mc2:ToolEntityRoleEnum .

NCIT:C12801 a owl:Class ;
    rdfs:label "Tissue" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "An anatomical structure consisting of similarly specialized cells and intercellular matrix, aggregated according to genetically determined spatial relationships, that performs a specific function." .

NCIT:C128639 a owl:Class ;
    rdfs:label "Analyte" ;
    rdfs:subClassOf mc2:BiospecimenTypeCategoryEnum ;
    skos:definition "The sample or material being subjected to analysis." .

NCIT:C130177 a owl:Class ;
    rdfs:label "Targeted-Capture" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "A technique that determines the nucleotide sequence of a pre-specified region of DNA or RNA by using primers that are specific for that region." .

NCIT:C13197 a owl:Class ;
    rdfs:label "Nucleus" ;
    rdfs:subClassOf mc2:ImageObjectClassEnum ;
    skos:definition "A body within the cell, surrounded by a membrane, within which lie the chromosomes, one or more nucleoli, combined with proteins, and exhibits mitosis." .

NCIT:C132010 a owl:Class ;
    rdfs:label "T5" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "An antiquated primary tumor finding term that refers to colorectal cancer which has spread by direct extension beyond the immediately adjacent organs or tissues (AJCC 1st Ed.)." .

NCIT:C13226 a owl:Class ;
    rdfs:label "Cytoplasm" ;
    rdfs:subClassOf mc2:ImageObjectClassEnum ;
    skos:definition "The protoplasm of a cell outside the nucleus, bounded by the plasma membrane and containing all of the cell's organelles except the nucleus." .

NCIT:C13275 a owl:Class ;
    rdfs:label "Saliva" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "The watery fluid in the mouth produced by the salivary glands that moistens food to aid digestion and helps protect the mouth against infection." .

NCIT:C135727 a owl:Class ;
    rdfs:label "Blood Derived Liquid Biopsy" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A blood-based liquid biopsy specimen used to sample circulating tumor cells, cell-free nucleic acids, or other tumor-derived material without a solid tissue biopsy." .

NCIT:C13735 a owl:Class ;
    rdfs:label "Plasma Membrane" ;
    rdfs:subClassOf mc2:ImageObjectClassEnum ;
    skos:definition "The semipermeable membrane that encloses the cytoplasm of a cell." .

NCIT:C139414 a owl:Class ;
    rdfs:label "Tis (DCIS)" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "Breast cancer with a finding of ductal carcinoma in situ." .

NCIT:C139415 a owl:Class ;
    rdfs:label "Tis (Paget's)" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "Paget disease of the nipple not associated with invasive carcinoma and/or carcinoma in situ in the underlying breast parenchyma." .

NCIT:C14174 a owl:Class ;
    rdfs:label "Metastatic" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A term referring to the clinical or pathologic observation of a tumor extension from its original site of growth to another anatomic site." .

NCIT:C142380 a owl:Class ;
    rdfs:label "HTML" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "HTML (Hypertext Markup Language) is a standard markup language used to structure and display content on web pages, as specified by the World Wide Web Consortium (W3C)." .

NCIT:C147937 a owl:Class ;
    rdfs:label "Preschool" ;
    rdfs:subClassOf mc2:ResourceEducationalLevelEnum ;
    skos:definition "An educational institution for children that precedes kindergarten." .

NCIT:C148411 a owl:Class ;
    rdfs:label "T2d" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A TNM stage finding term for ophthalmic sites melanoma staging, indicating tumor size category 2 with specific extension or caruncular criteria." .

NCIT:C148412 a owl:Class ;
    rdfs:label "T3d" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A TNM finding term for melanoma or retinoblastoma staging, indicating tumor size category 3 with ciliary body involvement, specific conjunctival extension, or scleral invasion criteria." .

NCIT:C150423 a owl:Class ;
    rdfs:label "Paired-end" ;
    rdfs:subClassOf mc2:NGSLibraryLayoutEnum ;
    skos:definition "A DNA sequencing strategy where a single read is initiated from each end of a DNA fragment." .

NCIT:C15189 a owl:Class ;
    rdfs:label "Biopsy" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "The removal of tissue specimens or fluid from the living body for microscopic examination, performed to establish a diagnosis." .

NCIT:C15275 a owl:Class ;
    rdfs:label "Lymphadenectomy (regional nodes)" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "Surgical removal of lymph nodes, usually done to assess the spread of cancer." .

NCIT:C153194 a owl:Class ;
    rdfs:label "Transcriptome" ;
    rdfs:subClassOf mc2:NGSLibrarySourceMoleculeEnum ;
    skos:definition "The complete set of RNA transcripts that are produced by the genome, under specific circumstances or in a specific cell." .

NCIT:C15361 a owl:Class ;
    rdfs:label "Fine needle aspirate" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "The removal of tissue or fluid with a thin needle for examination under a microscope." .

NCIT:C15385 a owl:Class ;
    rdfs:label "Excisional Biopsy" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "A surgical procedure in which an entire lesion is removed for microscopic examination." .

NCIT:C15386 a owl:Class ;
    rdfs:label "Incisional Biopsy" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "A surgical procedure in which part of a lesion is removed for microscopic examination." .

NCIT:C15387 a owl:Class ;
    rdfs:label "Shave biopsy" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "Removal skin tissue, for microscopic examination, using a blade oriented in the horizontal plane of the skin surface." .

NCIT:C156437 a owl:Class ;
    rdfs:label "Repli-G (Qiagen) DNA" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A genomic DNA specimen that has been amplified from a limited-quantity sample using the REPLI-g (Qiagen) whole genome amplification technology." .

NCIT:C156439 a owl:Class ;
    rdfs:label "Repli-G X (Qiagen) DNA" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A genomic DNA specimen amplified from an ultra-low-input sample using the REPLI-g X (Qiagen) whole genome amplification kit, designed for single-cell or trace-quantity starting material." .

NCIT:C156440 a owl:Class ;
    rdfs:label "Additional Metastatic" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A biospecimen derived from an additional metastatic tumor site, collected separately from the first-sampled metastatic lesion." .

NCIT:C156441 a owl:Class ;
    rdfs:label "Additional - New Primary" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A biospecimen collected from a new primary malignancy that arose in a patient in addition to a previously diagnosed primary tumor." .

NCIT:C156442 a owl:Class ;
    rdfs:label "Control Analyte" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A biospecimen or analyte that is used as a comparator or reference against an experimental sample." .

NCIT:C15667 a owl:Class ;
    rdfs:label "Sentinel node biopsy" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "Surgical removal and examination of the sentinel node, the lymph node which is first in receiving the lymphatic drainage of a specified anatomic location and is most likely to be affected by the lymphatic spread of cancer." .

NCIT:C15680 a owl:Class ;
    rdfs:label "Core needle biopsy" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "The removal of a tissue sample using a needle with a relatively large diameter, for microscopic examination." .

NCIT:C158417 a owl:Class ;
    rdfs:label "Frozen" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMethodEnum ;
    skos:definition "A tissue sample that has been frozen prior to analysis." .

NCIT:C158758 a owl:Class ;
    rdfs:label "Surgical Resection" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "The surgical removal of all or part of an organ or tissue structure that may include a lesion." .

NCIT:C159203 a owl:Class ;
    rdfs:label "Ascites" ;
    rdfs:subClassOf mc2:BiospecimenTypeCategoryEnum ;
    skos:definition "A biospecimen of ascitic fluid." .

NCIT:C16345 a owl:Class ;
    rdfs:label "Biology" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The scientific study of living organisms, including their structure, function, growth, evolution, and interactions with their environment." .

NCIT:C163987 a owl:Class ;
    rdfs:label "Affinity Enrichment" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "A library selection method that enriches for specific nucleic acid or protein targets through binding to an antibody, protein, or other affinity reagent prior to sequencing or analysis." .

NCIT:C163991 a owl:Class ;
    rdfs:label "miRNA Size Fractionation" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "A library selection method that isolates small RNA species, such as microRNAs, from a nucleic acid sample based on their characteristically small size, typically using gel- or column-based size-exclusion techniques." .

NCIT:C163993 a owl:Class ;
    rdfs:label "EBV Immortalized Normal" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A biospecimen consisting of normal lymphocytes that have been infected in vitro with Epstein-Barr virus (EBV) and cultured to establish an indefinitely proliferating cell line." .

NCIT:C163995 a owl:Class ;
    rdfs:label "Total RNA" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A biological sample comprised of all of the RNA collected from an experimental subject." .

NCIT:C164011 a owl:Class ;
    rdfs:label "Mononuclear Cells from Bone Marrow Normal" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A biological sample containing mononuclear cells isolated from a normal (non-malignant) bone marrow specimen." .

NCIT:C164014 a owl:Class ;
    rdfs:label "Solid Tissue Normal" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A specimen of morphologically normal solid tissue collected from a subject, typically used as a matched normal control for a tumor specimen." .

NCIT:C16403 a owl:Class ;
    rdfs:label "Cell Lines" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A permanently established cell culture that will proliferate indefinitely given appropriate fresh medium and growth space." .

NCIT:C164032 a owl:Class ;
    rdfs:label "Normal adjacent" ;
    rdfs:subClassOf mc2:BiospecimenCompositionEnum ;
    skos:definition "A specimen comprised of morphologically normal tissue collected from the area immediately surrounding a tumor in an experimental subject." .

NCIT:C164033 a owl:Class ;
    rdfs:label "Tumor Adjacent Normal - Post Neo-adjuvant Therapy" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A specimen of morphologically normal tissue collected from the area immediately surrounding a tumor, obtained from a subject after treatment with a neoadjuvant therapeutic." .

NCIT:C16414 a owl:Class ;
    rdfs:label "Chemistry" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The scientific study of the composition, structure, properties, and reactions of matter, especially atomic and molecular systems." .

NCIT:C164339 a owl:Class ;
    rdfs:label "Diagnosis Date" ;
    rdfs:subClassOf mc2:StudyIndexDateEnum ;
    skos:definition "The date on which a diagnosis of disease was made." .

NCIT:C16523 a owl:Class ;
    rdfs:label "Drug Resistance/Sensitivity" ;
    rdfs:subClassOf mc2:GrantThemeNameEnum .

NCIT:C16526 a owl:Class ;
    rdfs:label "Ecology" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The branch of biology concerned with the relationships between organisms and their environment." .

NCIT:C165444 a owl:Class ;
    rdfs:label "Single-indexed" ;
    rdfs:subClassOf mc2:NGSLibraryLayoutEnum ;
    skos:definition "An indexed sequencing method that includes one index read." .

NCIT:C16624 a owl:Class ;
    rdfs:label "Genetics" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The branch of biology that deals with heredity, especially the mechanisms of hereditary transmission and the variation of inherited characteristics among similar or related organisms." .

NCIT:C16989 a owl:Class ;
    rdfs:label "Physics" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The scientific study of matter, energy, and the fundamental forces and laws governing their interactions and behavior in nature." .

NCIT:C172264 a owl:Class ;
    rdfs:label "Buccal Cell Normal" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A sample of normal (non-tumor) cells collected by scraping or swabbing the inside of a subject's cheek, commonly used as a source of germline DNA." .

NCIT:C172265 a owl:Class ;
    rdfs:label "Formalin fixed paraffin embedded - FFPE" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMethodEnum ;
    skos:definition "A tissue sample that has been fixed with formalin and embedded in paraffin for long-term preservation and histological analysis." .

NCIT:C172267 a owl:Class ;
    rdfs:label "FFPE Recurrent" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A formalin-fixed, paraffin-embedded tissue sample derived from tissue isolated from a subject with recurrent disease." .

NCIT:C172268 a owl:Class ;
    rdfs:label "FFPE Scrolls" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A formalin-fixed, paraffin-embedded tissue sample that has been cut on a microtome into a thin section that rolls up on itself, forming a scroll." .

NCIT:C172293 a owl:Class ;
    rdfs:label "Human Tumor Original Cells" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A sample comprised of cells that were isolated from a human tumor and have not been cultured or expanded." .

NCIT:C172295 a owl:Class ;
    rdfs:label "Next Generation Cancer Model" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "An approach to cancer modeling that utilizes clinical data as well as the genomic and transcriptomic profiles of the parent tumor, metastases, if present, and case-matched normal tissues from individual patients." .

NCIT:C172301 a owl:Class ;
    rdfs:label "R1" ;
    rdfs:subClassOf mc2:NGSReadIndicatorEnum ;
    skos:definition "The read direction identified as number 1 in a paired-end nucleotide sequencing reaction." .

NCIT:C172302 a owl:Class ;
    rdfs:label "R2" ;
    rdfs:subClassOf mc2:NGSReadIndicatorEnum ;
    skos:definition "The read direction identified as number 2 in a paired-end nucleotide sequencing reaction." .

NCIT:C172305 a owl:Class ;
    rdfs:label "Web Application" ;
    rdfs:subClassOf mc2:ToolTypeEnum .

NCIT:C172858 a owl:Class ;
    rdfs:label "ncRNA-Seq" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Capture of other non-coding RNA types, including post-translation modification types such as snRNA (small nuclear RNA) or snoRNA (small nucleolar RNA), or expression regulation types such as siRNA (small interfering RNA) or piRNA/piwi/RNA (piwi-interacting RNA)." .

NCIT:C172859 a owl:Class ;
    rdfs:label "ssRNA-seq" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "strand-specific RNA sequencing" .

NCIT:C174118 a owl:Class ;
    rdfs:label "Mixed Adherent Suspension" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A sample comprised of a mixture of cells or clumps of cells, which may have been isolated from normal or tumor tissue, that are maintained together in a suspension culture." .

NCIT:C177206 a owl:Class ;
    rdfs:label "Forceps Biopsy" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "The removal of a tissue sample using a specially-designed endoscope consisting of a slender flexible forceps with movable cup-shaped jaws." .

NCIT:C178223 a owl:Class ;
    rdfs:label "Bulk Cells" ;
    rdfs:subClassOf mc2:NGSLibrarySourceMaterialEnum ;
    skos:definition "A biospecimen consisting of multiple cells intended to be analyzed as a pool." .

NCIT:C178224 a owl:Class ;
    rdfs:label "Bulk Nuclei" ;
    rdfs:subClassOf mc2:NGSLibrarySourceMaterialEnum ;
    skos:definition "A biospecimen consisting of multiple nuclei intended to be analyzed as a pool." .

NCIT:C178225 a owl:Class ;
    rdfs:label "Bulk Tissue" ;
    rdfs:subClassOf mc2:NGSLibrarySourceMaterialEnum ;
    skos:definition "A biospecimen either derived from a whole tissue specimen or tissue section, which may consist of heterogeneous cells or tissues." .

NCIT:C178226 a owl:Class ;
    rdfs:label "Single-cells" ;
    rdfs:subClassOf mc2:NGSLibrarySourceMaterialEnum ;
    skos:definition "A biospecimen that contains the contents of a single cell." .

NCIT:C178227 a owl:Class ;
    rdfs:label "Single-nuclei" ;
    rdfs:subClassOf mc2:NGSLibrarySourceMaterialEnum ;
    skos:definition "A biospecimen that contains the contents of a single nucleus." .

NCIT:C178534 a owl:Class ;
    rdfs:label "Carnoy's Solution" ;
    rdfs:subClassOf mc2:BiospecimenFixativeEnum ;
    skos:definition "A denaturing fixative consisting of ethanol, chloroform and glacial acetic acid in a 6:3:1 ratio, particularly effective for the preservation of nuclei and in retaining glycogen." .

NCIT:C178536 a owl:Class ;
    rdfs:label "Poloxamer" ;
    rdfs:subClassOf mc2:BiospecimenFixativeEnum ;
    skos:definition "A class of nonionic triblock copolymers composed of a hydrophobic polypropylene oxide chain flanked by two hydrophilic polyethylene oxide chains, used in some tissue preservation and cell membrane stabilization applications." .

NCIT:C178539 a owl:Class ;
    rdfs:label "CryoStor" ;
    rdfs:subClassOf mc2:BiospecimenFixativeEnum ;
    skos:definition "A serum- and protein-free cryopreservation medium for biological specimens that minimizes cellular damage following freezing and thawing." .

NCIT:C178572 a owl:Class ;
    rdfs:label "TCL Lysis Buffer" ;
    rdfs:subClassOf mc2:BiospecimenFixativeEnum ;
    skos:definition "A proprietary buffer containing RNase inhibitors designed for cell lysis and the extraction and collection of mRNA from cell samples." .

NCIT:C178573 a owl:Class ;
    rdfs:label "NP40 Lysis Buffer" ;
    rdfs:subClassOf mc2:BiospecimenFixativeEnum ;
    skos:definition "A detergent-based cell lysis buffer suitable for total protein extraction that helps retain the protein structure and function for enzyme assays or immunoassays." .

NCIT:C178955 a owl:Class ;
    rdfs:label "Negative 80 Deg C" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMethodEnum ;
    skos:definition "An indication that a specimen has been stored at a temperature of negative 80 degrees Celsius." .

NCIT:C18009 a owl:Class ;
    rdfs:label "Tumor" ;
    rdfs:subClassOf mc2:BiospecimenTumorStatusEnum ;
    skos:definition "Tissue sample that contains an abnormal cellular infiltrate forming a solid mass." .

NCIT:C180697 a owl:Class ;
    rdfs:label "CAGE" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Cap-analysis gene expression" .

NCIT:C180698 a owl:Class ;
    rdfs:label "RACE" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Rapid Amplification of cDNA Ends" .

NCIT:C18141 a owl:Class ;
    rdfs:label "Computer Science" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The study of the structure, theory, and application of computational systems, algorithms, and information processing using mathematical, logical, and empirical methods." .

NCIT:C18155 a owl:Class ;
    rdfs:label "EST" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Single pass sequencing of cDNA templates" .

NCIT:C181933 a owl:Class ;
    rdfs:label "GeoMX-DSP" ;
    rdfs:subClassOf mc2:ImageAssayTypeEnum ;
    skos:definition "GeoMx Digital Spatial Profiler (DSP): a method to profile RNA or protein from tissue sections that combines spatial and molecular profiling by generating a whole-tissue image at single-cell resolution alongside digital profiling data from photocleavable-oligonucleotide-barcoded probes imaged from selected regions of interest." .

NCIT:C18246 a owl:Class ;
    rdfs:label "Remission" ;
    rdfs:subClassOf mc2:BiospecimenIncidenceTypeEnum ;
    skos:definition "A state in which the signs and symptoms of a disease are reduced or absent." .

NCIT:C184757 a owl:Class ;
    rdfs:label "Expanded Next Generation Cancer Model" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A next generation cancer model that has been expanded using tissue culture or other propagation methods." .

NCIT:C184781 a owl:Class ;
    rdfs:label "Next Generation Cancer Model Expanded Under Non-conforming Conditions" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A next generation cancer model that has been expanded using unconventional or non-standard culturing methods." .

NCIT:C185110 a owl:Class ;
    rdfs:label "95% Ethanol" ;
    rdfs:subClassOf mc2:BiospecimenFixativeEnum ;
    skos:definition "An aqueous dilution of ethanol containing 95% ethanol by volume, which may be used as a solvent, disinfectant or fixative." .

NCIT:C185111 a owl:Class ;
    rdfs:label "Carbodiimide" ;
    rdfs:subClassOf mc2:BiospecimenFixativeEnum ;
    skos:definition "A group of reagents that crosslinks amines and carboxylates, used as a fixative and in peptide conjugation." .

NCIT:C185112 a owl:Class ;
    rdfs:label "Diimidoester" ;
    rdfs:subClassOf mc2:BiospecimenFixativeEnum ;
    skos:definition "A group of reagents that reacts with the epsilon-amino group of lysine and forms intermolecular cross-links within proteins. These agents may be used as tissue fixatives for electron microscopy and immunohistochemistry." .

NCIT:C185113 a owl:Class ;
    rdfs:label "PAXgene Tissue" ;
    rdfs:subClassOf mc2:BiospecimenFixativeEnum ;
    skos:definition "A proprietary system comprised of a formalin-free tissue fixative and stabilizing reagent designed to preserve tissue structures without damaging biomolecules." .

NCIT:C185118 a owl:Class ;
    rdfs:label "Captions" ;
    rdfs:subClassOf mc2:ResourceMediaAccessibilityEnum ;
    skos:definition "A synchronized, on-screen text display of spoken dialogue and other audio content within a video, providing an optional transcript of the audio for viewers who are deaf or hard of hearing." .

NCIT:C185193 a owl:Class ;
    rdfs:label "Not recorded" ;
    rdfs:subClassOf mc2:BiospecimenFixativeEnum ;
    skos:definition "The information was not captured or stored." .

NCIT:C185338 a owl:Class ;
    rdfs:label "Liquid Nitrogen" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMethodEnum ;
    skos:definition "An indication that a material has been stored in liquid nitrogen." .

NCIT:C185402 a owl:Class ;
    rdfs:label "Formalin fixed-unbuffered" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMethodEnum ;
    skos:definition "The use of unbuffered formalin for preservation of tissue samples." .

NCIT:C185403 a owl:Class ;
    rdfs:label "Formalin fixed-buffered" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMethodEnum ;
    skos:definition "The use of buffered formalin for preservation of tissue samples." .

NCIT:C185404 a owl:Class ;
    rdfs:label "Fresh dissociated" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMethodEnum ;
    skos:definition "A tissue preparation process that takes fresh tissue and dissociates it into single cell suspensions." .

NCIT:C185405 a owl:Class ;
    rdfs:label "Fresh dissociated and single cell sorted" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMethodEnum ;
    skos:definition "A tissue preparation process that separates fresh dissociated tissue cells into cell populations by single cell sorting." .

NCIT:C188292 a owl:Class ;
    rdfs:label "T1a1" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of a primary tumor limited to the site of growth; the specific definition of T1a1 depends on the type of cancer." .

NCIT:C188293 a owl:Class ;
    rdfs:label "T1a2" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of a primary tumor limited to the site of growth; the specific definition of T1a2 depends on the type of cancer." .

NCIT:C188294 a owl:Class ;
    rdfs:label "T1b1" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of a primary tumor limited to the site of growth; the specific definition of T1b1 depends on the type of cancer." .

NCIT:C188295 a owl:Class ;
    rdfs:label "T1b2" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of a primary tumor limited to the site of growth; the specific definition of T1b2 depends on the type of cancer." .

NCIT:C188296 a owl:Class ;
    rdfs:label "T2a1" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of a primary tumor; the specific definition of T2a1 depends on the type of cancer." .

NCIT:C188297 a owl:Class ;
    rdfs:label "T2a2" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of a primary tumor; the specific definition of T2a2 depends on the type of cancer." .

NCIT:C188298 a owl:Class ;
    rdfs:label "T4e" ;
    rdfs:subClassOf mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "A general term that refers to a TNM finding of a primary tumor with direct invasion of adjacent structures; the specific definition of T4e depends on the type of cancer." .

NCIT:C189124 a owl:Class ;
    rdfs:label "Sputum" ;
    rdfs:subClassOf mc2:BiospecimenTypeCategoryEnum ;
    skos:definition "A respiratory biospecimen obtained via expectoration." .

NCIT:C189126 a owl:Class ;
    rdfs:label "Urine" ;
    rdfs:subClassOf mc2:BiospecimenTypeCategoryEnum ;
    skos:definition "A biospecimen obtained from urine." .

NCIT:C190168 a owl:Class ;
    rdfs:label "Binaries" ;
    rdfs:subClassOf mc2:ToolDownloadTypeEnum ;
    skos:definition "Binaries for the software; compiled code that allow a program to be installed without having to compile the source code." .

NCIT:C192998 a owl:Class ;
    rdfs:label "Cells" ;
    rdfs:subClassOf mc2:BiospecimenTypeCategoryEnum ;
    skos:definition "A biospecimen comprised of purified or partially-purified cells." .

NCIT:C19597 a owl:Class ;
    rdfs:label "Methacarn fixed paraffin embedded - MFPE" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMethodEnum ;
    skos:definition "A tissue sample that has been fixed with Methacarn and embedded in paraffin for long-term preservation and histological analysis." .

NCIT:C198496 a owl:Class ;
    rdfs:label "snATAC-Seq" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "A molecular genetic technique where DNA is harvested from a single cell nucleus and subjected to ATAC-seq to isolate and sequence regions rich in open chromatin." .

NCIT:C198568 a owl:Class ;
    rdfs:label "RNA" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A biospecimen created to contain an isolated or enriched ribonucleic acid (RNA) sample." .

NCIT:C198569 a owl:Class ;
    rdfs:label "GenomePlex (Rubicon) Amplified DNA" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A DNA specimen that has been amplified using the GenomePlex (Rubicon Genomics) whole genome amplification method." .

NCIT:C198712 a owl:Class ;
    rdfs:label "Mouth Rinse" ;
    rdfs:subClassOf mc2:BiospecimenTypeCategoryEnum ;
    skos:definition "A sample consisting of biological material from the buccal cavity, collected by introducing a solution into the mouth, swishing, and collecting the rinse." .

NCIT:C19975 a owl:Class ;
    rdfs:label "Research Consortium" ;
    rdfs:subClassOf mc2:ToolEntityTypeEnum .

NCIT:C201530 a owl:Class ;
    rdfs:label "Mask" ;
    rdfs:subClassOf mc2:ImageSegmentationDataTypeEnum ;
    skos:definition "A segmentation output represented as a binary or labeled raster image in which pixels belonging to a segmented object (e.g., a cell or nucleus) are assigned a non-zero/class value and background pixels are assigned zero." .

NCIT:C201925 a owl:Class ;
    rdfs:label "Metagenomic" ;
    rdfs:subClassOf mc2:NGSLibrarySourceMoleculeEnum ;
    skos:definition "Derived from or associated with material collected from an environmental sample." .

NCIT:C201926 a owl:Class ;
    rdfs:label "Metatranscriptomic" ;
    rdfs:subClassOf mc2:NGSLibrarySourceMoleculeEnum ;
    skos:definition "Derived from or associated with transcripts from an environmental sample." .

NCIT:C202255 a owl:Class ;
    rdfs:label "Feature barcoding" ;
    rdfs:subClassOf mc2:NGSRNAReverseTranscriptionPrimerEnum ;
    skos:definition "A technology platform that uses oligonucleotide barcodes to simultaneously measure gene expression and other cellular features (surface proteins, T/B cell receptors, CRISPR perturbations) at single-cell resolution." .

NCIT:C202270 a owl:Class ;
    rdfs:label "3 Prime" ;
    rdfs:subClassOf mc2:NGSRNAEndBiasEnum ;
    skos:definition "An artifact of cDNA amplification and cloning where the 3' end of transcripts is over-represented in the final sample or library." .

NCIT:C202271 a owl:Class ;
    rdfs:label "5 Prime" ;
    rdfs:subClassOf mc2:NGSRNAEndBiasEnum ;
    skos:definition "An artifact of cDNA amplification and cloning where the 5' end of transcripts is over-represented in the final sample or library." .

NCIT:C202272 a owl:Class ;
    rdfs:label "Full Length Transcript" ;
    rdfs:subClassOf mc2:NGSRNAEndBiasEnum ;
    skos:definition "A cDNA molecule that spans the entire length of an RNA transcript, from its 5' end to its 3' end." .

NCIT:C204466 a owl:Class ;
    rdfs:label "Fluids" ;
    rdfs:subClassOf mc2:BiospecimenTypeCategoryEnum ;
    skos:definition "A biospecimen that consists of a body fluid." .

NCIT:C204811 a owl:Class ;
    rdfs:label "Viral RNA" ;
    rdfs:subClassOf mc2:NGSLibrarySourceMoleculeEnum ;
    skos:definition "The RNA that originates from a virus." .

NCIT:C204813 a owl:Class ;
    rdfs:label "AMPLICON" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Sequencing of overlapping or distinct PCR or RT-PCR products" .

NCIT:C204814 a owl:Class ;
    rdfs:label "CLONE" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Genomic clone based (hierarchical) sequencing" .

NCIT:C204815 a owl:Class ;
    rdfs:label "CLONEEND" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Clone end (5', 3', or both) sequencing" .

NCIT:C204816 a owl:Class ;
    rdfs:label "CTS" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Concatenated Tag Sequencing" .

NCIT:C204817 a owl:Class ;
    rdfs:label "FL-cDNA" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Full-length sequencing of cDNA templates" .

NCIT:C204818 a owl:Class ;
    rdfs:label "FINISHING" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Sequencing intended to finish (close) gaps in existing coverage" .

NCIT:C204819 a owl:Class ;
    rdfs:label "Hi-C" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Chromosome Conformation Capture technique where a biotin-labeled nucleotide is incorporated at the ligation junction, enabling selective purification of chimeric DNA ligation junctions followed by deep sequencing" .

NCIT:C204820 a owl:Class ;
    rdfs:label "MBD-Seq" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Direct sequencing of methylated fractions sequencing strategy" .

NCIT:C204822 a owl:Class ;
    rdfs:label "MRE-Seq" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Methylation-Sensitive Restriction Enzyme Sequencing strategy" .

NCIT:C204823 a owl:Class ;
    rdfs:label "POOLCLONE" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Shotgun of pooled clones (usually BACs and Fosmids)" .

NCIT:C204824 a owl:Class ;
    rdfs:label "RAD-Seq" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "A type of genome-wide sampling sequencing that reduces the complexity of the genome by subsampling only at specific sites defined by restriction enzymes." .

NCIT:C204825 a owl:Class ;
    rdfs:label "RIP-Seq" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Direct sequencing of RNA immunoprecipitates (includes CLIP-Seq, HITS-CLIP and PAR-CLIP)." .

NCIT:C204826 a owl:Class ;
    rdfs:label "SELEX" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Systematic Evolution of Ligands by EXponential enrichment" .

NCIT:C204827 a owl:Class ;
    rdfs:label "Synthetic-Long-Read" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "A sequencing strategy that uses specialized sample processing combined with conventional short-read sequencing to computationally reconstruct long sequencing reads." .

NCIT:C204829 a owl:Class ;
    rdfs:label "Tethered Chromatin Conformation Capture" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "A method for genome-wide mapping of chromatin interactions, similar to Hi-C sequencing except that the ligations are performed on a solid substrate rather than in solution, enhancing the signal-to-noise ratio." .

NCIT:C204830 a owl:Class ;
    rdfs:label "Tn-Seq" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Sequencing from transposon insertion sites" .

NCIT:C204831 a owl:Class ;
    rdfs:label "WCS" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "Random sequencing of a whole chromosome or other replicon isolated from a genome" .

NCIT:C205121 a owl:Class ;
    rdfs:label "Spatial-tx" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "A method that measures and maps gene expression in a biological sample while preserving the spatial context of the cells." .

NCIT:C205123 a owl:Class ;
    rdfs:label "scMultiome" ;
    rdfs:subClassOf mc2:NGSLibraryStrategyEnum ;
    skos:definition "A sequencing strategy that simultaneously profiles two or more molecular modalities, such as the transcriptome and chromatin accessibility, from the same individual cell to capture a more complete picture of cellular state." .

NCIT:C210697 a owl:Class ;
    rdfs:label "MERFISH" ;
    rdfs:subClassOf mc2:ImageAssayTypeEnum ;
    skos:definition "Multiplexed Error-Robust Fluorescence In Situ Hybridization (MERFISH): an image-based approach to single-cell transcriptomics in which RNAs are identified via a combinatorial labeling approach that encodes RNA species with error-robust barcodes, followed by sequential rounds of single-molecule FISH to read out the barcodes." .

NCIT:C210700 a owl:Class ;
    rdfs:label "CyCIF" ;
    rdfs:subClassOf mc2:ImageAssayTypeEnum ;
    skos:definition "Cyclic Immunofluorescence (CyCIF): a method for highly multiplexed immunofluorescent imaging of cells using an iterative, cycling process in which images of expressed fluorescently-tagged proteins, fluorescent dyes, or fluorescently-tagged antibodies are serially collected from the same sample and assembled into a high-dimensional representation of the spatial relationships between targets of interest." .

NCIT:C215818 a owl:Class ;
    rdfs:label "Complete Genomics" ;
    rdfs:subClassOf mc2:NGSSequencingPlatformEnum ;
    skos:definition "A life sciences subsidiary of a Chinese biotechnology company that has developed and commercialized a DNA sequencing platform for human genome sequencing and analysis." .

NCIT:C2190 a owl:Class ;
    rdfs:label "Alcohol" ;
    rdfs:subClassOf mc2:BiospecimenFixativeEnum ;
    skos:definition "A volatile liquid that kills organisms by denaturing their proteins; used as a disinfectant and tissue fixative." .

NCIT:C222473 a owl:Class ;
    rdfs:label "Enrollment Date" ;
    rdfs:subClassOf mc2:StudyIndexDateEnum ;
    skos:definition "The date a subject is formally enrolled in a study." .

NCIT:C25153 a owl:Class ;
    rdfs:label "Autopsy" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "A postmortem examination of the body that includes an examination of the internal organs and structures after dissection to determine the cause of death and the nature of pathological changes." .

NCIT:C25190 a owl:Class ;
    rdfs:label "Person" ;
    rdfs:subClassOf mc2:ToolEntityTypeEnum .

NCIT:C25213 a owl:Class ;
    rdfs:label "Baseline" ;
    rdfs:subClassOf mc2:FileLongitudinalEventTypeEnum ;
    skos:definition "A starting point to which things may be compared." .

NCIT:C25217 a owl:Class ;
    rdfs:label "Assessment" ;
    rdfs:subClassOf mc2:ResourceIntendedUseEnum ;
    skos:definition "The process of evaluating or measuring the value, significance, or extent of a learner's knowledge, skills, or performance." .

NCIT:C25251 a owl:Class ;
    rdfs:label "Primary" ;
    rdfs:subClassOf mc2:BiospecimenIncidenceTypeEnum ;
    skos:definition "Occurring first in time or sequence; original; of greatest rank or importance or value." .

NCIT:C28007 a owl:Class ;
    rdfs:label "Median" ;
    rdfs:subClassOf mc2:ImageSummaryStatisticEnum ;
    skos:definition "The value which has an equal number of values greater and less than it." .

NCIT:C28221 a owl:Class ;
    rdfs:label "Blood draw" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "The collection of blood from a vein, most commonly via needle venipuncture." .

NCIT:C28294 a owl:Class ;
    rdfs:label "Nutrition" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The processes by which an organism consumes and utilizes food, water, and other nourishment necessary to sustain its life processes." .

NCIT:C28554 a owl:Class ;
    rdfs:label "Dead" ;
    rdfs:subClassOf mc2:IndividualVitalStatusEnum ;
    skos:definition "The cessation of life." .

NCIT:C28743 a owl:Class ;
    rdfs:label "Punch biopsy" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "Removal of a disk of skin tissue, for microscopic examination, using a punch." .

NCIT:C29274 a owl:Class ;
    rdfs:label "Dimethylacetamide" ;
    rdfs:subClassOf mc2:BiospecimenFixativeEnum ;
    skos:definition "A dipolar aprotic solvent and reagent used in the production of fibers and pharmaceuticals, and as a non-aldehyde fixative." .

NCIT:C29744 a owl:Class ;
    rdfs:label "Formalin" ;
    rdfs:subClassOf mc2:BiospecimenFixativeEnum ;
    skos:definition "A colorless gas readily soluble in water; formalin (10% formaldehyde solution) is widely used as a tissue fixative and preservative." .

NCIT:C29807 a owl:Class ;
    rdfs:label "Acetone" ;
    rdfs:subClassOf mc2:BiospecimenFixativeEnum ;
    skos:definition "A colorless, volatile, flammable organic solvent used as a fixative and dehydration agent for biological tissues." .

NCIT:C3331 a owl:Class ;
    rdfs:label "Pleural Effusion" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "Increased amounts of fluid within the pleural cavity, usually caused by lung infections, congestive heart failure, pleural or lung tumors, connective tissue disorders, or trauma." .

NCIT:C36118 a owl:Class ;
    rdfs:label "In Situ Neoplasms" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "Neoplasms confined to the site of origin without invasion beyond the basement membrane or into surrounding tissue, such as carcinoma in situ." .

NCIT:C37948 a owl:Class ;
    rdfs:label "Enrollment" ;
    rdfs:subClassOf mc2:FileLongitudinalEventTypeEnum ;
    skos:definition "The act of registration, entering in a list, catalog, group, study; also, the number of subjects enrolled." .

NCIT:C37987 a owl:Class ;
    rdfs:label "Alive" ;
    rdfs:subClassOf mc2:IndividualVitalStatusEnum ;
    skos:definition "Showing characteristics of life; displaying signs of life." .

NCIT:C39409 a owl:Class ;
    rdfs:label "Funding Agency" ;
    rdfs:subClassOf mc2:ToolEntityTypeEnum .

NCIT:C41067 a owl:Class ;
    rdfs:label "Whole Blood" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "Blood that has not been separated into its various components, other than the addition of an anticoagulant." .

NCIT:C42709 a owl:Class ;
    rdfs:label "Parent" ;
    rdfs:subClassOf mc2:ResourcePrimaryAudienceEnum ;
    skos:definition "A mother or a father; an immediate progenitor." .

NCIT:C42753 a owl:Class ;
    rdfs:label "Workflow" ;
    rdfs:subClassOf mc2:ToolTypeEnum ;
    skos:definition "A set of tools which have been composed together into a pipeline of some sort. Such tools are (typically) standalone, but are composed for convenience, for instance for batch execution via some workflow engine or script." .

NCIT:C449 a owl:Class ;
    rdfs:label "DNA" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A long, linear, double-stranded polymer of nucleotides attached to a deoxyribose backbone that carries an organism's genetic information; used here to denote a specimen consisting of extracted DNA." .

NCIT:C45412 a owl:Class ;
    rdfs:label "Web Service" ;
    rdfs:subClassOf mc2:ToolTypeEnum .

NCIT:C47615 a owl:Class ;
    rdfs:label "Methacrylate" ;
    rdfs:subClassOf mc2:BiospecimenEmbeddingMediumEnum ;
    skos:definition "A methyl ester of methacrylic acid; a reactive resin used as cement in dentistry, orthopaedic surgery, and ophthalmology, and as a hard plastic embedding medium for electron microscopy." .

NCIT:C47824 a owl:Class ;
    rdfs:label "Data Set" ;
    rdfs:subClassOf mc2:ResourceActivityTypeEnum ;
    skos:definition "A structured collection of related data records provided as an educational resource for analysis, exploration, or hands-on learning exercises." .

NCIT:C47885 a owl:Class ;
    rdfs:label "Project" ;
    rdfs:subClassOf mc2:ToolEntityTypeEnum .

NCIT:C47901 a owl:Class ;
    rdfs:label "Source Code" ;
    rdfs:subClassOf mc2:ToolDownloadTypeEnum .

NCIT:C48600 a owl:Class ;
    rdfs:label "Re-excision" ;
    rdfs:subClassOf mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "A surgical procedure to remove the remaining abnormal tissues from the body, not completely removed in an earlier attempt." .

NCIT:C48699 a owl:Class ;
    rdfs:label "M0" ;
    rdfs:subClassOf mc2:IndividualMetastasisStageEnum ;
    skos:definition "No distant metastasis (cancer has not spread to other parts of the body)" .

NCIT:C48700 a owl:Class ;
    rdfs:label "M1" ;
    rdfs:subClassOf mc2:IndividualMetastasisStageEnum ;
    skos:definition "A clinical and/or pathologic distant metastasis TNM finding indicating the spread of cancer to distant anatomic sites." .

NCIT:C48701 a owl:Class ;
    rdfs:label "M1a" ;
    rdfs:subClassOf mc2:IndividualMetastasisStageEnum ;
    skos:definition "A distant metastasis TNM finding indicating the spread of cancer to a single distant organ or site; the specific meaning varies by cancer type." .

NCIT:C48702 a owl:Class ;
    rdfs:label "M1b" ;
    rdfs:subClassOf mc2:IndividualMetastasisStageEnum ;
