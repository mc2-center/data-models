        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:NGS_Library_Source_Molecule ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:SequencingRNALevel1_id ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:NGS_Sequencing_Design_Description ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:File_Format ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Description ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "\\d+$|Not\\sApplicable$|unknown$" ] ) ] ;
            owl:onProperty mc2:NGS_Library_Preparation_Days_from_Index ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:NGS_Library_Selection_Method ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^syn\\d{7,8}$" ] ) ] ;
            owl:onProperty mc2:SequencingRNALevel1_id ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:File_Level ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Longitudinal_Time_Elapsed_Unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:NGS_RNA_RIN ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:File_Url ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:NGS_Sequencing_Library_Construction_Days_from_Index ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Longitudinal_Total_Time_Elapsed ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:NGS_Library_Preparation_Days_from_Index ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Design ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:NGS_Unique_Bases ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:NGS_Sequencing_Platform ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Biospecimen_Key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Filename ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Longitudinal_Group ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:NGS_RNA_Reverse_Transcription_Primer ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:NGS_Read_Indicator ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:File_Species ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Longitudinal_Sequence_Identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:NGS_Library_Preparation_Kit_Vendor ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:NGS_Library_Layout ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "-B\\d{1,9}" ] ) ] ;
            owl:onProperty mc2:Biospecimen_Key ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:NGS_Library_Strategy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Study_Key ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:NGS_Read_Length ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Tissue ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:NGS_RNA_End_Bias ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:File_Alias ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:NGS_Library_Preparation_Kit_Name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Longitudinal_Event_Type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:NGS_RNA_DV200 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:NGS_Sequencing_Coverage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:NGS_Library_Preparation_Kit_Version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:DatasetView_Key ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:NGS_Library_Source_Material ] ;
    skos:definition "Unaligned/unprocessed RNA sequencing data" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:SequencingRNALevel1_Key a owl:DatatypeProperty ;
    rdfs:label "SequencingRNALevel1 Key" ;
    skos:definition "Unique SequencingRNALevel1_id foreign key(s) that link metadata entries as part of the same Dataset. Please provide multiple values as a comma-separate list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

mc2:Study a owl:Class ;
    rdfs:label "Study" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "CA\\d{6}" ] ) ] ;
            owl:onProperty mc2:GrantView_Key ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Study_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:GrantView_Key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:ProjectView_Key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:PersonView_Key ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Study_Deidentification_Method_Type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Study_dbGaP_Accession_Id ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Study_Name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Study_Index_Date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Study_Deidentification_Method_Description ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Study_Description ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Study_Number_of_Participants ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Study_Number_of_Samples ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "syn[0-9]+" ] ) ] ;
            owl:onProperty mc2:Study_Project_Identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Study_Deidentification_Method_Software ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Study_Investigator ] ;
    skos:definition "Studies associated with a grant" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Study_Data_Use_Codes a owl:ObjectProperty ;
    rdfs:label "Study Data Use Codes" ;
    rdfs:range mc2:StudyDataUseCodesEnum ;
    skos:definition "DUO code - A data item that is used to indicate consent permissions for datasets and/or materials, and relates to the purposes for which datasets and/or material might be removed, stored or used. Available DUO code definitions can be found here: https://mc2-center.github.io/data-models/valid_values/study/#attribute-study-data-use-codes" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "0002001" .

mc2:Study_License a owl:ObjectProperty ;
    rdfs:label "Study License" ;
    rdfs:range mc2:StudyLicenseEnum ;
    skos:definition "Official or legal permission to do or own a specified thing. Studies with data that will be submitted to CDS are required to provide a license. Maps to DUOplus6." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "14902606" .

mc2:Theme a owl:Class ;
    rdfs:label "Theme" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Theme_Description ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Theme_Name ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Theme_Display_Name ] ;
    skos:definition "Themes associated with resources derived from consortia activities" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:ToolView a owl:Class ;
    rdfs:label "Tool View" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Download_Version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Download_Type ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Tool_Name ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "CA\\d{6}" ] ) ] ;
            owl:onProperty mc2:GrantView_Key ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Tool_Input_Data ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:ToolView_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Cost ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Tool_Entity_Type ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Tool_Package_Dependencies_Present ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:GrantView_Key ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Tool_Description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:PublicationView_Key ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Tool_Homepage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Documentation_Url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Function_Note ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Tool_Entity_Role ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Tool_Input_Format ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Tool_Operation ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Tool_Doi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Study_Key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Cmd ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Accessibility ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Tool_Output_Data ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Tool_Release_Date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Date_Last_Modified ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Download_Url ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Tool_Output_Format ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:DatasetView_Key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Link_Note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Download_Note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Link_Url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Tool_Documentation_Note ] ;
    skos:definition "The denormalized manifest for tool submission." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Tool_Compute_Requirements a owl:DatatypeProperty ;
    rdfs:label "Tool Compute Requirements" ;
    skos:definition "Component dependency requirements for application. This includes runtime environments and shared libraries that are not included in the application distribution package, but required to run the application (examples: DirectX, Java or .NET runtime)." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: schema.org" .

mc2:Tool_Documentation_Type a owl:ObjectProperty ;
    rdfs:label "Tool Documentation Type" ;
    rdfs:range mc2:ToolDocumentationTypeEnum ;
    skos:definition "Type of documentation that is linked to. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Entity_Name a owl:DatatypeProperty ;
    rdfs:label "Tool Entity Name" ;
    skos:definition "Name of the entities that may be credited" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Tool_Grant_Number a owl:ObjectProperty ;
    rdfs:label "Tool Grant Number" ;
    rdfs:range mc2:ToolGrantNumberEnum ;
    skos:definition "Grant number associated with the tool's development. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Tool_Language a owl:ObjectProperty ;
    rdfs:label "Tool Language" ;
    rdfs:range mc2:ToolLanguageEnum ;
    skos:definition "Name of programming language the software source code was written in. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_License a owl:ObjectProperty ;
    rdfs:label "Tool License" ;
    rdfs:range mc2:ToolLicenseEnum ;
    skos:definition "Software or data usage license. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Link_Type a owl:ObjectProperty ;
    rdfs:label "Tool Link Type" ;
    rdfs:range mc2:ToolLinkTypeEnum ;
    skos:definition "The type of data, information or system that is obtained when the link is resolved. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Operating_System a owl:ObjectProperty ;
    rdfs:label "Tool Operating System" ;
    rdfs:range mc2:ToolOperatingSystemEnum ;
    skos:definition "The operating system supported by a downloadable software package. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Package_Dependencies a owl:DatatypeProperty ;
    rdfs:label "Tool Package Dependencies" ;
    skos:definition "Specifies the software libraries, frameworks, or other components that a tool or package relies on for its proper functioning. This attribute helps users understand the prerequisites needed for installation and usage of the tool within a given computational environment" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: CWL" .

mc2:Tool_Pubmed_Id a owl:DatatypeProperty ;
    rdfs:label "Tool Pubmed Id" ;
    rdfs:range xsd:float ;
    skos:definition "The pubMed identifer associated with the development of the tool." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Tool_Topic a owl:ObjectProperty ;
    rdfs:label "Tool Topic" ;
    rdfs:range mc2:ToolTopicEnum ;
    skos:definition "General scientific domain the software serves, or other general category. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Type a owl:ObjectProperty ;
    rdfs:label "Tool Type" ;
    rdfs:range mc2:ToolTypeEnum ;
    skos:definition "A type of application software: a discrete software entity can have more than one type. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:attribution a owl:DatatypeProperty ;
    rdfs:label "attribution" ;
    skos:definition "The attribution statement for the data associated with the access requirement. Equivalent to DUOPlus7." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:authors a owl:DatatypeProperty ;
    rdfs:label "authors" ;
    skos:definition "Author list for the dataset's associated publication. Distinct from creator, which captures the person(s)/organization(s) that generated or deposited the data itself." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:collaborationRequired a owl:DatatypeProperty ;
    rdfs:label "collaborationRequired" ;
    skos:definition "If collaboration is required for the access requirement, provide the PI email address. Provide multiple as a comma-separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:contributor a owl:DatatypeProperty ;
    rdfs:label "contributor" ;
    skos:definition "Organization(s), insitution(s), or person(s) that generated and/or deposited the data in Synapse. Can be identical to Grant Institution Name." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:countryOfOrigin a owl:ObjectProperty ;
    rdfs:label "countryOfOrigin" ;
    rdfs:range mc2:CountryOfOriginEnum ;
    skos:definition "Origin of individuals from which data were generated. Omit if not applicable/unknown." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:dataPermission a owl:ObjectProperty ;
    rdfs:label "dataPermission" ;
    rdfs:range mc2:DataPermissionEnum ;
    skos:definition "The permissions associated with the data under the access requirement. Equivalent to DUOPlus4." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:dataTier a owl:ObjectProperty ;
    rdfs:label "dataTier" ;
    rdfs:range mc2:DataTierEnum ;
    skos:definition "The tier of data access associated with the access requirement. Equivalent to DUOPlus5." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:dataType a owl:ObjectProperty ;
    rdfs:label "dataType" ;
    rdfs:range mc2:DataTypeEnum ;
    skos:definition "Broad data-type category for the dataset (e.g. gene expression, chromatin activity, genomic variants). Aligned with modules/shared/mc2_iconTag_map_3-4-25.csv's label taxonomy." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:dataUseModifiers a owl:ObjectProperty ;
    rdfs:label "dataUseModifiers" ;
    rdfs:range mc2:DataUseModifiersEnum ;
    skos:definition "A list of data use modifiers that apply to the access requirement. Examples include GRU, IRB, etc." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "00002002" .

mc2:deidentificationType a owl:ObjectProperty ;
    rdfs:label "deidentificationType" ;
    rdfs:range mc2:DeidentificationTypeEnum ;
    skos:definition "The type of de-identification applied to the data associated with the access requirement. Equivalent to DUOPlus3." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:diseaseSpecificResearch a owl:DatatypeProperty ;
    rdfs:label "diseaseSpecificResearch" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "MONDO:\\d{7}" ] ) ] ;
    skos:definition "The type(s) of disease research allowed by this access requirement. Provide the MONDO ID in format MONDO:id. Provide multiple values as a comma-separated list. MONDO terms can be found here: https://ols.monarchinitiative.org/ontologies/mondo" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:externalRepositoryUri a owl:DatatypeProperty ;
    rdfs:label "externalRepositoryUri" ;
    skos:definition "External repository identifier(s) for the dataset, as CURIE-shaped references (e.g. geo:GSE12345, sra:SRP12345, bioproject:PRJNA12345)." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:funder a owl:ObjectProperty ;
    rdfs:label "funder" ;
    rdfs:range mc2:FunderEnum ;
    skos:definition "The entity(ies) responsible for funding the data contributors." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:geographicalRestriction a owl:ObjectProperty ;
    rdfs:label "geographicalRestriction" ;
    rdfs:range mc2:GeographicalRestrictionEnum ;
    skos:definition "The specific geographic region(s) to which use is limited by the access requirement." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:institutionSpecificRestriction a owl:DatatypeProperty ;
    rdfs:label "institutionSpecificRestriction" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "ROR:[a-z0-9]{9}" ] ) ] ;
    skos:definition "Institutions with specific restrictions associated with the access requirement. Provide the institution ROR ID in format ROR:id. Provide multiple entries as a comma-separated list. ROR IDs can be found here: https://ror.org/search" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:license a owl:ObjectProperty ;
    rdfs:label "license" ;
    rdfs:range mc2:LicenseEnum ;
    skos:definition "The license under which the data associated with the access requirement is shared. Equivalent to DUOPlus6." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:measurementTechnique a owl:ObjectProperty ;
    rdfs:label "measurementTechnique" ;
    rdfs:range mc2:MeasurementTechniqueEnum ;
    skos:definition "Assay used to generate original data. Omit if not applicable (e.g. for curated dataset such as a list compounds from a database or text extracted from Wikipedia). Can be identical to Dataset Assay." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:populationType a owl:DatatypeProperty ;
    rdfs:label "populationType" ;
    skos:definition "The population studied in the research associated with the access requirement. Equivalent to DUOPlus2" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:publicationMoratorium a owl:DatatypeProperty ;
    rdfs:label "publicationMoratorium" ;
    skos:definition "End date of the publication moratorium associated with the access requirement." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic Format: date" .

mc2:researchSpecificRestrictions a owl:DatatypeProperty ;
    rdfs:label "researchSpecificRestrictions" ;
    skos:definition "Research-specific restrictions associated with the access requirement." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:sourceGeography a owl:ObjectProperty ;
    rdfs:label "sourceGeography" ;
    rdfs:range mc2:SourceGeographyEnum ;
    skos:definition "The geographical source of the data associated with the access requirement. Equivalent to DUOPlus1." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:species a owl:ObjectProperty ;
    rdfs:label "species" ;
    rdfs:range mc2:SpeciesEnum ;
    skos:definition "Species of the organism(s) from which the data were generated. Omit property if not applicable, such as for data like compounds or other non-biological data. Can be identical to Dataset Species." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:subject a owl:DatatypeProperty ;
    rdfs:label "subject" ;
    skos:definition "Applicable subject term(s) for dataset cataloging - in practice, a free-text model-system/specimen descriptor (e.g. C57BL/6, NOD SCID), not a Library of Congress Subject Heading." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:timeLimitOnUse a owl:DatatypeProperty ;
    rdfs:label "timeLimitOnUse" ;
    rdfs:range xsd:float ;
    skos:definition "Time limit on the use of the data associated with the access requirement." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:userSpecificRestriction a owl:DatatypeProperty ;
    rdfs:label "userSpecificRestriction" ;
    skos:definition "The user-specific restrictions associated with the access requirement." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

<mc2:DUO:0000007> a owl:DatatypeProperty ;
    rdfs:label "DUO:0000007" ;
    skos:definition "This data use permission indicates that use is allowed provided it is related to the specified disease." ;
    skos:exactMatch DUO:0000007 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic DependsOn (conditional requirement on sibling attributes, not represented as a LinkML rule): diseaseSpecificResearch" .

<mc2:DUO:0000012> a owl:DatatypeProperty ;
    rdfs:label "DUO:0000012" ;
    skos:definition "This data use modifier indicates that use is limited to studies of a certain research type." ;
    skos:exactMatch DUO:0000012 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic DependsOn (conditional requirement on sibling attributes, not represented as a LinkML rule): researchSpecificRestrictions" .

<mc2:DUO:0000020> a owl:DatatypeProperty ;
    rdfs:label "DUO:0000020" ;
    skos:definition "This data use modifier indicates that the requestor must agree to collaboration with the primary study investigator(s)." ;
    skos:exactMatch DUO:0000020 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic DependsOn (conditional requirement on sibling attributes, not represented as a LinkML rule): collaborationRequired" .

<mc2:DUO:0000022> a owl:DatatypeProperty ;
    rdfs:label "DUO:0000022" ;
    skos:definition "This data use modifier indicates that use is limited to within a specific geographic region." ;
    skos:exactMatch DUO:0000022 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic DependsOn (conditional requirement on sibling attributes, not represented as a LinkML rule): geographicalRestriction" .

<mc2:DUO:0000024> a owl:DatatypeProperty ;
    rdfs:label "DUO:0000024" ;
    skos:definition "This data use modifier indicates that requestor agrees not to publish results of studies until a specific date." ;
    skos:exactMatch DUO:0000024 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic DependsOn (conditional requirement on sibling attributes, not represented as a LinkML rule): publicationMoratorium" .

<mc2:DUO:0000025> a owl:DatatypeProperty ;
    rdfs:label "DUO:0000025" ;
    skos:definition "This data use modifier indicates that use is approved for a specific number of months." ;
    skos:exactMatch DUO:0000025 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic DependsOn (conditional requirement on sibling attributes, not represented as a LinkML rule): timeLimitOnUse" .

<mc2:DUO:0000026> a owl:DatatypeProperty ;
    rdfs:label "DUO:0000026" ;
    skos:definition "This data use modifier indicates that use is limited to use by approved users." ;
    skos:exactMatch DUO:0000026 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic DependsOn (conditional requirement on sibling attributes, not represented as a LinkML rule): userSpecificRestriction" .

<mc2:DUO:0000028> a owl:DatatypeProperty ;
    rdfs:label "DUO:0000028" ;
    skos:definition "This data use modifier indicates that use is limited to use within an approved institution." ;
    skos:exactMatch DUO:0000028 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic DependsOn (conditional requirement on sibling attributes, not represented as a LinkML rule): institutionSpecificRestriction" .

mc2:10xVisiumAuxiliaryFiles_Key a owl:DatatypeProperty ;
    rdfs:label "10xVisiumAuxiliaryFiles Key" ;
    skos:definition "Unique 10xVisiumAuxiliaryFiles_id foreign key(s) that link metadata entries as part of the same Dataset. Please provide multiple values as a comma-separate list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

mc2:10xVisiumRNALevel4_Key a owl:DatatypeProperty ;
    rdfs:label "10xVisiumRNALevel4 Key" ;
    skos:definition "Unique 10xVisiumRNALevel4_id foreign key(s) that link metadata entries as part of the same Dataset. Please provide multiple values as a comma-separate list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

mc2:Biospecimen_Acquisition_Method a owl:ObjectProperty ;
    rdfs:label "Biospecimen Acquisition Method" ;
    rdfs:range mc2:BiospecimenAcquisitionMethodEnum ;
    skos:definition "Records the method of acquisition or source for the specimen under consideration" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "6626651" .

mc2:Biospecimen_Age_at_Collection a owl:DatatypeProperty ;
    rdfs:label "Biospecimen Age at Collection" ;
    rdfs:range xsd:float ;
    skos:definition "Age at the time the biospecimen was collected. Please provide the unit in field Biospecimen Age at Collection Unit." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "14473376" .

mc2:Biospecimen_Age_at_Collection_Unit a owl:DatatypeProperty ;
    rdfs:label "Biospecimen Age at Collection Unit" ;
    skos:definition "Unit associated with age at the time the biospecimen was collected." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Biospecimen_Anatomic_Site a owl:ObjectProperty ;
    rdfs:label "Biospecimen Anatomic Site" ;
    rdfs:range mc2:BiospecimenAnatomicSiteEnum ;
    skos:definition "Text term that represents the name of the primary disease site of the submitted tumor sample." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "14156279" .

mc2:Biospecimen_BioSample_Identifier a owl:DatatypeProperty ;
    rdfs:label "Biospecimen BioSample Identifier" ;
    skos:definition "BioSample (SAMN) accession number corresponding to the source of this biospecimen." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Biospecimen_Collection_Site a owl:DatatypeProperty ;
    rdfs:label "Biospecimen Collection Site" ;
    skos:definition "The health care site at which the biospecimen sample was collected." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Biospecimen_Description a owl:DatatypeProperty ;
    rdfs:label "Biospecimen Description" ;
    skos:definition "A description of the biospecimen." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "14688604" .

mc2:Biospecimen_Embedding_Medium a owl:ObjectProperty ;
    rdfs:label "Biospecimen Embedding Medium" ;
    rdfs:range mc2:BiospecimenEmbeddingMediumEnum ;
    skos:definition "The name of the material that infiltrates and supports the specimen and preserves its shape and structure for sectioning and microscopy." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "8037927" .

mc2:Biospecimen_Fixative a owl:ObjectProperty ;
    rdfs:label "Biospecimen Fixative" ;
    rdfs:range mc2:BiospecimenFixativeEnum ;
    skos:definition "The name of the compound that preserves tissues and cells in this sample for microscopic study." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "0065078" .

mc2:Biospecimen_Incidence_Type a owl:ObjectProperty ;
    rdfs:label "Biospecimen Incidence Type" ;
    rdfs:range mc2:BiospecimenIncidenceTypeEnum ;
    skos:definition "Text term describing a change in disease status associated with the collection of this specimen." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "62997" .

mc2:Biospecimen_Last_Known_Disease_Status a owl:ObjectProperty ;
    rdfs:label "Biospecimen Last Known Disease Status" ;
    rdfs:range mc2:BiospecimenLastKnownDiseaseStatusEnum ;
    skos:definition "Text term that describes the last known status of an individual associated with this specimen." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Biospecimen_Preservation_Method a owl:ObjectProperty ;
    rdfs:label "Biospecimen Preservation Method" ;
    rdfs:range mc2:BiospecimenPreservationMethodEnum ;
    skos:definition "Text term that represents the method used to preserve the sample." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "8028962" .

mc2:Biospecimen_Primary_Diagnosis a owl:ObjectProperty ;
    rdfs:label "Biospecimen Primary Diagnosis" ;
    rdfs:range mc2:BiospecimenPrimaryDiagnosisEnum ;
    skos:definition "Text term used to describe the histologic diagnosis relevant to the model system, as described by the World Health Organization's (WHO) International Classification of Diseases for Oncology (ICD-O)." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "14714127" .

mc2:Biospecimen_Primary_Site a owl:ObjectProperty ;
    rdfs:label "Biospecimen Primary Site" ;
    rdfs:range mc2:BiospecimenPrimarySiteEnum ;
    skos:definition "Primary site in the body associated with the primary diagnosis." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Biospecimen_Sex a owl:ObjectProperty ;
    rdfs:label "Biospecimen Sex" ;
    rdfs:range mc2:BiospecimenSexEnum ;
    skos:definition "Biological sex associated with the specimen donor" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "7572817" .

mc2:Biospecimen_Site_of_Origin a owl:ObjectProperty ;
    rdfs:label "Biospecimen Site of Origin" ;
    rdfs:range mc2:BiospecimenSiteOfOriginEnum ;
    skos:definition "The text term used to describe the anatomic site of origin, of the patient's malignant disease." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "0000004" .

mc2:Biospecimen_Site_of_Resection_or_Biopsy a owl:ObjectProperty ;
    rdfs:label "Biospecimen Site of Resection or Biopsy" ;
    rdfs:range mc2:BiospecimenSiteOfResectionOrBiopsyEnum ;
    skos:definition "The text term used to describe the anatomic site of the resection or biopsy of the patient's malignant disease." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "0000006" .

mc2:Biospecimen_Species a owl:ObjectProperty ;
    rdfs:label "Biospecimen Species" ;
    rdfs:range mc2:BiospecimenSpeciesEnum ;
    skos:definition "The species from which the biospecimen originates" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Biospecimen_Stain a owl:DatatypeProperty ;
    rdfs:label "Biospecimen Stain" ;
    skos:definition "Any of the various methods that use a dye, reagent, or other material for producing coloration in tissues or microorganisms for microscopic examination." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "8120269" .

mc2:Biospecimen_Therapeutic_Agent a owl:ObjectProperty ;
    rdfs:label "Biospecimen Therapeutic Agent" ;
    rdfs:range mc2:BiospecimenTherapeuticAgentEnum ;
    skos:definition "Text identification of the individual agent(s) used as part of a treatment regimen." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "13579886" .

mc2:Biospecimen_Timepoint_Offset a owl:DatatypeProperty ;
    rdfs:label "Biospecimen Timepoint Offset" ;
    rdfs:range xsd:float ;
    skos:definition "The number of days that elapsed before the biospecimen was collected, relative to the event described by Biospecimen Timepoint Type. Floating point values are allowed." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Biospecimen_Timepoint_Type a owl:DatatypeProperty ;
    rdfs:label "Biospecimen Timepoint Type" ;
    skos:definition "Label to identify an event associated with the collection of the biospecimen (e.g. Baseline, End of Treatment, Overall survival, Final). Use Biospecimen Timepoint Offset to indicate the number of post-event days that elapsed before the biospecimen was collected. NO PHI/PII INFORMATION IS ALLOWED." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Biospecimen_Treatment_Response a owl:ObjectProperty ;
    rdfs:label "Biospecimen Treatment Response" ;
    rdfs:range mc2:BiospecimenTreatmentResponseEnum ;
    skos:definition "Text term that describes the treatment response of a model or patient from which this specimen was derived." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "13383448" .

mc2:Biospecimen_Tumor_Grade a owl:ObjectProperty ;
    rdfs:label "Biospecimen Tumor Grade" ;
    rdfs:range mc2:BiospecimenTumorGradeEnum ;
    skos:definition "Numeric value to express the degree of abnormality of cancer cells, a measure of differentiation and aggressiveness." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "11325685" .

mc2:Biospecimen_Tumor_Morphology a owl:ObjectProperty ;
    rdfs:label "Biospecimen Tumor Morphology" ;
    rdfs:range mc2:BiospecimenTumorMorphologyEnum ;
    skos:definition "Morphology code from the third edition of the International Classification of Diseases for Oncology, published in 2000, and used principally in tumor and cancer registries for coding the site (topography) and the histology (morphology) of neoplasms." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "0000003" .

mc2:Biospecimen_Tumor_Status a owl:ObjectProperty ;
    rdfs:label "Biospecimen Tumor Status" ;
    rdfs:range mc2:BiospecimenTumorStatusEnum ;
    skos:definition "Normal or Tumor Sample Pathology Indicator" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "14688604" .

mc2:Biospecimen_Tumor_Subtype a owl:DatatypeProperty ;
    rdfs:label "Biospecimen Tumor Subtype" ;
    skos:definition "The subtype related to the scientific determination and investigation, analysis and recognition of the presence and nature of disease, condition, or injury from expressed signs and symptoms of tissue growth resulting from uncontrolled cell proliferation." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Biospecimen_Type a owl:ObjectProperty ;
    rdfs:label "Biospecimen Type" ;
    rdfs:range mc2:BiospecimenTypeEnum ;
    skos:definition "The type of biospecimen" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Biospecimen_Type_Category a owl:ObjectProperty ;
