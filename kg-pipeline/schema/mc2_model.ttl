    skos:definition "The level of processing associated with the dataset." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:DSP_Dataset_Name a owl:DatatypeProperty ;
    rdfs:label "DSP Dataset Name" ;
    skos:definition "Name of the dataset" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:DSP_Dataset_Species a owl:ObjectProperty ;
    rdfs:label "DSP Dataset Species" ;
    rdfs:range mc2:DSPDatasetSpeciesEnum ;
    skos:definition "The species the data was collected on. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:DSP_Dataset_Url a owl:DatatypeProperty ;
    rdfs:label "DSP Dataset Url" ;
    skos:definition "The url where the dataset is or will be stored. For Synapse storage, the Synapse url or doi associated with the dataset storage folder should be used." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic Format: uri" .

mc2:DSP_Number_of_Files a owl:DatatypeProperty ;
    rdfs:label "DSP Number of Files" ;
    rdfs:range xsd:float ;
    skos:definition "The number of files that will be uploaded as part of this dataset." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:DSP_Number_of_Participants a owl:DatatypeProperty ;
    rdfs:label "DSP Number of Participants" ;
    rdfs:range xsd:float ;
    skos:definition "The number of individuals or model organisms from which samples were collected to generate the dataset." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:DSP_Number_of_Samples a owl:DatatypeProperty ;
    rdfs:label "DSP Number of Samples" ;
    rdfs:range xsd:float ;
    skos:definition "The number of biospecimens associated with the files included in the dataset" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:DSP_Planned_Release_Date a owl:DatatypeProperty ;
    rdfs:label "DSP Planned Release Date" ;
    skos:definition "The projected date that marks the end of any requested or required sharing embargo for the dataset." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic Format: date" .

mc2:DSP_Planned_Upload_Date a owl:DatatypeProperty ;
    rdfs:label "DSP Planned Upload Date" ;
    skos:definition "A non-binding, estimated date by which the files are expected to be uploaded to a repository." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic Format: date" .

mc2:DSP_Storage_Size a owl:DatatypeProperty ;
    rdfs:label "DSP Storage Size" ;
    rdfs:range xsd:float ;
    skos:definition "The expected total storage space required for the dataset in gigabytes (GB)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:DatasetView_id a owl:DatatypeProperty ;
    rdfs:label "DatasetView_id" ;
    skos:definition "Unique ID associated with this Dataset View entry, used as a key for record linking and updates. Unless otherwise directed, this value should be equivalent to Dataset Alias. For externally hosted datasets with a corresponding Synapse Dataset containing indexed data, this should be the Synapse Id of the Dataset." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Dataset_Alias a owl:DatatypeProperty ;
    rdfs:label "Dataset Alias" ;
    skos:definition "Alias of the dataset. Must be unique. Can be the GEO identifier such as GSE12345, or a DOI. No Greek Letters." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Dataset_Description a owl:DatatypeProperty ;
    rdfs:label "Dataset Description" ;
    skos:definition "Description of the dataset." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Dataset_Design a owl:DatatypeProperty ;
    rdfs:label "Dataset Design" ;
    skos:definition "The overall design of the dataset." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Dataset_Doi a owl:DatatypeProperty ;
    rdfs:label "Dataset Doi" ;
    skos:definition "The Digital Object Identifier (DOI) associated with the dataset." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic Format: uri" .

mc2:Dataset_Name a owl:DatatypeProperty ;
    rdfs:label "Dataset Name" ;
    skos:definition "Name of the dataset" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Dataset_Url a owl:DatatypeProperty ;
    rdfs:label "Dataset Url" ;
    skos:definition "The url of where the dataset is stored." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic Format: uri" .

mc2:Duration_of_Funding a owl:DatatypeProperty ;
    rdfs:label "Duration of Funding" ;
    rdfs:range xsd:float ;
    skos:definition "Duration of the funding period, in years" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:EducationalResource_Key a owl:DatatypeProperty ;
    rdfs:label "EducationalResource Key" ;
    skos:definition "Unique EducationalResource_id foreign key(s) that link metadata entries as part of the same collection. Please provide multiple values as a comma-separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

mc2:EducationalResource_id a owl:DatatypeProperty ;
    rdfs:label "EducationalResource_id" ;
    skos:definition "Unique ID associated with a Educational Resource entry, used as a key for record linking and updates." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Email a owl:DatatypeProperty ;
    rdfs:label "Email" ;
    skos:definition "Email address of the individual" ;
    skos:exactMatch CRDC_CDE:2517550 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Embargo_End_Date a owl:DatatypeProperty ;
    rdfs:label "Embargo End Date" ;
    skos:definition "Date at which an embargo on related resources had lifted" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic Format: date" .

mc2:File_Data_Category a owl:ObjectProperty ;
    rdfs:label "File Data Category" ;
    rdfs:range mc2:FileDataCategoryEnum ;
    skos:definition "A broad classification of the contents of a data file generated from an experiment or a study." ;
    skos:exactMatch CRDC_CDE:14824731 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:File_Data_Checksum_Type a owl:ObjectProperty ;
    rdfs:label "File Data Checksum Type" ;
    rdfs:range mc2:FileDataChecksumTypeEnum ;
    skos:definition "The method by which the file checksum was calculated." ;
    skos:exactMatch CRDC_CDE:11475057 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:File_Data_Checksum_Value a owl:DatatypeProperty ;
    rdfs:label "File Data Checksum Value" ;
    skos:definition "A small-sized block of data derived from a file for the purpose of detecting errors that may have been introduced during file transmission and/or storage and used to verify data integrity." ;
    skos:exactMatch CRDC_CDE:11480133 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:File_Data_Compression_Status a owl:ObjectProperty ;
    rdfs:label "File Data Compression Status" ;
    rdfs:range mc2:FileDataCompressionStatusEnum ;
    skos:definition "The state of data when saved to storage space or during data transmission." ;
    skos:exactMatch CRDC_CDE:11387114 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:File_Data_Size a owl:DatatypeProperty ;
    rdfs:label "File Data Size" ;
    rdfs:range xsd:float ;
    skos:definition "The measure (in bytes) of how much space a data file takes up on a storage medium." ;
    skos:exactMatch CRDC_CDE:11479876 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Genome_Annotation_URL a owl:DatatypeProperty ;
    rdfs:label "Genome Annotation URL" ;
    skos:definition "Link to the human genome annotation (GTF) file; ftp or reference URL will be accepted." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic Format: uri" .

mc2:Genomic_Reference_URL a owl:DatatypeProperty ;
    rdfs:label "Genomic Reference URL" ;
    skos:definition "Link to human genome sequence; ftp or reference URL will be accepted." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic Format: uri" .

mc2:GeoMx_AOI_Name a owl:DatatypeProperty ;
    rdfs:label "GeoMx AOI Name" ;
    skos:definition "Name of Area of Illumination corresponding to file. Multiple names should be comma-separated" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_AOI_X_Coordinate a owl:DatatypeProperty ;
    rdfs:label "GeoMx AOI X Coordinate" ;
    rdfs:range xsd:float ;
    skos:definition "Area of Illumination X location within the image" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_AOI_Y_Coordinate a owl:DatatypeProperty ;
    rdfs:label "GeoMx AOI Y Coordinate" ;
    rdfs:range xsd:float ;
    skos:definition "Area of Illumination Y location within the image" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_Binding_Density a owl:DatatypeProperty ;
    rdfs:label "GeoMx Binding Density" ;
    rdfs:range xsd:float ;
    skos:definition "The binding density as reported by the application" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_Excluded_Outlier_Probes a owl:DatatypeProperty ;
    rdfs:label "GeoMx Excluded Outlier Probes" ;
    rdfs:range xsd:float ;
    skos:definition "The list of probes excluded from analysis." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_Limit_of_Quantification a owl:DatatypeProperty ;
    rdfs:label "GeoMx Limit of Quantification" ;
    rdfs:range xsd:float ;
    skos:definition "The calculated limit of quantification associated with the segment." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_Negative_count_mean a owl:DatatypeProperty ;
    rdfs:label "GeoMx Negative count mean" ;
    rdfs:range xsd:float ;
    skos:definition "The geometric mean of the unique negative probes in a GeoMx panel that do not target mRNA and establish the background count level per segment" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_No_Template_Control_count a owl:DatatypeProperty ;
    rdfs:label "GeoMx No Template Control count" ;
    rdfs:range xsd:float ;
    skos:definition "The number of reads detected by the GeoMx probe panel in the control associated with this ROI." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_Nuclei_count a owl:DatatypeProperty ;
    rdfs:label "GeoMx Nuclei count" ;
    rdfs:range xsd:float ;
    skos:definition "Number of nuclei detected in the segment (if applicable)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_Positive_norm_factor a owl:DatatypeProperty ;
    rdfs:label "GeoMx Positive norm factor" ;
    rdfs:range xsd:float ;
    skos:definition "The Positive Control Normalization factor calculated using pos-hyb controls" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_ROI_Name a owl:DatatypeProperty ;
    rdfs:label "GeoMx ROI Name" ;
    skos:definition "Name of Region of Interest corresponding to file. Multiple names should be comma-separated" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_ROI_X_Coordinate a owl:DatatypeProperty ;
    rdfs:label "GeoMx ROI X Coordinate" ;
    rdfs:range xsd:float ;
    skos:definition "Region of Interest X location within the image" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_ROI_Y_Coordinate a owl:DatatypeProperty ;
    rdfs:label "GeoMx ROI Y Coordinate" ;
    rdfs:range xsd:float ;
    skos:definition "Region of Interest Y location within the image" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_Scan_Height a owl:DatatypeProperty ;
    rdfs:label "GeoMx Scan Height" ;
    rdfs:range xsd:float ;
    skos:definition "Height of the scan for GeoMx Analysis" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_Scan_Offset_X a owl:DatatypeProperty ;
    rdfs:label "GeoMx Scan Offset X" ;
    rdfs:range xsd:float ;
    skos:definition "Offset X of the scan for GeoMx Analysis" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_Scan_Offset_Y a owl:DatatypeProperty ;
    rdfs:label "GeoMx Scan Offset Y" ;
    rdfs:range xsd:float ;
    skos:definition "Offset Y of the scan for GeoMx Analysis" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_Scan_Width a owl:DatatypeProperty ;
    rdfs:label "GeoMx Scan Width" ;
    rdfs:range xsd:float ;
    skos:definition "Width of the scan for GeoMx Analysis" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_Scan_name a owl:DatatypeProperty ;
    rdfs:label "GeoMx Scan name" ;
    skos:definition "GeoMx Scan name (as appears in Segment Summary)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_Slide_name a owl:DatatypeProperty ;
    rdfs:label "GeoMx Slide name" ;
    skos:definition "Similar to a Run ID, the slide name indicates the slide a given ROI is linked to (as reported in Segment Summary)." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_Surface_area a owl:DatatypeProperty ;
    rdfs:label "GeoMx Surface area" ;
    rdfs:range xsd:float ;
    skos:definition "Surface area of the ROI in square microns (µm2)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_Tags a owl:DatatypeProperty ;
    rdfs:label "GeoMx Tags" ;
    skos:definition "The basename(s) or unique identifier(s) for FASTQ, RCC, or DCC file(s) associated with this ROI." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_Tissue_Stain a owl:DatatypeProperty ;
    rdfs:label "GeoMx Tissue Stain" ;
    skos:definition "Text description of the stain, fluorescent reporter, or channel used to select the boundaries of the ROI." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GrantView_id a owl:DatatypeProperty ;
    rdfs:label "GrantView_id" ;
    skos:definition "Unique row identifier, used as a primary key for record updates. This should be equivalent to the grant number in CAxxxxxx format unless otherwise indicated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Grant_Abstract a owl:DatatypeProperty ;
    rdfs:label "Grant Abstract" ;
    skos:definition "Abstract for the grant" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Grant_End_Date a owl:DatatypeProperty ;
    rdfs:label "Grant End Date" ;
    skos:definition "The end date of the grant YYYY-MM-DD format" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic Format: date" .

mc2:Grant_Institution_Alias a owl:ObjectProperty ;
    rdfs:label "Grant Institution Alias" ;
    rdfs:range mc2:GrantInstitutionAliasEnum ;
    skos:definition "The alias of the institution(s) associated with the grant (e.g. UCSD). 1...*" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Grant_Institution_Name a owl:ObjectProperty ;
    rdfs:label "Grant Institution Name" ;
    rdfs:range mc2:GrantInstitutionNameEnum ;
    skos:definition "The full name of the institution(s) associated with the grant. (e.g. Harvard University). 1...*" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Grant_Name a owl:DatatypeProperty ;
    rdfs:label "Grant Name" ;
    skos:definition "Name of the grant" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Grant_Start_Date a owl:DatatypeProperty ;
    rdfs:label "Grant Start Date" ;
    skos:definition "The start date of the grant YYYY-MM-DD format" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic Format: date" .

mc2:Grant_Synapse_Project a owl:DatatypeProperty ;
    rdfs:label "Grant Synapse Project" ;
    skos:definition "The Synapse project associated with the grant, created by the MC2 Center" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic Format: uri" .

mc2:Grant_Synapse_Team a owl:DatatypeProperty ;
    rdfs:label "Grant Synapse Team" ;
    skos:definition "The Synapse team associated with the grant, created by the MC2 Center" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic Format: uri" .

mc2:Grant_Theme_Name a owl:ObjectProperty ;
    rdfs:label "Grant Theme Name" ;
    rdfs:range mc2:GrantThemeNameEnum ;
    skos:definition "Theme(s) associated with the grant. 1...*" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Grant_Type a owl:ObjectProperty ;
    rdfs:label "Grant Type" ;
    rdfs:range mc2:GrantTypeEnum ;
    skos:definition "Type of grant" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_DICOM_Modality_Type a owl:ObjectProperty ;
    rdfs:label "Image DICOM Modality Type" ;
    rdfs:range mc2:ImageDICOMModalityTypeEnum ;
    skos:definition "The specific manner, characteristic, pattern or function, method or process, or devices that created the data." ;
    skos:exactMatch CRDC_CDE:12137353 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Number_of_Features a owl:DatatypeProperty ;
    rdfs:label "Image Number of Features" ;
    rdfs:range xsd:float ;
    skos:definition "The number of features (eg channels) described" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Object_Class_Description a owl:DatatypeProperty ;
    rdfs:label "Image Object Class Description" ;
    skos:definition "If Imaging Object Class is \"Other\", please use this field to provide a text description of the imaging object class associated with the segmentation data" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Platform_Model_Version a owl:DatatypeProperty ;
    rdfs:label "Image Platform Model Version" ;
    skos:definition "A string of characters used to identify the equipment model version." ;
    skos:exactMatch CRDC_CDE:16065945 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Segmentation_Data_Type a owl:ObjectProperty ;
    rdfs:label "Image Segmentation Data Type" ;
    rdfs:range mc2:ImageSegmentationDataTypeEnum ;
    skos:definition "Specifies how the segmentation is stored" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Summary_Statistic a owl:ObjectProperty ;
    rdfs:label "Image Summary Statistic" ;
    rdfs:range mc2:ImageSummaryStatisticEnum ;
    skos:definition "Function used to summarize object/feature intensity" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:ImagingChannel_id a owl:DatatypeProperty ;
    rdfs:label "ImagingChannel_id" ;
    skos:definition "Unique row identifier, used as a primary key for record updates." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:ImagingLevel1_Key a owl:DatatypeProperty ;
    rdfs:label "ImagingLevel1 Key" ;
    skos:definition "Unique ImagingLevel1_id foreign key(s) that link metadata entries as part of the same Dataset. Please provide multiple values as a comma-separate list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

mc2:ImagingLevel3Segments_Key a owl:DatatypeProperty ;
    rdfs:label "ImagingLevel3Segments Key" ;
    skos:definition "Unique ImagingLevel3Segments_id foreign key(s) that link metadata entries as part of the same Dataset. Please provide multiple values as a comma-separate list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

mc2:Individual_Age_90_or_Older a owl:ObjectProperty ;
    rdfs:label "Individual Age 90 or Older" ;
    rdfs:range mc2:IndividualAge90OrOlderEnum ;
    skos:definition "The response to indicate whether an individual is age 90 or older." ;
    skos:exactMatch CRDC_CDE:15354920 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Individual_Age_at_Diagnosis a owl:DatatypeProperty ;
    rdfs:label "Individual Age at Diagnosis" ;
    rdfs:range xsd:float ;
    skos:definition "Age at the time the individual was diagnosed, expressed in years. Note: the CRDC-required CDE for this concept (Subject Age At Diagnosis, CDE 10609539) expresses this value in days rather than years; a documented days<->years derivation is implemented at the mapping/ETL layer for CRDC submission, not as a separate stored field." ;
    skos:exactMatch CRDC_CDE:10609539 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "15019300" .

mc2:Individual_Days_To_Recurrence a owl:DatatypeProperty ;
    rdfs:label "Individual Days To Recurrence" ;
    rdfs:range xsd:float ;
    skos:definition "Number of days between the date used for index and the date the patient's disease recurred" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Individual_Days_to_Last_Followup a owl:DatatypeProperty ;
    rdfs:label "Individual Days to Last Followup" ;
    rdfs:range xsd:float ;
    skos:definition "Number of days between the dates used for index and last follow-up" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Individual_Days_to_Last_Known_Disease_Status a owl:DatatypeProperty ;
    rdfs:label "Individual Days to Last Known Disease Status" ;
    rdfs:range xsd:float ;
    skos:definition "Time interval from the date of last follow up to the date of initial pathologic diagnosis, represented as a calculated number of days." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Individual_Disease_Progression_or_Recurrence_Type a owl:ObjectProperty ;
    rdfs:label "Individual Disease Progression or Recurrence Type" ;
    rdfs:range mc2:IndividualDiseaseProgressionOrRecurrenceTypeEnum ;
    skos:definition "A term describing the kind of worsening or return of disease that a subject is experiencing." ;
    skos:exactMatch CRDC_CDE:14742451 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Individual_Gender a owl:ObjectProperty ;
    rdfs:label "Individual Gender" ;
    rdfs:range mc2:IndividualGenderEnum ;
    skos:definition "Text designations that identify gender. Gender is described as the assemblage of properties that distinguish people on the basis of their societal roles. Identification of gender is based upon self-report and may come from a form, questionnaire, interview, etc." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Individual_Metastasis_Stage a owl:ObjectProperty ;
    rdfs:label "Individual Metastasis Stage" ;
    rdfs:range mc2:IndividualMetastasisStageEnum ;
    skos:definition "Extent of the distant metastasis for the cancer based on evidence obtained from clinical assessment parameters determined prior to treatment." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "3440331" .

mc2:Individual_Primary_Tumor_Stage a owl:ObjectProperty ;
    rdfs:label "Individual Primary Tumor Stage" ;
    rdfs:range mc2:IndividualPrimaryTumorStageEnum ;
    skos:definition "Extent of the primary cancer based on evidence obtained from clinical assessment parameters determined prior to treatment." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "3440328" .

mc2:Individual_Recurrence_Status a owl:ObjectProperty ;
    rdfs:label "Individual Recurrence Status" ;
    rdfs:range mc2:IndividualRecurrenceStatusEnum ;
    skos:definition "Yes/No/Unknown indicator to identify whether a patient has had a new tumor event after initial treatment." ;
    skos:exactMatch CRDC_CDE:13529783 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "13529783" .

mc2:Individual_Residual_Disease_Status a owl:ObjectProperty ;
    rdfs:label "Individual Residual Disease Status" ;
    rdfs:range mc2:IndividualResidualDiseaseStatusEnum ;
    skos:definition "A text term describing the assessment of the presence of tumor cells remaining in the body following cancer treatment." ;
    skos:exactMatch CRDC_CDE:15157297 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Individual_Treatment_Intent_Type a owl:ObjectProperty ;
    rdfs:label "Individual Treatment Intent Type" ;
    rdfs:range mc2:IndividualTreatmentIntentTypeEnum ;
    skos:definition "Text term to identify the reason for the administration of a treatment regimen." ;
    skos:exactMatch CRDC_CDE:15157467 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Individual_Treatment_or_Therapy_Indicator a owl:ObjectProperty ;
    rdfs:label "Individual Treatment or Therapy Indicator" ;
    rdfs:range mc2:IndividualTreatmentOrTherapyIndicatorEnum ;
    skos:definition "An indicator that describes whether therapy was administered." ;
    skos:exactMatch CRDC_CDE:14713318 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Individual_Tumor_Lymph_Node_Stage a owl:ObjectProperty ;
    rdfs:label "Individual Tumor Lymph Node Stage" ;
    rdfs:range mc2:IndividualTumorLymphNodeStageEnum ;
    skos:definition "Extent of the regional lymph node involvement for the cancer based on evidence obtained from clinical assessment parameters determined prior to treatment." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "3440330" .

mc2:Individual_Vital_Status a owl:ObjectProperty ;
    rdfs:label "Individual Vital Status" ;
    rdfs:range mc2:IndividualVitalStatusEnum ;
    skos:definition "Text term that describes the patient's current vital status." ;
    skos:exactMatch CRDC_CDE:2847330 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "2847330" .

mc2:Individual_Year_of_Birth a owl:DatatypeProperty ;
    rdfs:label "Individual Year of Birth" ;
    rdfs:range xsd:float ;
    skos:definition "The 4-digit year of the subject's birth. Note: a PHI/de-identification consideration was raised and accepted for this field -- see plans/crdc_cde_integration.md." ;
    skos:exactMatch CRDC_CDE:16032218 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Individual_Year_of_Death a owl:DatatypeProperty ;
    rdfs:label "Individual Year of Death" ;
    rdfs:range xsd:float ;
    skos:definition "The year of a subject's death." ;
    skos:exactMatch CRDC_CDE:15112166 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Individual_Year_of_Diagnosis a owl:DatatypeProperty ;
    rdfs:label "Individual Year of Diagnosis" ;
    rdfs:range xsd:float ;
    skos:definition "Numeric value to represent the year of an individual's diagnosis of cancer." ;
    skos:exactMatch CRDC_CDE:15157224 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Individual_dbGaP_Subject_Id a owl:DatatypeProperty ;
    rdfs:label "Individual dbGaP Subject Id" ;
    skos:definition "The identifer assigned to the participant by dbGap" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Institution_Alias a owl:DatatypeProperty ;
    rdfs:label "Institution Alias" ;
    skos:definition "Alias of the institution (e.g. ASU, BU, etc.)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Institution_Full_Name a owl:DatatypeProperty ;
    rdfs:label "Institution Full Name" ;
    skos:definition "Human readable, full name of the institution. (e.g. Arizona State University, Boston University, etc.)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Institution_Location_City a owl:DatatypeProperty ;
    rdfs:label "Institution Location City" ;
    skos:definition "The City the institution is located in." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Institution_Location_State a owl:ObjectProperty ;
    rdfs:label "Institution Location State" ;
    rdfs:range mc2:InstitutionLocationStateEnum ;
    skos:definition "The US state the institution is located in. Use Not Applicable, if not applicable." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Institution_Name a owl:DatatypeProperty ;
    rdfs:label "Institution Name" ;
    skos:definition "Machine readable name of the institution. (e.g. ArizonaStatUniversity, BostonUniversity, etc.)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Institution_id a owl:ObjectProperty ;
    rdfs:label "Institution_id" ;
    rdfs:range mc2:InstitutionIdEnum ;
    skos:definition "Unique, stable, cross-portal identifier for the institution (see Sage Common Data Model's ORGANIZATION entity), used as a key for record linking and updates. Curated only for institutions with a well-formed ROR id." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Last_Known_Institution a owl:DatatypeProperty ;
    rdfs:label "Last Known Institution" ;
    skos:definition "Last known institutional affiliation of the individual." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Model_Acquisition_Type a owl:DatatypeProperty ;
    rdfs:label "Model Acquisition Type" ;
    skos:definition "The method by which the model was obtained. If applicable, please provide a link to the supplier of the model source." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Model_Age a owl:DatatypeProperty ;
    rdfs:label "Model Age" ;
    rdfs:range xsd:float ;
    skos:definition "The age of the model when used for an experiment (mice, zebrafish, etc.) or model source (cell lines, organoids, etc.)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Model_Age_Unit a owl:DatatypeProperty ;
    rdfs:label "Model Age Unit" ;
    skos:definition "The unit corresponding to the age provided for this model." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Model_Genotype a owl:DatatypeProperty ;
    rdfs:label "Model Genotype" ;
    skos:definition "The relevant genotype information associated with the model, including markers, background, etc." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Model_Graft_Source a owl:DatatypeProperty ;
    rdfs:label "Model Graft Source" ;
    skos:definition "If the model is an allograft or xenograft, as indicated by Model Type, please provide a unique identifier associated with the source of the graft material (e.g., RRID, Individual Key, Model Key, Biospecimen Key)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Model_Method a owl:DatatypeProperty ;
    rdfs:label "Model Method" ;
    skos:definition "The term that describes the general method used to create the model." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Model_Source a owl:DatatypeProperty ;
    rdfs:label "Model Source" ;
    skos:definition "The reference organism from which the model was derived, if applicable. This could be a specific Biospecimen Key, Model Key, mouse type, cell line, or other reference. Provide RRID if available, to link to existing cell line information. Do not use this field to designate an Individual as the source of the model." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Model_Type a owl:DatatypeProperty ;
    rdfs:label "Model Type" ;
    skos:definition "The general label used to identify the model type." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:NIH_RePORTER_Link a owl:DatatypeProperty ;
    rdfs:label "NIH RePORTER Link" ;
    skos:definition "Link to the search results for this grant number on the NIH Reporter website" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic Format: uri" .

mc2:Name a owl:DatatypeProperty ;
    rdfs:label "Name" ;
    skos:definition "Name of the individual" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:NanoStringGeoMXROISegmentAnnotation_id a owl:DatatypeProperty ;
    rdfs:label "NanoStringGeoMXROISegmentAnnotation_id" ;
    skos:definition "Unique row identifier, used as a primary key for record updates" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Parent_Biospecimen_Key a owl:DatatypeProperty ;
    rdfs:label "Parent Biospecimen Key" ;
    skos:definition "Biospecimen Key identifer of a biospecimen from which this sample was derived. Do not use this field to reference the source model or individual." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:PersonView_id a owl:DatatypeProperty ;
    rdfs:label "PersonView_id" ;
    skos:definition "A unique primary key that enables record updates using schematic." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Portal_Display a owl:ObjectProperty ;
    rdfs:label "Portal Display" ;
    rdfs:range mc2:PortalDisplayEnum ;
    skos:definition "Display content in CCKP" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:ProjectView_Key a owl:DatatypeProperty ;
    rdfs:label "ProjectView Key" ;
    skos:definition "Unique ProjectView_id foreign key(s) that group the resource with other components, as part of the same grant-associated studies. Please provide multiple values as a comma-separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

mc2:ProjectView_id a owl:DatatypeProperty ;
    rdfs:label "ProjectView_id" ;
    skos:definition "Unique row identifier, used as a primary key for record updates." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Project_Description a owl:DatatypeProperty ;
    rdfs:label "Project Description" ;
    skos:definition "Description of the project" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Project_Name a owl:DatatypeProperty ;
    rdfs:label "Project Name" ;
    skos:definition "Name of the project" ;
    skos:exactMatch CRDC_CDE:11459804 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Project_Short_Name a owl:DatatypeProperty ;
    rdfs:label "Project Short Name" ;
    skos:definition "An acronym or abbreviated form of the title used to refer to an organ-, site- or disease-specific data collection within a broad framework of goals under which related studies or other research activities are grouped." ;
    skos:exactMatch CRDC_CDE:11459806 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Project_Type a owl:ObjectProperty ;
    rdfs:label "Project Type" ;
    rdfs:range mc2:ProjectTypeEnum ;
    skos:definition "Type of project" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:PublicationView_id a owl:DatatypeProperty ;
    rdfs:label "PublicationView_id" ;
    skos:definition "Unique row identifier, used as a primary key for record updates. This should be equivalent to the PubMed Id, unless directed otherwise." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Publication_Abstract a owl:DatatypeProperty ;
    rdfs:label "Publication Abstract" ;
    skos:definition "The abstract of the publication." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Publication_Accessibility a owl:ObjectProperty ;
    rdfs:label "Publication Accessibility" ;
    rdfs:range mc2:PublicationAccessibilityEnum ;
    skos:definition "Whether there are non-monetary restrictions on accessing an the publication." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Publication_Authors a owl:DatatypeProperty ;
    rdfs:label "Publication Authors" ;
    skos:definition "Authors of the publication. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Publication_Doi a owl:DatatypeProperty ;
    rdfs:label "Publication Doi" ;
    skos:definition "The digital object identifier associated with the publication in the form of https://www.doi.org/{doi} to comply with CrossRef DOI display guidelines." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic Format: uri" .

mc2:Publication_Journal a owl:DatatypeProperty ;
    rdfs:label "Publication Journal" ;
    skos:definition "The name of the periodical publication in which the publication was published." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Publication_Title a owl:DatatypeProperty ;
    rdfs:label "Publication Title" ;
    skos:definition "Title of the publication" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Publication_Year a owl:DatatypeProperty ;
    rdfs:label "Publication Year" ;
    rdfs:range xsd:float ;
    skos:definition "Year of the publication" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Pubmed_Id a owl:DatatypeProperty ;
    rdfs:label "Pubmed Id" ;
    skos:definition "The PubMed identifier associated with the publication." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "3443453" .

mc2:Pubmed_Url a owl:DatatypeProperty ;
    rdfs:label "Pubmed Url" ;
    skos:definition "Pubmed URL for the publication" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic Format: uri" .

mc2:Resource_Activity_Type a owl:ObjectProperty ;
    rdfs:label "Resource Activity Type" ;
    rdfs:range mc2:ResourceActivityTypeEnum ;
    skos:definition "The type(s) of activities for which the item is intended to be used. Multiple values should be provided as a comma separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Resource_Alias a owl:DatatypeProperty ;
    rdfs:label "Resource Alias" ;
    skos:definition "A unique identifier (DOI, Synapse ID) for the item, if it exists." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Resource_Contributors a owl:DatatypeProperty ;
    rdfs:label "Resource Contributors" ;
    skos:definition "The name(s) of the contributor(s) to the item. Multiple contributor names should be provided as a comma-separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Resource_Description a owl:DatatypeProperty ;
    rdfs:label "Resource Description" ;
    skos:definition "Abstract or summary of the item." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Resource_Doi a owl:DatatypeProperty ;
    rdfs:label "Resource Doi" ;
    skos:definition "The Digital Object Identifier (DOI) associated with the educational resource." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic Format: uri" .

mc2:Resource_Educational_Level a owl:ObjectProperty ;
    rdfs:label "Resource Educational Level" ;
    rdfs:range mc2:ResourceEducationalLevelEnum ;
    skos:definition "Educational context (pre-school, lower-primary, upper-primary…) in which the item was intended to be used. Multiple values should be provided as a comma separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Resource_Intended_Use a owl:ObjectProperty ;
    rdfs:label "Resource Intended Use" ;
    rdfs:range mc2:ResourceIntendedUseEnum ;
    skos:definition "The purpose of the material for education. Multiple values should be provided as a comma separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Resource_Link a owl:DatatypeProperty ;
    rdfs:label "Resource Link" ;
    skos:definition "The URL that links to the item." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic Format: uri" .

mc2:Resource_Origin_Institution a owl:DatatypeProperty ;
    rdfs:label "Resource Origin Institution" ;
    skos:definition "Institution(s) of origin for this item. Multiple values should be provided as a comma separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Resource_Primary_Audience a owl:ObjectProperty ;
    rdfs:label "Resource Primary Audience" ;
    rdfs:range mc2:ResourcePrimaryAudienceEnum ;
    skos:definition "The intended end user audience for the resource. Multiple values should be provided as a comma separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Resource_Primary_Format a owl:ObjectProperty ;
    rdfs:label "Resource Primary Format" ;
    rdfs:range mc2:ResourcePrimaryFormatEnum ;
    skos:definition "The media type(s) of the item (video, audio, text, etc.) Multiple values should be provided as a comma separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Resource_Title a owl:DatatypeProperty ;
    rdfs:label "Resource Title" ;
    skos:definition "Title of the item." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Resource_Topic a owl:ObjectProperty ;
    rdfs:label "Resource Topic" ;
    rdfs:range mc2:ResourceTopicEnum ;
    skos:definition "General topic or research context of the item. If 'other' is selected, please provide additional topics in the 'Resource Secondary Topic' field. Multiple values should be provided as a comma separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Resource_Use_Requirements a owl:DatatypeProperty ;
    rdfs:label "Resource Use Requirements" ;
    skos:definition "A list of materials, hardware, software, computing power, and network requirements that the end user would need to satisfy before using the resource, if applicable. Multiple values should be provided as a comma separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Rorid a owl:DatatypeProperty ;
    rdfs:label "Rorid" ;
    skos:definition "Unique identifier (ROR ID) of an the institution" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:SequencingLevel1_Key a owl:DatatypeProperty ;
    rdfs:label "SequencingLevel1 Key" ;
    skos:definition "Unique SequencingLevel1_id foreign key(s) that link metadata entries as part of the same Dataset. Please provide multiple values as a comma-separate list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

mc2:SequencingLevel2_Key a owl:DatatypeProperty ;
    rdfs:label "SequencingLevel2 Key" ;
    skos:definition "Unique SequencingLevel2_id foreign key(s) that link metadata entries as part of the same Dataset. Please provide multiple values as a comma-separate list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

mc2:Study_Deidentification_Method_Description a owl:DatatypeProperty ;
    rdfs:label "Study Deidentification Method Description" ;
    skos:definition "Description of the process of removing potentially identifying data or data elements to render data into a form that does not identify individuals and where identification is not likely to take place." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Study_Deidentification_Method_Software a owl:DatatypeProperty ;
    rdfs:label "Study Deidentification Method Software" ;
    skos:definition "Software that was used to de-identify the data (if used)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Study_Deidentification_Method_Type a owl:ObjectProperty ;
    rdfs:label "Study Deidentification Method Type" ;
    rdfs:range mc2:StudyDeidentificationMethodTypeEnum ;
    skos:definition "General description of the de-identification method. Maps to DUOplus3." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "14576319" .

mc2:Study_Description a owl:DatatypeProperty ;
    rdfs:label "Study Description" ;
    skos:definition "Description of the study, including the types of experimental assays, model systems, types of analysis, description of cohort, associated vulnerable populations, special categories of data, rare diseases, etc. Maps to DUOplus2." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "03444002" .

mc2:Study_Index_Date a owl:ObjectProperty ;
    rdfs:label "Study Index Date" ;
    rdfs:range mc2:StudyIndexDateEnum ;
    skos:definition "The reference event associated with timepoints in this study. One of Diagnosis Date, Enrollment Date, Collection Date, or Birth Date." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Study_Name a owl:DatatypeProperty ;
    rdfs:label "Study Name" ;
    skos:definition "Name of the study" ;
    skos:exactMatch CRDC_CDE:11459810 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "11459810" .

mc2:Study_Number_of_Participants a owl:DatatypeProperty ;
    rdfs:label "Study Number of Participants" ;
    rdfs:range xsd:float ;
    skos:definition "The number of participant instances associated with systematic investigation into a subject." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "11555662" .

mc2:Study_Number_of_Samples a owl:DatatypeProperty ;
    rdfs:label "Study Number of Samples" ;
    rdfs:range xsd:float ;
    skos:definition "The number of specimens associated with systematic investigation into a subject." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "11555663" .

mc2:Study_Project_Identifier a owl:DatatypeProperty ;
    rdfs:label "Study Project Identifier" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "syn[0-9]+" ] ) ] ;
    skos:definition "The Synapse Project identifier (synID) with which this Study is related." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Study_Short_Name a owl:DatatypeProperty ;
    rdfs:label "Study Short Name" ;
    skos:definition "The acronym or abbreviated form of the title for a research data collection (e.g. GLIOMA01)." ;
    skos:exactMatch CRDC_CDE:11459812 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Study_dbGaP_Accession_Id a owl:DatatypeProperty ;
    rdfs:label "Study dbGaP Accession Id" ;
    skos:definition "A stable unique alphanumeric identifier assigned to a study and any objects by the database of Genotypes and Phenotypes (dbGaP). Required for controlled access data being submitted to CDS/CRDC." ;
    skos:exactMatch CRDC_CDE:11524544 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "11524544" .

mc2:Study_id a owl:DatatypeProperty ;
    rdfs:label "Study_id" ;
    skos:definition "Unique row identifier, used as a primary key for record updates." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "12960571" .

mc2:Synapse_ID_of_GeoMx_DSP_Config_File a owl:DatatypeProperty ;
    rdfs:label "Synapse ID of GeoMx DSP Config File" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^syn\\d{7,8}$" ] ) ] ;
    skos:definition "Synapse ID of config.ini file generated by the GeoMx DSP workflow." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Synapse_ID_of_GeoMx_DSP_PKC_File a owl:DatatypeProperty ;
    rdfs:label "Synapse ID of GeoMx DSP PKC File" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^syn\\d{7,8}$" ] ) ] ;
    skos:definition "The Synapse ID(s) associated with the PKC mapping file for the assay. Multiple files are listed as comma separated values." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Synapse_ID_of_GeoMx_DSP_ROI_Segment_Annotation_File a owl:DatatypeProperty ;
    rdfs:label "Synapse ID of GeoMx DSP ROI Segment Annotation File" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^syn\\d{7,8}$" ] ) ] ;
    skos:definition "Synapse ID(s) for ROI/AOI/Segmentation annotations in the GeoMx DSP experiment." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Synapse_ID_of_GeoMx_Lab_Worksheet_File a owl:DatatypeProperty ;
    rdfs:label "Synapse ID of GeoMx Lab Worksheet File" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^syn\\d{7,8}$" ] ) ] ;
    skos:definition "Synapse ID(s) of Lab Worksheet Files output from the GeoMx DSP workflow. Multiple files are listed as comma separated values." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Synapse_Profile_Id a owl:DatatypeProperty ;
    rdfs:label "Synapse Profile Id" ;
    skos:definition "Unique identifier (Synapse Profile ID) of the individual. See identifer in the url of the synapse profile page." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Theme_Description a owl:DatatypeProperty ;
    rdfs:label "Theme Description" ;
    skos:definition "Description of the research theme." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Theme_Display_Name a owl:DatatypeProperty ;
    rdfs:label "Theme Display Name" ;
    skos:definition "Human readable display name of the research theme. (e.g. Computational Resource, Drug Resistance/Sensitivity)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Theme_Name a owl:DatatypeProperty ;
    rdfs:label "Theme Name" ;
    skos:definition "Machine readable name of the research theme. (e.g. compuational_resource, drug_resistance_sensitivity)." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:ToolView_id a owl:DatatypeProperty ;
    rdfs:label "ToolView_id" ;
    skos:definition "Unique row identifier, used as a primary key for record updates." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Tool_Accessibility a owl:ObjectProperty ;
    rdfs:label "Tool Accessibility" ;
    rdfs:range mc2:ToolAccessibilityEnum ;
    skos:definition "Whether there are non-monetary restrictions on accessing an online service." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Cmd a owl:DatatypeProperty ;
    rdfs:label "Tool Cmd" ;
    skos:definition "Relevant command, command-line fragment, or option for executing this function/running the tool in this mode." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Cost a owl:ObjectProperty ;
    rdfs:label "Tool Cost" ;
    rdfs:range mc2:ToolCostEnum ;
    skos:definition "Monetary cost of acquiring the software." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Date_Last_Modified a owl:DatatypeProperty ;
    rdfs:label "Tool Date Last Modified" ;
    skos:definition "The date indicating when the tool's entry was most recently modified or updated, providing a timestamp of the latest changes made to the tool's information." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: schema.org",
        "schematic Format: date" .

mc2:Tool_Description a owl:DatatypeProperty ;
    rdfs:label "Tool Description" ;
    skos:definition "Textual description of the tool." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Documentation_Note a owl:DatatypeProperty ;
    rdfs:label "Tool Documentation Note" ;
    skos:definition "Comment about the documentation." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Documentation_Url a owl:DatatypeProperty ;
    rdfs:label "Tool Documentation Url" ;
    skos:definition "Link to documentation on the web for the tool." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema",
        "schematic Format: uri" .

mc2:Tool_Doi a owl:DatatypeProperty ;
    rdfs:label "Tool Doi" ;
    skos:definition "The Digital Object Identifier (DOI) associated with the computational tool." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic Format: uri" .

mc2:Tool_Download_Note a owl:DatatypeProperty ;
    rdfs:label "Tool Download Note" ;
    skos:definition "Comment about the download." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Download_Type a owl:ObjectProperty ;
    rdfs:label "Tool Download Type" ;
    rdfs:range mc2:ToolDownloadTypeEnum ;
    skos:definition "The type of data, information, or system that is obtained when the link is resolved." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Download_Url a owl:DatatypeProperty ;
    rdfs:label "Tool Download Url" ;
    skos:definition "Link to download (or repo providing a download) for the software." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema",
        "schematic Format: uri" .

mc2:Tool_Download_Version a owl:DatatypeProperty ;
    rdfs:label "Tool Download Version" ;
    skos:definition "Version information (typically a version number) of the software applicable to this download." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Entity_Role a owl:ObjectProperty ;
    rdfs:label "Tool Entity Role" ;
    rdfs:range mc2:ToolEntityRoleEnum ;
    skos:definition "Role performed by entity that is credited, e.g. “Developer”" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Entity_Type a owl:ObjectProperty ;
    rdfs:label "Tool Entity Type" ;
    rdfs:range mc2:ToolEntityTypeEnum ;
    skos:definition "Types of entities that may be credited, e.g. ‘Person’." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Function_Note a owl:DatatypeProperty ;
    rdfs:label "Tool Function Note" ;
    skos:definition "Concise comment about this function, if not apparent from the software description and EDAM annotations." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Homepage a owl:DatatypeProperty ;
    rdfs:label "Tool Homepage" ;
    skos:definition "Homepage of the software, or some URL that best serves this purpose." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema",
        "schematic Format: uri" .

mc2:Tool_Input_Data a owl:ObjectProperty ;
    rdfs:label "Tool Input Data" ;
    rdfs:range mc2:ToolInputDataEnum ;
    skos:definition "Type of primary input data. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Input_Format a owl:ObjectProperty ;
    rdfs:label "Tool Input Format" ;
    rdfs:range mc2:ToolInputFormatEnum ;
    skos:definition "Allowed format(s) of the input data. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Link_Note a owl:DatatypeProperty ;
    rdfs:label "Tool Link Note" ;
    skos:definition "Comment about the link." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Link_Url a owl:DatatypeProperty ;
    rdfs:label "Tool Link Url" ;
    skos:definition "A link of some relevance to the software (URL)." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema",
        "schematic Format: uri" .

mc2:Tool_Name a owl:DatatypeProperty ;
    rdfs:label "Tool Name" ;
    skos:definition "Canonical tool name provided by the tool developer or service provider." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Operation a owl:ObjectProperty ;
    rdfs:label "Tool Operation" ;
    rdfs:range mc2:ToolOperationEnum ;
    skos:definition "The basic operation(s) performed by this software function. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Output_Data a owl:ObjectProperty ;
    rdfs:label "Tool Output Data" ;
    rdfs:range mc2:ToolOutputDataEnum ;
    skos:definition "Type of primary output data. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Output_Format a owl:ObjectProperty ;
    rdfs:label "Tool Output Format" ;
    rdfs:range mc2:ToolOutputFormatEnum ;
    skos:definition "Allowed format(s) of the output data. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Tool_Package_Dependencies_Present a owl:ObjectProperty ;
    rdfs:label "Tool Package Dependencies Present" ;
    rdfs:range mc2:ToolPackageDependenciesPresentEnum ;
    skos:definition "Indicates whether the required package dependencies for tool are present." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: CWL" .

mc2:Tool_Release_Date a owl:DatatypeProperty ;
    rdfs:label "Tool Release Date" ;
    skos:definition "The release date of a product or product model. This can be used to distinguish the exact variant of a product." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: schema.org",
        "schematic Format: date" .

mc2:Tool_Version a owl:DatatypeProperty ;
    rdfs:label "Tool Version" ;
    skos:definition "Version information (typically a version number) of the software applicable to this entry." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: biotoolsschema" .

mc2:Url a owl:DatatypeProperty ;
    rdfs:label "Url" ;
    skos:definition "URL, e.g., individual's home page address" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic Format: uri" .

mc2:Visium_Applied_Hard_Trimming a owl:ObjectProperty ;
    rdfs:label "Visium Applied Hard Trimming" ;
    rdfs:range mc2:VisiumAppliedHardTrimmingEnum ;
    skos:definition "Was Hard Trimming applied" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: HTAN" .

mc2:Visium_Image_Re_orientation a owl:ObjectProperty ;
    rdfs:label "Visium Image Re-orientation" ;
    rdfs:range mc2:VisiumImageRe-orientationEnum ;
    skos:definition "To ensure good fiducial alignment and tissue spots detection, it is important to correct for this shift in orientation." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: HTAN" .

mc2:Visium_Mean_Reads_per_Spatial_Spot a owl:DatatypeProperty ;
    rdfs:label "Visium Mean Reads per Spatial Spot" ;
    rdfs:range xsd:float ;
    skos:definition "The number of reads, both under and outside of tissue, divided by the number of barcodes associated with a spot under tissue." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: HTAN" .

mc2:Visium_Median_Number_Genes_per_Spatial_Spot a owl:DatatypeProperty ;
    rdfs:label "Visium Median Number Genes per Spatial Spot" ;
    rdfs:range xsd:float ;
    skos:definition "The median number of genes detected per spot under tissue-associated barcode. Detection is defined as the presence of at least 1 UMI count." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: HTAN" .

mc2:Visium_Median_UMI_Counts_per_Spot a owl:DatatypeProperty ;
    rdfs:label "Visium Median UMI Counts per Spot" ;
    rdfs:range xsd:float ;
    skos:definition "The median number of UMI counts per tissue covered spot." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: HTAN" .

mc2:Visium_Permeabilization_Time a owl:DatatypeProperty ;
    rdfs:label "Visium Permeabilization Time" ;
    rdfs:range xsd:float ;
    skos:definition "Fixed and stained tissue sections are permeabilized for different times. Each Capture Area captures polyadenylated mRNA from the attached tissue section. Measure is provided in minutes." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: HTAN" .

mc2:Visium_Proportion_Reads_Mapped a owl:DatatypeProperty ;
    rdfs:label "Visium Proportion Reads Mapped" ;
    rdfs:range xsd:float ;
    skos:definition "Proportion of mapped reads collected from samtools. Number" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: HTAN" .

mc2:Visium_Proportion_Reads_Mapped_to_Transcriptome a owl:DatatypeProperty ;
    rdfs:label "Visium Proportion Reads Mapped to Transcriptome" ;
    rdfs:range xsd:float ;
    skos:definition "Fraction of reads that mapped to a unique gene in the transcriptome. The read must be consistent with annotated splice junctions. These reads are considered for UMI counting." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: HTAN" .

mc2:Visium_Slide_Version a owl:ObjectProperty ;
    rdfs:label "Visium Slide Version" ;
    rdfs:range mc2:VisiumSlideVersionEnum ;
    skos:definition "Version of imaging slide used. Slide version is critical for the analysis of the sequencing data as different slides have different capture area layouts." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: HTAN" .

mc2:Visium_Spatial_Barcode_Tag a owl:DatatypeProperty ;
    rdfs:label "Visium Spatial Barcode Tag" ;
    skos:definition "SAM tag for spot barcode field; please provide a valid tag-type pair, consisting of a tag (e.g. CB or CR) and type (e.g. Z) separated by a colon." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: HTAN" .

mc2:Visium_Spatial_Library_Construction_Method a owl:ObjectProperty ;
    rdfs:label "Visium Spatial Library Construction Method" ;
    rdfs:range mc2:VisiumSpatialLibraryConstructionMethodEnum ;
    skos:definition "Process which results in the creation of a library from fragments of DNA using cloning vectors or oligonucleotides with the role of adaptors [OBI_0000711]" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: HTAN" .

mc2:Visium_Spatial_Read1 a owl:ObjectProperty ;
    rdfs:label "Visium Spatial Read1" ;
    rdfs:range mc2:VisiumSpatialRead1Enum ;
    skos:definition "Read 1 content description" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: HTAN" .

mc2:Visium_Spatial_Read2 a owl:ObjectProperty ;
    rdfs:label "Visium Spatial Read2" ;
    rdfs:range mc2:VisiumSpatialRead2Enum ;
    skos:definition "Read 2 content description" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: HTAN" .

mc2:Visium_Spots_under_tissue a owl:DatatypeProperty ;
    rdfs:label "Visium Spots under tissue" ;
    rdfs:range xsd:float ;
    skos:definition "The number of barcodes associated with a spot under tissue." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: HTAN" .

mc2:Visium_UMI_Tag a owl:DatatypeProperty ;
    rdfs:label "Visium UMI Tag" ;
    skos:definition "SAM tag for the UMI field; please provide a valid tag-type pair, consisting of a tag (e.g. UB or UR) and type (e.g. Z) separated by a colon." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: HTAN" .

mc2:Visium_Whitelist_Spatial_Barcode_File_Link a owl:DatatypeProperty ;
    rdfs:label "Visium Whitelist Spatial Barcode File Link" ;
    skos:definition "Link to file listing all possible spatial barcodes. URL" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: HTAN" .

mc2:Visium_Workflow_Parameters_Description a owl:DatatypeProperty ;
    rdfs:label "Visium Workflow Parameters Description" ;
    skos:definition "Parameters used to run the workflow." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: HTAN" .

mc2:Visium_Workflow_Type a owl:DatatypeProperty ;
    rdfs:label "Visium Workflow Type" ;
    skos:definition "Generic name for the workflow used to analyze the visium data set." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: HTAN" .

mc2:Website a owl:DatatypeProperty ;
    rdfs:label "Website" ;
    skos:definition "Website of research consortium" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic Format: uri" .

mc2:Working_Group_Participation a owl:ObjectProperty ;
    rdfs:label "Working Group Participation" ;
    rdfs:range mc2:WorkingGroupParticipationEnum ;
    skos:definition "CSBC/PSON working group(s) of which the individual is a member (current and former). Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:accessType a owl:ObjectProperty ;
    rdfs:label "accessType" ;
    rdfs:range mc2:AccessTypeEnum ;
    skos:definition "Access type for the dataset." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:ageGroup a owl:DatatypeProperty ;
    rdfs:label "ageGroup" ;
    skos:definition "Age group of the individual(s)/subject(s) the dataset's data were generated from (e.g. Adult). Free text pending a confident controlled vocabulary - too few real values observed to seed one yet." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:alternateName a owl:DatatypeProperty ;
    rdfs:label "alternateName" ;
    skos:definition "An altername name that can be used for search and discovery improvement." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:citation a owl:DatatypeProperty ;
    rdfs:label "citation" ;
    skos:definition "Academic articles that are recommended by the data provider to be cited in addition to the dataset doi itself. Can be identical to DatasetView.PublicationView Key." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:community a owl:DatatypeProperty ;
    rdfs:label "community" ;
    skos:definition "The Sage Bionetworks project or initiative with which the dataset is associated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:conditionsOfAccess a owl:DatatypeProperty ;
    rdfs:label "conditionsOfAccess" ;
    skos:definition "Additional requirements a user may need outside of Data Use Modifiers. This could include additional registration, updating profile information, joining a Synapse Team, or using specific authentication methods like 2FA or RAS. Omit property if not applicable/unknown." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:creator a owl:DatatypeProperty ;
    rdfs:label "creator" ;
    skos:definition "Organization or person that is creator of the dataset. Default is the PI of the project and/or the user who created all files in the dataset." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:croissant_s3_file_object a owl:DatatypeProperty ;
    rdfs:label "croissant_s3_file_object" ;
    skos:definition "A Synapse url where the croissant file associated with this dataset is stored." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic Format: uri" .

mc2:dataCatalogLicense a owl:ObjectProperty ;
    rdfs:label "dataCatalogLicense" ;
    rdfs:range mc2:DataCatalogLicenseEnum ;
    skos:definition "The terms and conditions underwhich the data are allowed to be accessed and used. Unless information for license is clear, this should default to UNKNOWN." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:datePublished a owl:DatatypeProperty ;
    rdfs:label "datePublished" ;
    rdfs:range xsd:float ;
    skos:definition "Date data were published/available on Synapse." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    skos:definition "A text description of the dataset. Can be identifical to Dataset Description." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:diseaseFocus a owl:DatatypeProperty ;
    rdfs:label "diseaseFocus" ;
    skos:definition "Disease area the dataset focuses on, as annotated directly on the Synapse Dataset entity. Not populated in current practice." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:doi a owl:DatatypeProperty ;
    rdfs:label "doi" ;
    skos:definition "Digital Object Identifier (DOI) for citation and identification. Can be identical to Dataset Doi" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic Format: uri" .

mc2:downloadType a owl:ObjectProperty ;
    rdfs:label "downloadType" ;
    rdfs:range mc2:DownloadTypeEnum ;
    skos:definition "Hosting type for the dataset's files, as annotated directly on the Synapse Dataset entity (distinct from the CCKP portal's own DatasetView.downloadType column)." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:includedInDataCatalog a owl:DatatypeProperty ;
    rdfs:label "includedInDataCatalog" ;
    skos:definition "Link(s) to known data catalog(s) the dataset is included in." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:individualCount a owl:DatatypeProperty ;
    rdfs:label "individualCount" ;
    rdfs:range xsd:float ;
    skos:definition "The number of participants or samples associated with the files in the dataset. Can be identical to Study Number of Participants or DSP Number of Participants" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:keywords a owl:DatatypeProperty ;
    rdfs:label "keywords" ;
    skos:definition "Keywords associated with the dataset. Can be identical to Publication Keywords." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:link a owl:DatatypeProperty ;
    rdfs:label "link" ;
    skos:definition "The url where the dataset is displayed, typically on a public-facing data portal. Can be identical to Dataset Url." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic Format: uri" .

mc2:manifestation a owl:ObjectProperty ;
    rdfs:label "manifestation" ;
    rdfs:range mc2:ManifestationEnum ;
    skos:definition "Tumor type or other clinical manifestation associated with the dataset. Can be identical to Dataset Tumor Type." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:portal a owl:DatatypeProperty ;
    rdfs:label "portal" ;
    skos:definition "The Sage Bionetworks portal that curated this record (e.g. CCKP). Distinguishes provenance if this vocabulary is ever shared across multiple Sage portals." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:series a owl:DatatypeProperty ;
    rdfs:label "series" ;
    skos:definition "Data series designation (e.g., NF-OSI Processed Data)." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:specimenCount a owl:DatatypeProperty ;
    rdfs:label "specimenCount" ;
    rdfs:range xsd:float ;
    skos:definition "Number of unique specimens in the dataset. Can be identical to DSP Number of Samples." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:title a owl:DatatypeProperty ;
    rdfs:label "title" ;
    skos:definition "The name of the dataset." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:visualizeDataOn a owl:DatatypeProperty ;
    rdfs:label "visualizeDataOn" ;
    skos:definition "Links to external visualization platforms." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic Format: uri" .

mc2:yearProcessed a owl:DatatypeProperty ;
    rdfs:label "yearProcessed" ;
    rdfs:range xsd:float ;
    skos:definition "Year the data were processed (used with specific series only)." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

