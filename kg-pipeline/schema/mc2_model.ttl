    rdfs:range xsd:float ;
    skos:definition "Number of days between the date used for index and the date the treatment started." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Individual_Gender a owl:ObjectProperty ;
    rdfs:label "Individual Gender" ;
    rdfs:range mc2:IndividualGenderEnum ;
    skos:definition "Text designations that identify gender. Gender is described as the assemblage of properties that distinguish people on the basis of their societal roles. Identification of gender is based upon self-report and may come from a form, questionnaire, interview, etc." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Individual_Last_Known_Disease_Status a owl:ObjectProperty ;
    rdfs:label "Individual Last Known Disease Status" ;
    rdfs:range mc2:IndividualLastKnownDiseaseStatusEnum ;
    skos:definition "Text term that describes the last known status of an individual." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Individual_Metastasis_Stage a owl:ObjectProperty ;
    rdfs:label "Individual Metastasis Stage" ;
    rdfs:range mc2:IndividualMetastasisStageEnum ;
    skos:definition "Extent of the distant metastasis for the cancer based on evidence obtained from clinical assessment parameters determined prior to treatment." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "3440331" .

mc2:Individual_Primary_Diagnosis a owl:ObjectProperty ;
    rdfs:label "Individual Primary Diagnosis" ;
