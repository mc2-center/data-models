mc2:NGS_Library_Strategy a owl:ObjectProperty ;
    rdfs:label "NGS Library Strategy" ;
    rdfs:range mc2:NGSLibraryStrategyEnum ;
    skos:definition "The assay associated with the nucleic acid library (e.g., RNA-Seq, ChIP-Seq)" ;
    skos:exactMatch CRDC_CDE:6273393 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "6273393" .

mc2:NGS_Read_Length a owl:DatatypeProperty ;
    rdfs:label "NGS Read Length" ;
    rdfs:range xsd:float ;
    skos:definition "The average length of the sequencing reads. Can be integer, null" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "12426615" .

mc2:NGS_Sequencing_Design_Description a owl:DatatypeProperty ;
    rdfs:label "NGS Sequencing Design Description" ;
    skos:definition "Free-form description of the methods used to create the sequencing library; a brief 'materials and methods' section." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "11529028" .

mc2:NGS_Unique_Bases a owl:DatatypeProperty ;
    rdfs:label "NGS Unique Bases" ;
    rdfs:range xsd:float ;
    skos:definition "Count of unique basecalls present in the data." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:ResourceAccessHazardEnum a owl:Class ;
    rdfs:label "Resource Access Hazard Enum" ;
    owl:unionOf ( <https://w3id.org/mc2-center/mc2-model/ResourceAccessHazardEnum#Flashing> <https://w3id.org/mc2-center/mc2-model/ResourceAccessHazardEnum#Motion> <https://w3id.org/mc2-center/mc2-model/ResourceAccessHazardEnum#Simulation> <https://w3id.org/mc2-center/mc2-model/ResourceAccessHazardEnum#Sound> ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values <https://w3id.org/mc2-center/mc2-model/ResourceAccessHazardEnum#Flashing>,
        <https://w3id.org/mc2-center/mc2-model/ResourceAccessHazardEnum#Motion>,
        <https://w3id.org/mc2-center/mc2-model/ResourceAccessHazardEnum#Simulation>,
        <https://w3id.org/mc2-center/mc2-model/ResourceAccessHazardEnum#Sound> .

mc2:ResourceIntendedUseEnum a owl:Class ;
    rdfs:label "Resource Intended Use Enum" ;
    owl:unionOf ( mesh:D003479 NCIT:C25217 <https://w3id.org/mc2-center/mc2-model/ResourceIntendedUseEnum#Professional%20Development> NCIT:C17649 ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values mesh:D003479,
        NCIT:C17649,
        NCIT:C25217,
        <https://w3id.org/mc2-center/mc2-model/ResourceIntendedUseEnum#Professional%20Development> .

mc2:Software_and_Version a owl:DatatypeProperty ;
    rdfs:label "Software and Version" ;
    skos:definition "Name of software used to generate the information contained in the file. String" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "11529072" .

mc2:StudyDeidentificationMethodTypeEnum a owl:Class ;
    rdfs:label "Study Deidentification Method Type Enum" ;
    owl:unionOf ( NCIT:C63513 NCIT:C172484 NCIT:C70669 NCIT:C48660 ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values NCIT:C172484,
        NCIT:C48660,
        NCIT:C63513,
        NCIT:C70669 .

mc2:StudyIndexDateEnum a owl:Class ;
    rdfs:label "Study Index Date Enum" ;
    owl:unionOf ( NCIT:C164339 NCIT:C222473 NCIT:C81286 NCIT:C68615 ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values NCIT:C164339,
        NCIT:C222473,
        NCIT:C68615,
        NCIT:C81286 .

mc2:VisiumSlideVersionEnum a owl:Class ;
    rdfs:label "Visium Slide Version Enum" ;
    owl:unionOf ( EFO:0022857 EFO:0022858 <https://w3id.org/mc2-center/mc2-model/VisiumSlideVersionEnum#V3> <https://w3id.org/mc2-center/mc2-model/VisiumSlideVersionEnum#V4> ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values EFO:0022857,
        EFO:0022858,
        <https://w3id.org/mc2-center/mc2-model/VisiumSlideVersionEnum#V3>,
        <https://w3id.org/mc2-center/mc2-model/VisiumSlideVersionEnum#V4> .

mc2:Visium_Run_ID a owl:DatatypeProperty ;
    rdfs:label "Visium Run ID" ;
    skos:definition "A unique identifier for this individual run (typically associated with a single slide) of the spatial transcriptomic processing workflow." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: HTAN" .

EDAM:data_0582 a owl:Class ;
    rdfs:label "Ontology" ;
    rdfs:subClassOf mc2:ToolInputDataEnum,
        mc2:ToolOutputDataEnum,
        mc2:ToolTypeEnum ;
    skos:definition "A collection of information about concepts, including terms, synonyms, descriptions etc." .

EDAM:data_3112 a owl:Class ;
    rdfs:label "Gene Expression Matrix",
        "Normalized Counts" ;
    rdfs:subClassOf mc2:NGSMatrixTypeEnum,
        mc2:ToolInputDataEnum,
        mc2:ToolOutputDataEnum ;
    skos:definition "A matrix of feature counts that has been adjusted (e.g., for sequencing depth or library size) to enable comparison across cells or samples." .

EDAM:data_3669 a owl:Class ;
    rdfs:label "Training Material" ;
    rdfs:subClassOf mc2:ToolDocumentationTypeEnum,
        mc2:ToolInputDataEnum,
        mc2:ToolOutputDataEnum .

EDAM:data_3914 a owl:Class ;
    rdfs:label "Quality Control Report",
        "qc result html" ;
    rdfs:subClassOf mc2:ToolInputDataEnum,
        mc2:ToolOutputDataEnum,
        mc2:VisiumFileTypeEnum ;
    skos:definition "HTML quality-control report summarizing metrics from Space Ranger processing of a Visium sample, such as sequencing, alignment, and spatial coverage statistics." .

EDAM:data_3917 a owl:Class ;
    rdfs:label "Count Matrix",
        "Raw Counts" ;
    rdfs:subClassOf mc2:NGSMatrixTypeEnum,
        mc2:ToolInputDataEnum,
        mc2:ToolOutputDataEnum ;
    skos:definition "The unprocessed matrix of read or fragment counts per feature (e.g., gene or transcript) per cell or sample, prior to any normalization, scaling, or batch correction." .

EDAM:format_2013 a owl:Class ;
    rdfs:label "Biological Model Format",
        "Biological Pathway Or Network Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "A category of formats used to encode computational or mathematical models of biological systems and processes, such as reaction networks or systems biology models.",
        "Data format for representing a biological pathway or network." .

EDAM:format_2330 a owl:Class ;
    rdfs:label "TXT",
        "Textual Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "A generic category of formats in which data is represented as plain text.",
        "Generic plain-text file format, in which data is represented as unstructured or loosely structured human-readable text." .

EDAM:format_3549 a owl:Class ;
    rdfs:label "NIFTI Format",
        "nii" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "An open file format from the Neuroimaging Informatics Technology Initiative (NIfTI), commonly used to store brain imaging data obtained via Magnetic Resonance Imaging (MRI)." .

operation:3795 a owl:Class ;
    rdfs:label "In Vitro Selection" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An iterative laboratory process for isolating molecules (e.g., nucleic acids or proteins) with desired properties from a large pool through repeated rounds of selection and amplification outside a living organism." .

mesh:D000072760 a owl:Class ;
    rdfs:label "Single-Molecule Tracking" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A microscopy technique that follows the spatial position of individual fluorescently labeled molecules over time to study their movement, diffusion, or interaction dynamics within a cell." .

mesh:D000073798 a owl:Class ;
    rdfs:label "Second-Harmonic Imaging Microscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An imaging technique that produces spatially resolved images based on the differences in the excited state decay rates of fluorescent compounds in a sample." .

mesh:D000097913 a owl:Class ;
    rdfs:label "Confocal Reflectance Quantitative Phase Microscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A system of (usually) epifluorescence light microscopy in which a fine laser beam of light is scanned over the object through the objective lens. This technique is particularly good at rejecting light from outside the plane of focus and so produces higher effective resolution than other microscopy techniques." .

mesh:D012984 a owl:Class ;
    rdfs:label "Computational Tool" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A computer program or algorithm used to process, analyze, or interpret biological or experimental data." .

mesh:D019044 a owl:Class ;
    rdfs:label "Image Cytometry" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A flow cytometry technique that utilizes mass spectrometry to detect antibodies labeled with heavy metal ion tags that are bound to antigens of interest on single cells." .

mesh:D046210 a owl:Class ;
    rdfs:label "Microfluidics" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A technology that manipulates small volumes of fluid (nanoliter to microliter scale) through networks of miniaturized channels, used for high-throughput single-cell or biochemical assays." .

mesh:D062308 a owl:Class ;
    rdfs:label "Optogenetic Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The combination of genetic and optical methods to control specific cellular events with temporal precision in targeted cells of a functioning biological system." .

CHMO:0000062 a owl:Class ;
    rdfs:label "Forster Resonance Energy Transfer" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A method for determining the distance between two molecules by measuring the energy transfer between two chromophores (a donor and an acceptor) in close proximity." .

CHMO:0000065 a owl:Class ;
    rdfs:label "Fluorescence Recovery After Photo-Bleaching" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The use of a special microscope to see objects that give off fluorescent light. For example, cells or tissue can be treated with a substance that contains a fluorescent dye. The dye lights up when viewed under a microscope with a special light." .

CHMO:0000074 a owl:Class ;
    rdfs:label "Field-Emission Scanning Electron Microscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Scanning electron microscopy that uses a field-emission electron source to produce a finely focused, high-resolution electron beam." .

CHMO:0000142 a owl:Class ;
    rdfs:label "Electron Diffraction" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Any form of microscopy in which the interactions of electrons with the specimens are used to provide information about the final structure of that specimen." .

CHMO:0000156 a owl:Class ;
    rdfs:label "X-Ray Diffraction" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A technique in crystallography in which the pattern produced by the diffraction of x-rays through the closely spaced lattice of atoms in a crystal is recorded and then analyzed to reveal the nature of that lattice." .

CHMO:0000168 a owl:Class ;
    rdfs:label "Multi-Angle Light Scattering" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A method for determining particle size and molecular weight by measuring the intensity of light scattered from a sample at multiple angles." .

CHMO:0000204 a owl:Class ;
    rdfs:label "Small-Angle X-ray Scattering" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A technique in crystallography in which the pattern produced by the diffraction of x-rays through the closely spaced lattice of atoms in a crystal is recorded and then analyzed to reveal the nature of that lattice." .

CHMO:0000239 a owl:Class ;
    rdfs:label "Graphite Furnace Atomic Absorption Spectrometry" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A technique utilizing a scanning probe to image and analyze the surface of a material with atomic-level resolution." .

CHMO:0000251 a owl:Class ;
    rdfs:label "Optical Emission Spectroscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The technique of measuring the emission and absorption of different wavelengths (spectra) of visible and non-visible light. This can be done via a spectroscope, which consists of a slit, prism, collimator lens, object lens, and a grating." .

CHMO:0000288 a owl:Class ;
    rdfs:label "Fluorescence Correlation Spectroscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The technique of measuring the emission and absorption of different wavelengths (spectra) of visible and non-visible light. This can be done via a spectroscope, which consists of a slit, prism, collimator lens, object lens, and a grating." .

CHMO:0000323 a owl:Class ;
    rdfs:label "Circular Dichroism Spectroscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The technique of measuring the emission and absorption of different wavelengths (spectra) of visible and non-visible light. This can be done via a spectroscope, which consists of a slit, prism, collimator lens, object lens, and a grating." .

CHMO:0000628 a owl:Class ;
    rdfs:label "Vibrational Spectroscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The technique of measuring the emission and absorption of different wavelengths (spectra) of visible and non-visible light. This can be done via a spectroscope, which consists of a slit, prism, collimator lens, object lens, and a grating." .

CHMO:0000636 a owl:Class ;
    rdfs:label "Fourier-Transform Infrared Spectroscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A type of mass spectrometry that uses the cyclotron frequency of ions in a fixed magnetic field to determine their ionic mass-to-charge ratio." .

CHMO:0000675 a owl:Class ;
    rdfs:label "Stimulated Raman Scattering" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Emission of electromagnetic energy with a shorter frequency (longer wavelength) than that of the incident monochromatic light.  Arises from the low probability absorption of quanta with a higher energy than that required for a transition: the difference in energy is emitted as a lower frequency (energy) photon.  Allows analysis of vibrational and rotational energy levels using visible incident light." .

CHMO:0000683 a owl:Class ;
    rdfs:label "Isothermal Titration Calorimetry" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The measurement of thermodynamic parameters (e.g. enthalpy) at constant temperature during a titration." .

CHMO:0000701 a owl:Class ;
    rdfs:label "Liquid Chromatography/Tandem Mass Spectrometry" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An analytical technique wherein liquid chromatography is coupled to tandem mass spectrometry in order to separate, identify, and quantify substances in a sample." .

CHMO:0000736 a owl:Class ;
    rdfs:label "Electrospray Ionization Time-of-Flight Mass Spectrometry" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An analytical technique wherein ions are separated according to their ratio of charge to mass. From the mass spectrum produced, the atomic weight of the particle can be deduced." .

CHMO:0000915 a owl:Class ;
    rdfs:label "Rheometry" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The measurement of the flow and deformation behavior of fluids or soft materials in response to applied stress." .

CHMO:0001007 a owl:Class ;
    rdfs:label "Thin-Layer Chromatography" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A planar chromatography technique in which the stationary phase is a thin layer of sorbent applied to a rigid backing (e.g., glass or aluminum), used to separate mixtures of compounds." .

CHMO:0001074 a owl:Class ;
    rdfs:label "Time Lapse Microscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The use of various technologies to resolve the structure or features of objects too small or fine to naturally be seen by eye." .

CHMO:0001122 a owl:Class ;
    rdfs:label "Dynamic Force Spectroscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The technique of measuring the emission and absorption of different wavelengths (spectra) of visible and non-visible light. This can be done via a spectroscope, which consists of a slit, prism, collimator lens, object lens, and a grating." .

CHMO:0001259 a owl:Class ;
    rdfs:label "Reverse-Phase High-Performance liquid Chromatography" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Liquid chromatography in which the mobile phase is significantly more polar than the nonpolar stationary phase, commonly used to separate small molecules based on hydrophobicity." .

CHMO:0001410 a owl:Class ;
    rdfs:label "Photolithography" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A synthesis method that uses light to transfer a pattern onto a substrate, typically via a light-sensitive photoresist layer." .

CHMO:0001440 a owl:Class ;
    rdfs:label "Microcontact Printing" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A synthesis method for transferring a molecular pattern onto a substrate surface, typically by coating a patterned stamp with a molecule of interest and bringing it into contact with the surface." .

CHMO:0001660 a owl:Class ;
    rdfs:label "Desorption Electrospray Ionization" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An ionization method in which charged solvent droplets are sprayed at a sample surface under ambient conditions, desorbing and ionizing surface molecules for direct mass spectrometric analysis." .

CHMO:0001963 a owl:Class ;
    rdfs:label "Time-Correlated Single Photon Counting" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A fluorescence detection technique that measures the relaxation (decay) rate of excited fluorescent molecules by timing individual detected photons relative to an excitation laser pulse." .

CHMO:0002262 a owl:Class ;
    rdfs:label "Hydrophilic Interaction Chromatography" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A liquid chromatography technique in which the stationary phase is hydrophilic and the mobile phase is largely organic, separating polar compounds based on their differential partitioning." .

CHMO:0002437 a owl:Class ;
    rdfs:label "Interference Reflection Microscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The use of various technologies to resolve the structure or features of objects too small or fine to naturally be seen by eye." .

CHMO:0002474 a owl:Class ;
    rdfs:label "Magnetic Tweezers" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A technique that utilizes light waves to exert minute forces as well as transmit energy to isolate and manipulate nanoparticles." .

CHMO:0002504 a owl:Class ;
    rdfs:label "Bioelectrochemical Analysis" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The use of an electrochemical cell to measure a qualitative or quantitative response of a biological system." .

DOID:0080375 a owl:Class ;
    rdfs:label "Gastroesophageal Adenocarcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A malignant epithelial neoplasm composed of glandular (adenocarcinoma) cells arising at or near the junction of the esophagus and stomach. It encompasses tumors previously classified as distal esophageal, gastroesophageal junction, or gastric cardia adenocarcinomas." .

ECO:0000227 a owl:Class ;
    rdfs:label "ChIP-PCR" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A molecular genetic technique that combines chromatin immunoprecipitation (ChIP) with massively parallel DNA sequencing to map the binding sites of DNA-associated proteins in a sample of cells. First, crosslinked protein-DNA complexes are isolated using ChIP. Next, the crosslinks are broken, the proteins are removed and the purified DNA is modified with adaptor oligonucleotides to facilitate massively parallel DNA sequencing. Following sequencing, the DNA sequences that are obtained can be mapped to their genomic locations." .

ECO:0000237 a owl:Class ;
    rdfs:label "3C-qPCR" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A chromosome conformation capture (3C) method that uses quantitative PCR to measure the interaction frequency between a single pair of genomic loci." .

ECO:0006334 a owl:Class ;
    rdfs:label "Differential Scanning Fluorimetry" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Technique of electron microscopy in which the specimen is coated with heavy metal and then scanned by an electron beam. The resolution is not as great as with transmission electron microscopy, but preparation is easier (often by fixation followed by critical point drying), the depth of focus is relatively enormous, the surface of a specimen can be seen (though not the interior unless the specimen is cracked open) and the image is aesthetically pleasing." .

ECO:0008187 a owl:Class ;
    rdfs:label "Single Molecule Forster Resonance Energy Transfer" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A single-molecule variant of Forster Resonance Energy Transfer (FRET) that measures the distance-dependent energy transfer between two fluorophores on individual molecules to study conformational dynamics and interactions in real time." .

ENVO:01001562 a owl:Class ;
    rdfs:label "Hydrogels" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A three-dimensional network of hydrophilic polymer chains that can absorb and retain large amounts of water, commonly used as a scaffold material in 3D cell culture and tissue engineering." .

ERO:0000651 a owl:Class ;
    rdfs:label "In Vivo Bioluminescence" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An imaging technique that detects light emitted by luciferase-expressing cells or tissues within a living organism, used to monitor biological processes such as tumor growth or gene expression over time." .

ERO:0000906 a owl:Class ;
    rdfs:label "In Vitro Translation" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A cell-free system that synthesizes protein from an RNA or DNA template using cellular translation machinery (ribosomes, tRNAs, and associated factors) extracted from cells." .

ERO:0001093 a owl:Class ;
    rdfs:label "Electron Paramagnetic Resonance Spectroscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The technique of measuring the emission and absorption of different wavelengths (spectra) of visible and non-visible light. This can be done via a spectroscope, which consists of a slit, prism, collimator lens, object lens, and a grating." .

ERO:0001182 a owl:Class ;
    rdfs:label "Apoptosis Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An assay used to detect or quantify cells undergoing apoptosis (programmed cell death), commonly via markers such as caspase activity, Annexin V staining, or DNA fragmentation." .

ERO:0001308 a owl:Class ;
    rdfs:label "Plasmid Construction" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The process of assembling or engineering a plasmid vector, typically by inserting a DNA sequence of interest into a plasmid backbone using molecular cloning techniques." .

ERO:000132 a owl:Class ;
    rdfs:label "Cell Viability Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A colorimetric assay that can assess the viability of cells by quantitation of the reduction of a yellow tetrazolium salt substrate to a product that has a purple color. This assay can measure the cytotoxicity of a chemical or drug by determining the affect of treatment on cell viability." .

ERO:0001512 a owl:Class ;
    rdfs:label "Cell Adhesion Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Any method to measure the number of dividing cells in a culture, or to measure the change in the proportion of cells that are dividing." .

ERO:0001638 a owl:Class ;
    rdfs:label "Intravital Microscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The use of various technologies to resolve the structure or features of objects too small or fine to naturally be seen by eye." .

FBbi:00000336 a owl:Class ;
    rdfs:label "Stochastic Optical Reconstruction Microscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The use of various technologies to resolve the structure or features of objects too small or fine to naturally be seen by eye." .

FBbi:00000339 a owl:Class ;
    rdfs:label "Point Accumulation for Imaging in Nanoscale Topography" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A super-resolution microscopy technique (PAINT) that achieves nanoscale spatial resolution by imaging the transient, stochastic binding of fluorescently labeled probes to a target structure over time." .

FBbi:00050000 a owl:Class ;
    rdfs:label "Focused Ion Beam Scanning Electron Microscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Technique of electron microscopy in which the specimen is coated with heavy metal and then scanned by an electron beam. The resolution is not as great as with transmission electron microscopy, but preparation is easier (often by fixation followed by critical point drying), the depth of focus is relatively enormous, the surface of a specimen can be seen (though not the interior unless the specimen is cracked open) and the image is aesthetically pleasing." .

FBbi:00100015 a owl:Class ;
    rdfs:label "Cryo-Electron Tomography" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A form of electron tomography in which a cryo-preserved specimen is tilted incrementally in a cryogenic transmission electron microscope to acquire a series of images used to reconstruct its 3D structure." .

FBcv:0003077 a owl:Class ;
    rdfs:label "RNAi Screen" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An assay that uses a panel of RNA interference (RNAi) reagents to systematically knock down a large set of genes, one at a time, to identify those involved in a biological process of interest." .

MI:0430 a owl:Class ;
    rdfs:label "UV Photocrosslinking" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A technique that covalently crosslinks nucleic acids to interacting proteins using ultraviolet light, used to capture and study protein-nucleic acid interactions." .

MI:2213 a owl:Class ;
    rdfs:label "Super-Resolution Microscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The use of various technologies to resolve the structure or features of objects too small or fine to naturally be seen by eye." .

MMO:0000098 a owl:Class ;
    rdfs:label "Immunoassay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An immunological procedure used for the microscopic examination of tissues.  It involves the usage of enzyme-antibody or enzyme-antigen conjugates, antienzyme antibodies, or enzyme-antienzyme complexes." .

MMO:0000444 a owl:Class ;
    rdfs:label "Enzyme Activity Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A procedure performed outside the living body to measure the catalytic activity of an enzyme." .

MMO:0000462 a owl:Class ;
    rdfs:label "RT-qPCR" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Real-time PCR in which an RNA sample is first reverse transcribed into complementary DNA (cDNA) and then quantified by real-time PCR." .

MMO:0000570 a owl:Class ;
    rdfs:label "Micro-computed Tomography" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An imaging technique for examining structures within the body by scanning them with X rays and using a computer to construct a series of cross-sectional scans along a single axis." .

MMO:0000679 a owl:Class ;
    rdfs:label "Cell Fractionation" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A technique in which sub-cellular components are separated based on their physical properties, such as density in a sucrose density gradient." .

MSIO:0000159 a owl:Class ;
    rdfs:label "3D Cell Culture" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A cultured cell population grown in a three-dimensional format that more closely mimics the in vivo growth environment than conventional two-dimensional culture." .

NCIT:C101293 a owl:Class ;
    rdfs:label "Next Generation Sequencing" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Technologies that facilitate the rapid determination of the nucleotide sequence of large numbers of strands or segments of DNA or RNA." .

NCIT:C103512 a owl:Class ;
    rdfs:label "PET-CT" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An imaging technique that combines positron emission tomography and computed tomography acquisition in a single machine to provide co-registered functional and anatomical images." .

NCIT:C105555 a owl:Class ;
    rdfs:label "High Grade Ovarian Serous Adenocarcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A rapidly growing serous adenocarcinoma that arises from the ovary. It is characterized by the presence of high grade cytologic features and frequent mitotic figures." .

NCIT:C111116 a owl:Class ;
    rdfs:label "Diffusion Weighted Imaging" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A type of MRI technique in which diffusion-sensitizing gradients are applied to the imaging sequence." .

NCIT:C111203 a owl:Class ;
    rdfs:label "Gas Chromatography Mass Spectrometry" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An analytical technique wherein gas chromatography is coupled to mass spectrometry in order to separate, identify, and quantify substances in a sample." .

NCIT:C116151 a owl:Class ;
    rdfs:label "Single Nucleotide Polymorphism Array" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A genomic microarray-based method able to detect single nucleotide polymorphisms." .

NCIT:C116152 a owl:Class ;
    rdfs:label "Cross-Linking Immunoprecipitation High-throughput Sequencing" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A molecular biology method combining crosslinking-immunoprecipitation and high-throughput sequencing techniques to detect and map RNA-protein interactions. In CLIP, whole tissues, organisms or individual cell types are treated with UV irradiation, which introduces covalent bonds between RNA-protein complexes. This is followed by immunoprecipitation and removal of the protein component of the crosslinked complex. The purified RNAs are then fragmented, reduced in size and subjected to high-throughput sequencing for the identification of RNA binding sites." .

NCIT:C116162 a owl:Class ;
    rdfs:label "Optical Mapping" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A technique used for constructing the ordered and high-resolution genome or chromosome sized restriction enzyme map of an organism from a single, stained DNA molecule, digested by the restriction enzyme and imaged by an optical microscope." .

NCIT:C116453 a owl:Class ;
    rdfs:label "Dynamic Susceptibility Contrast-Enhanced Magnetic Resonance Imaging" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A type of magnetic resonance imaging that uses the transient signal reduction induced by the first pass of gadolinium chelate through the brain vessels to calculate cerebral blood flow maps, and to determine the ratio between the cerebral blood volume in the lesion and the cerebral blood volume in normal tissue." .

NCIT:C116458 a owl:Class ;
    rdfs:label "Multiparametric Magnetic Resonance Imaging" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The combination of multiple magnetic resonance techniques, including diffusion weighted imaging, dynamic contrast-enhanced imaging, and spectroscopy, to achieve an image that will allow for better identification of tumor size and location, as well as possibly identifying cancer spread and aggressiveness." .

NCIT:C116489 a owl:Class ;
    rdfs:label "Fluorescence Imaging" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An imaging technique that uses fluorescent dye to achieve the desired image." .

NCIT:C116504 a owl:Class ;
    rdfs:label "Multiphoton Microscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An imaging technique that uses multiple photons to absorb infrared light, thereby minimizing phototoxicty and photobleaching, making it an ideal method for imaging living specimens, especially those involving deep tissue." .

NCIT:C116553 a owl:Class ;
    rdfs:label "Cell Proliferation Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Any method to measure the number of dividing cells in a culture, or to measure the change in the proportion of cells that are dividing." .

NCIT:C116571 a owl:Class ;
    rdfs:label "Fourier Transform Ion Cyclotron Resonance Mass Spectrometry" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A type of mass spectrometry that uses the cyclotron frequency of ions in a fixed magnetic field to determine their ionic mass-to-charge ratio." .

NCIT:C116641 a owl:Class ;
    rdfs:label "Magnetically Activated Cell Sorting" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Selection and deposition of individual cells of a particular phenotype from a mixed population into a separate tube or tissue culture plate by the use of a fluorescence-activated cell sorter (FACS) and fluorescently-labeled antibodies specific for surface molecules on the cells to be sorted." .

NCIT:C116749 a owl:Class ;
    rdfs:label "Photoacoustic Imaging" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An imaging technique during which non-ionizing pulses are delivered into tissue and the resulting ultrasonic waves are detected and converted into images." .

NCIT:C118401 a owl:Class ;
    rdfs:label "TRAP Staining" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A staining method used to demonstrate the presence of acid phosphatase and tartrate resistant acid phosphatase (TRAP) in osteoclasts." .

NCIT:C120659 a owl:Class ;
    rdfs:label "Ribosomal P Protein Antibody Measurement" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The determination of the ribosomal P protein antibody present in a sample." .

NCIT:C120691 a owl:Class ;
    rdfs:label "HPLC-MSMS" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An analytical technique wherein high performance liquid chromatography is coupled to tandem mass spectrometry in order to separate, identify, and quantify substances in a sample." .

NCIT:C123893 a owl:Class ;
    rdfs:label "shRNA" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An artificial RNA molecule with a tight hairpin turn that can be used to silence target gene expression via RNA interference (RNAi)." .

NCIT:C126102 a owl:Class ;
    rdfs:label "Chimeric Antigen Receptor T-Cell Therapy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Treatment that uses T-cells engineered to express a chimeric antigen receptor (CAR) that specifically targets a particular antigen, most commonly used in cancer immunotherapy." .

NCIT:C126449 a owl:Class ;
    rdfs:label "Serous Tubal Intraepithelial Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A non-invasive serous carcinoma arising from the fallopian tube." .

NCIT:C126598 a owl:Class ;
    rdfs:label "Thyroid Gland Noninvasive Follicular Neoplasm with Papillary-Like Nuclear Features" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A non-invasive neoplasm of thyroid follicular cells with a follicular growth pattern and nuclear features of papillary thyroid carcinoma that has an extremely low malignant potential. These tumors were formerly classified as non-invasive encapsulated follicular variant of papillary thyroid carcinoma or well-differentiated tumor of uncertain malignant potential. (WHO)" .

NCIT:C127880 a owl:Class ;
    rdfs:label "Nested PCR" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Polymerase chain reaction that uses two sets of primers, in two sequential runs of amplification, with the second set intended to amplify a target within the first run product." .

NCIT:C12932 a owl:Class ;
    rdfs:label "Xenograft" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Cells, tissues, or organs from a donor that are transplanted into a recipient of another species." .

NCIT:C129431 a owl:Class ;
    rdfs:label "Rosette-Forming Glioneuronal Tumor" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A central nervous system neoplasm mostly occurring in the fourth ventricle region. It is characterized by the presence of neurocytes forming pseudorosettes and astrocytes which contain Rosenthal fibers. Cytologic atypia is minimal." .

NCIT:C129432 a owl:Class ;
    rdfs:label "mRNA Sequencing" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A procedure that can determine the RNA sequences for all or part of the poly-A tail-containing messenger RNA transcripts in an individual." .

NCIT:C129886 a owl:Class ;
    rdfs:label "Cytokine Expression Profile" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The identification and quantitation of all of the cytokines expressed in a biological sample." .

NCIT:C130234 a owl:Class ;
    rdfs:label "Castration-Resistant Prostate Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Prostate carcinoma that grows and continues to spread despite the surgical removal of the testes or medical intervention to block androgen production." .

NCIT:C13049 a owl:Class ;
    rdfs:label "Lymphoid Normal",
        "Lymphoid Tissue" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum,
        mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "A specimen of normal (non-malignant) lymphoid tissue or cells used as a reference or control sample.",
        "Tissue characterized by the presence of large numbers of lymphocytes in different stages of transformation. Connective tissue cells including fibroblasts and macrophages may be present. Lymphoid tissue is framed by a network of reticular fibers and may be diffuse, or densely aggregated." .

NCIT:C132067 a owl:Class ;
    rdfs:label "Low Grade Glioma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A grade I or grade II glioma arising from the central nervous system. This category includes pilocytic astrocytoma, diffuse astrocytoma, subependymal giant cell astrocytoma, ependymoma, oligodendroglioma, oligoastrocytoma, and angiocentric glioma." .

NCIT:C139305 a owl:Class ;
    rdfs:label "RAS Protein Family Activation Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An in vitro assay that can indirectly detect the activation of small GTPases in the RAS family through the staining of phosphorylated forms of MEK (MAP2K) family proteins (pMEK). A farnesylated RAS family protein is anchored to an in vitro model of the plasma membrane and, under different conditions, is co-incubated with both a RAF family protein, which binds to and is activated by active RAS proteins, and a MEK family protein, which is phosphorylated by active RAF proteins. pMEK is detected using a donor bead coated with anti-MEK antibodies that is capable of oxidizing an acceptor molecule attached to an anti-pMEK antibody. When the donor and acceptor are in close proximity, the acceptor molecule is oxidized and can be visualized using electron microscopy." .

NCIT:C141478 a owl:Class ;
    rdfs:label "Not Allowed To Collect",
        "Not Allowed to Collect" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum,
        mc2:IndividualRecurrenceStatusEnum,
        mc2:LastKnownDiseaseStatusEnum ;
    skos:definition "An indication that specifies that a collection event was not permitted.",
        "An indicator that specifies that a biospecimen collection event was not permitted.",
        "An indicator that specifies that a collection event was not permitted." .

NCIT:C142337 a owl:Class ;
    rdfs:label "Immunofluorescent Staining Method" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A microscopy staining method that uses fluorescently labeled antibodies to detect specific target antigens in preserved cells or tissue." .

NCIT:C142787 a owl:Class ;
    rdfs:label "Viral Transduction" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The transfer of genetic material into a cell using a viral vector." .

NCIT:C146818 a owl:Class ;
    rdfs:label "Nanopore Sequencing" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A proprietary next-generation DNA sequencing technology from Oxford Nanopore Technologies that can directly identify and sequence a DNA molecule as it passes through a nanopore, driven by electrophoresis." .

NCIT:C151895 a owl:Class ;
    rdfs:label "Cerenkov Luminescence Imaging" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An imaging modality to study charged particles in tissue by detecting the Cerenkov luminescence produced, allowing the imaging of beta-emitting nuclear medicine probes by optical methods." .

NCIT:C15229 a owl:Class ;
    rdfs:label "Antitumor Drug Screening Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A technique used to assess the effectiveness of a potential antineoplastic agent against tumor cells." .

NCIT:C154786 a owl:Class ;
    rdfs:label "Fluorescence Lifetime Imaging Microscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An imaging technique that produces spatially resolved images based on the differences in the excited state decay rates of fluorescent compounds in a sample." .

NCIT:C156443 a owl:Class ;
    rdfs:label "Cell Line Derived Xenograft Tissue",
        "Xenograft" ;
    rdfs:subClassOf mc2:BiospecimenCompositionEnum,
        mc2:BiospecimenPathologyEnum,
        mc2:BiospecimenTypeEnum ;
    skos:definition "A biospecimen derived from the culturing of a derived cell line in a non-human organism.",
        "A biospecimen derived from tissue that developed after a laboratory cell line was implanted and grown in a non-human host organism.",
        "A transplantation of cancer cells derived from an established cancer cell line into an immunodeficient mouse." .

NCIT:C156444 a owl:Class ;
    rdfs:label "Post neo-adjuvant therapy",
        "Tumor post-adjuvant therapy",
        "Tumor post-neoadjuvant therapy",
        "Tumor post-therapy" ;
    rdfs:subClassOf mc2:BiospecimenCompositionEnum,
        mc2:BiospecimenTypeEnum ;
    skos:definition "A biospecimen collected from a subject after treatment with a neoadjuvant therapeutic agent.",
        "A specimen derived from a subject after treatment with a neoadjuvant therapeutic." .

NCIT:C156484 a owl:Class ;
    rdfs:label "Malignant Genitourinary System Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A primary or metastatic malignant neoplasm that affects the genitourinary system." .

NCIT:C156754 a owl:Class ;
    rdfs:label "Proximity Ligation Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A technique that leverages immunoassay and DNA amplification technology to detect protein-protein interactions with high specificity and sensitivity. A sample is prepared and then exposed to primary antibodies raised in different species recognizing the target epitopes on the proteins of interest. Then, secondary antibodies that are tagged with short oligonucleotides and that target each primary antibody are added. Next, a mixture comprised of a ligase, PCR components and a connector oligonucleotide, which hybridizes to both oligonucleotide tags and can prime rolling DNA circle synthesis, are added and the sample is subjected to real-time PCR to amplify the DNA circles. Rolling circle synthesis and amplification is only possible if the protein epitopes are in close proximity (i.e. in a protein complex). Finally, a labeled complementary nucleotide probe is added to detect and/or visualize the amplified DNA." .

NCIT:C156781 a owl:Class ;
    rdfs:label "Biliary Tract Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A carcinoma arising from the intrahepatic bile ducts, hepatic ducts, common bile duct, cystic duct, or gallbladder." .

NCIT:C158252 a owl:Class ;
    rdfs:label "Targeted Transcriptome Sequencing" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An RNA sequencing technique in which selected RNA transcripts of an individual's genome are sequenced." .

NCIT:C158253 a owl:Class ;
    rdfs:label "Targeted Genome Sequencing" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A DNA sequencing technique in which selected regions of an individual's genome are sequenced." .

NCIT:C16063 a owl:Class ;
    rdfs:label "Modeling" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The use of statistical analysis, computer analysis, or model organisms to predict outcomes of research. (doegenomes.org)" .

NCIT:C161789 a owl:Class ;
    rdfs:label "Immobilized Metal Affinity Chromatography" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A method to purify proteins or peptides from a mixture that leverages their affinity to positively charged ions immobilized on NTA-agarose beads." .

NCIT:C161825 a owl:Class ;
    rdfs:label "Label-free Protein Quantification by LC/MS" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A method for quantitating proteins in samples subjected to liquid chromatography-mass spectrometry (LC/MS) without the use of isotopic or chemical labels." .

NCIT:C16215 a owl:Class ;
    rdfs:label "Soft Agar Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Soft agar colony formation assay is performed to assay for anchorage independent growth." .

NCIT:C16216 a owl:Class ;
    rdfs:label "Invasion Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An in vitro assay, commonly using a reconstituted basement membrane (e.g., Matrigel), that assesses the ability of cells to degrade and migrate through tissue barriers." .

NCIT:C16309 a owl:Class ;
    rdfs:label "Artificial Intelligence" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The branch of computer science concerned with creating systems that can perform tasks normally requiring human intelligence, such as learning, reasoning, and problem-solving." .

NCIT:C16314 a owl:Class ;
    rdfs:label "Autoradiography" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A technique used to locate radioactively labeled molecules, or fragments of molecules, by recording on a photographic or sensor plate the radiation emitted by radioactive material within a molecule." .

NCIT:C16356 a owl:Class ;
    rdfs:label "Southern Blotting" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Electrophoresis-based technique used in genetic testing to detect large deletions in DNA that can be missed by PCR-based genetic testing methods." .

NCIT:C16357 a owl:Class ;
    rdfs:label "Western Blotting" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A method for the detection or identification of proteins or peptides that have been separated by gel electrophoresis and transferred onto nitrocellulose or other type of paper or nylon membrane. The proteins are then detected by reaction with enzymatically labeled or radiolabeled antibody probes." .

NCIT:C163758 a owl:Class ;
    rdfs:label "Targeted Therapy Agent" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Any agent that specifically targets or interferes with the synthesis or function of a molecule expressed specifically in or on cells relevant to a disease process, such as a tumor." .

NCIT:C16396 a owl:Class ;
    rdfs:label "Cell Culture" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The maintenance and growth of cells, derived from a strain or cell line, in a controlled laboratory environment outside their original organism." .

NCIT:C16433 a owl:Class ;
    rdfs:label "Size Exclusion Chromatography" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Gel permeation or sieve chromatography that is performed on porous gels that separate solutes on the basis of size. Smaller solutes are included within the particles of the gel matrix more frequently than larger solutes, thus affecting elution rates." .

NCIT:C16461 a owl:Class ;
    rdfs:label "Computational Modeling" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The use of statistical analysis, computer analysis, or model organisms to predict outcomes of research. (doegenomes.org)" .

NCIT:C165222 a owl:Class ;
    rdfs:label "DNA Methylation Array" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The use of a high-throughput microarray where all of the known CpG islands either in a single specimen or all of the known promoter sequences of a specimen or a population group are coupled to beads or microwells to determine which are methylated." .

NCIT:C16553 a owl:Class ;
    rdfs:label "ELISA" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A type of enzyme immunoassay in which an antigen or antibody is bound to a solid substrate (e.g., microplate or beads) and interacts with an enzyme-linked antibody or antigen in solution." .

NCIT:C16555 a owl:Class ;
    rdfs:label "Epidemiological Method" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Epidemiological methods involve sophisticated statistics and higher mathematics.  These methods allow epidemiologists to address issues like non-experimental studies of mechanistic questions in disease etiology, including studies of the impact of the social position of individuals in different social contexts." .

NCIT:C16585 a owl:Class ;
    rdfs:label "Flow Cytometry" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A technique for counting, examining or sorting microscopic particles suspended in a stream of fluid. The cells are placed in a fluid (with or without light-sensitive dye) and passed in a stream before a laser or other type of light." .

NCIT:C166064 a owl:Class ;
    rdfs:label "Droplet Digital PCR" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A type of digital polymerase chain reaction technique in which the sample is fractionated into thousands of tiny droplets using a water-oil emulsion droplet technology, within which individual PCR reactions occur in each droplet." .

NCIT:C16724 a owl:Class ;
    rdfs:label "Immunoprecipitation" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Antigen aggregation with antibody, in the right ratios, to cause precipitation. (NCI)" .

NCIT:C16768 a owl:Class ;
    rdfs:label "Karyotyping" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The preparation, analysis, and interpretation of a karyotype, the representation of the chromosome set of a cell." .

NCIT:C16809 a owl:Class ;
    rdfs:label "Magnetic Resonance Imaging" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Imaging that uses radiofrequency waves and a strong magnetic field rather than x-rays to provide detailed pictures of internal organs and tissues. The technique is valuable for the diagnosis of many pathologic conditions, including cancer, heart and vascular disease, stroke, and joint and musculoskeletal disorders." .

NCIT:C16853 a owl:Class ;
    rdfs:label "Microscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The use of various technologies to resolve the structure or features of objects too small or fine to naturally be seen by eye." .

NCIT:C16854 a owl:Class ;
    rdfs:label "Electron Microscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Any form of microscopy in which the interactions of electrons with the specimens are used to provide information about the final structure of that specimen." .

NCIT:C16855 a owl:Class ;
    rdfs:label "Scanning Electron Microscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Technique of electron microscopy in which the specimen is coated with heavy metal and then scanned by an electron beam. The resolution is not as great as with transmission electron microscopy, but preparation is easier (often by fixation followed by critical point drying), the depth of focus is relatively enormous, the surface of a specimen can be seen (though not the interior unless the specimen is cracked open) and the image is aesthetically pleasing." .

NCIT:C16856 a owl:Class ;
    rdfs:label "Fluorescence Microscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The use of a special microscope to see objects that give off fluorescent light. For example, cells or tissue can be treated with a substance that contains a fluorescent dye. The dye lights up when viewed under a microscope with a special light." .

NCIT:C16869 a owl:Class ;
    rdfs:label "Statistical Modeling" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The statistical characterization of a system to estimate its future behavior based on past behavior and extrapolation." .

NCIT:C16870 a owl:Class ;
    rdfs:label "Mathematical Modeling" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The use of statistical analysis, computer analysis, or model organisms to predict outcomes of research. (doegenomes.org)" .

NCIT:C16921 a owl:Class ;
    rdfs:label "Nuclear Magnetic Resonance" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A physical phenomenon involving the interaction of atomic nuclei placed in an external magnetic field with an applied electromagnetic field oscillating at a particular frequency. Magnetic conditions within the material are measured by monitoring the radiation absorbed and emitted by the atomic nuclei. It is the underlying principle of Magnetic Resonance Imaging (MRI)." .

NCIT:C17007 a owl:Class ;
    rdfs:label "Positron Emission Tomography" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An imaging technique for measuring the gamma radiation produced by collisions of electrons and positrons (anti-electrons) within living tissue. In positron emission tomography (PET), a subject is given a dose of a positron-emitting radionuclide attached to a metabolically active substance. A scanner reveals the tissue location of the metabolically-active substance administered." .

NCIT:C17048 a owl:Class ;
    rdfs:label "Questionnaire" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A set of questions or items shown to a respondent in order to get answers for research purposes. [PRO Draft Guidance] See also instrument, survey." .

NCIT:C171152 a owl:Class ;
    rdfs:label "Single Cell RNA-Sequencing" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A procedure that determines the nucleotide sequence of RNA transcripts from an amplified sample derived from a single cell, enabling transcriptomic profiling at single-cell resolution." .

NCIT:C17155 a owl:Class ;
    rdfs:label "Spectroscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The technique of measuring the emission and absorption of different wavelengths (spectra) of visible and non-visible light. This can be done via a spectroscope, which consists of a slit, prism, collimator lens, object lens, and a grating." .

NCIT:C17156 a owl:Class ;
    rdfs:label "Mass Spectrometry" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An analytical technique wherein ions are separated according to their ratio of charge to mass. From the mass spectrum produced, the atomic weight of the particle can be deduced." .

NCIT:C17157 a owl:Class ;
    rdfs:label "Raman Spectroscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Emission of electromagnetic energy with a shorter frequency (longer wavelength) than that of the incident monochromatic light.  Arises from the low probability absorption of quanta with a higher energy than that required for a transition: the difference in energy is emitted as a lower frequency (energy) photon.  Allows analysis of vibrational and rotational energy levels using visible incident light." .

NCIT:C17204 a owl:Class ;
    rdfs:label "Computed Tomography" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An imaging technique for examining structures within the body by scanning them with X rays and using a computer to construct a series of cross-sectional scans along a single axis." .

NCIT:C172259 a owl:Class ;
    rdfs:label "Organoid" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A three dimensional mass comprised of a cultured cell or tissue sample that resembles an in vivo tissue or organ. Organoids are grown in vitro from a combination of cells or tissue fragments cultured in medium containing a variety of biochemical factors." .

NCIT:C17230 a owl:Class ;
    rdfs:label "Ultrasound Imaging" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The use of high-frequency sound waves to generate images of internal body structures." .

NCIT:C17353 a owl:Class ;
    rdfs:label "Fluorescence Activated Cell Sorting" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Selection and deposition of individual cells of a particular phenotype from a mixed population into a separate tube or tissue culture plate by the use of a fluorescence-activated cell sorter (FACS) and fluorescently-labeled antibodies specific for surface molecules on the cells to be sorted." .

NCIT:C17369 a owl:Class ;
    rdfs:label "Imaging" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An imaging technique that uses fluorescent dye to achieve the desired image." .

NCIT:C17370 a owl:Class ;
    rdfs:label "Fluorescent Antibody Procedure" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An immunological procedure in which the antibodies are coupled with molecules which fluoresce under ultra violet (UV) light. This makes them particularly suitable for detection of specific antigens in tissues or on cells." .

NCIT:C174336 a owl:Class ;
    rdfs:label "Virus Plaque Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An assay that is used to determine viral quantity by infecting monolayers of host cells with serially diluted virus, covering the monolayers with an immobilizing overlay after a period of incubation to restrict the spread of the virus to neighboring cells, and counting the resulting visible plaques of infected cells." .

NCIT:C17562 a owl:Class ;
    rdfs:label "In Situ Hybridization" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Use of a DNA or RNA probe to detect the presence of complementary sequences in chromosomes, cells, or tissues. (NCI)" .

NCIT:C17563 a owl:Class ;
    rdfs:label "FISH" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Any jawed or jawless organisms in the phylum Chordata including the jawless fish, armored fish, cartilaginous fish, ray-finned fish and lobe-finned fish." .

NCIT:C176258 a owl:Class ;
    rdfs:label "Deep Learning" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A subset of machine learning based on artificial neural networks with multiple layers, capable of learning complex representations directly from data." .

NCIT:C17672 a owl:Class ;
    rdfs:label "X-Ray Crystallography" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A technique in crystallography in which the pattern produced by the diffraction of x-rays through the closely spaced lattice of atoms in a crystal is recorded and then analyzed to reveal the nature of that lattice." .

NCIT:C17731 a owl:Class ;
    rdfs:label "Immunocytochemistry" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A method for the detection of proteins or antigens on samples of cells that are grown in monolayers or in suspension and deposited on slides, using antibodies or other biomolecules that bind the target and can be visualized through a chemical process." .

NCIT:C17753 a owl:Class ;
    rdfs:label "Confocal Microscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A system of (usually) epifluorescence light microscopy in which a fine laser beam of light is scanned over the object through the objective lens. This technique is particularly good at rejecting light from outside the plane of focus and so produces higher effective resolution than other microscopy techniques." .

NCIT:C17754 a owl:Class ;
    rdfs:label "Atomic Force Microscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A technique utilizing a scanning probe to image and analyze the surface of a material with atomic-level resolution." .

NCIT:C179435 a owl:Class ;
    rdfs:label "HiChIP" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A method that combines chromosome conformation capture, proximity ligation and chromatin immunoprecipitation to isolate DNA from a biospecimen, create a genomic library and analyze 3D chromatin organization." .

NCIT:C179458 a owl:Class ;
    rdfs:label "Single Cell ATAC-Seq" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A molecular genetic technique where DNA is isolated from single cell (sc) samples and amplified to create a genomic library. Then the library is subjected to ATAC-seq, which isolates and sequences regions rich in open chromatin." .

NCIT:C18075 a owl:Class ;
    rdfs:label "Tissue Engineering" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Application of the principles of bioengineering to combining scaffolds, cells, and biologically active molecules into functional tissues. The goal of tissue engineering is to assemble functional constructs that restore, maintain, or improve damaged tissues or whole organs." .

NCIT:C18084 a owl:Class ;
    rdfs:label "Comparative Genomic Hybridization" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A technique that detects losses and gains in DNA copy number across an entire genome without the need for cell culturing." .

NCIT:C18097 a owl:Class ;
    rdfs:label "Molecular Simulations" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The use of computational methods to simulate the physical motions and interactions of atoms or molecules over time." .

NCIT:C18113 a owl:Class ;
    rdfs:label "Cryo-Electron Microscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Electron microscopy performed on an aqueous sample suspension that is applied as an extremely thin film to a grid and rapidly frozen, preserving its near-native structure for imaging." .

NCIT:C18117 a owl:Class ;
    rdfs:label "Surface Plasmon Resonance" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A quantum optical-electrical phenomena consisting of an alteration in light reflectance as a result of binding of molecules to a surface from which total internal reflection is occurring. Used to detect macromolecular interactions, SPR can be used as the basis for a sensor which is capable of sensitive and quantitative measurement of a broad spectrum of chemical and biological entities." .

NCIT:C181182 a owl:Class ;
    rdfs:label "Target Engagement Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An assay type that examines the interaction of ligands with their target biomolecules." .

NCIT:C18216 a owl:Class ;
    rdfs:label "Transmission Electron Microscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An electron microscopy imaging technique that is utilized to examine structural components of a sample by passing electrons through the specimen." .

NCIT:C182622 a owl:Class ;
    rdfs:label "Cell-free Circulating Tumor DNA Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An assay used to detect cell-free circulating tumor DNA in a biological sample, for identification of molecular residual disease and assessment of treatment response." .

NCIT:C18472 a owl:Class ;
    rdfs:label "High Throughput Screening" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Use of robots and other automated techniques to screen large numbers of samples." .

NCIT:C18475 a owl:Class ;
    rdfs:label "Liquid Chromatography Mass Spectrometry" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "LC/MS is a hyphenated technique, combining the separation power of liquid chromatography (LC), an analytical chromatographic technique for separating ions or molecules dissolved in a solvent, with the detection power of mass spectrometry(MS), a technique to separate gas phase ions according their m/z (mass to charge ratio) value. Used for drug screening, pharmacology studies, environmental analyses and forensics." .

NCIT:C187898 a owl:Class ;
    rdfs:label "Mass Cytometry" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A flow cytometry technique that utilizes mass spectrometry to detect antibodies labeled with heavy metal ion tags that are bound to antigens of interest on single cells." .

NCIT:C189102 a owl:Class ;
    rdfs:label "TCR Sequencing" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A DNA sequencing technique that can differentiate cytosine from 5-methylcytosine in a DNA sample. First, a denatured DNA sample is treated with bisulfite which converts non-methylated cytosine to uracil. Next, the sample is amplified using a PCR method that does not discriminate between non-methylated and methylated sequences. The amplified DNA is subjected to nucleotide sequencing. The resulting sequence is compared to an identical control sample of DNA that was not treated with bisulfite. Unmethylated cytosines will be displayed as cytosines in the control sample and as thymines in the bisulfite-treated sample." .

NCIT:C18940 a owl:Class ;
    rdfs:label "Phylogenetic Analysis" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The study of evolutionary relationships among organisms or sequences, typically represented as a branching tree (phylogeny) inferred from molecular or morphological data." .

NCIT:C19146 a owl:Class ;
    rdfs:label "In Vitro Model" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A laboratory model system, such as cultured cells or tissue, used to study biological processes or disease outside of a living organism." .

NCIT:C19151 a owl:Class ;
    rdfs:label "Metastasis" ;
    rdfs:subClassOf mc2:BiospecimenIncidenceTypeEnum,
        mc2:GrantThemeNameEnum,
        mc2:ResourceTopicEnum ;
    skos:definition "The spread of a neoplasm from the original site of growth to another site.",
        "The spread of cancer cells from the primary tumor site to other parts of the body, forming secondary tumors that share characteristics of the original neoplasm." .

NCIT:C19362 a owl:Class ;
    rdfs:label "Electrophoretic Mobility Shift Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A molecular biology technique used to detect the interaction of a DNA binding protein with its cognate binding sequence.  Labeled DNAs were reacted with crude cell extracts and the complexes are run through a non-denaturing polyacrylamide gel.  The migration of the labeled DNA through the gel will be slower by being bound.  This shift in electrophoretic mobility indicates functional binding between the protein and the DNA." .

NCIT:C19425 a owl:Class ;
    rdfs:label "Migration Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An in vitro assay in which cultured cells are monitored and analyzed for their ability to move into an acellular area of a culture material." .

NCIT:C19594 a owl:Class ;
    rdfs:label "NOS",
        "Not Otherwise Specified" ;
    rdfs:subClassOf mc2:BiospecimenCompositionEnum,
        mc2:BiospecimenPathologyEnum,
        mc2:DiseaseTypeEnum ;
    skos:definition "A term used to indicate that a specific type or category is not more precisely described or classified.",
        "Not characterized in any other way.",
        "Not more specifically or particularly described than the stated category." .

NCIT:C19641 a owl:Class ;
    rdfs:label "Dideoxy Chain Termination DNA Sequencing" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A DNA sequencing technique in which a mixture of deoxynucleosidetriphosphates (dNTPs) and chain-terminating dNTPs, which are radioactively or fluorescently labeled, are combined within the reaction mixture. Once the reaction is complete, the DNA strands are separated by size, and the labeled chain terminating dNTPs can be read in sequence by the investigator or by a machine." .

NCIT:C19815 a owl:Class ;
    rdfs:label "TUNEL assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A method to detect apoptosis." .

NCIT:C19819 a owl:Class ;
    rdfs:label "cDNA Array" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A molecular biology device that utilizes a set of defined cDNA clones attached in a specific grid arrangement to a solid support for nucleic acid hybridization assays in gene mapping studies or in determining gene sequences, sequence variations, or gene expression patterns." .

NCIT:C19827 a owl:Class ;
    rdfs:label "Brightfield Microscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Brightfield microscopy is a type of light microscopy in which objects are seen against a bright background." .

NCIT:C19830 a owl:Class ;
    rdfs:label "Co-Immunoprecipitation" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Co-immunoprecipitation (Co-IP) is a popular technique for protein interaction discovery. In a co-IP the target antigen precipitated by the antibody \"co-precipitates\" a binding partner/protein complex from a lysate. It is assumed that these proteins are related to the function of the target antigen at the cellular level." .

NCIT:C19835 a owl:Class ;
    rdfs:label "Gelatin Zymography" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An SDS-PAGE based procedure used to identify matrix metalloproteinases." .

NCIT:C19922 a owl:Class ;
    rdfs:label "Tissue Microarray" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A device for use in high-throughput molecular analysis/screening of clinical tissue specimens.  Tissue microarrays spatially arrange 500-1000 tumor biopsies or other tissue onto a microarray block, which is then sliced into sections for probing DNA, RNA or protein targets to provide coincident analysis of all specimens in the array.  Subsequent sections can be analyzed with additional probes." .

NCIT:C19935 a owl:Class ;
    rdfs:label "MALDI-TOF Mass Spectrometry" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An analytical technique wherein ions are separated according to their ratio of charge to mass. From the mass spectrum produced, the atomic weight of the particle can be deduced." .

NCIT:C207229 a owl:Class ;
    rdfs:label "Pancreatic Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A disease in which malignant (cancer) cells are found in the tissues of the pancreas." .

NCIT:C20828 a owl:Class ;
    rdfs:label "Optical Coherence Tomography" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Optical Coherence Tomography (OCT) combines the principles of ultrasound with the imaging performance of a microscope. OCT uses infrared light waves that reflect off the internal microstructure within the biological tissues. The frequencies and bandwidths of infrared light are orders of magnitude higher than medical ultrasound signals, resulting in greatly increased image resolution, 8-25 times greater than any existing modality. In addition to providing high-level resolutions for the evaluation of microanatomic structures OCT is also able to provide information regarding tissue composition. (NCI)" .

NCIT:C208352 a owl:Class ;
    rdfs:label "Acute Promyelocytic Leukemia" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An acute myeloid leukemia characterized by the predominance of abnormal promyelocytes, most often driven by translocations involving the retinoic acid receptor-alpha (RARA) gene. Over 95% of cases show the reciprocal balanced translocation t(15;17)(q24.1;q21.2), which fuses the PML and RARA genes." .

NCIT:C2191 a owl:Class ;
    rdfs:label "siRNA" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A 20 to 25-nucleotide double-stranded RNA which is involved in a sequence-specific messenger RNA degradation process known as RNA interference." .

NCIT:C223372 a owl:Class ;
    rdfs:label "Endotoxin Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An assay to detect and quantify endotoxin in a sample." .

NCIT:C223894 a owl:Class ;
    rdfs:label "Single Cell DNA Sequencing" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The determination of the sequence of purines and pyrimidines in deoxyribonucleic acid (DNA)." .

NCIT:C23012 a owl:Class ;
    rdfs:label "Trichrome Staining Method" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A histological staining method that uses acid dyes and washes to selectively stain structural elements in tissue samples in three or more contrasting colors, commonly used to visualize collagen and muscle fibers." .

NCIT:C23020 a owl:Class ;
    rdfs:label "Immunohistochemistry Staining Method" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Immunohistochemical staining techniques allow for the visualization of antigens via the sequential application of a specific antibody to the antigen (primary antibody), a secondary antibody to the primary antibody and an enzyme complex with a chromogenic substrate. The enzymatic activation of the chromogen results in a visible reaction product at the antigen site. The specimen may then be counterstained and coverslipped. Results are interpreted using a light microscope and aid in the differential diagnosis of pathophysiological processes, which may or may not be associated with a particular antigen." .

NCIT:C23029 a owl:Class ;
    rdfs:label "Synaptophysin Staining Method" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "This is an immunohistochemical technique utilizing antibody to synaptophysin, an integral membrane glycoprotein present in presynaptic vesicles in neurons. The antibody labels neuroendocrine cells and neurons of the brain, spinal cord and retina. Used to detect neuroendocrine neoplasms including neuroblastomas, ganglioneuroblastomas, ganglioneuromas, pheochromocytomas, chromaffin, and non-chromaffin paragangliomas." .

NCIT:C27349 a owl:Class ;
    rdfs:label "Histiocytic Sarcoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An aggressive malignant neoplasm with a poor response to therapy, usually presenting as stage III/IV disease. It is characterized by the presence of neoplastic cells with morphologic and immunophenotypic characteristics similar to those seen in mature histiocytes." .

NCIT:C2852 a owl:Class ;
    rdfs:label "Adenocarcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Cancer that begins in cells that line certain internal organs and that have gland-like (secretory) properties." .

NCIT:C2862 a owl:Class ;
    rdfs:label "Primary Myelofibrosis" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A progressive, chronic disease in which the bone marrow is replaced by fibrous tissue and blood is made in organs such as the liver and the spleen, instead of in the bone marrow. This disease is marked by an enlarged spleen and progressive anemia." .

NCIT:C2891 a owl:Class ;
    rdfs:label "Barrett Esophagus" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Esophageal lesion lined with columnar metaplastic epithelium which is flat or villiform. Barrett epithelium is characterized by two different types of cells: goblet cells and columnar cells. The symptomatology of Barrett esophagus is that of gastro-esophageal reflux. It is the precursor of most esophageal adenocarcinomas.  (WHO)" .

NCIT:C2901 a owl:Class ;
    rdfs:label "Bladder Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A benign or malignant, primary or metastatic neoplasm of the bladder." .

NCIT:C2907 a owl:Class ;
    rdfs:label "Brain Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "The growth of abnormal cells in the tissues of the brain. Brain tumors can be benign (not cancer) or malignant (cancer)." .

NCIT:C2910 a owl:Class ;
    rdfs:label "Breast Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A benign or malignant neoplasm of the breast parenchyma. It can originate from the ducts, lobules or the breast adipose tissue. Breast neoplasms are much more common in females than males." .

NCIT:C2916 a owl:Class ;
    rdfs:label "Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Cancer that begins in the skin or in tissues that line or cover internal organs." .

NCIT:C2919 a owl:Class ;
    rdfs:label "Prostate Adenocarcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An adenocarcinoma arising from the prostate gland.  It is one of the most common malignant tumors afflicting men.  The majority of adenocarcinomas arise in the peripheral zone and a minority occurs in the central or the transitional zone of the prostate gland.  Grading of prostatic adenocarcinoma predicts disease progression and correlates with survival.  Several grading systems have been proposed, of which the Gleason system is the most commonly used.  Gleason sums of 2 to 4 represent well-differentiated disease, 5 to 7 moderately differentiated disease and 8 to 10 poorly differentiated disease.  Prostatic-specific antigen (PSA) serum test is widely used as a screening test for the early detection of prostatic adenocarcinoma.  Treatment options include radical prostatectomy, radiation therapy, androgen ablation and cryotherapy.  Watchful waiting or surveillance alone is an option for older patients with low-grade or low-stage disease." .

NCIT:C2920 a owl:Class ;
    rdfs:label "Malignant Skin Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Cancer that forms in the tissues of the skin. There are several types of skin cancer. Skin cancer that forms in melanocytes (skin cells that make pigment) is called melanoma. Skin cancer that forms in the lower part of the epidermis (the outer layer of the skin) is called basal cell carcinoma. Skin cancer that forms in squamous cells (flat cells that form the surface of the skin) is called squamous cell carcinoma. Skin cancer that forms in neuroendocrine cells (cells that release hormones in response to signals from the nervous system) is called neuroendocrine carcinoma of the skin. Most skin cancers form in older people on parts of the body exposed to the sun or in people who have weakened immune systems." .

NCIT:C2924 a owl:Class ;
    rdfs:label "Ductal Breast Carcinoma In Situ" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A noninvasive condition in which abnormal cells are found in the lining of a breast duct. The abnormal cells have not spread outside the duct to other tissues in the breast. In some cases, ductal carcinoma in situ may become invasive cancer and spread to other tissues, although it is not known at this time how to predict which lesions will become invasive." .

NCIT:C2926 a owl:Class ;
    rdfs:label "Lung Non-Small Cell Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A group of lung cancers that are named for the kinds of cells found in the cancer and how the cells look under a microscope. The three main types of non-small cell lung cancer are squamous cell carcinoma, large cell carcinoma, and adenocarcinoma. Non-small cell lung cancer is the most common kind of lung cancer." .

NCIT:C2929 a owl:Class ;
    rdfs:label "Squamous Cell Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Cancer that begins in squamous cells, which are thin, flat cells that look like fish scales. Squamous cells are found in the tissue that forms the surface of the skin, the lining of the hollow organs of the body, and the passages of the respiratory and digestive tracts." .

NCIT:C2935 a owl:Class ;
    rdfs:label "Cerebellar Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A benign or malignant (primary or metastatic) tumor involving the cerebellum." .

NCIT:C2940 a owl:Class ;
    rdfs:label "Cervical Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A benign, malignant, or precancerous neoplasm that affects the cervix." .

NCIT:C2945 a owl:Class ;
    rdfs:label "Chondroblastoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A benign, chondroid-producing, well-circumscribed, lytic neoplasm usually arising from the epiphysis of long bones.  It is characterized by the presence of chondroblasts, osteoclast-like giant cells, chondroid formation, calcification, and mitotic activity. In aggressive cases, there is rearrangement of the 8q21 chromosome band.  It occurs most frequently in children and young adults and rarely metastasizes." .

NCIT:C2948 a owl:Class ;
    rdfs:label "Choriocarcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An aggressive malignant tumor arising from trophoblastic cells. The vast majority of cases arise in the uterus and represent gestational choriocarcinomas that derive from placental trophoblastic cells. Approximately half of the cases develop from a complete hydatidiform mole. A minority of cases arise in the testis or the ovaries. There is often marked elevation of human chorionic gonadotropin (hCG) in the blood. Choriocarcinomas disseminate rapidly through the hematogenous route; the lungs are most frequently affected." .

NCIT:C2955 a owl:Class ;
    rdfs:label "Colorectal Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Cancer that develops in the colon (the longest part of the large intestine) and/or the rectum (the last several inches of the large intestine before the anus)." .

NCIT:C2956 a owl:Class ;
    rdfs:label "Colorectal Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A benign or malignant neoplasm that affects the colon or rectum.  Representative examples of benign neoplasms include lipoma and leiomyoma.  Representative examples of malignant neoplasms include carcinoma, lymphoma, and sarcoma.  Colorectal adenomas always exhibit epithelial dysplasia and are considered premalignant neoplasms." .

NCIT:C2964 a owl:Class ;
    rdfs:label "Craniopharyngioma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A histologically benign, but locally destructive, partly cystic, epithelial tumor of the sellar region, derived from Rathke pouch epithelium." .

NCIT:C3012 a owl:Class ;
    rdfs:label "Endometrial Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A benign, borderline, or malignant neoplasm that affects the endometrium." .

NCIT:C3017 a owl:Class ;
    rdfs:label "Ependymoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A type of brain tumor that begins in cells lining the spinal cord central canal (fluid-filled space down the center) or the ventricles (fluid-filled spaces of the brain). Ependymomas may also form in the choroid plexus (tissue in the ventricles that makes cerebrospinal fluid)." .

NCIT:C3043 a owl:Class ;
    rdfs:label "Fibrosarcoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A malignant mesenchymal neoplasm of the soft tissue and bone." .

NCIT:C3058 a owl:Class ;
    rdfs:label "Glioblastoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "The most malignant astrocytic tumor (WHO grade 4).  It is composed of poorly differentiated neoplastic astrocytes and is characterized by the presence of cellular polymorphism, nuclear atypia, brisk mitotic activity, vascular thrombosis, microvascular proliferation, and necrosis. It typically affects adults and is preferentially located in the cerebral hemispheres. (Adapted from WHO)" .

NCIT:C3077 a owl:Class ;
    rdfs:label "Head and Neck Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A carcinoma that arises from the head and neck region.  Representative examples include oral cavity squamous cell carcinoma, laryngeal squamous cell carcinoma, and salivary gland carcinoma." .

NCIT:C3088 a owl:Class ;
    rdfs:label "Angiosarcoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A type of cancer that begins in the cells that line blood vessels." .

NCIT:C3099 a owl:Class ;
    rdfs:label "Hepatocellular Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A type of adenocarcinoma and the most common type of liver tumor." .

NCIT:C3141 a owl:Class ;
    rdfs:label "Intestinal Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A benign or malignant neoplasm involving the small or large intestine." .

NCIT:C3163 a owl:Class ;
    rdfs:label "Chronic Lymphocytic Leukemia" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "The most common type of chronic lymphoid leukemia.  It comprises 90% of chronic lymphoid leukemias in the United States.  Morphologically, the neoplastic cells are small, round B-lymphocytes.  This type of leukemia is not considered to be curable with available therapy. (WHO, 2001)" .

NCIT:C3167 a owl:Class ;
    rdfs:label "Acute Lymphoblastic Leukemia" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Leukemia with an acute onset, characterized by the presence of lymphoblasts in the bone marrow and the peripheral blood. It includes the acute B lymphoblastic leukemia and acute T lymphoblastic leukemia." .

NCIT:C3171 a owl:Class ;
    rdfs:label "Acute Myeloid Leukemia" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An aggressive (fast-growing) disease in which too many myeloblasts (immature white blood cells that are not lymphoblasts) are found in the bone marrow and blood." .

NCIT:C3172 a owl:Class ;
    rdfs:label "Myeloid Leukemia" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A progressive, proliferative disease of blood cells, originating from immature granulocytes." .

NCIT:C3174 a owl:Class ;
    rdfs:label "Chronic Myeloid Leukemia" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A chronic myeloproliferative neoplasm characterized by the expression of the BCR-ABL1 fusion gene. It presents with neutrophilic leukocytosis. It can appear at any age, but it mostly affects middle aged and older individuals. Patients usually present with fatigue, weight loss, anemia, night sweats, and splenomegaly." .

NCIT:C3183 a owl:Class ;
    rdfs:label "T Acute Lymphoblastic Leukemia" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An aggressive (fast-growing) type of leukemia (blood cancer) in which too many T-cell lymphoblasts (immature white blood cells) are found in the bone marrow and blood." .

NCIT:C3200 a owl:Class ;
    rdfs:label "Lung Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A benign or malignant, primary or metastatic neoplasm involving the lungs.  Representative examples of benign neoplasms include adenoma, papilloma, chondroma, and endobronchial lipoma.  Representative examples of malignant neoplasms include carcinoma, carcinoid tumor, sarcoma, and lymphoma." .

NCIT:C3208 a owl:Class ;
    rdfs:label "Lymphoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Cancer that begins in cells of the immune system. There are two basic categories of lymphomas. One kind is Hodgkin lymphoma, which is marked by the presence of a type of cell called the Reed-Sternberg cell. The other category is non-Hodgkin lymphomas, which includes a large, diverse group of cancers of immune system cells. Non-Hodgkin lymphomas can be further divided into cancers that have an indolent (slow-growing) course and those that have an aggressive (fast-growing) course. These subtypes behave and respond to treatment differently. Both Hodgkin and non-Hodgkin lymphomas can occur in children and adults, and prognosis and treatment depend on the stage and the type of cancer." .

NCIT:C3209 a owl:Class ;
    rdfs:label "Follicular Lymphoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A type of B-cell non-Hodgkin lymphoma (cancer of the immune system) that is usually indolent (slow-growing). The tumor cells grow as groups to form nodules. There are several subtypes of follicular lymphoma." .

NCIT:C3211 a owl:Class ;
    rdfs:label "Non-Hodgkin Lymphoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Distinct from Hodgkin lymphoma both morphologically and biologically, non-Hodgkin lymphoma (NHL) is characterized by the absence of Reed-Sternberg cells, can occur at any age, and usually presents as a localized or generalized lymphadenopathy associated with fever and weight loss. The clinical course varies according to the morphologic type. NHL is clinically classified as indolent, aggressive, or having a variable clinical course. NHL can be of B-or T-/NK-cell lineage." .

NCIT:C3222 a owl:Class ;
    rdfs:label "Medulloblastoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A rapidly progressive cancer of the brain that originates in the cerebellum." .

NCIT:C3224 a owl:Class ;
    rdfs:label "Melanoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A malignant, usually aggressive tumor composed of atypical, neoplastic melanocytes. Most often, melanomas arise in the skin (cutaneous melanomas) and include the following histologic subtypes: superficial spreading melanoma, nodular melanoma, acral lentiginous melanoma, and lentigo maligna melanoma. Cutaneous melanomas may arise from acquired or congenital melanocytic or dysplastic nevi. Melanomas may also arise in other anatomic sites including the gastrointestinal system, eye, urinary tract, and reproductive system. Melanomas frequently metastasize to lymph nodes, liver, lungs, and brain." .

NCIT:C324 a owl:Class ;
    rdfs:label "cDNA" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum,
        mc2:VisiumSpatialRead1Enum,
        mc2:VisiumSpatialRead2Enum ;
    skos:definition "Single-stranded DNA that is complementary to messenger RNA or DNA that has been synthesized from messenger RNA by reverse transcriptase.",
        "complementary DNA" .

NCIT:C3242 a owl:Class ;
    rdfs:label "Multiple Myeloma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A type of cancer that begins in plasma cells (white blood cells that produce antibodies)." .

NCIT:C3246 a owl:Class ;
    rdfs:label "Mycosis Fungoides" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A type of non-Hodgkin's lymphoma that first appears on the skin and can spread to the lymph nodes or other organs such as the spleen, liver, or lungs." .

NCIT:C3269 a owl:Class ;
    rdfs:label "Schwannoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A tumor of the peripheral nervous system that arises in the nerve sheath (protective covering).  It is almost always benign, but rare malignant schwannomas have been reported." .

NCIT:C3270 a owl:Class ;
    rdfs:label "Neuroblastoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Cancer that arises in immature nerve cells and affects mostly infants and children." .

NCIT:C3272 a owl:Class ;
    rdfs:label "Neurofibroma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An intraneural or extraneural neoplasm arising from nerve tissues and neural sheaths. It is composed of perineurial-like fibroblasts and Schwann cells. It usually presents as a localized cutaneous lesion and less often as a circumscribed peripheral nerve mass. Patients with neurofibromatosis type 1 present with multiple masses. Neurofibromas which arise from major nerves and plexiform neurofibromas are precursor lesions to malignant peripheral nerve sheath tumors." .

NCIT:C3291 a owl:Class ;
    rdfs:label "Oropharyngeal Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A benign or malignant neoplasm that affects the oropharynx." .

NCIT:C3305 a owl:Class ;
    rdfs:label "Pancreatic Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A benign or malignant neoplasm involving the pancreas." .

NCIT:C3326 a owl:Class ;
    rdfs:label "Pheochromocytoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Tumor that forms in the center of the adrenal gland (gland located above the kidney) that causes it to make too much adrenaline. Pheochromocytomas are usually benign (not cancer) but can cause high blood pressure, pounding headaches, heart palpitations, flushing of the face, nausea, and vomiting." .

NCIT:C3329 a owl:Class ;
    rdfs:label "Pituitary Gland Adenoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A well-differentiated neuroendocrine neoplasm that arises from the adenohypophysial cells of the anterior lobe of the pituitary gland. The tumor can be hormonally functioning or not. It has a low frequency of metastatic spread. When metastatic, the term metastatic pituitary neuroendocrine tumor is endorsed instead of pituitary carcinoma. (WHO)" .

NCIT:C3337 a owl:Class ;
    rdfs:label "Fibroepithelial Polyp" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A polypoid lesion composed of fibrous tissue and epithelium. Representative examples include skin tag, anal fibroepithelial polyp, and gingival fibroepithelial polyp." .

NCIT:C3343 a owl:Class ;
    rdfs:label "Prostate Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A benign, borderline, or malignant neoplasm that affects the prostate gland.  Representative examples include benign prostate phyllodes tumor, prostatic intraepithelial neoplasia, prostate carcinoma, and prostate sarcoma." .

NCIT:C3359 a owl:Class ;
    rdfs:label "Rhabdomyosarcoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Cancer that forms in the soft tissues in a type of muscle called striated muscle. Rhabdomyosarcoma can occur anywhere in the body." .

NCIT:C3372 a owl:Class ;
    rdfs:label "Skin Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A benign, intermediate, or malignant neoplasm involving the skin." .

NCIT:C3387 a owl:Class ;
    rdfs:label "Gastric Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A benign or malignant neoplasm involving the stomach." .

NCIT:C3400 a owl:Class ;
    rdfs:label "Synovial Sarcoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A malignant tumor that develops in the synovial membrane of the joints." .

NCIT:C3403 a owl:Class ;
    rdfs:label "Teratoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A type of germ cell tumor that may contain several different types of tissue, such as hair, muscle, and bone.  Teratomas occur most often in the ovaries in women, the testicles in men, and the tailbone in children.  Not all teratomas are malignant." .

NCIT:C3436 a owl:Class ;
    rdfs:label "Uveal Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A neoplasm that affects the uvea.  Uveal melanoma is a representative example." .

NCIT:C34447 a owl:Class ;
    rdfs:label "Head and Neck Squamous Cell Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Cancer of the head and neck that begins in squamous cells (thin, flat cells that form the surface of the skin, eyes, various internal organs, and the lining of hollow organs and ducts of some glands). Squamous cell carcinoma of the head and neck includes cancers of the nasal cavity, sinuses, lips, mouth, salivary glands, throat, and larynx (voice box). Most head and neck cancers are squamous cell carcinomas." .

NCIT:C3457 a owl:Class ;
    rdfs:label "B-Cell Non-Hodgkin Lymphoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "The most common type of non-Hodgkin lymphoma.  It includes the most frequently seen morphologic variants which are: diffuse large B-cell lymphoma, follicular lymphoma, small lymphocytic lymphoma and marginal zone B-cell lymphoma." .

NCIT:C3466 a owl:Class ;
    rdfs:label "T-Cell Lymphoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A non-Hodgkin lymphoma of T-cell lineage. It includes the T lymphoblastic lymphoma and the mature T- and NK-cell lymphomas." .

NCIT:C3467 a owl:Class ;
    rdfs:label "Cutaneous T Cell Lymphoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Any of a group of T-cell non-Hodgkin lymphomas that begins in the skin as an itchy, red rash that can thicken or form a tumor. The most common types are mycosis fungoides and Sezary syndrome." .

NCIT:C3493 a owl:Class ;
    rdfs:label "Lung Squamous Cell Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A carcinoma arising from squamous bronchial epithelial cells. It may be keratinizing or non-keratinizing. Keratinizing squamous cell carcinoma is characterized by the presence of keratinization, pearl formation, and/or intercellular bridges. Non-keratinizing squamous cell carcinoma is characterized by the absence of keratinization, pearl formation, and intercellular bridges. Cigarette smoking and arsenic exposure are strongly associated with squamous cell lung carcinoma." .

NCIT:C3510 a owl:Class ;
    rdfs:label "Cutaneous Melanoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A primary melanoma arising from atypical melanocytes in the skin.  Precursor lesions include acquired and congenital melanocytic nevi, and dysplastic nevi.  Several histologic variants have been recognized, including superficial spreading melanoma, acral lentiginous melanoma, nodular melanoma, and lentigo maligna melanoma." .

NCIT:C3512 a owl:Class ;
    rdfs:label "Lung Adenocarcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A carcinoma that arises from the lung and is characterized by the presence of malignant glandular epithelial cells.  There is a male predilection with a male to female ratio of 2:1.  Usually lung adenocarcinoma is asymptomatic and is identified through screening studies or as an incidental radiologic finding.  If clinical symptoms are present they include shortness of breath, cough, hemoptysis, chest pain, and fever.  Tobacco smoke is a known risk factor." .

NCIT:C3513 a owl:Class ;
    rdfs:label "Esophageal Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Cancer that forms in tissues lining the esophagus (the muscular tube through which food passes from the throat to the stomach). Two types of esophageal cancer are squamous cell carcinoma (cancer that begins in flat cells lining the esophagus) and adenocarcinoma (cancer that begins in cells that make and release mucus and other fluids)." .

NCIT:C3538 a owl:Class ;
    rdfs:label "Malignant Peritoneal Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Cancer of the tissue that lines the abdominal wall and covers organs in the abdomen." .

NCIT:C35417 a owl:Class ;
    rdfs:label "Intrahepatic Cholangiocarcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A malignant neoplasm of the liver arising from/comprising cells resembling those of bile ducts." .

NCIT:C35571 a owl:Class ;
    rdfs:label "Progression",
        "Progressive Disease" ;
    rdfs:subClassOf mc2:BiospecimenCompositionEnum,
        mc2:BiospecimenIncidenceTypeEnum,
        mc2:TreatmentResponseEnum ;
    skos:definition "A clinical, pathologic, and/or molecular finding indicating that the course of a disease is worsening in terms of extent or severity.",
        "A clinical, pathologic, and/or molecular finding indicating that the course of a disease is worsening.",
        "Progressive Disease" .

NCIT:C3568 a owl:Class ;
    rdfs:label "Malignant Brain Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An abnormal solid mass arising within the brain with histologic features suggesting the potential to metastasize." .

NCIT:C35850 a owl:Class ;
    rdfs:label "Head and Neck Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A carcinoma that arises from the head and neck region.  Representative examples include oral cavity squamous cell carcinoma, laryngeal squamous cell carcinoma, and salivary gland carcinoma." .

NCIT:C3768 a owl:Class ;
    rdfs:label "Acinar Cell Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A malignant glandular epithelial neoplasm consisting of secretory cells forming acinar patterns. Representative examples include the acinar cell carcinoma of the pancreas and the acinar adenocarcinoma of the prostate gland." .

NCIT:C3770 a owl:Class ;
    rdfs:label "Pancreatic Neuroendocrine Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Cancer arising from cells in the islets of Langerhans, which are found in the pancreas." .

NCIT:C3797 a owl:Class ;
    rdfs:label "Plexiform Neurofibroma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An elongated and multinodular neurofibroma that forms when the tumor involves either multiple trunks of a nerve plexus or multiple fascicles of a large nerve. Some plexiform neurofibromas resemble a 'bag of worms', while others produce a massive ropy enlargement of the nerve. (Adapted from WHO)" .

NCIT:C3798 a owl:Class ;
    rdfs:label "Malignant Peripheral Nerve Sheath Tumor" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An uncommon, highly aggressive malignant tumor, arising from the peripheral nerves and affecting mostly adults in their third to sixth decades of life.  It usually occurs in medium-sized and large nerves of the buttock, thigh, upper arm, or the paraspinal region.  It may be associated with neurofibromatosis 1 (NF1)." .

NCIT:C3809 a owl:Class ;
    rdfs:label "Neuroendocrine Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An epithelial neoplasm with neuroendocrine differentiation. This category includes neuroendocrine tumors, neuroendocrine carcinomas, and paragangliomas." .

NCIT:C3828 a owl:Class ;
    rdfs:label "Combined Hepatocellular Carcinoma and Cholangiocarcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A rare tumor containing unequivocal elements of both hepatocellular and cholangiocarcinoma that are intimately admixed.  This tumor should be distinguished from separate hepatocellular carcinoma and cholangiocarcinoma arising in the same liver.  The prognosis of this tumor is poor." .

NCIT:C3844 a owl:Class ;
    rdfs:label "Gallbladder Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Cancer that forms in tissues of the gallbladder. The gallbladder is a pear-shaped organ below the liver that collects and stores bile (a fluid made by the liver to digest fat). Gallbladder cancer begins in the innermost layer of tissue and spreads through the outer layers as it grows." .

NCIT:C3868 a owl:Class ;
    rdfs:label "Gastrointestinal Stromal Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A type of tumor that usually begins in cells in the wall of the gastrointestinal tract. It can be benign or malignant." .

NCIT:C3871 a owl:Class ;
    rdfs:label "Nasopharyngeal Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Cancer that forms in tissues of the nasopharynx (upper part of the throat behind the nose). Most nasopharyngeal cancers are squamous cell carcinomas (cancer that begins in flat cells lining the nasopharynx)." .

NCIT:C3878 a owl:Class ;
    rdfs:label "Thyroid Gland Anaplastic Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An aggressive carcinoma of the thyroid gland composed of undifferentiated cells." .

NCIT:C39200 a owl:Class ;
    rdfs:label "Gene Silencing" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The process by which the expression of a specific gene is suppressed, occurring naturally (e.g., via RNA interference or DNA methylation) or induced experimentally as a research tool." .

NCIT:C4004 a owl:Class ;
    rdfs:label "Gastric Adenocarcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An adenocarcinoma arising from the stomach glandular epithelium. Gastric adenocarcinoma is primarily a disease of older individuals.  It most commonly develops after a long period of atrophic gastritis and is strongly associated with Helicobacter pylori infection. The lack of early symptoms often delays the diagnosis of gastric cancer. The majority of patients present with advanced tumors which have poor rates of curability. Microscopically, two important histologic types of gastric adenocarcinoma are recognized: the intestinal and diffuse type. The overall prognosis of gastric adenocarcinomas is poor, even in patients who receive a \"curative\" resection (adapted from Sternberg's Surgical Pathology, 3rd ed., 1999)." .

NCIT:C4024 a owl:Class ;
    rdfs:label "Esophageal Squamous Cell Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A squamous cell carcinoma arising from the esophagus.  It is associated with a long history of tobacco and alcohol abuse and is exceedingly rare before the age of 30.  The median age is around 65 in both males and females.  It is located mostly in the middle and lower third of the esophagus.  Grossly, polypoid, ulcerated, plaque-like and occult lesions have been described.  The microscopic features are the same as in other squamous cell carcinomas.  Any degree of differentiation may occur, and variation within a single tumor is common.  The prognosis is poor." .

NCIT:C4025 a owl:Class ;
    rdfs:label "Esophageal Adenocarcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A malignant tumor with glandular differentiation arising predominantly from Barrett mucosa in the lower third of the esophagus.  Rare examples of esophageal adenocarcinoma deriving from ectopic gastric mucosa in the upper esophagus have also been reported.  Grossly, esophageal adenocarcinomas are similar to esophageal squamous cell carcinomas.  Microscopically, adenocarcinomas arising in the setting of Barrett esophagus are typically papillary and/or tubular.  The prognosis is poor." .

NCIT:C4030 a owl:Class ;
    rdfs:label "Urothelial Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A malignant neoplasm derived from the transitional epithelium of the urinary tract (urinary bladder, ureter, urethra, or renal pelvis). It is frequently papillary." .

NCIT:C4033 a owl:Class ;
    rdfs:label "Clear Cell Renal Cell Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "The most common type of kidney cancer. It begins in the lining of the renal tubules in the kidney. The renal tubules filter the blood and produce urine." .

NCIT:C40392 a owl:Class ;
    rdfs:label "Myoepithelioma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A tumor composed predominantly of myoepithelial cells, the contractile cells that normally surround the secretory acini of glandular tissue such as the salivary or breast glands. It is usually benign, though malignant myoepithelial tumors (myoepithelial carcinoma) also occur." .

NCIT:C4047 a owl:Class ;
    rdfs:label "Pilocytic Astrocytoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A WHO grade 1, relatively circumscribed, slowly growing, often cystic astrocytoma occurring in children and young adults.  Histologically it is characterized by a biphasic pattern with compacted bipolar cells associated with Rosenthal fibers and multipolar cells associated with microcysts and eosinophilic bodies/hyaline droplets. (WHO)" .

NCIT:C4131 a owl:Class ;
    rdfs:label "Fibrolamellar Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A distinctive type of liver cell carcinoma that arises in non-cirrhotic livers and is seen predominantly in young patients.  The tumor cells are polygonal and deeply eosinophilic, and are embedded in a fibrous stroma.  The prognosis is similar to classical hepatocellular carcinoma that arises in non-cirrhotic livers, and better than hepatocellular carcinoma that arises in cirrhotic livers." .

NCIT:C4194 a owl:Class ;
    rdfs:label "Invasive Ductal Breast Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "The most common type of invasive breast cancer. It starts in the cells that line the milk ducts in the breast, grows outside the ducts, and often spreads to the lymph nodes." .

NCIT:C4337 a owl:Class ;
    rdfs:label "Mantle Cell Lymphoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An aggressive, usually diffuse non-Hodgkin lymphoma composed of small to medium sized B-lymphocytes (centrocytes).  Most patients present with advanced stage disease with lymphadenopathy, hepatosplenomegaly, and bone marrow involvement.  The gastrointestinal tract is the most commonly affected extranodal site by this type of non-Hodgkin lymphoma.  The vast majority of cases express the t(11;14)(q13;q32) resulting in the rearrangement of the BCL-1 gene and the overexpression of cyclin D1 mRNA." .

NCIT:C4341 a owl:Class ;
    rdfs:label "Marginal Zone Lymphoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An indolent (slow-growing) type of B-cell non-Hodgkin lymphoma that begins forming in certain areas (the marginal zones) of lymph tissue. There are three types based on whether it forms in the spleen, lymph nodes, or other lymphoid tissue that contains a lot of B cells (a type of white blood cell)." .

NCIT:C4345 a owl:Class ;
    rdfs:label "Myeloproliferative Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A group of slow growing blood cancers, including chronic myelogenous leukemia, in which large numbers of abnormal red blood cells, white blood cells, or platelets grow and spread in the bone marrow and the peripheral blood." .

NCIT:C4348 a owl:Class ;
    rdfs:label "Non-Functioning Pituitary Gland Adenoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A hormone producing or non-producing pituitary neuroendocrine tumor not associated with a hormonal syndrome." .

NCIT:C4349 a owl:Class ;
    rdfs:label "Colon Adenocarcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An adenocarcinoma arising from the colon.  It is more frequently seen in populations with a Western type diet and in patients with a history of chronic inflammatory bowel disease.  Signs and symptoms include intestinal bleeding, anemia, and change in bowel habits.  According to the degree of cellular differentiation, colonic adenocarcinomas are divided into well, moderately, and poorly differentiated.  Histologic variants include mucinous adenocarcinoma, signet ring cell carcinoma, medullary carcinoma, serrated adenocarcinoma, cribriform comedo-type adenocarcinoma, and micropapillary adenocarcinoma." .

NCIT:C4436 a owl:Class ;
    rdfs:label "Cholangiocarcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A rare type of cancer that develops in cells that line the bile ducts in the liver. Cancer that forms where the right and left ducts meet is called Klatskin tumor." .

NCIT:C4456 a owl:Class ;
    rdfs:label "Mesothelioma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A usually malignant and aggressive neoplasm of the mesothelium which is often associated with exposure to asbestos." .

NCIT:C45447 a owl:Class ;
    rdfs:label "Genotyping" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The determination of the nucleotide sequence of the genetic material at a specific locus." .

NCIT:C4724 a owl:Class ;
    rdfs:label "Cellular Schwannoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A morphologic variant of schwannoma characterized by hypercellularity, Antoni A pattern, and the absence of well-formed Verocay bodies." .

NCIT:C48061 a owl:Class ;
    rdfs:label "Collision-Induced Dissociation" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A method by which fragmentation can be achieved.  CID is accomplished by selecting an ion of interest with the mass analyzer and then subjecting that ion to collisions with neutral atoms or molecules.  The resulting fragment ions are then mass analyzed. (from The Expanding Role of Mass Spectrometry in Biotechnology by Gary Siuzdak)" .

NCIT:C4815 a owl:Class ;
    rdfs:label "Thyroid Gland Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Cancer that forms in the thyroid gland (an organ at the base of the throat that makes hormones that help control heart rate, blood pressure, body temperature, and weight). Four main types of thyroid cancer are papillary, follicular, medullary, and anaplastic thyroid cancer. The four types are based on how the cancer cells look under a microscope." .

NCIT:C4817 a owl:Class ;
    rdfs:label "Ewing Sarcoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A type of cancer that forms in bone or soft tissue." .

NCIT:C4822 a owl:Class ;
    rdfs:label "Malignant Glioma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A malignant neuroglial neoplasm. The term can apply to several primary neoplasm of the brain and spinal cord, including astrocytoma and oligodendroglioma in addition to others." .

NCIT:C4833 a owl:Class ;
    rdfs:label "Oral Cavity Squamous Cell Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A type of mass spectrometry that uses the cyclotron frequency of ions in a fixed magnetic field to determine their ionic mass-to-charge ratio." .

NCIT:C4861 a owl:Class ;
    rdfs:label "Acute Monocytic Leukemia" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An acute myeloid leukemia in which the majority of monocytic cells are promonocytes.  (WHO, 2001)" .

NCIT:C4863 a owl:Class ;
    rdfs:label "Prostate Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "One of the most common malignant tumors afflicting men.  The majority of carcinomas arise in the peripheral zone and a minority occur in the central or the transitional zone of the prostate gland.  Grossly, prostatic carcinomas appear as ill-defined yellow areas of discoloration in the prostate gland lobes.  Adenocarcinomas represent the overwhelming majority of prostatic carcinomas.  Prostatic-specific antigen (PSA) serum test is widely used as a screening test for the early detection of prostatic carcinoma.  Treatment options include radical prostatectomy, radiation therapy, androgen ablation and cryotherapy.  Watchful waiting or surveillance alone is an option for older patients with low-grade or low-stage disease." .

NCIT:C4872 a owl:Class ;
    rdfs:label "Breast Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Cancer that forms in tissues of the breast, usually the ducts (tubes that carry milk to the nipple) and lobules (glands that make milk). It occurs in both men and women, although male breast cancer is rare." .

NCIT:C4878 a owl:Class ;
    rdfs:label "Lung Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Cancer that forms in tissues of the lung, usually in the cells lining air passages. The two main types are small cell lung cancer and non-small cell lung cancer. These types are diagnosed based on how the cells look under a microscope." .

NCIT:C4890 a owl:Class ;
    rdfs:label "Malignant Digestive System Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A primary or metastatic malignant neoplasm involving any part of the digestive system." .

NCIT:C4908 a owl:Class ;
    rdfs:label "Ovarian Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Cancer that occurs in the cells lining the ovaries." .

NCIT:C4910 a owl:Class ;
    rdfs:label "Colon Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Cancer that forms in the tissues of the colon (the longest part of the large intestine). Most colon cancers are adenocarcinomas (cancers that begin in cells that make and release mucus and other fluids)." .

NCIT:C4911 a owl:Class ;
    rdfs:label "Gastric Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Cancer that forms in tissues lining the stomach." .

NCIT:C4912 a owl:Class ;
    rdfs:label "Bladder Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Cancer that forms in tissues of the bladder (the organ that stores urine). Most bladder cancers are transitional cell carcinomas (cancer that begins in cells that normally make up the inner lining of the bladder). Other types include squamous cell carcinoma (cancer that begins in thin, flat cells) and adenocarcinoma (cancer that begins in cells that make and release mucus and other fluids). The cells that form squamous cell carcinoma and adenocarcinoma develop in the inner lining of the bladder as a result of chronic irritation and inflammation." .

NCIT:C4914 a owl:Class ;
    rdfs:label "Skin Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Skin cancer that arises in basal cells or squamous cells but not in melanocytes (pigment-producing cells of the skin)." .

NCIT:C4917 a owl:Class ;
    rdfs:label "Lung Small Cell Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An aggressive (fast-growing) cancer that forms in tissues of the lung and can spread to other parts of the body. The cancer cells look small and oval-shaped when looked at under a microscope." .

NCIT:C4984 a owl:Class ;
    rdfs:label "Ovarian Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A benign, borderline, or malignant neoplasm involving the ovary." .

NCIT:C5105 a owl:Class ;
    rdfs:label "Colorectal Adenocarcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "The most common type of colorectal carcinoma.  It is characterized by the presence of malignant glandular epithelial cells invading through the muscularis mucosa into the submucosa.  Histologic variants include mucinous adenocarcinoma, signet ring cell carcinoma, medullary carcinoma, serrated adenocarcinoma, cribriform comedo-type adenocarcinoma, and micropapillary adenocarcinoma." .

NCIT:C51962 a owl:Class ;
    rdfs:label "qPCR" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An application of PCR that measures the products generated during each cycle of the polymerase chain reaction process in order to determine the starting amount of template in the reaction." .

NCIT:C5214 a owl:Class ;
    rdfs:label "Breast Adenocarcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "The most common histologic type of breast carcinoma.  Representative examples include invasive ductal carcinoma not otherwise specified, ductal carcinoma in situ, inflammatory carcinoma, secretory carcinoma, signet ring cell carcinoma, tubular carcinoma, invasive lobular carcinoma, and lobular carcinoma in situ." .

NCIT:C53372 a owl:Class ;
    rdfs:label "Survival Analysis" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A statistical method that analyzes the duration of time until an event of interest occurs, such as death, disease recurrence, or treatment failure." .

NCIT:C53554 a owl:Class ;
    rdfs:label "Luminal A Breast Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A biologic subset of breast carcinoma defined by high expression of genes characteristic of luminal epithelial cells, including estrogen receptor (ER), estrogen regulated protein LIV-1, and the transcription factors hepatocyte nuclear factor 3, HNF3A, XBP1, and GATA 3.  This subtype of breast cancer is associated with a good prognosis." .

NCIT:C53558 a owl:Class ;
    rdfs:label "Basal-Like Breast Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A biologic subset of breast carcinoma defined by high expression of genes characteristic of basal epithelial cells, including KRT5 and KRT17, annexin 8, CX3CL1, and TRIM29, and usually by lack of expression of the estrogen receptor (ER), progesterone receptor (PR), and human epidermal growth factor receptor 2 (HER2). It is the most common subtype of breast cancer associated with BRCA1 mutations, and is associated with a poor prognosis." .

NCIT:C5673 a owl:Class ;
    rdfs:label "Colorectal Adenoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An adenoma that arises from the colon or rectum.  The group of colorectal adenomas includes tubular, villous, and tubulovillous adenomas, traditional serrated adenomas, sessile serrated adenomas/polyps, and familial adenomatous polyposis." .

NCIT:C60701 a owl:Class ;
    rdfs:label "Allograft" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A graft transferred from a donor of one species to a recipient of the same species but different genetic makeup." .

NCIT:C60781 a owl:Class ;
    rdfs:label "Astrocytoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A tumor that begins in the brain or spinal cord in small, star-shaped cells called astrocytes." .

NCIT:C61408 a owl:Class ;
    rdfs:label "Synthesis" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The process of producing a chemical compound, usually by the union of simpler chemical compounds." .

NCIT:C62320 a owl:Class ;
    rdfs:label "Optical Tweezers" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A technique that utilizes light waves to exert minute forces as well as transmit energy to isolate and manipulate nanoparticles." .

NCIT:C62328 a owl:Class ;
    rdfs:label "Inductively-Coupled Plasma Mass Spectrometry" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A mass spectrometry technique that uses inductively-coupled plasma generated from argon gas to atomize and ionize a sample. The resulting ions are separated and analyzed using a mass spectrometer." .

NCIT:C62329 a owl:Class ;
    rdfs:label "Dynamic Light Scattering" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A type of spectroscopy that utilizes a laser beam to irradiate a sample containing particles in suspension, resulting in light scattering. Rapid fluctuations in scattering intensity, around a mean value at a certain angle, occur because of particle diffusion and are dependent upon on particle size. The calculated correlation function yields a diffusion coefficient, for a given temperature and viscosity, which can be used to calculate particle size." .

NCIT:C62376 a owl:Class ;
    rdfs:label "Nanowire" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A nanometer-scale wire consisting of metal atoms, silicon or other materials that conduct electricity. Nanowires are one-dimensional, and exhibit unique electrical and optical properties. They are built atom by atom on a solid surface, often as part of a microfluidic device. In addition, they can be coated with molecules such as antibodies that will bind to proteins for both basic science and clinical applications." .

NCIT:C62665 a owl:Class ;
    rdfs:label "Dynamic Contrast-Enhanced Magnetic Resonance Imaging" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A type of contrast-enhanced MRI that allows observation of functional properties in addition to structural properties." .

NCIT:C63327 a owl:Class ;
    rdfs:label "Clonality Analysis" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A molecular analysis performed to determine whether a population of cells is descended from a single progenitor cell." .

NCIT:C6336 a owl:Class ;
    rdfs:label "Uterine Adenosarcoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A primary malignant neoplasm of the uterine corpus characterized by a sarcomatous (malignant) mesenchymal component combined with a benign glandular epithelial component. It is generally a low-grade tumor that can recur locally following resection." .

NCIT:C6341 a owl:Class ;
    rdfs:label "Testicular Embryonal Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A malignant germ cell neoplasm arising from the testis.  It is composed of primitive epithelial cells arranged in solid, papillary, and glandular configurations.  Most patients present with a testicular mass, which may be associated with pain.  More than half of the patients have metastatic disease at diagnosis.  The form of treatment following radical orchiectomy is stage dependent." .

NCIT:C6510 a owl:Class ;
    rdfs:label "Leiomyoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A well-circumscribed benign smooth muscle neoplasm characterized by the presence of spindle cells with cigar-shaped nuclei, interlacing fascicles, and a whorled pattern." .

NCIT:C68611 a owl:Class ;
    rdfs:label "Sinonasal Squamous Cell Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A rare, keratinizing or non-keratinizing squamous cell carcinoma arising from the mucosal epithelium of the nasal cavity or the paranasal sinuses.  It affects most often the maxillary sinus.  Less frequently, it arises from the nasal cavity, ethmoid sinus, sphenoid sinus, and frontal sinus.  Symptoms include nasal fullness, epistaxis, rhinorhea, pain, and paresthesia.  Patients with nasal squamous cell carcinoma usually present earlier than patients with maxillary sinus carcinoma and have a better prognosis compared to the latter group." .

NCIT:C6906 a owl:Class ;
    rdfs:label "Atypical Teratoid/Rhabdoid Tumor" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An aggressive malignant embryonal neoplasm arising from the central nervous system. It is composed of cells with a large eccentric nucleus, prominent nucleolus, and abundant cytoplasm. Mutations of the SMARCB1 gene or very rarely SMARCA4 (BRG1) gene are present. The vast majority of cases occur in childhood. Symptoms include lethargy, vomiting, cranial nerve palsy, headache, and hemiplegia." .

NCIT:C6969 a owl:Class ;
    rdfs:label "Plexiform Schwannoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A schwannoma characterized by a plexiform or multinodular growth pattern.  It usually arises from the skin or subcutaneous tissues in the extremities, trunk, and head and neck." .

NCIT:C7103 a owl:Class ;
    rdfs:label "Liver and Intrahepatic Bile Duct Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A benign or malignant neoplasm that affects the liver parenchyma or intrahepatic bile ducts.  Representative examples of benign neoplasms include hepatocellular adenoma, and bile duct adenoma.  Representative examples of malignant neoplasms include hepatocellular carcinoma, intrahepatic cholangiocarcinoma, and lymphoma." .

NCIT:C71104 a owl:Class ;
    rdfs:label "Clinical Study" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Research conducted with human subjects or human-derived material in which an investigator directly interacts with subjects, encompassing clinical trials as well as epidemiologic, behavioral, and health services research." .

NCIT:C71732 a owl:Class ;
    rdfs:label "Triple-Negative Breast Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An invasive breast carcinoma which is negative for expression of estrogen receptor (ER), progesterone receptor (PR), and human epidermal growth factor receptor 2 (HER2)." .

NCIT:C7224 a owl:Class ;
    rdfs:label "Plasmablastic Lymphoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An aggressive diffuse large B-cell lymphoma frequently arising in the setting of HIV infection and characterized by the presence of large neoplastic cells resembling B-immunoblasts which have the immunophenotypic profile of plasma cells.  Sites of involvement include the oral cavity, sinonasal cavity, skin, soft tissues, gastrointestinal tract, and bone." .

NCIT:C7317 a owl:Class ;
    rdfs:label "Ovarian Adenosarcoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A biphasic neoplasm that arises from the ovary and is characterized by the presence of mullerian-type epithelial tissue in a mesenchymal sarcomatous stroma.  The presence of a high grade sarcomatous component is associated with recurrences and metastases." .

NCIT:C7431 a owl:Class ;
    rdfs:label "Malignant Ovarian Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Cancer that forms in tissues of the ovary (one of a pair of female reproductive glands in which the ova, or eggs, are formed). Most ovarian cancers are either ovarian epithelial carcinomas (cancer that begins in the cells on the surface of the ovary) or malignant germ cell tumors (cancer that begins in egg cells)." .

NCIT:C7539 a owl:Class ;
    rdfs:label "Lymphoid Leukemia" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A type of cancer in which the bone marrow makes too many lymphocytes (white blood cells)." .

NCIT:C7541 a owl:Class ;
    rdfs:label "Retinoblastoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Cancer that forms in the tissues of the retina (the light-sensitive layers of nerve tissue at the back of the eye). Retinoblastoma usually occurs in children younger than 5 years. It may be hereditary or nonhereditary (sporadic)." .

NCIT:C7550 a owl:Class ;
    rdfs:label "Ovarian Serous Adenocarcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An adenocarcinoma that arises from the ovary and is characterized by the presence of malignant epithelial cells that, in well differentiated tumors, resemble the epithelium of the fallopian tube or, in poorly differentiated tumors, show anaplastic features and marked nuclear atypia." .

NCIT:C7558 a owl:Class ;
    rdfs:label "Endometrial Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Cancer that forms in the tissue lining the uterus (the small, hollow, pear-shaped organ in a woman's pelvis in which a fetus develops). Most endometrial cancers are adenocarcinomas (cancers that begin in cells that make and release mucus and other fluids)." .

NCIT:C7606 a owl:Class ;
    rdfs:label "Oral Cavity Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A benign or malignant neoplasm that affects the oral cavity." .

NCIT:C7712 a owl:Class ;
    rdfs:label "Uveal Melanoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A rare cancer of melanocytes (cells that produce the pigment melanin) found in the eye." .

NCIT:C78869 a owl:Class ;
    rdfs:label "Energy-Dispersive X-Ray Spectroscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A technique in crystallography in which the pattern produced by the diffraction of x-rays through the closely spaced lattice of atoms in a crystal is recorded and then analyzed to reveal the nature of that lattice." .

NCIT:C7927 a owl:Class ;
    rdfs:label "Liver and Intrahepatic Bile Duct Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Primary liver cancer is cancer that forms in the tissues of the liver. Secondary liver cancer is cancer that spreads to the liver from another part of the body." .

NCIT:C7982 a owl:Class ;
    rdfs:label "Cervical Small Cell Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A small cell neuroendocrine carcinoma arising from the cervix." .

NCIT:C8026 a owl:Class ;
    rdfs:label "Salivary Gland Adenoid Cystic Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An adenoid cystic carcinoma arising from the salivary gland.  It is characterized by the presence of epithelial and myoepithelial cells forming tubular, cribriform, and solid patterns.  It usually presents as a slow growing mass.  Patients may experience pain because of the tumor propensity for perineural invasion.  The tumor may follow an aggressive clinical course with recurrences and mestastases to distant sites including lungs, bones, brain, and liver." .

NCIT:C8294 a owl:Class ;
    rdfs:label "Pancreatic Adenocarcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An adenocarcinoma which arises from the exocrine pancreas.  Ductal adenocarcinoma and its variants are the most common types of pancreatic adenocarcinoma." .

NCIT:C84621 a owl:Class ;
    rdfs:label "Central Nervous System Cavernous Hemangioma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A cavernous hemangioma arising from the central nervous system." .

NCIT:C8509 a owl:Class ;
    rdfs:label "Primary",
        "Primary Neoplasm",
        "Primary Tumor" ;
    rdfs:subClassOf mc2:BiospecimenCompositionEnum,
        mc2:BiospecimenPathologyEnum,
        mc2:BiospecimenTypeEnum ;
    skos:definition "A neoplasm at the original site of growth.",
        "A tumor at the original site at which it arose.",
        "A tumor specimen collected from the anatomic site where the cancer originated, as opposed to a metastatic or recurrent site." .

NCIT:C85574 a owl:Class ;
    rdfs:label "Atomic Absorption Spectroscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A spectrometric method that determines the type and concentration of metal elements in a sample, based upon the principle that each elemental metal absorbs a particular wavelength of ultraviolet light when exposed to heat." .

NCIT:C85837 a owl:Class ;
    rdfs:label "Dark Field Microscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A microscopic technique in which the light that does not come into contact with the structure or details of interest is subtracted from the ocular image. This yields an image in which the structure or details are alight while the areas where the structures or details are absent are dark." .

NCIT:C8644 a owl:Class ;
    rdfs:label "B Acute Lymphoblastic Leukemia" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "The most frequent type of acute lymphoblastic leukemia.  Approximately 75% of cases occur in children under six years of age.  This is a good prognosis leukemia.  In the pediatric age group the complete remission rate is approximately 95% and the disease free survival rate is 70%.  Approximately 80% of children appear to be cured.  In the adult age group the complete remission rate is 60-85%.  (WHO, 2001)" .

NCIT:C8851 a owl:Class ;
    rdfs:label "Diffuse Large B-Cell Lymphoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A type of B-cell non-Hodgkin lymphoma (cancer of the immune system) that is usually aggressive (fast-growing). It is the most common type of non-Hodgkin lymphoma, and is marked by rapidly growing tumors in the lymph nodes, spleen, liver, bone marrow, or other organs. Other symptoms include fever, night sweats, and weight loss. There are several subtypes of diffuse large B-cell lymphoma." .

NCIT:C8936 a owl:Class ;
    rdfs:label "Precursor B-cell lymphoblastic leukemia" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "The most frequent type of acute lymphoblastic leukemia.  Approximately 75% of cases occur in children under six years of age.  This is a good prognosis leukemia.  In the pediatric age group the complete remission rate is approximately 95% and the disease free survival rate is 70%.  Approximately 80% of children appear to be cured.  In the adult age group the complete remission rate is 60-85%.  (WHO, 2001)" .

NCIT:C9005 a owl:Class ;
    rdfs:label "Malignant Pancreatic Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A primary or metastatic malignant tumor involving the pancreas.  Representative examples include carcinoma and lymphoma." .

NCIT:C9039 a owl:Class ;
    rdfs:label "Cervical Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Cancer that forms in tissues of the cervix (the organ connecting the uterus and vagina). It is usually a slow-growing cancer that may not have symptoms but can be found with regular Pap tests (a procedure in which cells are scraped from the cervix and looked at under a microscope). Cervical cancer is almost always caused by human papillomavirus (HPV) infection." .

NCIT:C9061 a owl:Class ;
    rdfs:label "Penile Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A rare cancer that forms in the penis (an external male reproductive organ). Most penile cancers are squamous cell carcinomas (cancer that begins in flat cells lining the penis)." .

NCIT:C9087 a owl:Class ;
    rdfs:label "Kaposi Sarcoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A type of cancer characterized by the abnormal growth of blood vessels that develop into skin lesions or occur internally." .

NCIT:C9118 a owl:Class ;
    rdfs:label "Sarcoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A usually aggressive malignant neoplasm of the soft tissue or bone. It arises from muscle, fat, fibrous tissue, bone, cartilage, and blood vessels. Sarcomas occur in both children and adults. The prognosis depends largely on the degree of differentiation (grade) of the neoplasm. Representative subtypes are liposarcoma, leiomyosarcoma, osteosarcoma, and chondrosarcoma." .

NCIT:C9120 a owl:Class ;
    rdfs:label "Pancreatic Ductal Adenocarcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An infiltrating adenocarcinoma that arises from the epithelial cells of the pancreas.  It affects males more often than females and the patients are usually over 50 years of age.  Microscopically it is characterized by the presence of glandular (ductal) differentiation and desmoplastic stroma formation.  Signs and symptoms include pain, loss of weight, and jaundice.  It grows rapidly and is usually detected after it has metastasized to other anatomic sites.  The prognosis is usually poor." .

NCIT:C9145 a owl:Class ;
    rdfs:label "Osteosarcoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A usually aggressive malignant bone-forming mesenchymal neoplasm, predominantly affecting adolescents and young adults. It usually involves bones and less frequently extraosseous sites. It often involves the long bones (particularly distal femur, proximal tibia, and proximal humerus). Pain with or without a palpable mass is the most frequent clinical symptom. It may spread to other anatomic sites, particularly the lungs." .

NCIT:C92299 a owl:Class ;
    rdfs:label "Alcian Blue Staining Method" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A microscopy staining method that uses Alcian Blue, a cationic copper-containing dye, to detect acidic mucosubstances and glycosaminoglycans in tissue." .

NCIT:C92555 a owl:Class ;
    rdfs:label "Extraventricular Neurocytoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A WHO grade 2 neoplasm that arises from the brain parenchyma. Morphologically it is characterized by the presence of neoplastic uniform, round cells with neuronal differentiation. Unlike central neurocytoma, it does not involve the lateral ventricles. It usually affects young adults and has a favorable prognosis." .

NCIT:C9290 a owl:Class ;
    rdfs:label "Myeloid Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Proliferation of myeloid cells originating from a primitive stem cell." .

NCIT:C9293 a owl:Class ;
    rdfs:label "Central Nervous System Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A tumor of the central nervous system, including brain stem glioma, craniopharyngioma, medulloblastoma, and meningioma." .

NCIT:C9296 a owl:Class ;
    rdfs:label "Gastroesophageal Junction Adenocarcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An adenocarcinoma that arises from and straddles the junction of the stomach and esophagus.  The category of adenocarcinomas of the gastroesophageal junction also includes the majority of adenocarcinomas previously called gastric cardia adenocarcinomas.  Squamous cell carcinomas that affect or cross the junction of the stomach and esophagus are classified as carcinomas of the distal esophagus.  Adenocarcinoma of the gastroesophageal junction occurs more often in Caucasian middle aged and elderly males.  Clinical signs and symptoms include dysphagia, abdominal pain, and weight loss.  The prognosis depends on the completeness of the surgical resection, the number of lymph nodes involved by cancer, and the presence or absence of postoperative complications.  The presence of TP53 mutations indicates worse prognosis." .

NCIT:C9301 a owl:Class ;
    rdfs:label "Primary Central Nervous System Lymphoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Primary CNS lymphomas are extranodal malignant lymphomas arising in the CNS in the absence of obvious lymphoma outside the nervous system at the time of diagnosis. They should be differentiated from secondary involvement of the nervous system in systemic lymphomas. The incidence of primary CNS lymphomas has recently increased markedly worldwide from about 1% to over 6% of primary intracranial neoplasms due mainly as a consequence of the AIDS epidemic.  Primary CNS lymphomas affect all ages, with a peak incidence in immunocompetent subjects during the sixth and seventh decade of life and a male:female ratio of 3:2. In immunocompromised patients, the age at manifestation is lowest in individuals who have an inherited immunodeficiency (10 years), followed by transplant recipients (37 years) and AIDS patients (39 years, 90% males). About 60% of primary CNS lymphomas involve the supratentorial space, including the frontal (15%), temporal (8%), parietal (7%) and occipital (3%) lobes, basal ganglia/periventricular regions (10%) and corpus callosum (5%), the posterior fossa (13%), and the spinal cord (1%).  The majority of primary CNS lymphomas are large B-cell lymphomas, often associated with the Epstein-Barr virus.  (Adapted from WHO.)" .

NCIT:C9305 a owl:Class ;
    rdfs:label "Malignant Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "Uncontrolled growth of abnormal cells with potential for metastatic spread." .

NCIT:C9306 a owl:Class ;
    rdfs:label "Soft Tissue Sarcoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A solid, malignant neoplasm originating in muscle, tendon, fat, blood vessels, nerves, connective or joint tissue." .

NCIT:C93207 a owl:Class ;
    rdfs:label "DNA Gene-Expression Microarray" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A process that allows thousands of pieces of DNA that are fixed to a glass slide to be analyzed at one time. It is used to identify the genes (pieces of DNA) in specific cells or tissue that are actively used to make RNA, which then may be used to make proteins." .

NCIT:C9343 a owl:Class ;
    rdfs:label "Bone Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A benign, intermediate, or malignant neoplasm involving the bone or articular cartilage." .

NCIT:C9349 a owl:Class ;
    rdfs:label "Plasmacytoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A type of cancer that begins in plasma cells (white blood cells that produce antibodies). A plasmacytoma may turn into multiple myeloma." .

NCIT:C9357 a owl:Class ;
    rdfs:label "Hodgkin Lymphoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A malignant neoplasm of the lymphatic system that is comprised of abnormal lymphocytes and is characterized by the presence of Reed-Sternberg cells." .

NCIT:C9383 a owl:Class ;
    rdfs:label "Rectal Adenocarcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "An adenocarcinoma arising from the rectum.  It is more frequently seen in populations with a Western type diet and in patients with a history of chronic inflammatory bowel disease.  Signs and symptoms include intestinal bleeding, anemia, and change in bowel habits.  According to the degree of cellular differentiation, rectal adenocarcinomas are divided into well, moderately, and poorly differentiated.  Histologic variants include mucinous adenocarcinoma, signet ring cell carcinoma, medullary carcinoma, serrated adenocarcinoma, cribriform comedo-type adenocarcinoma, and micropapillary adenocarcinoma." .

NCIT:C9385 a owl:Class ;
    rdfs:label "Renal Cell Carcinoma" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "The most common type of kidney cancer. It begins in the lining of the renal tubules in the kidney. The renal tubules filter the blood and produce urine." .

NCIT:C94604 a owl:Class ;
    rdfs:label "Murine Model" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An experimental model that uses mice to study biological processes, disease mechanisms, or the effects of treatments in vivo." .

NCIT:C95027 a owl:Class ;
    rdfs:label "Colorimetric Cell Viability Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A colorimetric assay that can assess the viability of cells by quantitation of the reduction of a yellow tetrazolium salt substrate to a product that has a purple color. This assay can measure the cytotoxicity of a chemical or drug by determining the affect of treatment on cell viability." .

NCIT:C9505 a owl:Class ;
    rdfs:label "Dysembryoplastic Neuroepithelial Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A neoplasm of the nervous system that arises from the neuroepithelial tissues.  Representative examples include astrocytic tumors, oligodendroglial tumors, ependymal tumors, and primitive neuroectodermal tumors." .

NCIT:C96515 a owl:Class ;
    rdfs:label "Single Cell Gel Electrophoresis" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A rapid, simple, visual and sensitive technique for measuring DNA breakage in individual mammalian cells in response to a test agent. A cell is immobilized in agarose and made permeable and the broken DNA migrates out under the influence of the electric field. A damaged cell has the appearance of a comet with a brightly fluorescent cell body and a tail whose length and fluorescence intensity are related to the number of DNA-strand breaks induced by the test agent." .

OBCS:0000147 a owl:Class ;
    rdfs:label "Gene Set Enrichment Analysis" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An inferential statistical data analysis that determines whether an a priori defined set of genes shows statistically significant, concordant differences in expression between two biological states." .

OBI:0000366 a owl:Class ;
    rdfs:label "Metabolite Profiling Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An assay that detects and identifies small-molecule chemical entities resulting from biochemical and cellular metabolism." .

OBI:0000693 a owl:Class ;
    rdfs:label "MeDIP" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A DNA methylation profiling assay (methylated DNA immunoprecipitation) that uses an antibody against 5-methylcytosine to enrich for methylated DNA fragments prior to sequencing." .

OBI:0000903 a owl:Class ;
    rdfs:label "In Vitro Cell Killing Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A cell killing assay that measures whether, and to what extent, target cells are actively killed by other cells in a cell culture." .

OBI:0000920 a owl:Class ;
    rdfs:label "Cytometric Bead Array Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An analyte assay in which a series of beads coated with antibodies, antigens, or other capture molecules are used in combination with flow cytometry to detect multiple analytes simultaneously." .

OBI:0001335 a owl:Class ;
    rdfs:label "MicroRNA Expression Array" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A molecular biology device that utilizes a set of defined cDNA clones attached in a specific grid arrangement to a solid support for nucleic acid hybridization assays in gene mapping studies or in determining gene sequences, sequence variations, or gene expression patterns." .

OBI:0001863 a owl:Class ;
    rdfs:label "Whole Genome Bisulfite Sequencing" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A procedure that can determine the DNA sequence for nearly the entire genome of an individual." .

OBI:0002107 a owl:Class ;
    rdfs:label "Bio-Layer Interferometry" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A label-free optical technique that detects binding interactions by measuring shifts in the interference pattern of light reflected from a layer of immobilized biomolecules on a biosensor tip." .

OBI:0002112 a owl:Class ;
    rdfs:label "smRNA-seq" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A molecular genetic technique that combines chromatin immunoprecipitation (ChIP) with massively parallel DNA sequencing to map the binding sites of DNA-associated proteins in a sample of cells. First, crosslinked protein-DNA complexes are isolated using ChIP. Next, the crosslinks are broken, the proteins are removed and the purified DNA is modified with adaptor oligonucleotides to facilitate massively parallel DNA sequencing. Following sequencing, the DNA sequences that are obtained can be mapped to their genomic locations." .

OBI:0002169 a owl:Class ;
    rdfs:label "ChIP-qPCR assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A molecular genetic technique that combines chromatin immunoprecipitation (ChIP) with massively parallel DNA sequencing to map the binding sites of DNA-associated proteins in a sample of cells. First, crosslinked protein-DNA complexes are isolated using ChIP. Next, the crosslinks are broken, the proteins are removed and the purified DNA is modified with adaptor oligonucleotides to facilitate massively parallel DNA sequencing. Following sequencing, the DNA sequences that are obtained can be mapped to their genomic locations." .

OBI:0002175 a owl:Class ;
    rdfs:label "ATP Bioluminescence Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An analyte assay that detects ATP concentration via light output when luciferase catalyzes the oxidation of luciferin in the presence of ATP, commonly used as a measure of cell viability." .

OBI:0002437 a owl:Class ;
    rdfs:label "Widefield Fluorescence Microscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The use of a special microscope to see objects that give off fluorescent light. For example, cells or tissue can be treated with a substance that contains a fluorescent dye. The dye lights up when viewed under a microscope with a special light." .

OBI:0002629 a owl:Class ;
    rdfs:label "Direct Long-Read RNA Sequencing" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A sequencing method that determines RNA sequence directly from long native RNA molecules without prior conversion to cDNA." .

OBI:0002763 a owl:Class ;
    rdfs:label "16S Ribosomal Gene Sequencing Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An amplicon sequencing assay in which universal primers are used to amplify the 16S ribosomal RNA gene from bacterial or archaeal samples for taxonomic identification and profiling." .

OBI:0002957 a owl:Class ;
    rdfs:label "Reverse Phase Protein Array" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An antibody-based functional proteomic microarray that can characterize basal protein expression and levels of protein modifications in a series of samples of body fluids or those derived from tissue or cellular lysates." .

OBI:0002961 a owl:Class ;
    rdfs:label "Global Chromatin Profiling" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A type of epigenetic modification assay that uses targeted quantitative mass spectrometry to profile post-translational modifications of core histone proteins in chromatin." .

OBI:0003781 a owl:Class ;
    rdfs:label "Proteomics Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A mass spectrometry assay that identifies and measures proteins in a sample." .

OBI:0600031 a owl:Class ;
    rdfs:label "Enzyme-Linked Immunospot Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A cytometry-based assay in which cells are cultured on a surface coated with a capture antibody for a secreted analyte, which is then detected as discrete spots corresponding to individual secreting cells." .

PRIDE:0000429 a owl:Class ;
    rdfs:label "Shotgun Mass Spectrometry" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An analytical technique wherein ions are separated according to their ratio of charge to mass. From the mass spectrum produced, the atomic weight of the particle can be deduced." .

PRIDE:0000430 a owl:Class ;
    rdfs:label "Cross-Linking Mass Spectrometry" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An analytical technique wherein ions are separated according to their ratio of charge to mass. From the mass spectrum produced, the atomic weight of the particle can be deduced." .

T4FS:0000487 a owl:Class ;
    rdfs:label "Data Integration" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The process of combining data from multiple sources or of different types into a unified, consistent representation for analysis." .

SNOMED:117008001 a owl:Class ;
    rdfs:label "Von Kossa Staining" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A histochemical staining method that detects calcium deposits (e.g., in bone or calcified tissue) using silver nitrate to precipitate calcium phosphates and carbonates." .

SNOMED:45101000 a owl:Class ;
    rdfs:label "Phagocytosis Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An assay that measures the ability of phagocytic cells to engulf and internalize particles, pathogens, or other cells." .

SNOMED:51567006 a owl:Class ;
    rdfs:label "Picrosirius Staining" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A histochemical staining method using picric acid and Sirius Red dye to selectively stain collagen fibers, commonly used to assess fibrosis and collagen organization in tissue sections." .

BAO:0000680 a owl:Class ;
    rdfs:label "Dual-Luciferase Reporter Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An assay that uses two different luciferase reporter enzymes (typically firefly and Renilla) to simultaneously measure experimental and internal-control reporter gene expression within the same sample." .

BAO:0002041 a owl:Class ;
    rdfs:label "Cell Cycle Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An assay that measures the distribution of cells across different phases of the cell cycle (G0/G1, S, G2/M) to evaluate proliferation status or cell cycle perturbations." .

BAO:0002423 a owl:Class ;
    rdfs:label "In-Cell Western Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Any method to measure the number of dividing cells in a culture, or to measure the change in the proportion of cells that are dividing." .

BAO:0002467 a owl:Class ;
    rdfs:label "Bicinchoninic Acid Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A copper-based colorimetric assay for total protein quantification. This assay relies on the formation of a Cu2+-protein complex in a basic environment, followed by reduction of the Cu2+ to Cu+, causing a change of color from green to purple, with a strong absorbance at 562nm." .

BAO:0002511 a owl:Class ;
    rdfs:label "Differential Interference Contrast Microscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The use of various technologies to resolve the structure or features of objects too small or fine to naturally be seen by eye." .

BAO:0002529 a owl:Class ;
    rdfs:label "Atomic Absorption Spectrophotometry" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A technique utilizing a scanning probe to image and analyze the surface of a material with atomic-level resolution." .

BAO:0002661 a owl:Class ;
    rdfs:label "Luciferase Reporter Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An assay that uses a luciferase reporter gene under the control of a regulatory element of interest to measure gene expression or promoter/enhancer activity via light output." .

BAO:0002993 a owl:Class ;
    rdfs:label "Cytotoxicity Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An assay that measures the degree to which a substance or treatment is toxic to cells, typically assessed via cell viability, membrane integrity, or metabolic activity." .

BAO:0003006 a owl:Class ;
    rdfs:label "Reporter Gene Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An assay that uses a reporter gene (e.g., luciferase, GFP, beta-galactosidase) whose measurable expression serves as a readout of the activity of a promoter, enhancer, or other regulatory element." .

BAO:0010005 a owl:Class ;
    rdfs:label "Single Cell Cytokine Detection Chip Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A molecular genetic technique that combines chromatin immunoprecipitation (ChIP) with massively parallel DNA sequencing to map the binding sites of DNA-associated proteins in a sample of cells. First, crosslinked protein-DNA complexes are isolated using ChIP. Next, the crosslinks are broken, the proteins are removed and the purified DNA is modified with adaptor oligonucleotides to facilitate massively parallel DNA sequencing. Following sequencing, the DNA sequences that are obtained can be mapped to their genomic locations." .

BAO:0010046 a owl:Class ;
    rdfs:label "L1000 mRNA Profiling Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A high-throughput gene expression profiling assay in which cultured cells are treated with chemical or genetic perturbations and the transcriptional response of ~1,000 landmark genes is measured, with the remaining transcriptome inferred computationally." .

BAO:0010060 a owl:Class ;
    rdfs:label "MEMA Cell Growth Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Any method to measure the number of dividing cells in a culture, or to measure the change in the proportion of cells that are dividing." .

BAO:0010083 a owl:Class ;
    rdfs:label "Permeability Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An assay that measures the rate or extent to which a substance passes through a biological or synthetic semi-permeable barrier, such as a cell monolayer or membrane." .

BAO:0010261 a owl:Class ;
    rdfs:label "Thermal Shift Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A molecular biology technique used to detect the interaction of a DNA binding protein with its cognate binding sequence.  Labeled DNAs were reacted with crude cell extracts and the complexes are run through a non-denaturing polyacrylamide gel.  The migration of the labeled DNA through the gel will be slower by being bound.  This shift in electrophoretic mobility indicates functional binding between the protein and the DNA." .

BAO:0010269 a owl:Class ;
    rdfs:label "Chemotaxis Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An assay that measures the directional movement of cells in response to a chemical gradient (chemoattractant or chemorepellent)." .

BAO:0020015 a owl:Class ;
    rdfs:label "Transwell Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An assay that uses a porous membrane insert (Transwell) to separate two cell compartments, commonly used to measure cell migration, invasion, or barrier permeability." .

EFO:0002704 a owl:Class ;
    rdfs:label "Tiling Array" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A molecular biology device that utilizes a set of defined cDNA clones attached in a specific grid arrangement to a solid support for nucleic acid hybridization assays in gene mapping studies or in determining gene sequences, sequence variations, or gene expression patterns." .

EFO:0003747 a owl:Class ;
    rdfs:label "Amplicon Sequencing" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A DNA sequencing technique that can differentiate cytosine from 5-methylcytosine in a DNA sample. First, a denatured DNA sample is treated with bisulfite which converts non-methylated cytosine to uracil. Next, the sample is amplified using a PCR method that does not discriminate between non-methylated and methylated sequences. The amplified DNA is subjected to nucleotide sequencing. The resulting sequence is compared to an identical control sample of DNA that was not treated with bisulfite. Unmethylated cytosines will be displayed as cytosines in the control sample and as thymines in the bisulfite-treated sample." .

EFO:0003750 a owl:Class ;
    rdfs:label "Methyl Binding Domain Sequencing" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An assay in which DNA is enriched using a methyl-binding domain protein to isolate methylated genomic fractions prior to sequencing." .

EFO:0003751 a owl:Class ;
    rdfs:label "MNase-Seq" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A molecular genetic technique that combines chromatin immunoprecipitation (ChIP) with massively parallel DNA sequencing to map the binding sites of DNA-associated proteins in a sample of cells. First, crosslinked protein-DNA complexes are isolated using ChIP. Next, the crosslinks are broken, the proteins are removed and the purified DNA is modified with adaptor oligonucleotides to facilitate massively parallel DNA sequencing. Following sequencing, the DNA sequences that are obtained can be mapped to their genomic locations." .

EFO:0005033 a owl:Class ;
    rdfs:label "RIP" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "RNA immunoprecipitation (RIP), a technique used to investigate protein-RNA interactions in the cell by immunoprecipitating an RNA-binding protein along with its bound RNAs." .

EFO:0005227 a owl:Class ;
    rdfs:label "Global Run-On Sequencing" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Global run-on sequencing (GRO-seq), a sequencing-based assay derived from nuclear run-on assays that maps the position and orientation of actively transcribing RNA polymerases genome-wide." .

EFO:0005310 a owl:Class ;
    rdfs:label "RIP-Seq" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A molecular genetic technique that combines chromatin immunoprecipitation (ChIP) with massively parallel DNA sequencing to map the binding sites of DNA-associated proteins in a sample of cells. First, crosslinked protein-DNA complexes are isolated using ChIP. Next, the crosslinks are broken, the proteins are removed and the purified DNA is modified with adaptor oligonucleotides to facilitate massively parallel DNA sequencing. Following sequencing, the DNA sequences that are obtained can be mapped to their genomic locations." .

