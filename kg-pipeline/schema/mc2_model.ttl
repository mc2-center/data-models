        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Longitudinal_Sequence_Identifier ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:10xVisiumRNALevel1_id ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:NGS_Sequencing_Library_Construction_Days_from_Index ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:File_Url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Longitudinal_Time_Elapsed_Unit ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Visium_Run_ID ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:NGS_RNA_DV200 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Study_Key ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Visium_Spatial_Read2 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Visium_Permeabilization_Time ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Tissue ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Visium_Slide_ID ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Filename ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:NGS_RNA_End_Bias ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Biospecimen_Key ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:File_Assay ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:NGS_Sequencing_Platform ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:File_Species ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Longitudinal_Event_Type ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:NGS_Read_Indicator ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Visium_Slide_Version ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^syn\\d{7,8}$" ] ) ] ;
            owl:onProperty mc2:10xVisiumRNALevel1_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Design ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Visium_Spatial_Library_Construction_Method ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:NGS_RNA_Reverse_Transcription_Primer ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Visium_Capture_Area ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Tumor_Type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "\\d+$|Not\\sApplicable$|unknown$" ] ) ] ;
