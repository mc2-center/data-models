<https://w3id.org/mc2-center/mc2-model/VisiumFileTypeEnum#barcodes> a owl:Class ;
    rdfs:label "barcodes" ;
    rdfs:subClassOf mc2:VisiumFileTypeEnum ;
    skos:definition "Space Ranger output file (barcodes.tsv) listing the spot barcode sequences corresponding to the columns of the feature-barcode expression matrix." .

<https://w3id.org/mc2-center/mc2-model/VisiumFileTypeEnum#detected%20image%20png> a owl:Class ;
    rdfs:label "detected image png" ;
    rdfs:subClassOf mc2:VisiumFileTypeEnum ;
    skos:definition "PNG image output by Space Ranger showing the tissue area and spots detected during the tissue-detection step, overlaid on the slide image." .

<https://w3id.org/mc2-center/mc2-model/VisiumFileTypeEnum#detected%20jpg> a owl:Class ;
    rdfs:label "detected jpg" ;
    rdfs:subClassOf mc2:VisiumFileTypeEnum ;
    skos:definition "JPEG image output by Space Ranger showing the tissue area and spots detected during the tissue-detection step, overlaid on the slide image." .

<https://w3id.org/mc2-center/mc2-model/VisiumFileTypeEnum#features> a owl:Class ;
    rdfs:label "features" ;
    rdfs:subClassOf mc2:VisiumFileTypeEnum ;
    skos:definition "Space Ranger output file (features.tsv) listing the gene/feature IDs and names corresponding to the rows of the feature-barcode expression matrix." .

<https://w3id.org/mc2-center/mc2-model/VisiumFileTypeEnum#fiducial%20image%20jpg> a owl:Class ;
    rdfs:label "fiducial image jpg" ;
    rdfs:subClassOf mc2:VisiumFileTypeEnum ;
    skos:definition "JPEG image showing the fiducial frame (alignment markers) printed on the Visium slide, used by Space Ranger/Loupe Browser to register the capture area to the tissue image." .

<https://w3id.org/mc2-center/mc2-model/VisiumFileTypeEnum#fiducial%20image%20png> a owl:Class ;
    rdfs:label "fiducial image png" ;
    rdfs:subClassOf mc2:VisiumFileTypeEnum ;
    skos:definition "PNG image showing the fiducial frame (alignment markers) printed on the Visium slide, used by Space Ranger/Loupe Browser to register the capture area to the tissue image." .

<https://w3id.org/mc2-center/mc2-model/VisiumFileTypeEnum#high%20res%20image> a owl:Class ;
    rdfs:label "high res image" ;
    rdfs:subClassOf mc2:VisiumFileTypeEnum ;
    skos:definition "High-resolution tissue microscopy image (tissue_hires_image.png) bundled in Space Ranger spatial output, used for detailed visualization of the tissue section with the overlaid spot grid." .

<https://w3id.org/mc2-center/mc2-model/VisiumFileTypeEnum#json%20scale%20factors> a owl:Class ;
    rdfs:label "json scale factors" ;
    rdfs:subClassOf mc2:VisiumFileTypeEnum ;
    skos:definition "JSON file output by Space Ranger (scalefactors_json.json) that records the scaling factors needed to relate spot positions to the full-resolution, high-resolution, and low-resolution tissue images." .

<https://w3id.org/mc2-center/mc2-model/VisiumFileTypeEnum#low%20res%20image> a owl:Class ;
    rdfs:label "low res image" ;
    rdfs:subClassOf mc2:VisiumFileTypeEnum ;
    skos:definition "Low-resolution, downsampled tissue microscopy image (tissue_lowres_image.png) bundled in Space Ranger spatial output, used for lightweight visualization of the tissue section with the overlaid spot grid." .

<https://w3id.org/mc2-center/mc2-model/VisiumFileTypeEnum#probe%20dataset%20csv> a owl:Class ;
    rdfs:label "probe dataset csv" ;
    rdfs:subClassOf mc2:VisiumFileTypeEnum ;
    skos:definition "CSV file listing the probe set used in a probe-based (e.g., FFPE) Visium assay, including probe IDs and the genes they target." .

<https://w3id.org/mc2-center/mc2-model/VisiumFileTypeEnum#reference%20jpg> a owl:Class ;
    rdfs:label "reference jpg" ;
    rdfs:subClassOf mc2:VisiumFileTypeEnum ;
    skos:definition "JPEG image of the tissue section supplied as the Space Ranger alignment reference image, used to register the capture-area spot grid to the tissue for spatial gene expression analysis." .

<https://w3id.org/mc2-center/mc2-model/VisiumFileTypeEnum#reference%20png> a owl:Class ;
    rdfs:label "reference png" ;
    rdfs:subClassOf mc2:VisiumFileTypeEnum ;
    skos:definition "PNG image of the tissue section supplied as the Space Ranger alignment reference image, used to register the capture-area spot grid to the tissue for spatial gene expression analysis." .

<https://w3id.org/mc2-center/mc2-model/VisiumFileTypeEnum#tissue_positions> a owl:Class ;
    rdfs:label "tissue_positions" ;
    rdfs:subClassOf mc2:VisiumFileTypeEnum ;
    skos:definition "Space Ranger output file (tissue_positions.csv/.parquet) that maps each spot barcode to its row/column array coordinates and pixel coordinates on the full-resolution tissue image, and indicates whether the spot overlaps tissue." .

<https://w3id.org/mc2-center/mc2-model/VisiumSlideVersionEnum#V3> a owl:Class ;
    rdfs:label "V3" ;
    rdfs:subClassOf mc2:VisiumSlideVersionEnum ;
    skos:definition "A later generation of the 10x Genomics Visium slide, succeeding versions 1 and 2 in this model's slide-version series. 10x Genomics has not published a distinct 'V3' Visium slide specification in public ontology sources, so exact design differences from earlier versions are not documented here." .

<https://w3id.org/mc2-center/mc2-model/VisiumSlideVersionEnum#V4> a owl:Class ;
    rdfs:label "V4" ;
    rdfs:subClassOf mc2:VisiumSlideVersionEnum ;
    skos:definition "The most recent generation of the 10x Genomics Visium slide referenced in this model, succeeding versions 1 through 3. 10x Genomics has not published a distinct 'V4' Visium slide specification in public ontology sources, so exact design differences from earlier versions are not documented here." .

<https://w3id.org/mc2-center/mc2-model/VisiumSpatialLibraryConstructionMethodEnum#10xV1.1> a owl:Class ;
    rdfs:label "10xV1.1" ;
    rdfs:subClassOf mc2:VisiumSpatialLibraryConstructionMethodEnum ;
    skos:definition "Minor revision (v1.1) of the first-generation 10x Genomics single-cell 3' library construction chemistry; specific chemistry differences from v1.0 are not documented in public ontology sources." .

<https://w3id.org/mc2-center/mc2-model/VisiumSpatialLibraryConstructionMethodEnum#Nextera%20XT> a owl:Class ;
    rdfs:label "Nextera XT" ;
    rdfs:subClassOf mc2:VisiumSpatialLibraryConstructionMethodEnum ;
    skos:definition "Illumina library preparation kit that uses tagmentation (simultaneous enzymatic fragmentation and adapter tagging) to construct sequencing-ready libraries from very low quantities of input DNA/cDNA; commonly used as a downstream library-prep step following methods such as Smart-seq2." .

<https://w3id.org/mc2-center/mc2-model/VisiumSpatialLibraryConstructionMethodEnum#inDropsV2> a owl:Class ;
    rdfs:label "inDropsV2" ;
    rdfs:subClassOf mc2:VisiumSpatialLibraryConstructionMethodEnum ;
    skos:definition "Second version (v2) of the inDrop (indexing droplets) single-cell RNA-seq library construction method, a droplet microfluidic platform that uses hydrogel beads to deliver barcoded primers to individual cells." .

<https://w3id.org/mc2-center/mc2-model/VisiumSpatialLibraryConstructionMethodEnum#inDropsV3> a owl:Class ;
    rdfs:label "inDropsV3" ;
    rdfs:subClassOf mc2:VisiumSpatialLibraryConstructionMethodEnum ;
    skos:definition "Third version (v3) of the inDrop (indexing droplets) single-cell RNA-seq library construction method." .

<https://w3id.org/mc2-center/mc2-model/VisiumSpatialRead1Enum#Spatial%20Barcode%20and%20UMI> a owl:Class ;
    rdfs:label "Spatial Barcode and UMI" ;
    rdfs:subClassOf mc2:VisiumSpatialRead1Enum ;
    skos:definition "A sequencing read that contains the spatial barcode and unique molecular identifier (UMI) sequences used to assign reads to their spatial location and de-duplicate transcript counts." .

<https://w3id.org/mc2-center/mc2-model/VisiumSpatialRead2Enum#Spatial%20Barcode%20and%20UMI> a owl:Class ;
    rdfs:label "Spatial Barcode and UMI" ;
    rdfs:subClassOf mc2:VisiumSpatialRead2Enum ;
    skos:definition "A sequencing read that contains the spatial barcode and unique molecular identifier (UMI) sequences used to assign reads to their spatial location and de-duplicate transcript counts." .

mc2:Visium_File_Type a owl:ObjectProperty ;
    rdfs:label "Visium File Type" ;
    rdfs:range mc2:VisiumFileTypeEnum ;
    skos:definition "The file type generated for the visium experiment." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: HTAN" .

mc2:Visium_Slide_ID a owl:DatatypeProperty ;
    rdfs:label "Visium Slide ID" ;
    skos:definition "For Visium, it is the unique identifier printed on the label of each Visium slide. The serial number starts with V followed by a number which can range between one through five and ends with a dash and a three digit number, such as 123. For CosMx, this refers to the loaded Flow Cell ID. For Xenium, this ID indicates the slide orientation, as it matches the relative location of the ID on the physical Xenium slide." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: HTAN" .

mc2:Workflow_Parameter_Description a owl:DatatypeProperty ;
    rdfs:label "Workflow Parameter Description" ;
    skos:definition "Link or text description of flags or options provided to the workflow used to generate the file." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Workflow_Type a owl:DatatypeProperty ;
    rdfs:label "Workflow Type" ;
    skos:definition "Type of computational workflow used to generate the file." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

