<https://w3id.org/mc2-center/mc2-model/ToolInputFormatEnum#Antimony> a owl:Class ;
    rdfs:label "Antimony" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum ;
    skos:definition "A human-readable, text-based modeling language for specifying systems biology models (reaction networks, rate laws, and initial conditions) that can be compiled to SBML; used by tools such as Tellurium/libAntimony." .

<https://w3id.org/mc2-center/mc2-model/ToolInputFormatEnum#DCC> a owl:Class ;
    rdfs:label "DCC" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum ;
    skos:definition "A tab-delimited count file produced by the NanoString GeoMx Digital Spatial Profiler, containing per-probe digital count data for a given region of interest." .

<https://w3id.org/mc2-center/mc2-model/ToolInputFormatEnum#DCD> a owl:Class ;
    rdfs:label "DCD" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum ;
    skos:definition "A binary trajectory file format used by molecular dynamics simulation packages such as CHARMM and NAMD to store atomic coordinates (and optionally velocities) over the course of a simulation." .

<https://w3id.org/mc2-center/mc2-model/ToolInputFormatEnum#Genotype%20And%20Phenotype%20Annotation%20Format> a owl:Class ;
    rdfs:label "Genotype And Phenotype Annotation Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum ;
    skos:definition "A category of formats used to represent annotations linking genotype data to associated phenotype information, e.g. from studies or databases such as dbGaP." .

<https://w3id.org/mc2-center/mc2-model/ToolInputFormatEnum#H5AD> a owl:Class ;
    rdfs:label "H5AD" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum ;
    skos:definition "HDF5-based binary file format used by the AnnData Python library to store annotated data matrices (e.g. gene expression matrices with associated cell/feature metadata), widely used in single-cell genomics tools such as Scanpy." .

<https://w3id.org/mc2-center/mc2-model/ToolInputFormatEnum#HED> a owl:Class ;
    rdfs:label "HED" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum ;
    skos:definition "Hierarchical Event Descriptor (HED), a structured vocabulary and format for annotating events in time-series data (e.g. EEG/behavioral data), used within BIDS-formatted neuroimaging datasets." .

<https://w3id.org/mc2-center/mc2-model/ToolInputFormatEnum#MRC> a owl:Class ;
    rdfs:label "MRC" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum ;
    skos:definition "MRC/MRC2014, a binary file format for storing 3D volumetric density map data, widely used in cryo-electron microscopy (cryo-EM) for representing reconstructed density maps." .

<https://w3id.org/mc2-center/mc2-model/ToolInputFormatEnum#Not%20Applicable> a owl:Class ;
    rdfs:label "Not Applicable" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum ;
    skos:definition "Placeholder value used when specifying a tool input/output format is not applicable to the entry being described." .

<https://w3id.org/mc2-center/mc2-model/ToolInputFormatEnum#Unspecified> a owl:Class ;
    rdfs:label "Unspecified" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum ;
    skos:definition "Placeholder value used when the specific input/output format for a tool was not specified or is not known." .

<https://w3id.org/mc2-center/mc2-model/ToolLanguageEnum#AWK> a owl:Class ;
    rdfs:label "AWK" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "AWK is a text-processing scripting language and command-line utility designed for pattern scanning and manipulation of structured text such as tabular or delimited data." .

<https://w3id.org/mc2-center/mc2-model/ToolLanguageEnum#Bash> a owl:Class ;
    rdfs:label "Bash" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Bash (Bourne Again SHell) is a Unix shell and command language interpreter widely used as the default login shell and scripting language on Linux and macOS systems." .

<https://w3id.org/mc2-center/mc2-model/ToolLanguageEnum#CSS> a owl:Class ;
    rdfs:label "CSS" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "CSS (Cascading Style Sheets) is a style sheet language used to describe the presentation and formatting of documents written in HTML or XML." .

<https://w3id.org/mc2-center/mc2-model/ToolLanguageEnum#Dockerfile> a owl:Class ;
    rdfs:label "Dockerfile" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "A Dockerfile is a text document containing a series of instructions used to automatically build a Docker container image." .

<https://w3id.org/mc2-center/mc2-model/ToolLanguageEnum#Elm> a owl:Class ;
    rdfs:label "Elm" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Elm is a functional programming language that compiles to JavaScript, designed for building reliable web applications with a strong emphasis on usability and type safety." .

<https://w3id.org/mc2-center/mc2-model/ToolLanguageEnum#Go> a owl:Class ;
    rdfs:label "Go" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Go (Golang) is a statically typed, compiled programming language developed by Google, designed for simplicity, concurrency, and efficiency in building scalable software and networked services." .

<https://w3id.org/mc2-center/mc2-model/ToolLanguageEnum#Icarus> a owl:Class ;
    rdfs:label "Icarus" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Icarus Verilog is an open-source compiler and simulator for the Verilog hardware description language, used for digital circuit design and simulation." .

<https://w3id.org/mc2-center/mc2-model/ToolLanguageEnum#JSP> a owl:Class ;
    rdfs:label "JSP" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "JavaServer Pages (JSP) is a Java-based technology that enables embedding Java code and dynamic content directly within HTML web pages for server-side rendering." .

<https://w3id.org/mc2-center/mc2-model/ToolLanguageEnum#Julia> a owl:Class ;
    rdfs:label "Julia" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "Julia is a high-level, high-performance dynamic programming language designed for numerical and scientific computing, combining ease of use with speed comparable to statically typed languages." .

<https://w3id.org/mc2-center/mc2-model/ToolLanguageEnum#Netlogo> a owl:Class ;
    rdfs:label "Netlogo" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "NetLogo is a multi-agent programmable modeling environment used for simulating and exploring complex natural and social phenomena." .

<https://w3id.org/mc2-center/mc2-model/ToolLanguageEnum#Ocaml> a owl:Class ;
    rdfs:label "Ocaml" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "OCaml is a general-purpose, statically typed functional programming language that also supports imperative and object-oriented programming styles." .

<https://w3id.org/mc2-center/mc2-model/ToolLanguageEnum#OpenEdge%20ABL> a owl:Class ;
    rdfs:label "OpenEdge ABL" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "OpenEdge ABL (Advanced Business Language) is a proprietary fourth-generation programming language developed by Progress Software for building business applications." .

<https://w3id.org/mc2-center/mc2-model/ToolLanguageEnum#Other> a owl:Class ;
    rdfs:label "Other" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "A programming or software language used by a tool that is not otherwise represented among the listed valid values." .

<https://w3id.org/mc2-center/mc2-model/ToolLanguageEnum#PowerShell> a owl:Class ;
    rdfs:label "PowerShell" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "PowerShell is a task automation and configuration management framework from Microsoft, consisting of a command-line shell and an associated scripting language built on .NET." .

<https://w3id.org/mc2-center/mc2-model/ToolLanguageEnum#PyMOL> a owl:Class ;
    rdfs:label "PyMOL" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "PyMOL is a molecular visualization and modeling software system with an embedded Python-based scripting interface, widely used for rendering and analyzing 3D structures of proteins and other molecules." .

<https://w3id.org/mc2-center/mc2-model/ToolLanguageEnum#TeX> a owl:Class ;
    rdfs:label "TeX" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "TeX is a typesetting system and programming language created by Donald Knuth, widely used for producing technical and scientific documents with precise typographic control." .

<https://w3id.org/mc2-center/mc2-model/ToolLanguageEnum#WDL> a owl:Class ;
    rdfs:label "WDL" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "WDL (Workflow Description Language) is a human-readable and writable language for specifying data processing workflows, commonly used in bioinformatics pipelines." .

<https://w3id.org/mc2-center/mc2-model/ToolLanguageEnum#XAML> a owl:Class ;
    rdfs:label "XAML" ;
    rdfs:subClassOf mc2:ToolLanguageEnum ;
    skos:definition "XAML (Extensible Application Markup Language) is a declarative XML-based markup language used to define user interfaces and object hierarchies in Microsoft applications such as WPF and UWP." .

<https://w3id.org/mc2-center/mc2-model/ToolLinkTypeEnum#Galaxy%20Service> a owl:Class ;
    rdfs:label "Galaxy Service" ;
    rdfs:subClassOf mc2:ToolLinkTypeEnum .

<https://w3id.org/mc2-center/mc2-model/ToolLinkTypeEnum#Helpdesk> a owl:Class ;
    rdfs:label "Helpdesk" ;
    rdfs:subClassOf mc2:ToolLinkTypeEnum ;
    skos:definition "A phone line, web site or email-based system providing help to the end-user of the software." .

<https://w3id.org/mc2-center/mc2-model/ToolLinkTypeEnum#Issue%20Tracker> a owl:Class ;
    rdfs:label "Issue Tracker" ;
    rdfs:subClassOf mc2:ToolLinkTypeEnum .

<https://w3id.org/mc2-center/mc2-model/ToolLinkTypeEnum#Mailing%20list> a owl:Class ;
