            owl:onProperty mc2:manifestation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:citation ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
