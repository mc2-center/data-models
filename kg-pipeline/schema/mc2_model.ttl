mc2:File_Alias a owl:DatatypeProperty ;
    rdfs:label "File Alias" ;
    skos:definition "A string identifier associated with the file. Must be unique. Can be the repository accesssion number (e.g., Synapse ID, GEO identifier such as GSE12345). No Greek Letters or DOIs." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:File_Description a owl:DatatypeProperty ;
    rdfs:label "File Description" ;
    skos:definition "Description of the file." ;
    skos:exactMatch CRDC_CDE:11280338 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "11280338" .

mc2:File_Design a owl:DatatypeProperty ;
    rdfs:label "File Design" ;
    skos:definition "The overall design of the file, including a batch identifier, if applicable." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:File_Format a owl:ObjectProperty ;
    rdfs:label "File Format" ;
    rdfs:range mc2:FileFormatEnum ;
    skos:definition "The format of the file described by this entry." ;
    skos:exactMatch CRDC_CDE:11416926 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "11416926" .

mc2:File_Level a owl:ObjectProperty ;
    rdfs:label "File Level" ;
    rdfs:range mc2:FileLevelEnum ;
    skos:definition "The processing level the file can be mapped to." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:File_Longitudinal_Event_Type a owl:ObjectProperty ;
    rdfs:label "File Longitudinal Event Type" ;
    rdfs:range mc2:FileLongitudinalEventTypeEnum ;
    skos:definition "The type of event to which File Longitudinal Total Time Elapsed is related" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:File_Longitudinal_Group a owl:DatatypeProperty ;
    rdfs:label "File Longitudinal Group" ;
    skos:definition "A label that can be used to identify groups of files from the same longitudinal/time-resolved experiment" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:File_Longitudinal_Sequence_Identifier a owl:DatatypeProperty ;
    rdfs:label "File Longitudinal Sequence Identifier" ;
    rdfs:range xsd:float ;
    skos:definition "The order in which this file was collected with respect to the longitudinal experiment (e.g., 1, 2, etc.). Integer." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:File_Longitudinal_Time_Elapsed_Unit a owl:DatatypeProperty ;
    rdfs:label "File Longitudinal Time Elapsed Unit" ;
    skos:definition "The unit of time associated with Sequential and Total Time Elapsed attributes." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:File_Longitudinal_Total_Time_Elapsed a owl:DatatypeProperty ;
    rdfs:label "File Longitudinal Total Time Elapsed" ;
    rdfs:range xsd:float ;
    skos:definition "The total time elapsed between the first and current files contained this longitudinal group." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:File_Url a owl:DatatypeProperty ;
    rdfs:label "File Url" ;
    skos:definition "The url of where the file is stored." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "schematic Format: uri" ;
    mc2:cde_id "11556141" .

mc2:Filename a owl:DatatypeProperty ;
    rdfs:label "Filename" ;
    skos:definition "The path of a file in Synapse, relative to the project. The file associated with the path will be annotated with attributes contained in this sheet." ;
    skos:exactMatch CRDC_CDE:11284037 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "11284037" .

