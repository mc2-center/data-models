mc2:grantNumber a owl:DatatypeProperty ;
    rdfs:label "grantNumber" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^CA\\d{6}$" ] ) ] ;
    skos:definition "Grant number associated with the dataset, as annotated directly on the Synapse Dataset entity. Can be identical to Dataset Grant Number." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:studyId a owl:DatatypeProperty ;
    rdfs:label "studyId" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^syn\\d{7,8}$" ] ) ] ;
    skos:definition "The Synapse ID of the Project associated with this dataset's grant. Populated as a native Synapse annotation directly on the Dataset entity; distinct from this repo's own Study_id/Study Key." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

operation:2426 a owl:Class ;
    rdfs:label "Modelling and Simulation",
        "Tissue Modelling" ;
    rdfs:subClassOf mc2:ToolOperationEnum .

operation:3680 a owl:Class ;
    rdfs:label "RNA-Seq Analysis",
        "scRNA-Seq Analysis" ;
    rdfs:subClassOf mc2:ToolOperationEnum .

NCIT:C164015 a owl:Class ;
    rdfs:label "Blood Derived Cancer - Bone Marrow",
        "Primary Blood Derived Cancer - Bone Marrow" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A bone marrow specimen collected from a subject at the time of initial diagnosis of a hematologic (blood-derived) malignancy, prior to treatment.",
        "A bone marrow specimen collected from a subject that has been diagnosed with a hematologic (blood-derived) malignancy." .

NCIT:C164017 a owl:Class ;
    rdfs:label "Blood Derived Cancer - Bone Marrow; Post-treatment",
        "Recurrent Blood Derived Cancer - Bone Marrow" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A bone marrow specimen collected from a subject at the time of relapse or recurrence of a hematologic malignancy.",
        "A bone marrow specimen collected from a subject with a hematologic malignancy after the subject has received treatment." .

NCIT:C164030 a owl:Class ;
    rdfs:label "Blood Derived Cancer - Peripheral Blood",
        "Primary Blood Derived Cancer - Peripheral Blood" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A peripheral whole blood specimen collected from a subject at the time of initial diagnosis of a hematologic malignancy, prior to treatment.",
        "A peripheral whole blood specimen collected from a subject that has been diagnosed with a hematologic (blood-derived) malignancy." .

NCIT:C164031 a owl:Class ;
    rdfs:label "Blood Derived Cancer - Peripheral Blood; Post-treatment",
        "Recurrent Blood Derived Cancer - Peripheral Blood" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum ;
    skos:definition "A peripheral whole blood specimen collected from a subject at the time of relapse or recurrence of a hematologic malignancy.",
        "A peripheral whole blood specimen collected from a subject with a hematologic malignancy after the subject has received treatment." .

NCIT:C184778 a owl:Class ;
    rdfs:label "filtered mex",
        "unfiltered mex" ;
    rdfs:subClassOf mc2:VisiumFileTypeEnum ;
    skos:definition "Filtered feature-barcode expression matrix in Market Exchange (MEX) sparse-matrix format, containing only spots that Space Ranger called as being covered by tissue in a Visium sample.",
        "Unfiltered feature-barcode expression matrix in Market Exchange (MEX) sparse-matrix format, containing all spots on the capture area regardless of tissue coverage, output by Space Ranger." .

NCIT:C185406 a owl:Class ;
    rdfs:label "Fresh dissociated and single cell sorted into plates",
        "Fresh dissociated and single cell sorted into plates in NP40 buffer" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMethodEnum ;
    skos:definition "A tissue preparation process that takes dissociated, sorted cells and distributes them into cell propagation plates." .

NCIT:C198498 a owl:Class ;
    rdfs:label "Protein nCounter",
        "RNA nCounter" ;
    rdfs:subClassOf mc2:GeoMxDSPAssayTypeEnum ;
    skos:definition "GeoMx Digital Spatial Profiler (DSP) readout method in which oligonucleotide barcodes released from RNA probes hybridized within selected regions of interest are quantified using the NanoString nCounter digital barcode counting platform, without amplification or sequencing.",
        "GeoMx Digital Spatial Profiler (DSP) readout method in which oligonucleotide barcodes released from antibody-conjugated protein probes bound within selected regions of interest are quantified using the NanoString nCounter digital barcode counting platform." .

NCIT:C85402 a owl:Class ;
    rdfs:label "Point",
        "Polygon" ;
    rdfs:subClassOf mc2:ImageSegmentationDataTypeEnum ;
    skos:definition "A segmentation output in which an object or region of interest is represented by a single coordinate (point) rather than an outline, polygon, or mask.",
        "A segmentation output in which an object's spatial extent is represented as a closed polygon defined by an ordered sequence of vertex coordinates." .

mc2:AccessTypeEnum a owl:Class ;
    rdfs:label "accessType Enum" ;
    owl:unionOf ( <https://w3id.org/mc2-center/mc2-model/AccessTypeEnum#Open%20Access> <https://w3id.org/mc2-center/mc2-model/AccessTypeEnum#Restricted%20Access> ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values <https://w3id.org/mc2-center/mc2-model/AccessTypeEnum#Open%20Access>,
        <https://w3id.org/mc2-center/mc2-model/AccessTypeEnum#Restricted%20Access> .

