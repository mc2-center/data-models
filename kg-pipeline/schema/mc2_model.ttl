mc2:FileView_id a owl:DatatypeProperty ;
    rdfs:label "FileView_id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^syn\\d{7,8}$" ] ) ] ;
    skos:definition "Unique ID associated with a File entry, used as a key for record linking and updates. This should be equivalent to File Alias unless otherwise directed." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "14528010" .

<https://w3id.org/mc2-center/mc2-model/GeoMxDSPAssayTypeEnum#Protein%20NGS> a owl:Class ;
    rdfs:label "Protein NGS" ;
    rdfs:subClassOf mc2:GeoMxDSPAssayTypeEnum ;
    skos:definition "GeoMx Digital Spatial Profiler (DSP) readout method in which oligonucleotide barcodes released from antibody-conjugated protein probes bound within selected regions of interest are quantified by next-generation sequencing rather than the nCounter platform, enabling higher-plex protein readouts." .

<https://w3id.org/mc2-center/mc2-model/GeoMxDSPAssayTypeEnum#RNA%20NGS> a owl:Class ;
    rdfs:label "RNA NGS" ;
    rdfs:subClassOf mc2:GeoMxDSPAssayTypeEnum ;
    skos:definition "GeoMx Digital Spatial Profiler (DSP) readout method in which oligonucleotide barcodes released from RNA probes hybridized within selected regions of interest are quantified by next-generation sequencing rather than the nCounter platform, enabling whole-transcriptome or higher-plex RNA readouts." .

mc2:GeoMx_DSP_Assay_Type a owl:ObjectProperty ;
    rdfs:label "GeoMx DSP Assay Type" ;
    rdfs:range mc2:GeoMxDSPAssayTypeEnum ;
    skos:definition "The assay type which was used for the GeoMx DSP pipeline." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "7789196" .

mc2:GeoMx_ROI_Table_Id a owl:DatatypeProperty ;
    rdfs:label "GeoMx ROI Table Id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^syn\\d{7,8}$" ] ) ] ;
    skos:definition "The Synapse Id corresponding to a GeoMx ROI/Segment Annotations metadata table associated with the Dataset(s)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

