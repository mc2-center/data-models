<https://w3id.org/mc2-center/mc2-model/ModelPrimaryDiagnosisEnum#Adenocarcinoma%20Combined%20With%20Other%20Types%20Of%20Carcinoma> a owl:Class ;
    rdfs:label "Adenocarcinoma Combined With Other Types Of Carcinoma" ;
    rdfs:subClassOf mc2:ModelPrimaryDiagnosisEnum .

<https://w3id.org/mc2-center/mc2-model/ModelPrimaryDiagnosisEnum#Adenocarcinoma%20In%20Adenomatous%20Polyposis%20Coli> a owl:Class ;
    rdfs:label "Adenocarcinoma In Adenomatous Polyposis Coli" ;
