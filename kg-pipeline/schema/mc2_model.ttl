mc2:Collection_id a owl:DatatypeProperty ;
    rdfs:label "Collection_id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^C-\\d{2,9}$" ] ) ] ;
    skos:definition "Unique ID associated with a collection, used as a key for record linking and updates." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

