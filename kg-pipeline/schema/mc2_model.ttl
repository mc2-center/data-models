mc2:Biospecimen_Key a owl:DatatypeProperty ;
    rdfs:label "Biospecimen Key" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "-B\\d{1,9}" ] ) ] ;
    skos:definition "Unique Biospecimen_id foreign key(s) that link metadata entries as part of the same collection. Please provide multiple values as a comma-separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

