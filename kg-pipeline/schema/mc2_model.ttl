    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^syn\\d{7,8}$" ] ) ] ;
    skos:definition "Unique row identifier, used as a primary key for record updates. This should be equivalent to the file Synapse Id unless otherwise indicated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:NanoStringGeoMxDSPLevel3_id a owl:DatatypeProperty ;
    rdfs:label "NanoStringGeoMxDSPLevel3_id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^syn\\d{7,8}$" ] ) ] ;
    skos:definition "Unique row identifier, used as a primary key for record updates. This should be equivalent to the file Synapse Id unless otherwise indicated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Orcid_Id a owl:DatatypeProperty ;
    rdfs:label "Orcid Id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "\\d{4}\\-\\d{4}\\-\\d{4}\\-\\d{3}(\\d|X)" ] ) ] ;
    skos:definition "Unique identifier (ORCID ID) of the individual" ;
    skos:exactMatch CRDC_CDE:10624734 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

<https://w3id.org/mc2-center/mc2-model/PortalDisplayEnum#FALSE> a owl:Class ;
    rdfs:label "FALSE" ;
    rdfs:subClassOf mc2:PortalDisplayEnum .

<https://w3id.org/mc2-center/mc2-model/PortalDisplayEnum#TRUE> a owl:Class ;
    rdfs:label "TRUE" ;
    rdfs:subClassOf mc2:PortalDisplayEnum .

<https://w3id.org/mc2-center/mc2-model/ProjectTypeEnum#Core> a owl:Class ;
    rdfs:label "Core" ;
    rdfs:subClassOf mc2:ProjectTypeEnum .

<https://w3id.org/mc2-center/mc2-model/ProjectTypeEnum#Project> a owl:Class ;
    rdfs:label "Project" ;
    rdfs:subClassOf mc2:ProjectTypeEnum .

<https://w3id.org/mc2-center/mc2-model/PublicationAccessibilityEnum#Open%20Access> a owl:Class ;
    rdfs:label "Open Access" ;
    rdfs:subClassOf mc2:PublicationAccessibilityEnum ;
    skos:definition "Publication content that is freely available to the public without restriction or subscription requirement." .

<https://w3id.org/mc2-center/mc2-model/PublicationAccessibilityEnum#Restricted%20Access> a owl:Class ;
    rdfs:label "Restricted Access" ;
    rdfs:subClassOf mc2:PublicationAccessibilityEnum ;
    skos:definition "Publication content that is limited to specific individuals or requires permission, subscription, or payment to access." .

<https://w3id.org/mc2-center/mc2-model/ResourceAccessHazardEnum#Flashing> a owl:Class ;
    rdfs:label "Flashing" ;
    rdfs:subClassOf mc2:ResourceAccessHazardEnum ;
    skos:definition "Indicates the educational resource contains flashing or strobing visual effects that may pose a seizure risk for photosensitive users." .

<https://w3id.org/mc2-center/mc2-model/ResourceAccessHazardEnum#Motion> a owl:Class ;
    rdfs:label "Motion" ;
    rdfs:subClassOf mc2:ResourceAccessHazardEnum ;
    skos:definition "Indicates the educational resource contains motion effects (e.g., panning, zooming, or animated movement) that may cause discomfort or disorientation for motion-sensitive users." .

<https://w3id.org/mc2-center/mc2-model/ResourceAccessHazardEnum#Simulation> a owl:Class ;
    rdfs:label "Simulation" ;
    rdfs:subClassOf mc2:ResourceAccessHazardEnum ;
    skos:definition "Indicates the educational resource contains simulated or virtual environments that may pose a hazard for users sensitive to simulated motion or visual effects." .

<https://w3id.org/mc2-center/mc2-model/ResourceAccessHazardEnum#Sound> a owl:Class ;
    rdfs:label "Sound" ;
    rdfs:subClassOf mc2:ResourceAccessHazardEnum ;
    skos:definition "Indicates the educational resource contains audio content, including unexpected or startling sounds, that may pose a hazard for users with sound sensitivities." .

<https://w3id.org/mc2-center/mc2-model/ResourceActivityTypeEnum#Activity%2FLab> a owl:Class ;
    rdfs:label "Activity/Lab" ;
    rdfs:subClassOf mc2:ResourceActivityTypeEnum ;
    skos:definition "A hands-on exercise or laboratory-based activity in which learners actively perform tasks, experiments, or procedures to apply and reinforce concepts." .

<https://w3id.org/mc2-center/mc2-model/ResourceActivityTypeEnum#Case%20Study> a owl:Class ;
    rdfs:label "Case Study" ;
    rdfs:subClassOf mc2:ResourceActivityTypeEnum ;
    skos:definition "A detailed, narrative-based educational resource examining a specific real-world example, scenario, or problem to illustrate concepts or promote analytical and critical-thinking skills." .

<https://w3id.org/mc2-center/mc2-model/ResourceActivityTypeEnum#Full%20Course> a owl:Class ;
    rdfs:label "Full Course" ;
    rdfs:subClassOf mc2:ResourceActivityTypeEnum ;
    skos:definition "A complete, self-contained sequence of instructional materials and activities covering a full subject or curriculum, typically spanning a full academic term." .

<https://w3id.org/mc2-center/mc2-model/ResourceActivityTypeEnum#Game> a owl:Class ;
    rdfs:label "Game" ;
    rdfs:subClassOf mc2:ResourceActivityTypeEnum ;
    skos:definition "An interactive, rule-based activity designed to engage learners and teach or reinforce concepts through play." .

<https://w3id.org/mc2-center/mc2-model/ResourceActivityTypeEnum#Interactive> a owl:Class ;
    rdfs:label "Interactive" ;
    rdfs:subClassOf mc2:ResourceActivityTypeEnum ;
    skos:definition "A resource that requires active learner participation or response, such as a clickable simulation, interactive exercise, or dynamic multimedia element." .

<https://w3id.org/mc2-center/mc2-model/ResourceActivityTypeEnum#Lesson> a owl:Class ;
    rdfs:label "Lesson" ;
    rdfs:subClassOf mc2:ResourceActivityTypeEnum ;
    skos:definition "A single, discrete unit of instruction focused on a specific topic or set of learning objectives." .

<https://w3id.org/mc2-center/mc2-model/ResourceActivityTypeEnum#Lesson%20Plan> a owl:Class ;
    rdfs:label "Lesson Plan" ;
    rdfs:subClassOf mc2:ResourceActivityTypeEnum ;
    skos:definition "A structured outline prepared by an instructor detailing the objectives, activities, materials, and assessment methods for a lesson." .

<https://w3id.org/mc2-center/mc2-model/ResourceActivityTypeEnum#Module> a owl:Class ;
    rdfs:label "Module" ;
    rdfs:subClassOf mc2:ResourceActivityTypeEnum ;
    skos:definition "A self-contained segment of instructional content covering a specific topic, often combined with other modules to form a larger course or curriculum." .

<https://w3id.org/mc2-center/mc2-model/ResourceActivityTypeEnum#Primary%20Source> a owl:Class ;
    rdfs:label "Primary Source" ;
    rdfs:subClassOf mc2:ResourceActivityTypeEnum ;
    skos:definition "An original document, artifact, or firsthand record (such as a letter, dataset, or historical artifact) created at the time of the event or phenomenon under study, used as direct evidence for learning or research." .

<https://w3id.org/mc2-center/mc2-model/ResourceActivityTypeEnum#Reading> a owl:Class ;
    rdfs:label "Reading" ;
    rdfs:subClassOf mc2:ResourceActivityTypeEnum ;
    skos:definition "A text-based resource, such as an article, excerpt, or book chapter, assigned for learners to read as part of instructional content." .

<https://w3id.org/mc2-center/mc2-model/ResourceActivityTypeEnum#Simulation> a owl:Class ;
    rdfs:label "Simulation" ;
    rdfs:subClassOf mc2:ResourceActivityTypeEnum ;
    skos:definition "An interactive model or representation of a real-world process, system, or scenario that allows learners to explore and experiment in a controlled, simulated environment." .

<https://w3id.org/mc2-center/mc2-model/ResourceActivityTypeEnum#Student%20Guide> a owl:Class ;
    rdfs:label "Student Guide" ;
    rdfs:subClassOf mc2:ResourceActivityTypeEnum ;
    skos:definition "A resource providing learners with instructions, guidance, or supplementary information to support their use of a course or activity." .

<https://w3id.org/mc2-center/mc2-model/ResourceActivityTypeEnum#Unit%20of%20Study> a owl:Class ;
    rdfs:label "Unit of Study" ;
    rdfs:subClassOf mc2:ResourceActivityTypeEnum ;
    skos:definition "A cohesive set of lessons or learning materials organized around a specific topic or theme, typically spanning several class sessions." .

<https://w3id.org/mc2-center/mc2-model/ResourceEducationalLevelEnum#Career%20%2F%20Technical> a owl:Class ;
    rdfs:label "Career / Technical" ;
    rdfs:subClassOf mc2:ResourceEducationalLevelEnum ;
    skos:definition "Educational programs focused on career-specific or technical/vocational skills that prepare students for direct entry into a trade or occupation." .

<https://w3id.org/mc2-center/mc2-model/ResourceEducationalLevelEnum#College%20%2F%20Upper%20Division> a owl:Class ;
    rdfs:label "College / Upper Division" ;
    rdfs:subClassOf mc2:ResourceEducationalLevelEnum ;
    skos:definition "A four-year postsecondary institution, or the upper-division (junior and senior level) undergraduate coursework within one." .

<https://w3id.org/mc2-center/mc2-model/ResourceEducationalLevelEnum#Lower%20Primary> a owl:Class ;
    rdfs:label "Lower Primary" ;
    rdfs:subClassOf mc2:ResourceEducationalLevelEnum ;
    skos:definition "The earlier years of primary (elementary) education, typically encompassing the first few grades of primary school." .

<https://w3id.org/mc2-center/mc2-model/ResourceEducationalLevelEnum#Middle%20School> a owl:Class ;
    rdfs:label "Middle School" ;
    rdfs:subClassOf mc2:ResourceEducationalLevelEnum ;
    skos:definition "The educational level between primary/elementary school and high school, typically covering grades 6 through 8." .

<https://w3id.org/mc2-center/mc2-model/ResourceEducationalLevelEnum#Upper%20Primary> a owl:Class ;
    rdfs:label "Upper Primary" ;
    rdfs:subClassOf mc2:ResourceEducationalLevelEnum ;
    skos:definition "The later years of primary (elementary) education, typically encompassing the grades preceding the transition to middle or secondary school." .

<https://w3id.org/mc2-center/mc2-model/ResourceIntendedUseEnum#Professional%20Development> a owl:Class ;
    rdfs:label "Professional Development" ;
    rdfs:subClassOf mc2:ResourceIntendedUseEnum ;
    skos:definition "Resources intended to support ongoing training, skill-building, or continuing education for professionals in a given field." .

