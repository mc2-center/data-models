        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "An assay that detects or quantifies an analyte by measuring light emitted from a chemiluminescent reaction." .

pmid:28667618 a owl:Class ;
