mc2:ToolCostEnum a owl:Class ;
    rdfs:label "Tool Cost Enum" ;
    owl:unionOf ( <https://w3id.org/mc2-center/mc2-model/ToolCostEnum#Commercial> <https://w3id.org/mc2-center/mc2-model/ToolCostEnum#Free%20of%20Charge> <https://w3id.org/mc2-center/mc2-model/ToolCostEnum#Free%20of%20Charge%20%28With%20Restrictions%29> ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values <https://w3id.org/mc2-center/mc2-model/ToolCostEnum#Commercial>,
        <https://w3id.org/mc2-center/mc2-model/ToolCostEnum#Free%20of%20Charge>,
        <https://w3id.org/mc2-center/mc2-model/ToolCostEnum#Free%20of%20Charge%20%28With%20Restrictions%29> .

mc2:ToolOperatingSystemEnum a owl:Class ;
    rdfs:label "Tool Operating System Enum" ;
    owl:unionOf ( SWO:0000022 SWO:0000151 SWO:9000072 ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values SWO:0000022,
        SWO:0000151,
        SWO:9000072 .

mc2:Treatment_Anatomic_Site a owl:DatatypeProperty ;
    rdfs:label "Treatment Anatomic Site" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^UBERON:\\d+$" ] ) ] ;
    skos:definition "The UBERON identifier of the organ or part of the body targeted by a therapeutic procedure (see https://www.ebi.ac.uk/ols4/ontologies/uberon)." ;
    skos:exactMatch CRDC_CDE:14461856 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Visium_Capture_Area a owl:ObjectProperty ;
    rdfs:label "Visium Capture Area" ;
    rdfs:range mc2:VisiumCaptureAreaEnum ;
    skos:definition "Area (or Capture Area) - One of the either four or two active regions where tissue can be placed on a Visium slide. Each area is intended to contain only one tissue sample. Slide areas are named consecutively from top to bottom: A1, B1, C1, D1 for Visium slides with 6.5 mm Capture Area and A, B for CytAssist slides with 11 mm Capture Area. Both CytAssist slides with 6.5 mm Capture Area and Gateway Slides contain only two slide areas, A1 and D1." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: HTAN" .

mc2:Workflow_Version a owl:DatatypeProperty ;
    rdfs:label "Workflow Version" ;
    skos:definition "Major version of the workflow (e.g. Cell Ranger v3.1)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

<SPDX:CC-BY-4.0> a owl:Class ;
    rdfs:label "CC-BY-4.0",
        "CC_BY" ;
    rdfs:subClassOf mc2:DataCatalogLicenseEnum,
        mc2:LicenseEnum ;
    skos:definition "Creative Commons Attribution license, requiring attribution to the original source." .

<SPDX:CC-BY-NC-3.0> a owl:Class ;
    rdfs:label "CC-BY-NC-3.0",
        "CC_BY_NC" ;
    rdfs:subClassOf mc2:DataCatalogLicenseEnum,
        mc2:LicenseEnum ;
    skos:definition "Creative Commons Attribution-NonCommercial license, allowing for non-commercial use with attribution." .

mesh:D009893 a owl:Class ;
    rdfs:label "Opossum" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "New World marsupials of the family Didelphidae. Opossums are omnivorous, largely nocturnal and arboreal mammals, and have an abdominal pouch in which the young are carried at birth." .

DUO:0000007 a owl:Class ;
    rdfs:label "DUO:0000007" ;
    rdfs:subClassOf mc2:DataCatalogDataUseModifiersEnum,
        mc2:DataUseModifiersEnum ;
    skos:definition "This data use permission indicates that use is allowed provided it is related to the specified disease. If providing this term, please provide the disease MONDO ID(s) in column diseaseSpecificResearch." .

DUO:0000012 a owl:Class ;
    rdfs:label "DUO:0000012" ;
    rdfs:subClassOf mc2:DataCatalogDataUseModifiersEnum,
        mc2:DataUseModifiersEnum ;
    skos:definition "This data use modifier indicates that use is limited to studies of a certain research type. If providing this term, please note the research type(s) in column researchSpecificRestrictions." .

DUO:0000020 a owl:Class ;
    rdfs:label "DUO:0000020" ;
    rdfs:subClassOf mc2:DataCatalogDataUseModifiersEnum,
        mc2:DataUseModifiersEnum ;
    skos:definition "This data use modifier indicates that the requestor must agree to collaboration with the primary study investigator(s). If providing this term, please note the contact email in column collaborationRequired." .

DUO:0000022 a owl:Class ;
    rdfs:label "DUO:0000022" ;
    rdfs:subClassOf mc2:DataCatalogDataUseModifiersEnum,
        mc2:DataUseModifiersEnum ;
    skos:definition "This data use modifier indicates that use is limited to within a specific geographic region. If providing this term, please provide the applicable country code(s) in column geographicalRestriction." .

DUO:0000024 a owl:Class ;
    rdfs:label "DUO:0000024" ;
    rdfs:subClassOf mc2:DataCatalogDataUseModifiersEnum,
        mc2:DataUseModifiersEnum ;
    skos:definition "This data use modifier indicates that requestor agrees not to publish results of studies until a specific date. If providing this term, please provide the date in column publicationMoratorium." .

DUO:0000025 a owl:Class ;
    rdfs:label "DUO:0000025" ;
    rdfs:subClassOf mc2:DataCatalogDataUseModifiersEnum,
        mc2:DataUseModifiersEnum ;
    skos:definition "This data use modifier indicates that use is approved for a specific number of months. If providing this term, please provide the number of months in column timeLimitOnUse." .

DUO:0000026 a owl:Class ;
    rdfs:label "DUO:0000026" ;
    rdfs:subClassOf mc2:DataCatalogDataUseModifiersEnum,
        mc2:DataUseModifiersEnum ;
    skos:definition "This data use modifier indicates that use is limited to use by approved users. If providing this term, please describe the restrictions in column userSpecificRestriction." .

DUO:0000028 a owl:Class ;
    rdfs:label "DUO:0000028" ;
    rdfs:subClassOf mc2:DataCatalogDataUseModifiersEnum,
        mc2:DataUseModifiersEnum ;
    skos:definition "This data use modifier indicates that use is limited to use within an approved institution. If providing this term, please provide the institution ROR ID(s) in column institutionSpecificRestriction." .

FBcv:0003142 a owl:Class ;
    rdfs:label "Multispecies" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "A dataset or sample that is derived from or associated with more than one species." .

FOODON:00004286 a owl:Class ;
    rdfs:label "Boar" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "The wild boar (Sus scrofa), the wild ancestor of the domestic pig; used as a source organism in comparative and veterinary research." .

NCBITaxon:10228 a owl:Class ;
    rdfs:label "Trichoplax adhaerens" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "Trichoplax adhaerens, a simple multicellular marine organism belonging to the phylum Placozoa; used as a model organism in evolutionary and developmental biology." .

NCBITaxon:4896 a owl:Class ;
    rdfs:label "Schizosaccharomyces pombe" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "The fission yeast, Schizosaccharomyces pombe, a unicellular fungus widely used as a model organism in cell biology, distinct from the budding yeast Saccharomyces cerevisiae." .

NCBITaxon:5476 a owl:Class ;
    rdfs:label "Candida albicans" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "An opportunistic pathogenic yeast, Candida albicans, commonly used as a model organism in fungal biology and infection research." .

NCBITaxon:9545 a owl:Class ;
    rdfs:label "Macaca nemestrina" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "The pig-tailed macaque (Macaca nemestrina), an Old World monkey native to Southeast Asia, used as a model organism in biomedical research. Distinct from Rhesus monkey (Macaca mulatta)." .

NCBITaxon:9783 a owl:Class ;
    rdfs:label "Asian Elephant" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "The Asian elephant (Elephas maximus), native to South and Southeast Asia; used as a source organism in comparative and veterinary research." .

NCBITaxon:9785 a owl:Class ;
    rdfs:label "African Bush Elephant" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "The African bush elephant (Loxodonta africana), the largest living terrestrial animal, native to sub-Saharan Africa; used as a source organism in comparative and veterinary research." .

NCIT:C14185 a owl:Class ;
    rdfs:label "Armadillo" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "Any of several small, burrowing, chiefly nocturnal mammals with a body covered with strong horny plates." .

NCIT:C14191 a owl:Class ;
    rdfs:label "Cat" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "The domesticated feline mammal, Felis catus, which is kept as a house pet." .

NCIT:C14192 a owl:Class ;
    rdfs:label "Cow" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "Domesticated ungulates that are raised for beef, dairy products, and leather, and used for labor." .

NCIT:C14193 a owl:Class ;
    rdfs:label "Chicken" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "The common domestic fowl, Gallus gallus." .

NCIT:C14201 a owl:Class ;
    rdfs:label "Dog" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "The domestic dog, Canis familiaris." .

NCIT:C14202 a owl:Class ;
    rdfs:label "Fruit Fly" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "Drosophila melanogaster, commonly known as the fruit fly, a small dipteran insect that has been extensively used in genetic and developmental biology studies." .

NCIT:C14206 a owl:Class ;
    rdfs:label "Escherichia coli" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "A common, gram negative gut bacterium that has been studied intensively by geneticists because of its small genome size, normal lack of pathogenicity, and ease of growth in the laboratory." .

NCIT:C14211 a owl:Class ;
    rdfs:label "Guinea Pig" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "The domesticated guinea pig, Cavia porcellus." .

NCIT:C14222 a owl:Class ;
    rdfs:label "Horse" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "The domestic horse, Equus caballus." .

NCIT:C14225 a owl:Class ;
    rdfs:label "Human" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "The bipedal primate mammal, Homo sapiens; belonging to man or mankind; pertaining to man or to the race of man; use of man as experimental subject or unit of analysis in research." .

NCIT:C14233 a owl:Class ;
    rdfs:label "Rhesus monkey" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "A pale brown macaque (Macaca mulatta) native to India, China, and other parts of Asia, often used in medical research owing to its relative ease of upkeep and physiological similarity to humans." .

NCIT:C14238 a owl:Class ;
    rdfs:label "Mouse" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "Any of numerous species of small rodents belonging to the genus Mus and various related genera of the family Muridae." .

NCIT:C14264 a owl:Class ;
    rdfs:label "Rabbit" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "Various members of the family Leporidae, especially those of the genus Sylvilagus." .

NCIT:C14273 a owl:Class ;
    rdfs:label "Sheep" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "Any one of several species of ruminants of the genus Ovis, native of the higher mountains of both hemispheres but most numerous in Asia; the domestic sheep, Ovis aries." .

NCIT:C14286 a owl:Class ;
    rdfs:label "Yeast" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "Various single-celled members of the fungal families, ascomycetes, basidiomycetes and imperfect fungi that tend to be unicellular for the greater part of their life cycle." .

NCIT:C14287 a owl:Class ;
    rdfs:label "Zebrafish" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "Brachydanio rerio, a species of small freshwater aquarium fish with a transparent embryo, making it possible to follow progeny of single cells until late stages of development; an important model for studies of vertebrate cell lineage and developmental biology." .

NCIT:C14303 a owl:Class ;
    rdfs:label "Worm" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "A roundworm, most commonly Caenorhabditis elegans, that is used as a model organism in biological research." .

NCIT:C160998 a owl:Class ;
    rdfs:label "Rat" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "Any of various rodent species of the genus Rattus, particularly Rattus norvegicus, that are widely used as model organisms in biomedical research." .

NCIT:C16475 a owl:Class ;
    rdfs:label "Cryopreservation in dry ice - dead tissue",
        "Cryopreservation in liquid nitrogen - dead tissue",
        "Cryopreservation in liquid nitrogen - live cells",
        "Cryopreserved" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMethodEnum ;
    skos:definition "Preservation of cells, tissues, organs, or embryos by storage at low temperatures." .

NCIT:C16960 a owl:Class ;
    rdfs:label "Human Patient" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "A human patient enrolled in a clinical study who receives medical attention, care, or treatment." .

NCIT:C201930 a owl:Class ;
    rdfs:label "Random",
        "cDNA random priming" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum,
        mc2:NGSRNAReverseTranscriptionPrimerEnum ;
    skos:definition "A library selection method using random-sequence oligonucleotides to prime cDNA synthesis, allowing unbiased coverage of RNA transcripts including non-polyadenylated species.",
        "Random selection by shearing or other method",
        "Short oligonucleotides of random sequence that anneal throughout the length of RNA templates and are used to prime reverse transcription." .

NCIT:C20218 a owl:Class ;
    rdfs:label "Human Cell Line" ;
    rdfs:subClassOf mc2:DSPDatasetSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "A cell line established from human-derived cells that is maintained and propagated in vitro for research purposes." .

NCIT:C36032 a owl:Class ;
    rdfs:label "Atypia or hyperplasia",
        "Premalignant",
        "Premalignant Neoplasm" ;
    rdfs:subClassOf mc2:BiospecimenCompositionEnum,
        mc2:BiospecimenPathologyEnum ;
    skos:definition "A lesion or cellular condition with the potential to develop into cancer.",
        "A pathological process that precedes and often leads to the development of cancer." .

NCIT:C38155 a owl:Class ;
    rdfs:label "Local recurrence",
        "Recurrence",
        "Recurrent" ;
    rdfs:subClassOf mc2:BiospecimenCompositionEnum,
        mc2:BiospecimenIncidenceTypeEnum ;
    skos:definition "The return of a disease after a period of remission." .

mc2:BiospecimenTreatmentPriorToSpecimenCollectionIndicatorEnum a owl:Class ;
    rdfs:label "Biospecimen Treatment Prior to Specimen Collection Indicator Enum" ;
    owl:unionOf ( <https://w3id.org/mc2-center/mc2-model/BiospecimenTreatmentPriorToSpecimenCollectionIndicatorEnum#Not%20Reported> <https://w3id.org/mc2-center/mc2-model/BiospecimenTreatmentPriorToSpecimenCollectionIndicatorEnum#Yes> <https://w3id.org/mc2-center/mc2-model/BiospecimenTreatmentPriorToSpecimenCollectionIndicatorEnum#No> <https://w3id.org/mc2-center/mc2-model/BiospecimenTreatmentPriorToSpecimenCollectionIndicatorEnum#Unknown> ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
