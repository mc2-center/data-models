mc2:NGS_Sequencing_Platform a owl:ObjectProperty ;
    rdfs:label "NGS Sequencing Platform" ;
    rdfs:range mc2:NGSSequencingPlatformEnum ;
    skos:definition "A platform is an object aggregate that is the set of instruments and software needed to perform a process [OBI_0000050]. Specific model of the sequencing instrument." ;
    skos:exactMatch CRDC_CDE:6352164 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "6352164" .

mc2:Primary_Site a owl:DatatypeProperty ;
    rdfs:label "Primary Site" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^UBERON:\\d+$" ] ) ] ;
    skos:definition "The UBERON identifier of the organ or part of the body where the disease began, i.e. the primary/original disease site (see https://www.ebi.ac.uk/ols4/ontologies/uberon). Reference-validated, not a fixed list." ;
    skos:exactMatch CRDC_CDE:14883047 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "14883047" .

mc2:Site_of_Origin a owl:DatatypeProperty ;
    rdfs:label "Site of Origin" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^UBERON:\\d+$" ] ) ] ;
    skos:definition "The UBERON identifier of the anatomic site of origin of the patient's, biospecimen donor's, or model's malignant disease (see https://www.ebi.ac.uk/ols4/ontologies/uberon)." ;
    skos:exactMatch CRDC_CDE:14883072 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "14156279" .

mc2:Workflow_Link a owl:DatatypeProperty ;
