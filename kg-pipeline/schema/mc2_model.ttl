    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:DSP_Dataset_Assay a owl:ObjectProperty ;
    rdfs:label "DSP Dataset Assay" ;
    rdfs:range mc2:DSPDatasetAssayEnum ;
