    rdfs:range xsd:float ;
    skos:definition "Number of channels. Integer >= 1" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Dimension_Order a owl:DatatypeProperty ;
    rdfs:label "Image Dimension Order" ;
    skos:definition "The order in which the individual planes of data are interleaved." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_FOV_Index a owl:DatatypeProperty ;
    rdfs:label "Image FOV Index" ;
    rdfs:range xsd:float ;
    skos:definition "Index of FOV (as it pertains to its sequence order). Integer >= 1" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_FOV_Size_X a owl:DatatypeProperty ;
    rdfs:label "Image FOV Size X" ;
    rdfs:range xsd:float ;
    skos:definition "Field of view X dimension. Floating point" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_FOV_Size_X_Unit a owl:DatatypeProperty ;
    rdfs:label "Image FOV Size X Unit" ;
    skos:definition "Field of view X dimension units. See OME enumeration of allowed values for the UnitsLength attribute -- default: microns (um)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_FOV_Size_Y a owl:DatatypeProperty ;
    rdfs:label "Image FOV Size Y" ;
    rdfs:range xsd:float ;
    skos:definition "Field  of view Y dimension. Floating point value" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_FOV_Size_Y_Unit a owl:DatatypeProperty ;
    rdfs:label "Image FOV Size Y Unit" ;
    skos:definition "Field of view Y dimension units. See OME enumeration of allowed values for the UnitsLength attribute -- default: microns (um)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Frame_Averaging a owl:DatatypeProperty ;
    rdfs:label "Image Frame Averaging" ;
    rdfs:range xsd:float ;
    skos:definition "Number of frames averaged together (if no averaging, set to 1). Integer >= 1" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Identifier a owl:DatatypeProperty ;
    rdfs:label "Image Identifier" ;
    skos:definition "Unique internal image identifier. eg \"Image:0\". (To be extracted from OME-XML)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Immersion_Type a owl:ObjectProperty ;
    rdfs:label "Image Immersion Type" ;
    rdfs:range mc2:ImageImmersionTypeEnum ;
    skos:definition "Immersion medium" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "8058286" .

mc2:Image_Lense_Aperture a owl:DatatypeProperty ;
    rdfs:label "Image Lense Aperture" ;
    rdfs:range xsd:float ;
    skos:definition "The numerical aperture of the lens. Floating point value > 0." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Nominal_Magnification a owl:DatatypeProperty ;
    rdfs:label "Image Nominal Magnification" ;
    rdfs:range xsd:float ;
    skos:definition "The magnification of the lens as specified by the manufacturer - i.e. '60' is a 60X lens. floating point value > 1(no units)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "7788940" .

mc2:Image_Number_of_Timepoints a owl:DatatypeProperty ;
    rdfs:label "Image Number of Timepoints" ;
    rdfs:range xsd:float ;
    skos:definition "Number of time points. Integer >= 1" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Objective a owl:DatatypeProperty ;
    rdfs:label "Image Objective" ;
    skos:definition "Objective lens identifier" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Physical_Size_X a owl:DatatypeProperty ;
    rdfs:label "Image Physical Size X" ;
    rdfs:range xsd:float ;
    skos:definition "Physical size (X-dimension) of a pixel. Units are set by PhysicalSizeXUnit. Floating point value > 0." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Physical_Size_X_Unit a owl:DatatypeProperty ;
    rdfs:label "Image Physical Size X Unit" ;
    skos:definition "The units of the physical size of a pixel. See OME enumeration of allowed values for the UnitsLength attribute -- default: microns (um)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Physical_Size_Y a owl:DatatypeProperty ;
    rdfs:label "Image Physical Size Y" ;
    rdfs:range xsd:float ;
    skos:definition "Physical size (Y-dimension) of a pixel. Units are set by PhysicalSizeYUnit. Floating point value > 0." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Physical_Size_Y_Unit a owl:DatatypeProperty ;
    rdfs:label "Image Physical Size Y Unit" ;
    skos:definition "The units of the physical size of a pixel. See OME enumeration of allowed values for the UnitsLength attribute -- default: microns (um)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Physical_Size_Z a owl:DatatypeProperty ;
    rdfs:label "Image Physical Size Z" ;
    rdfs:range xsd:float ;
    skos:definition "Physical size (Z-dimension) of a pixel. Units are set by PhysicalSizeZUnit. Floating point value > 0." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Physical_Size_Z_Unit a owl:DatatypeProperty ;
    rdfs:label "Image Physical Size Z Unit" ;
    skos:definition "The units of the physical size of a pixel. See OME enumeration of allowed values for the UnitsLength attribute -- default: microns (um)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Pixel_Type a owl:DatatypeProperty ;
    rdfs:label "Image Pixel Type" ;
    skos:definition "Data type for each pixel value. E.g. \"uint16\"" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Pixels_BigEndian a owl:ObjectProperty ;
    rdfs:label "Image Pixels BigEndian" ;
    rdfs:range mc2:ImagePixelsBigEndianEnum ;
    skos:definition "Boolean (True/False)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Plane_Count a owl:DatatypeProperty ;
    rdfs:label "Image Plane Count" ;
    rdfs:range xsd:float ;
    skos:definition "Number of Z-planes (not to be confused with downsampled \"pyramid\"). Integer >=1" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Pyramidal a owl:ObjectProperty ;
    rdfs:label "Image Pyramidal" ;
    rdfs:range mc2:ImagePyramidalEnum ;
    skos:definition "Does data file contain pyramid of images" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "7788945" .

mc2:Image_Timeseries a owl:DatatypeProperty ;
    rdfs:label "Image Timeseries" ;
    rdfs:range xsd:boolean ;
    skos:definition "Does data file contain a time-series of images" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Working_Distance a owl:DatatypeProperty ;
    rdfs:label "Image Working Distance" ;
    rdfs:range xsd:float ;
    skos:definition "The working distance of the lens, expressed as a floating point number. Floating point > 0." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Working_Distance_Unit a owl:ObjectProperty ;
    rdfs:label "Image Working Distance Unit" ;
    rdfs:range mc2:ImageWorkingDistanceUnitEnum ;
    skos:definition "The units of the working distance. See OME enumeration of allowed values for the UnitsLength attribute -- default: microns (um)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_X_Pixels a owl:DatatypeProperty ;
    rdfs:label "Image X Pixels" ;
    rdfs:range xsd:float ;
    skos:definition "Size of image: X dimension (in pixels). Integer >= 1" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Y_Pixels a owl:DatatypeProperty ;
    rdfs:label "Image Y Pixels" ;
    rdfs:range xsd:float ;
    skos:definition "Size of image: Y dimension (in pixels). Integer >= 1" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Z_Pixels a owl:DatatypeProperty ;
    rdfs:label "Image Z Pixels" ;
    rdfs:range xsd:float ;
    skos:definition "Size of image: Z dimension (in pixels). Integer >= 1" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Z_stack a owl:DatatypeProperty ;
    rdfs:label "Image Z stack" ;
    rdfs:range xsd:boolean ;
    skos:definition "Does data file contain a Z-stack of images" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:ImagingLevel2_Key a owl:DatatypeProperty ;
    rdfs:label "ImagingLevel2 Key" ;
    skos:definition "Unique ImagingLevel2_id foreign key(s) that link metadata entries as part of the same Dataset. Please provide multiple values as a comma-separate list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

mc2:NGSLibraryLayoutEnum a owl:Class ;
    rdfs:label "NGS Library Layout Enum" ;
    owl:unionOf ( NCIT:C150423 NCIT:C165444 ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values NCIT:C150423,
        NCIT:C165444 .

mc2:NGS_Aligned_Reads a owl:DatatypeProperty ;
    rdfs:label "NGS Aligned Reads" ;
    rdfs:range xsd:float ;
    skos:definition "Is a sequence that has been aligned to a gene/probe. Typically these reads can number from the hundreds of thousands to tens of millions. In GeoMx alignment is via mapping the RTS ID to a white list of sequences that represent targets." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:NGS_Deduplicated_Reads a owl:DatatypeProperty ;
    rdfs:label "NGS Deduplicated Reads" ;
    rdfs:range xsd:float ;
    skos:definition "Is the replacement of blocks of duplicate data with a Virtual Index Pointer linking the new sub-block to the existing block of data in a duplicate repository. This is used to reduce the amount of space need to store the data." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:NGS_Library_Preparation_Kit_Name a owl:DatatypeProperty ;
    rdfs:label "NGS Library Preparation Kit Name" ;
    skos:definition "Name of Library Preparation Kit. String" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:NGS_Library_Preparation_Kit_Vendor a owl:DatatypeProperty ;
    rdfs:label "NGS Library Preparation Kit Vendor" ;
    skos:definition "Vendor of Library Preparation Kit. String" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:NGS_Library_Preparation_Kit_Version a owl:DatatypeProperty ;
    rdfs:label "NGS Library Preparation Kit Version" ;
    skos:definition "Version of Library Preparation Kit. String" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:NGS_MapQ30 a owl:DatatypeProperty ;
    rdfs:label "NGS MapQ30" ;
    rdfs:range xsd:float ;
    skos:definition "Number of reads with Quality >= 30." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:NGS_Stitched_Reads a owl:DatatypeProperty ;
    rdfs:label "NGS Stitched Reads" ;
    rdfs:range xsd:float ;
    skos:definition "Represents consensus from the overlapping sequence of read 1 and 2. This is a % of the aligned reads that were overlapped and consensus confirmed, usually upward of 80% but less in terms of number of reads than aligned reads" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:NGS_Trimmed_Reads a owl:DatatypeProperty ;
    rdfs:label "NGS Trimmed Reads" ;
    rdfs:range xsd:float ;
    skos:definition "Number of the reads remaining after trimming has been applied." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:NanoStringGeoMXROISegmentAnnotation_Key a owl:DatatypeProperty ;
    rdfs:label "NanoStringGeoMXROISegmentAnnotation Key" ;
    skos:definition "Unique NanoStringGeoMXROISegmentAnnotation_id foreign key(s) that link metadata entries as part of the same Dataset. Please provide multiple values as a comma-separate list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

mc2:NanoStringGeoMxDSPLevel1_Key a owl:DatatypeProperty ;
    rdfs:label "NanoStringGeoMxDSPLevel1 Key" ;
    skos:definition "Unique NanoStringGeoMxDSPLevel1_id foreign key(s) that link metadata entries as part of the same Dataset. Please provide multiple values as a comma-separate list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

mc2:PersonView_Key a owl:DatatypeProperty ;
    rdfs:label "PersonView Key" ;
    skos:definition "Unique PersonView_id foreign key(s) that group the resource with other components, as part of the same person-associated studies. Please provide multiple values as a comma-separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

mc2:PortalDisplayEnum a owl:Class ;
    rdfs:label "Portal Display Enum" ;
    owl:unionOf ( <https://w3id.org/mc2-center/mc2-model/PortalDisplayEnum#FALSE> <https://w3id.org/mc2-center/mc2-model/PortalDisplayEnum#TRUE> ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values <https://w3id.org/mc2-center/mc2-model/PortalDisplayEnum#FALSE>,
        <https://w3id.org/mc2-center/mc2-model/PortalDisplayEnum#TRUE> .

mc2:ProjectTypeEnum a owl:Class ;
    rdfs:label "Project Type Enum" ;
    owl:unionOf ( <https://w3id.org/mc2-center/mc2-model/ProjectTypeEnum#Core> <https://w3id.org/mc2-center/mc2-model/ProjectTypeEnum#Project> ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values <https://w3id.org/mc2-center/mc2-model/ProjectTypeEnum#Core>,
        <https://w3id.org/mc2-center/mc2-model/ProjectTypeEnum#Project> .

mc2:PublicationAccessibilityEnum a owl:Class ;
    rdfs:label "Publication Accessibility Enum" ;
    owl:unionOf ( <https://w3id.org/mc2-center/mc2-model/PublicationAccessibilityEnum#Open%20Access> <https://w3id.org/mc2-center/mc2-model/PublicationAccessibilityEnum#Restricted%20Access> ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values <https://w3id.org/mc2-center/mc2-model/PublicationAccessibilityEnum#Open%20Access>,
        <https://w3id.org/mc2-center/mc2-model/PublicationAccessibilityEnum#Restricted%20Access> .

mc2:ToolPackageDependenciesPresentEnum a owl:Class ;
    rdfs:label "Tool Package Dependencies Present Enum" ;
    owl:unionOf ( NCIT:C68850 NCIT:C68851 ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values NCIT:C68850,
        NCIT:C68851 .

mc2:VisiumAppliedHardTrimmingEnum a owl:Class ;
    rdfs:label "Visium Applied Hard Trimming Enum" ;
    owl:unionOf ( NCIT:C68850 NCIT:C68851 ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values NCIT:C68850,
        NCIT:C68851 .

mc2:VisiumImageRe-orientationEnum a owl:Class ;
    rdfs:label "Visium Image Re-orientation Enum" ;
    owl:unionOf ( NCIT:C68850 NCIT:C68851 ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values NCIT:C68850,
        NCIT:C68851 .

mc2:VisiumSpatialRead1Enum a owl:Class ;
    rdfs:label "Visium Spatial Read1 Enum" ;
    owl:unionOf ( NCIT:C324 <https://w3id.org/mc2-center/mc2-model/VisiumSpatialRead1Enum#Spatial%20Barcode%20and%20UMI> ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values NCIT:C324,
        <https://w3id.org/mc2-center/mc2-model/VisiumSpatialRead1Enum#Spatial%20Barcode%20and%20UMI> .

mc2:VisiumSpatialRead2Enum a owl:Class ;
    rdfs:label "Visium Spatial Read2 Enum" ;
    owl:unionOf ( NCIT:C324 <https://w3id.org/mc2-center/mc2-model/VisiumSpatialRead2Enum#Spatial%20Barcode%20and%20UMI> ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values NCIT:C324,
