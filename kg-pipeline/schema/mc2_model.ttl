mc2:Image_Channel_Size a owl:DatatypeProperty ;
    rdfs:label "Image Channel Size" ;
    rdfs:range xsd:float ;
    skos:definition "Number of channels. Integer >= 1" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Dimension_Order a owl:DatatypeProperty ;
    rdfs:label "Image Dimension Order" ;
    skos:definition "The order in which the individual planes of data are interleaved." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_FOV_Index a owl:DatatypeProperty ;
    rdfs:label "Image FOV Index" ;
    rdfs:range xsd:float ;
    skos:definition "Index of FOV (as it pertains to its sequence order). Integer >= 1" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_FOV_Size_X a owl:DatatypeProperty ;
    rdfs:label "Image FOV Size X" ;
    rdfs:range xsd:float ;
    skos:definition "Field of view X dimension. Floating point" ;
