        <https://w3id.org/mc2-center/mc2-model/DataTypeEnum#nucleic%20acid%20sequence%20record> .

mc2:FileLevelEnum a owl:Class ;
    rdfs:label "File Level Enum" ;
    owl:unionOf ( NCIT:C142663 <https://w3id.org/mc2-center/mc2-model/FileLevelEnum#Level%202> <https://w3id.org/mc2-center/mc2-model/FileLevelEnum#Level%203> <https://w3id.org/mc2-center/mc2-model/FileLevelEnum#Level%204> <https://w3id.org/mc2-center/mc2-model/FileLevelEnum#Auxiliary> NCIT:C48660 NCIT:C52095 ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values NCIT:C142663,
        NCIT:C48660,
        NCIT:C52095,
        <https://w3id.org/mc2-center/mc2-model/FileLevelEnum#Auxiliary>,
        <https://w3id.org/mc2-center/mc2-model/FileLevelEnum#Level%202>,
        <https://w3id.org/mc2-center/mc2-model/FileLevelEnum#Level%203>,
        <https://w3id.org/mc2-center/mc2-model/FileLevelEnum#Level%204> .

mc2:IndividualRecurrenceStatusEnum a owl:Class ;
    rdfs:label "Individual Recurrence Status Enum" ;
    owl:unionOf ( NCIT:C49488 NCIT:C17998 NCIT:C43234 NCIT:C48660 NCIT:C141478 NCIT:C49487 NCIT:C118962 ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values NCIT:C118962,
        NCIT:C141478,
        NCIT:C17998,
        NCIT:C43234,
        NCIT:C48660,
        NCIT:C49487,
        NCIT:C49488 .

mc2:NGS_Library_Preparation_Days_from_Index a owl:DatatypeProperty ;
    rdfs:label "NGS Library Preparation Days from Index" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "\\d+$|Not\\sApplicable$|unknown$" ] ) ] ;
    skos:definition "Number of days between sample for assay was received in lab and the libraries were prepared for sequencing [number]. If not applicable please enter 'Not Applicable'" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:NGS_Sequencing_Library_Construction_Days_from_Index a owl:DatatypeProperty ;
    rdfs:label "NGS Sequencing Library Construction Days from Index" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "\\d+$|Not\\sApplicable$|unknown$" ] ) ] ;
    skos:definition "Number of days between sample for assay was received in lab and day of sequencing library construction [number]. If not applicable please enter 'Not Applicable'" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

