    rdfs:range xsd:float ;
    skos:definition "The expected total storage space required for the dataset in gigabytes (GB)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:DatasetView_id a owl:DatatypeProperty ;
    rdfs:label "DatasetView_id" ;
    skos:definition "Unique ID associated with this Dataset View entry, used as a key for record linking and updates. Unless otherwise directed, this value should be equivalent to Dataset Alias. For externally hosted datasets with a corresponding Synapse Dataset containing indexed data, this should be the Synapse Id of the Dataset." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Dataset_Alias a owl:DatatypeProperty ;
    rdfs:label "Dataset Alias" ;
    skos:definition "Alias of the dataset. Must be unique. Can be the GEO identifier such as GSE12345, or a DOI. No Greek Letters." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Dataset_Assay a owl:ObjectProperty ;
    rdfs:label "Dataset Assay" ;
    rdfs:range mc2:DatasetAssayEnum ;
    skos:definition "The assay the dataset is representative of. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Dataset_Description a owl:DatatypeProperty ;
    rdfs:label "Dataset Description" ;
    skos:definition "Description of the dataset." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Dataset_Design a owl:DatatypeProperty ;
    rdfs:label "Dataset Design" ;
