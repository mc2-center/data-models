NCIT:C15262 a owl:Class ;
    rdfs:label "Immunotherapy" ;
    rdfs:subClassOf mc2:BiospecimenTreatmentTypeEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:GrantThemeNameEnum,
        mc2:IndividualTreatmentTypeEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:ModelTreatmentTypeEnum,
        mc2:PublicationAssayEnum,
        mc2:ResourceTopicEnum ;
    skos:definition "Therapy designed to induce changes in a patient's immune status in order to treat disease, such as cancer.",
        "Therapy designed to induce changes in a patient's immune status in order to treat disease.",
        "Therapy designed to induce, enhance, or suppress changes in a patient's immune status in order to treat disease, such as cancer." .

OBI:0003098 a owl:Class ;
    rdfs:label "Lattice Light Sheet Microscopy",
        "Light Sheet Microscopy",
        "Multiscale Light Sheet Microscopy" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "A fluorescence microscopy technique that captures photons emitted by fluorophores excited with a thin sheet of laser light, illuminating only a thin region of the sample at a time.",
        "A light-sheet fluorescence microscopy approach that combines imaging at multiple spatial scales (e.g., whole-organism to subcellular) within the same experiment.",
        "The use of a special microscope to see objects that give off fluorescent light. For example, cells or tissue can be treated with a substance that contains a fluorescent dye. The dye lights up when viewed under a microscope with a special light." .

