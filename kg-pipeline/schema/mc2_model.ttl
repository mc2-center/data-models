    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:DSP_Dataset_Destination a owl:DatatypeProperty ;
    rdfs:label "DSP Dataset Destination" ;
    skos:definition "An identifier representing the repository in which this dataset is intended to be held for long term preservation." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:DSP_Dataset_Name a owl:DatatypeProperty ;
    rdfs:label "DSP Dataset Name" ;
    skos:definition "Name of the dataset" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:DSP_Dataset_Species a owl:ObjectProperty ;
    rdfs:label "DSP Dataset Species" ;
    rdfs:range mc2:DSPDatasetSpeciesEnum ;
