NCBITaxon:9785 a owl:Class ;
    rdfs:label "African Bush Elephant" ;
    rdfs:subClassOf mc2:BiospecimenSpeciesEnum,
        mc2:DSPDatasetSpeciesEnum,
        mc2:DatasetSpeciesEnum,
        mc2:FileSpeciesEnum,
        mc2:ModelSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "The African bush elephant (Loxodonta africana), the largest living terrestrial animal, native to sub-Saharan Africa; used as a source organism in comparative and veterinary research." .

NCIT:C101294 a owl:Class ;
    rdfs:label "WGS",
        "Whole Genome Sequencing" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:NGSLibraryStrategyEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "A procedure that can determine the DNA sequence for nearly the entire genome of an individual.",
        "Random sequencing of the whole genome" .

NCIT:C101295 a owl:Class ;
    rdfs:label "WXS",
        "Whole Exome Sequencing" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:NGSLibraryStrategyEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "A procedure that can determine the DNA sequence for all of the exons in an individual.",
        "Random sequencing of exonic regions selected from the genome" .

NCIT:C106048 a owl:Class ;
    rdfs:label "ChIP",
        "ChIP-Seq" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:NGSLibrarySelectionMethodEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "A molecular genetic technique that combines chromatin immunoprecipitation (ChIP) with massively parallel DNA sequencing to map the binding sites of DNA-associated proteins in a sample of cells. First, crosslinked protein-DNA complexes are isolated using ChIP. Next, the crosslinks are broken, the proteins are removed and the purified DNA is modified with adaptor oligonucleotides to facilitate massively parallel DNA sequencing. Following sequencing, the DNA sequences that are obtained can be mapped to their genomic locations.",
        "Chromatin immunoprecipitation" .

NCIT:C106051 a owl:Class ;
    rdfs:label "FAIRE-Seq",
        "FAIRE-seq" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:NGSLibraryStrategyEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "A molecular genetic technique that depletes a biological sample of nucleosomal DNA and then subjects the non-nucleosome-associated DNA to next-generation sequencing. Since nucleosome disruption of chromatin is indicative of active sites of DNA transcription, this technique can isolate DNA sequences that are involved in transcriptional regulation. First, a sample is treated with formaldehyde to form DNA-protein crosslinks, followed by sample lysis and sonication. The processed sample is subjected to phenol/chloroform extraction and the DNA in the aqueous phase is analyzed using next-generation sequencing techniques.",
        "Formaldehyde Assisted Isolation of Regulatory Elements. reveals regions of open chromatin" .

NCIT:C106052 a owl:Class ;
    rdfs:label "DNase-Hypersensitivity",
        "DNase-Seq" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:NGSLibraryStrategyEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "A molecular genetic technique where genome-wide sequencing is performed on DNA regions that are super sensitive to cleavage by DNase I to identify putative DNA regulatory sequences.",
        "Sequencing of hypersensitive sites, or segments of open chromatin that are more readily cleaved by DNaseI" .

NCIT:C106054 a owl:Class ;
    rdfs:label "Bisulfite Sequencing",
        "Bisulfite-Seq" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:NGSLibraryStrategyEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "A DNA sequencing technique that can differentiate cytosine from 5-methylcytosine in a DNA sample. First, a denatured DNA sample is treated with bisulfite which converts non-methylated cytosine to uracil. Next, the sample is amplified using a PCR method that does not discriminate between non-methylated and methylated sequences. The amplified DNA is subjected to nucleotide sequencing. The resulting sequence is compared to an identical control sample of DNA that was not treated with bisulfite. Unmethylated cytosines will be displayed as cytosines in the control sample and as thymines in the bisulfite-treated sample.",
        "Sequencing following treatment of DNA with bisulfite to convert cytosine residues to uracil depending on methylation status" .

NCIT:C124261 a owl:Class ;
    rdfs:label "RNA Sequencing",
        "RNA-Seq" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:NGSLibraryStrategyEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "A procedure that can determine the RNA sequences for all or part of the poly-A tail-containing messenger RNA transcripts in an individual.",
        "Random sequencing of whole transcriptome" .

NCIT:C14185 a owl:Class ;
    rdfs:label "Armadillo" ;
