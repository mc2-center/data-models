mc2:Dataset_Name a owl:DatatypeProperty ;
    rdfs:label "Dataset Name" ;
    skos:definition "Name of the dataset" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Dataset_Species a owl:ObjectProperty ;
    rdfs:label "Dataset Species" ;
