EDAM:format_1929 a owl:Class ;
    rdfs:label "FASTA" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum,
        mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "A text-based format for representing nucleotide or peptide sequences, in which base pairs or amino acids are represented using single-letter codes, with each sequence preceded by a single-line description beginning with a '>' character.",
        "Text-based format for representing nucleotide or peptide sequences, in which each sequence is preceded by a single-line description starting with a '>' character." .

EDAM:format_2331 a owl:Class ;
    rdfs:label "HTML" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum,
        mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "HTML (HyperText Markup Language) is a markup format used to structure and present content, including text, images, and hyperlinks, for display in web browsers.",
        "HyperText Markup Language (HTML) format, used for structuring and rendering documents on the web." .

EDAM:format_2332 a owl:Class ;
    rdfs:label "XML" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum,
        mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "XML (Extensible Markup Language) is a flexible, tag-based text format for representing structured, hierarchical data in a manner that is both human-readable and machine-parsable.",
        "eXtensible Markup Language (XML), a markup format for representing structured, hierarchical data." .

EDAM:format_3003 a owl:Class ;
    rdfs:label "BED" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum,
        mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "BED (Browser Extensible Data) format is a tab-delimited text format for describing genomic regions or features, such as gene models or annotation tracks, typically displayed in a genome browser.",
        "Browser Extensible Data (BED) format for sequence annotation tracks, typically displayed in a genome browser." .

EDAM:format_3579 a owl:Class ;
    rdfs:label "JPG" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum,
        mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "JPEG (Joint Photographic Experts Group) is a lossy compressed raster image file format commonly used for photographic and other continuous-tone images.",
        "Joint Photographic Experts Group (JPEG) format, a common lossy compressed image format." .

EDAM:format_3591 a owl:Class ;
    rdfs:label "TIFF" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum,
        mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "A versatile bitmap image format that supports numerous data compression schemes, widely used for high-quality raster images, including microscopy and pathology images.",
        "Tagged Image File Format (TIFF), a versatile and extensible bitmap image format supporting numerous compression schemes." .

EDAM:format_3621 a owl:Class ;
    rdfs:label "DB",
        "SQLite Format" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum,
        mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "DB is a generic file extension denoting a database file used to store structured, queryable data, most commonly associated with lightweight database engines such as SQLite.",
        "Data format used by the SQLite embedded relational database engine." .

EDAM:format_3702 a owl:Class ;
    rdfs:label "MSF" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum,
        mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "A proprietary mass-spectrometry format used by Thermo Scientific's ProteomeDiscoverer software; it corresponds to an SQLite database that stores peptide and protein identification results.",
        "A structured (SQLite-based) mass spectrometry result file format used by Thermo Scientific's Proteome Discoverer software." .

EDAM:format_3873 a owl:Class ;
    rdfs:label "HDF" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum,
        mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "HDF is the name of a set of file formats and libraries designed to store and organize large amounts of numerical data, originally developed at the National Center for Supercomputing Applications; it is supported by many platforms including Java, MATLAB, Python, and R.",
        "Hierarchical Data Format (HDF), a set of file formats and libraries for storing and organizing large amounts of numerical data." .

EDAM:format_4002 a owl:Class ;
    rdfs:label "PKL",
        "pkl" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum,
        mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format used by Python's pickle module for serializing and de-serializing a Python object structure to and from a binary file.",
        "Format used by the Python pickle module for serializing and de-serializing a Python object structure to and from a byte stream." .

EDAM:format_4007 a owl:Class ;
    rdfs:label "MATLAB Script",
        "MATLAB script" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum,
        mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "File format for scripts or functions written in the MATLAB programming language.",
        "The file format for MATLAB scripts or functions, stored as plain text with a .m extension and executed within the MATLAB software environment." .

operation:3501 a owl:Class ;
    rdfs:label "Enrichment Analysis",
        "Gene Ontology Enrichment Analysis" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:ToolOperationEnum ;
    skos:definition "A statistical method that determines whether genes annotated with particular Gene Ontology (GO) terms are significantly over- or under-represented within a gene list of interest, relative to a background set." .

NCIT:C101294 a owl:Class ;
    rdfs:label "WGS",
        "Whole Genome Sequencing" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:NGSLibraryStrategyEnum ;
    skos:definition "A procedure that can determine the DNA sequence for nearly the entire genome of an individual.",
        "Random sequencing of the whole genome" .

NCIT:C101295 a owl:Class ;
    rdfs:label "WXS",
        "Whole Exome Sequencing" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:NGSLibraryStrategyEnum ;
    skos:definition "A procedure that can determine the DNA sequence for all of the exons in an individual.",
        "Random sequencing of exonic regions selected from the genome" .

NCIT:C106048 a owl:Class ;
    rdfs:label "ChIP",
        "ChIP-Seq" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "A molecular genetic technique that combines chromatin immunoprecipitation (ChIP) with massively parallel DNA sequencing to map the binding sites of DNA-associated proteins in a sample of cells. First, crosslinked protein-DNA complexes are isolated using ChIP. Next, the crosslinks are broken, the proteins are removed and the purified DNA is modified with adaptor oligonucleotides to facilitate massively parallel DNA sequencing. Following sequencing, the DNA sequences that are obtained can be mapped to their genomic locations.",
        "Chromatin immunoprecipitation" .

NCIT:C106051 a owl:Class ;
    rdfs:label "FAIRE-Seq",
        "FAIRE-seq" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:NGSLibraryStrategyEnum ;
    skos:definition "A molecular genetic technique that depletes a biological sample of nucleosomal DNA and then subjects the non-nucleosome-associated DNA to next-generation sequencing. Since nucleosome disruption of chromatin is indicative of active sites of DNA transcription, this technique can isolate DNA sequences that are involved in transcriptional regulation. First, a sample is treated with formaldehyde to form DNA-protein crosslinks, followed by sample lysis and sonication. The processed sample is subjected to phenol/chloroform extraction and the DNA in the aqueous phase is analyzed using next-generation sequencing techniques.",
        "Formaldehyde Assisted Isolation of Regulatory Elements. reveals regions of open chromatin" .

NCIT:C106052 a owl:Class ;
    rdfs:label "DNase-Hypersensitivity",
        "DNase-Seq" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:NGSLibraryStrategyEnum ;
    skos:definition "A molecular genetic technique where genome-wide sequencing is performed on DNA regions that are super sensitive to cleavage by DNase I to identify putative DNA regulatory sequences.",
        "Sequencing of hypersensitive sites, or segments of open chromatin that are more readily cleaved by DNaseI" .

NCIT:C106054 a owl:Class ;
    rdfs:label "Bisulfite Sequencing",
        "Bisulfite-Seq" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:NGSLibraryStrategyEnum ;
    skos:definition "A DNA sequencing technique that can differentiate cytosine from 5-methylcytosine in a DNA sample. First, a denatured DNA sample is treated with bisulfite which converts non-methylated cytosine to uracil. Next, the sample is amplified using a PCR method that does not discriminate between non-methylated and methylated sequences. The amplified DNA is subjected to nucleotide sequencing. The resulting sequence is compared to an identical control sample of DNA that was not treated with bisulfite. Unmethylated cytosines will be displayed as cytosines in the control sample and as thymines in the bisulfite-treated sample.",
        "Sequencing following treatment of DNA with bisulfite to convert cytosine residues to uracil depending on methylation status" .

NCIT:C123891 a owl:Class ;
    rdfs:label "GCT",
        "Gene Cluster Format" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum,
        mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "A tab-delimited matrix file format that describes a gene expression dataset, where columns correspond to samples/profiles, rows correspond to genes, and cell values correspond to expression measurements.",
        "A tab-delimited, matrix file text format that describes a gene expression dataset; the columns of the matrix correspond to profiles/samples, the rows correspond to genes, and the values of the cells correspond to an expression measurement." .

NCIT:C124261 a owl:Class ;
    rdfs:label "RNA Sequencing",
        "RNA-Seq" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:NGSLibraryStrategyEnum ;
    skos:definition "A procedure that can determine the RNA sequences for all or part of the poly-A tail-containing messenger RNA transcripts in an individual.",
        "Random sequencing of whole transcriptome" .

NCIT:C153598 a owl:Class ;
    rdfs:label "DNA Sequencing",
        "DNA-Seq" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:NGSLibraryStrategyEnum ;
    skos:definition "The determination of the sequence of purine and pyrimidine bases in a strand of DNA.",
        "The determination of the sequence of purines and pyrimidines in deoxyribonucleic acid (DNA)." .

NCIT:C156056 a owl:Class ;
    rdfs:label "ATAC-Seq",
        "ATAC-seq" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:NGSLibraryStrategyEnum ;
    skos:definition "A molecular genetic technique that isolates and sequences chromosomal regions that are rich in open chromatin. First, nuclei are harvested from a cellular sample. Then a hyperactive Tn5 transposase is added to the nuclei where it excises non-nucleosomal DNA strands and ligates co-administered high-throughput sequencing adapters (tagmentation).  The tagged DNA fragments are isolated, amplified by PCR and sequenced. The number of reads for specific region of DNA correlate with increased chromatin accessibility and this method can identify regions of transcription factor and nucleosome binding.",
        "Assay for Transposase-Accessible Chromatin (ATAC) strategy is used to study genome-wide chromatin accessibility. alternative method to DNase-seq that uses an engineered Tn5 transposase to cleave DNA and to integrate primer DNA sequences into the cleaved genomic DNA" .

NCIT:C156057 a owl:Class ;
    rdfs:label "MicroRNA Sequencing",
        "miRNA-Seq" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:NGSLibraryStrategyEnum ;
    skos:definition "A next-generation or massively parallel high-throughput DNA sequencing-based procedure that can identify and quantify the microRNA sequences present in a biological sample.",
        "Random sequencing of small miRNAs" .

NCIT:C167284 a owl:Class ;
    rdfs:label "Reduced Representation",
        "Reduced Representation Bisulfite Sequencing" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "A DNA sequencing technique that can differentiate cytosine from 5-methylcytosine in a DNA sample. First, a denatured DNA sample is treated with bisulfite which converts non-methylated cytosine to uracil. Next, the sample is amplified using a PCR method that does not discriminate between non-methylated and methylated sequences. The amplified DNA is subjected to nucleotide sequencing. The resulting sequence is compared to an identical control sample of DNA that was not treated with bisulfite. Unmethylated cytosines will be displayed as cytosines in the control sample and as thymines in the bisulfite-treated sample.",
        "Reproducible genomic subsets, often generated by restriction fragment size selection, containing a manageable number of loci to facilitate re-sampling" .

NCIT:C172215 a owl:Class ;
    rdfs:label "MAF",
        "maf" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum,
        mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "A tab-delimited text file containing mutation information aggregated across a set of variant call files (VCF).",
        "Mutation Annotation Format (MAF), a tab-delimited text file that aggregates mutation/variant information across a set of samples from one or more VCF files, commonly used in cancer genomics." .

NCIT:C172845 a owl:Class ;
    rdfs:label "ChIA-PET" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:NGSLibraryStrategyEnum ;
    skos:definition "A molecular genetic technique that combines chromatin immunoprecipitation (ChIP) with paired end tagged (PET) DNA sequencing to identify the nucleotide sequences for the binding sites occupied by DNA-associated proteins in a sample.",
        "Direct sequencing of proximity-ligated chromatin immunoprecipitates." .

NCIT:C18136 a owl:Class ;
    rdfs:label "RT-PCR" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "Polymerase chain reaction that uses two sets of primers, in two sequential runs of amplification, with the second set intended to amplify a target within the first run product.",
        "Source material was selected by reverse transcription PCR" .

NCIT:C181927 a owl:Class ;
    rdfs:label "Multiplexed Immunohistochemistry",
        "mIHC" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:ImageAssayTypeEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A method that enables simultaneous detection of multiple biomarkers on a single tissue section using immunohistochemistry techniques.",
        "Multiplexed Immunohistochemistry (mIHC): a method that enables simultaneous detection of multiple biomarkers on a single tissue section using immunohistochemistry techniques." .

NCIT:C181928 a owl:Class ;
    rdfs:label "Multiplexed Immunofluorescence",
        "MxIF" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:ImageAssayTypeEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A method that enables simultaneous detection of multiple biomarkers on a single tissue section using immunofluorescence techniques.",
        "Multiplexed Immunofluorescence (MxIF): a method that enables simultaneous detection of multiple biomarkers on a single tissue section using immunofluorescence techniques." .

NCIT:C181930 a owl:Class ;
    rdfs:label "MIBI",
        "Multiplexed Ion Beam Imaging" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:ImageAssayTypeEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A method for multiplexed immunohistochemistry that uses secondary ion mass spectrometry to image antibodies tagged with isotopically pure elemental metal reporters. Multiplexed ion beam imaging (MIBI) is capable of analyzing up to 100 targets simultaneously over a five-log dynamic range. This technique enables comprehensive phenotypic profiling and spatial analysis of the tissue microenvironment.",
        "Multiplexed Ion Beam Imaging (MIBI): a method for multiplexed immunohistochemistry that uses secondary ion mass spectrometry to image antibodies tagged with isotopically pure elemental metal reporters, capable of analyzing up to 100 targets simultaneously over a five-log dynamic range." .

NCIT:C181931 a owl:Class ;
    rdfs:label "CODEX" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:ImageAssayTypeEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A highly multiplexed cytometric imaging approach that iteratively visualizes many protein targets in a single tissue staining reaction.",
        "CO-Detection by indEXing (CODEX): a highly multiplexed cytometric imaging approach used to create multiplexed datasets from a single tissue staining reaction. CODEX iteratively visualizes antibody binding events using DNA barcodes, fluorescent dNTP analogs, and an in situ polymerization-based indexing procedure." .

NCIT:C182027 a owl:Class ;
    rdfs:label "IMC",
        "Imaging Mass Cytometry" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:ImageAssayTypeEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A method that combines laser ablation of tissue specimens with mass spectrometry to image antibodies tagged with isotopically pure metals, enabling highly multiplexed spatial protein detection.",
        "Imaging Mass Cytometry (IMC): a method that combines laser ablation of tissue specimens with secondary ion mass spectrometry to image antibodies tagged with isotopically pure elemental metal reporters, allowing in situ characterization of the specimen while preserving its tissue architecture and cellular morphology." .

NCIT:C190178 a owl:Class ;
    rdfs:label "MAT" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum,
        mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "A proprietary, binary data container format used by MATLAB software to store workspace variables." .

NCIT:C209895 a owl:Class ;
    rdfs:label "RDS" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum,
        mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "A native binary file format used by R to save and load a single serialized R object to and from a file.",
        "A native binary file format used to save and load single R objects to and from a file." .

NCIT:C23011 a owl:Class ;
    rdfs:label "H&E",
        "Hematoxylin and Eosin Staining Method" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:ImageAssayTypeEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "Hematoxylin and Eosin (H&E) staining: a routine histological staining method using two dyes, hematoxylin, which stains cell nuclei a dark purplish color, and eosin, which stains cytoplasm and connective tissue an orangish-pink color.",
        "Hematoxylin-and-eosin, or H&E, is a routine staining procedure of tissue sections. This staining method uses two separate dyes, one staining the nucleus and the other staining the cytoplasm and connective tissue. Hematoxylin is a dark purplish dye that stains the chromatin (nuclear material) within the nucleus. Eosin is an orangish-pink to red dye that stains the cytoplasmic material including connective tissue and collagen." .

NCIT:C2917 a owl:Class ;
    rdfs:label "Carcinoma In Situ",
        "Premalignant - in situ" ;
    rdfs:subClassOf mc2:BiospecimenCompositionEnum,
        mc2:DSPDatasetTumorTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A malignant epithelial neoplasm which is confined to the epithelial layer without evidence of further tissue invasion.",
        "A neoplasm in which the malignant cells are confined to the epithelium of origin, without invasion of the basement membrane." .

NCIT:C3055 a owl:Class ;
    rdfs:label "Giant Cell Tumor",
        "Giant Cell Tumors" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:DiseaseTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A benign, intermediate, or malignant tumor that arises from the bone or soft tissue. It is characterized by the presence of multinucleated osteoclast-like giant cells.",
        "A neoplasm characterized by the presence of multinucleated giant cells intermixed with mononuclear stromal cells." .

NCIT:C3059 a owl:Class ;
    rdfs:label "Glioma",
        "Gliomas" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:DiseaseTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A general term for tumors of the central nervous system, including astrocytomas, ependymal tumors, glioblastoma multiforme, and primitive neuroectodermal tumors.",
        "A neoplasm arising from glial cells of the central nervous system, including astrocytes, oligodendrocytes, and ependymal cells." .

NCIT:C3161 a owl:Class ;
    rdfs:label "Leukemia",
        "Leukemias" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:DiseaseTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A malignant clonal hematologic disorder involving hematopoietic stem cells, characterized by the presence of primitive or atypical myeloid or lymphoid cells in the bone marrow and blood.",
        "Cancer that starts in blood-forming tissue such as the bone marrow and causes large numbers of blood cells to be produced and enter the bloodstream." .

NCIT:C3230 a owl:Class ;
    rdfs:label "Meningioma",
        "Meningiomas" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:DiseaseTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A usually benign neoplasm arising from the meninges, the membranes that cover and protect the brain and spinal cord.",
        "A usually benign tumor that develops in the meninges." .

NCIT:C3784 a owl:Class ;
    rdfs:label "Basal Cell Neoplasm",
        "Basal Cell Neoplasms" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:DiseaseTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A neoplastic proliferation of basal cells in the epidermis (part of the skin) or other anatomic sites (most frequently the salivary glands).  The basal cell neoplastic proliferation in the epidermis results in basal cell carcinomas.  The basal cell neoplastic proliferation in the salivary glands can be benign, resulting in basal cell adenomas or malignant, resulting in basal cell adenocarcinomas.",
        "A neoplastic proliferation of basal cells in the epidermis or other anatomic sites (most frequently the salivary glands); the epidermal proliferation results in basal cell carcinomas, while the salivary gland proliferation can be benign (basal cell adenoma) or malignant (basal cell adenocarcinoma)." .

NCIT:C3787 a owl:Class ;
    rdfs:label "Neuroepithelial Neoplasm",
        "Neuroepitheliomatous Neoplasms" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:DiseaseTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A neoplasm of the nervous system that arises from the neuroepithelial tissues.  Representative examples include astrocytic tumors, oligodendroglial tumors, ependymal tumors, and primitive neuroectodermal tumors.",
        "A neoplasm of the nervous system that arises from the neuroepithelial tissues. Representative examples include astrocytic tumors, oligodendroglial tumors, ependymal tumors, and primitive neuroectodermal tumors." .

NCIT:C7388 a owl:Class ;
    rdfs:label "Blood Vessel Tumors",
        "Vascular Neoplasm" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum,
        mc2:DiseaseTypeEnum,
        mc2:ManifestationEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A benign, intermediate, or malignant neoplasm arising from vascular tissue including arteries, veins, venous sinuses, lymphatic vessels, arterioles and capillaries. It may occur in essentially any body location and is characterized by the presence of vascular channel formation and endothelial cells.",
        "An ICD-O-3 morphology category comprising benign and malignant neoplasms that arise from blood vessels, such as hemangioma, hemangioendothelioma, and angiosarcoma." .

OBI:0000327 a owl:Class ;
    rdfs:label "FCS" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum,
        mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "FCS (Flow Cytometry Standard) is a binary file format standardized by the International Society for Advancement of Cytometry for storing list-mode flow cytometry data, including per-event fluorescence and light-scatter measurements plus instrument and acquisition metadata.",
        "Flow Cytometry Standard (FCS), the standard binary file format for storing multiparameter flow or mass cytometry data produced by cytometry instruments." .

EFO:0008722 a owl:Class ;
    rdfs:label "Drop-Seq",
        "Drop-seq" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:VisiumSpatialLibraryConstructionMethodEnum ;
    skos:definition "A molecular genetic technique that combines chromatin immunoprecipitation (ChIP) with massively parallel DNA sequencing to map the binding sites of DNA-associated proteins in a sample of cells. First, crosslinked protein-DNA complexes are isolated using ChIP. Next, the crosslinks are broken, the proteins are removed and the purified DNA is modified with adaptor oligonucleotides to facilitate massively parallel DNA sequencing. Following sequencing, the DNA sequences that are obtained can be mapped to their genomic locations.",
        "Droplet microfluidics-based method for parallel analysis of mRNA transcripts from thousands of individual cells, in which each cell is co-encapsulated with a barcoded bead in a nanoliter droplet." .

mc2:DSPDatasetLevelEnum a owl:Class ;
    rdfs:label "DSP Dataset Level Enum" ;
    owl:unionOf ( NCIT:C142663 <https://w3id.org/mc2-center/mc2-model/DSPDatasetLevelEnum#Level%202> <https://w3id.org/mc2-center/mc2-model/DSPDatasetLevelEnum#Level%203> <https://w3id.org/mc2-center/mc2-model/DSPDatasetLevelEnum#Level%204> <https://w3id.org/mc2-center/mc2-model/DSPDatasetLevelEnum#Auxiliary> NCIT:C48660 NCIT:C52095 ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values NCIT:C142663,
        NCIT:C48660,
        NCIT:C52095,
        <https://w3id.org/mc2-center/mc2-model/DSPDatasetLevelEnum#Auxiliary>,
        <https://w3id.org/mc2-center/mc2-model/DSPDatasetLevelEnum#Level%202>,
        <https://w3id.org/mc2-center/mc2-model/DSPDatasetLevelEnum#Level%203>,
        <https://w3id.org/mc2-center/mc2-model/DSPDatasetLevelEnum#Level%204> .

mc2:DataTypeEnum a owl:Class ;
    rdfs:label "dataType Enum" ;
    owl:unionOf ( <https://w3id.org/mc2-center/mc2-model/DataTypeEnum#gene%20expression> <https://w3id.org/mc2-center/mc2-model/DataTypeEnum#chromatin%20activity> <https://w3id.org/mc2-center/mc2-model/DataTypeEnum#genomic%20variants> <https://w3id.org/mc2-center/mc2-model/DataTypeEnum#immunoassay> <https://w3id.org/mc2-center/mc2-model/DataTypeEnum#network> <https://w3id.org/mc2-center/mc2-model/DataTypeEnum#nucleic%20acid%20sequence%20record> <https://w3id.org/mc2-center/mc2-model/DataTypeEnum#image> ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values <https://w3id.org/mc2-center/mc2-model/DataTypeEnum#chromatin%20activity>,
        <https://w3id.org/mc2-center/mc2-model/DataTypeEnum#gene%20expression>,
        <https://w3id.org/mc2-center/mc2-model/DataTypeEnum#genomic%20variants>,
        <https://w3id.org/mc2-center/mc2-model/DataTypeEnum#image>,
        <https://w3id.org/mc2-center/mc2-model/DataTypeEnum#immunoassay>,
        <https://w3id.org/mc2-center/mc2-model/DataTypeEnum#network>,
        <https://w3id.org/mc2-center/mc2-model/DataTypeEnum#nucleic%20acid%20sequence%20record> .

mc2:FileLevelEnum a owl:Class ;
    rdfs:label "File Level Enum" ;
    owl:unionOf ( NCIT:C142663 <https://w3id.org/mc2-center/mc2-model/FileLevelEnum#Level%202> <https://w3id.org/mc2-center/mc2-model/FileLevelEnum#Level%203> <https://w3id.org/mc2-center/mc2-model/FileLevelEnum#Level%204> <https://w3id.org/mc2-center/mc2-model/FileLevelEnum#Auxiliary> NCIT:C48660 NCIT:C52095 ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values NCIT:C142663,
        NCIT:C48660,
        NCIT:C52095,
        <https://w3id.org/mc2-center/mc2-model/FileLevelEnum#Auxiliary>,
        <https://w3id.org/mc2-center/mc2-model/FileLevelEnum#Level%202>,
        <https://w3id.org/mc2-center/mc2-model/FileLevelEnum#Level%203>,
        <https://w3id.org/mc2-center/mc2-model/FileLevelEnum#Level%204> .

mc2:IndividualDiseaseProgressionOrRecurrenceTypeEnum a owl:Class ;
    rdfs:label "Individual Disease Progression or Recurrence Type Enum" ;
    owl:unionOf ( <https://w3id.org/mc2-center/mc2-model/IndividualDiseaseProgressionOrRecurrenceTypeEnum#Not%20Reported> <https://w3id.org/mc2-center/mc2-model/IndividualDiseaseProgressionOrRecurrenceTypeEnum#Unknown> <https://w3id.org/mc2-center/mc2-model/IndividualDiseaseProgressionOrRecurrenceTypeEnum#Regional> <https://w3id.org/mc2-center/mc2-model/IndividualDiseaseProgressionOrRecurrenceTypeEnum#Local> <https://w3id.org/mc2-center/mc2-model/IndividualDiseaseProgressionOrRecurrenceTypeEnum#Biochemical> <https://w3id.org/mc2-center/mc2-model/IndividualDiseaseProgressionOrRecurrenceTypeEnum#Distant> <https://w3id.org/mc2-center/mc2-model/IndividualDiseaseProgressionOrRecurrenceTypeEnum#Locoregional> ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values <https://w3id.org/mc2-center/mc2-model/IndividualDiseaseProgressionOrRecurrenceTypeEnum#Biochemical>,
        <https://w3id.org/mc2-center/mc2-model/IndividualDiseaseProgressionOrRecurrenceTypeEnum#Distant>,
        <https://w3id.org/mc2-center/mc2-model/IndividualDiseaseProgressionOrRecurrenceTypeEnum#Local>,
        <https://w3id.org/mc2-center/mc2-model/IndividualDiseaseProgressionOrRecurrenceTypeEnum#Locoregional>,
        <https://w3id.org/mc2-center/mc2-model/IndividualDiseaseProgressionOrRecurrenceTypeEnum#Not%20Reported>,
        <https://w3id.org/mc2-center/mc2-model/IndividualDiseaseProgressionOrRecurrenceTypeEnum#Regional>,
        <https://w3id.org/mc2-center/mc2-model/IndividualDiseaseProgressionOrRecurrenceTypeEnum#Unknown> .

mc2:IndividualRecurrenceStatusEnum a owl:Class ;
    rdfs:label "Individual Recurrence Status Enum" ;
    owl:unionOf ( NCIT:C49488 NCIT:C17998 NCIT:C43234 NCIT:C48660 NCIT:C141478 NCIT:C49487 NCIT:C118962 ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values NCIT:C118962,
        NCIT:C141478,
        NCIT:C17998,
        NCIT:C43234,
        NCIT:C48660,
        NCIT:C49487,
        NCIT:C49488 .

mc2:IndividualTreatmentIntentTypeEnum a owl:Class ;
    rdfs:label "Individual Treatment Intent Type Enum" ;
    owl:unionOf ( <https://w3id.org/mc2-center/mc2-model/IndividualTreatmentIntentTypeEnum#Unknown> <https://w3id.org/mc2-center/mc2-model/IndividualTreatmentIntentTypeEnum#Prevention> <https://w3id.org/mc2-center/mc2-model/IndividualTreatmentIntentTypeEnum#Palliative> <https://w3id.org/mc2-center/mc2-model/IndividualTreatmentIntentTypeEnum#Neoadjuvant> <https://w3id.org/mc2-center/mc2-model/IndividualTreatmentIntentTypeEnum#Maintenance> <https://w3id.org/mc2-center/mc2-model/IndividualTreatmentIntentTypeEnum#Curative> <https://w3id.org/mc2-center/mc2-model/IndividualTreatmentIntentTypeEnum#Adjuvant> ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values <https://w3id.org/mc2-center/mc2-model/IndividualTreatmentIntentTypeEnum#Adjuvant>,
        <https://w3id.org/mc2-center/mc2-model/IndividualTreatmentIntentTypeEnum#Curative>,
        <https://w3id.org/mc2-center/mc2-model/IndividualTreatmentIntentTypeEnum#Maintenance>,
        <https://w3id.org/mc2-center/mc2-model/IndividualTreatmentIntentTypeEnum#Neoadjuvant>,
        <https://w3id.org/mc2-center/mc2-model/IndividualTreatmentIntentTypeEnum#Palliative>,
        <https://w3id.org/mc2-center/mc2-model/IndividualTreatmentIntentTypeEnum#Prevention>,
        <https://w3id.org/mc2-center/mc2-model/IndividualTreatmentIntentTypeEnum#Unknown> .

mc2:NGS_Library_Preparation_Days_from_Index a owl:DatatypeProperty ;
    rdfs:label "NGS Library Preparation Days from Index" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "\\d+$|Not\\sApplicable$|unknown$" ] ) ] ;
    skos:definition "Number of days between sample for assay was received in lab and the libraries were prepared for sequencing [number]. If not applicable please enter 'Not Applicable'" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:NGS_Sequencing_Library_Construction_Days_from_Index a owl:DatatypeProperty ;
    rdfs:label "NGS Sequencing Library Construction Days from Index" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "\\d+$|Not\\sApplicable$|unknown$" ] ) ] ;
    skos:definition "Number of days between sample for assay was received in lab and day of sequencing library construction [number]. If not applicable please enter 'Not Applicable'" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

