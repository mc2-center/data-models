    skos:definition "Machine readable name of the research consortium. (e.g. sage_bionetworks, csbc_pson, etc.)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Consortium_id a owl:ObjectProperty ;
    rdfs:label "Consortium_id" ;
