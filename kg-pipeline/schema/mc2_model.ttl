    rdfs:label "Probability Map" ;
    rdfs:subClassOf mc2:ImageSegmentationDataTypeEnum ;
    skos:definition "A segmentation output in which each pixel is assigned a continuous value representing the estimated probability that it belongs to a given object class, typically produced by a probabilistic or machine-learning-based segmentation algorithm rather than a binary mask." .

mc2:Image_Number_of_Objects a owl:DatatypeProperty ;
    rdfs:label "Image Number of Objects" ;
    rdfs:range xsd:float ;
    skos:definition "The number of objects (eg cells) described" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Object_Class a owl:ObjectProperty ;
    rdfs:label "Image Object Class" ;
    rdfs:range mc2:ImageObjectClassEnum ;
    skos:definition "Defines the structure that the mask delineates" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Parameter_file a owl:DatatypeProperty ;
    rdfs:label "Image Parameter file" ;
    skos:definition "Path in Synapse to a text file listing algorithm version numbers and relevant parameters needed to reproduce the analysis" ;
