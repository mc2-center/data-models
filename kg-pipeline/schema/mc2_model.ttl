        mc2:FileSpeciesEnum,
        mc2:ModelSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "Various members of the family Leporidae, especially those of the genus Sylvilagus." .

NCIT:C14273 a owl:Class ;
    rdfs:label "Sheep" ;
    rdfs:subClassOf mc2:BiospecimenSpeciesEnum,
        mc2:DSPDatasetSpeciesEnum,
