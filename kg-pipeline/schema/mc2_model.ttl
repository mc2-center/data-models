        mc2:DatasetSpeciesEnum,
        mc2:FileSpeciesEnum,
        mc2:ModelSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "The bipedal primate mammal, Homo sapiens; belonging to man or mankind; pertaining to man or to the race of man; use of man as experimental subject or unit of analysis in research." .

NCIT:C14233 a owl:Class ;
    rdfs:label "Rhesus monkey" ;
    rdfs:subClassOf mc2:BiospecimenSpeciesEnum,
        mc2:DSPDatasetSpeciesEnum,
        mc2:DatasetSpeciesEnum,
        mc2:FileSpeciesEnum,
        mc2:ModelSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "A pale brown macaque (Macaca mulatta) native to India, China, and other parts of Asia, often used in medical research owing to its relative ease of upkeep and physiological similarity to humans." .

NCIT:C14238 a owl:Class ;
