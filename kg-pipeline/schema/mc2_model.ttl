mc2:GrantView_Key a owl:DatatypeProperty ;
    rdfs:label "GrantView Key" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "CA\\d{6}" ] ) ] ;
    skos:definition "Unique GrantView_id foreign key(s) that group the resource with other components, as part of the same grant-associated collection. Please provide multiple values as a comma-separated list." ;
