    rdfs:subClassOf mc2:ModelPrimaryDiagnosisEnum .

<https://w3id.org/mc2-center/mc2-model/ModelPrimaryDiagnosisEnum#Acute%20Megakaryoblastic%20Leukemia> a owl:Class ;
    rdfs:label "Acute Megakaryoblastic Leukemia" ;
    rdfs:subClassOf mc2:ModelPrimaryDiagnosisEnum .

<https://w3id.org/mc2-center/mc2-model/ModelPrimaryDiagnosisEnum#Acute%20Monoblastic%20And%20Monocytic%20Leukemia> a owl:Class ;
    rdfs:label "Acute Monoblastic And Monocytic Leukemia" ;
    rdfs:subClassOf mc2:ModelPrimaryDiagnosisEnum .

<https://w3id.org/mc2-center/mc2-model/ModelPrimaryDiagnosisEnum#Acute%20Monoblastic%20Leukemia> a owl:Class ;
    rdfs:label "Acute Monoblastic Leukemia" ;
    rdfs:subClassOf mc2:ModelPrimaryDiagnosisEnum .

<https://w3id.org/mc2-center/mc2-model/ModelPrimaryDiagnosisEnum#Acute%20Monocytic%20Leukemia> a owl:Class ;
    rdfs:label "Acute Monocytic Leukemia" ;
    rdfs:subClassOf mc2:ModelPrimaryDiagnosisEnum .

