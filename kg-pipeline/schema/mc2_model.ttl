            owl:maxCardinality 1 ;
            owl:onProperty mc2:DatasetView_Key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Longitudinal_Time_Elapsed_Unit ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:File_Format ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "-B\\d{1,9}" ] ) ] ;
            owl:onProperty mc2:Biospecimen_Key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Study_Key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Longitudinal_Total_Time_Elapsed ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Data_Checksum_Value ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:FileView_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Species ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Data_Size ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Longitudinal_Sequence_Identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Filename ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Data_Compression_Status ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^syn\\d{7,8}$" ] ) ] ;
            owl:onProperty mc2:FileView_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Data_Checksum_Type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Data_Category ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:File_Alias ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Biospecimen_Key ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:File_Level ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Longitudinal_Event_Type ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:File_Url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Design ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Longitudinal_Group ] ;
    skos:definition "The denormalized manifest for file submission." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:File_Anatomic_Site a owl:DatatypeProperty ;
    rdfs:label "File Anatomic Site" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^UBERON:\\d+$" ] ) ] ;
    skos:definition "The UBERON identifier of the anatomic site associated with the data contained in this file (see https://www.ebi.ac.uk/ols4/ontologies/uberon). Reference-validated, not a fixed list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "14156279" .

mc2:File_Longitudinal_Sequential_Time_Elapsed a owl:DatatypeProperty ;
    rdfs:label "File Longitudinal Sequential Time Elapsed" ;
    rdfs:range xsd:float ;
    skos:definition "The time elapsed between collecting the current and previous files in this longitudinal group." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_Biological_probe_median a owl:DatatypeProperty ;
    rdfs:label "GeoMx Biological probe median" ;
    rdfs:range xsd:float ;
    skos:definition "Is the median count from all probes except the negative control probes. A measure of signal to background for each segment" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_Imaging_AOI_Coordinates a owl:DatatypeProperty ;
    rdfs:label "GeoMx Imaging AOI Coordinates" ;
    skos:definition "Synapse Id(s) of tabular file(s) containing coordinate points for AOIs found in the image; multiple values should be provided as a comma-separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_Imaging_Channel_Names a owl:DatatypeProperty ;
    rdfs:label "GeoMx Imaging Channel Names" ;
    skos:definition "Name(s) of imaging channel(s) associated with the image; multiple values should be provided as a comma-separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_In_Situ_Negative_median a owl:DatatypeProperty ;
    rdfs:label "GeoMx In Situ Negative median" ;
    rdfs:range xsd:float ;
    skos:definition "Is the median of all negative control probes for a given segment. A measure of signal to background for each segment." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_QC_status a owl:DatatypeProperty ;
    rdfs:label "GeoMx QC status" ;
    skos:definition "ROI quality control flag as reported by the application" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_Sequencing_Saturation a owl:DatatypeProperty ;
    rdfs:label "GeoMx Sequencing Saturation" ;
    rdfs:range xsd:float ;
    skos:definition "The fraction of reads originating from an already-observed UMI. This is a function of library complexity and sequencing depth. More specifically, this is the fraction of confidently mapped, valid spot-barcode, valid UMI reads that had a non-unique (spot-barcode, UMI, gene)." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

