    skos:definition "The species the data was collected on. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Dataset_Url a owl:DatatypeProperty ;
    rdfs:label "Dataset Url" ;
    skos:definition "The url of where the dataset is stored." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
