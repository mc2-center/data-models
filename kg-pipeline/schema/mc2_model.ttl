    mc2:foreign_key true .

mc2:PersonView a owl:Class ;
    rdfs:label "Person View" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Consortium_Key ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Consent_For_Portal_Display ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Working_Group_Participation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Institution_Key ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Chair_Roles ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:PersonView_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Orcid_Id ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "CA\\d{6}" ] ) ] ;
            owl:onProperty mc2:GrantView_Key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Synapse_Profile_Id ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Last_Known_Institution ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Person_Consortium_Name ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Portal_Display ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Url ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "\\d{4}\\-\\d{4}\\-\\d{4}\\-\\d{3}(\\d|X)" ] ) ] ;
            owl:onProperty mc2:Orcid_Id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Email ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:GrantView_Key ] ;
    skos:definition "The denormalized manifest for person submission." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Person_Datasets a owl:DatatypeProperty ;
    rdfs:label "Person Datasets" ;
    skos:definition "A list of the dataset aliases (An alias of the dataset must be unique. Can be the GEO identifier such as GSE12345, or a DOI. No Greek Letters) associated with the person. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Person_Educational_Resources a owl:DatatypeProperty ;
    rdfs:label "Person Educational Resources" ;
    skos:definition "A list of educational resource identifiers associated with the person. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Person_Grant_Number a owl:ObjectProperty ;
    rdfs:label "Person Grant Number" ;
    rdfs:range mc2:PersonGrantNumberEnum ;
    skos:definition "Grant number(s) associated with the person. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Person_Publications a owl:DatatypeProperty ;
    rdfs:label "Person Publications" ;
    skos:definition "A list of the pubmed Ids associated with the person. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Person_Tools a owl:DatatypeProperty ;
    rdfs:label "Person Tools" ;
    skos:definition "A list of the tool names associated with the person. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:ProjectView a owl:Class ;
    rdfs:label "Project View" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:GrantView_Key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:PersonView_Key ],
