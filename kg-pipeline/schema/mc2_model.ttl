        mc2:FileSpeciesEnum,
        mc2:ModelSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "Drosophila melanogaster, commonly known as the fruit fly, a small dipteran insect that has been extensively used in genetic and developmental biology studies." .

NCIT:C14206 a owl:Class ;
    rdfs:label "Escherichia coli" ;
    rdfs:subClassOf mc2:BiospecimenSpeciesEnum,
        mc2:DSPDatasetSpeciesEnum,
        mc2:DatasetSpeciesEnum,
        mc2:FileSpeciesEnum,
        mc2:ModelSpeciesEnum,
        mc2:SpeciesEnum ;
    skos:definition "A common, gram negative gut bacterium that has been studied intensively by geneticists because of its small genome size, normal lack of pathogenicity, and ease of growth in the laboratory." .

NCIT:C14211 a owl:Class ;
    rdfs:label "Guinea Pig" ;
