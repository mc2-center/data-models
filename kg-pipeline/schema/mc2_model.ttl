        <https://w3id.org/mc2-center/mc2-model/ToolCostEnum#Free%20of%20Charge%20%28With%20Restrictions%29> .

mc2:ToolOperatingSystemEnum a owl:Class ;
    rdfs:label "Tool Operating System Enum" ;
    owl:unionOf ( SWO:0000022 SWO:0000151 SWO:9000072 ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values SWO:0000022,
        SWO:0000151,
        SWO:9000072 .

mc2:Visium_Capture_Area a owl:ObjectProperty ;
    rdfs:label "Visium Capture Area" ;
    rdfs:range mc2:VisiumCaptureAreaEnum ;
    skos:definition "Area (or Capture Area) - One of the either four or two active regions where tissue can be placed on a Visium slide. Each area is intended to contain only one tissue sample. Slide areas are named consecutively from top to bottom: A1, B1, C1, D1 for Visium slides with 6.5 mm Capture Area and A, B for CytAssist slides with 11 mm Capture Area. Both CytAssist slides with 6.5 mm Capture Area and Gateway Slides contain only two slide areas, A1 and D1." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    skos:note "Source: HTAN" .

mc2:Workflow_Version a owl:DatatypeProperty ;
    rdfs:label "Workflow Version" ;
    skos:definition "Major version of the workflow (e.g. Cell Ranger v3.1)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

DUO:0000007 a owl:Class ;
    rdfs:label "DUO:0000007" ;
    rdfs:subClassOf mc2:DataUseModifiersEnum,
        mc2:StudyDataUseCodesEnum ;
    skos:definition "This data use permission indicates that use is allowed provided it is related to the specified disease. If providing this term, please provide the disease MONDO ID(s) in column diseaseSpecificResearch." .

DUO:0000012 a owl:Class ;
    rdfs:label "DUO:0000012" ;
    rdfs:subClassOf mc2:DataUseModifiersEnum,
        mc2:StudyDataUseCodesEnum ;
    skos:definition "This data use modifier indicates that use is limited to studies of a certain research type. If providing this term, please note the research type(s) in column researchSpecificRestrictions." .

DUO:0000020 a owl:Class ;
    rdfs:label "DUO:0000020" ;
    rdfs:subClassOf mc2:DataUseModifiersEnum,
        mc2:StudyDataUseCodesEnum ;
    skos:definition "This data use modifier indicates that the requestor must agree to collaboration with the primary study investigator(s). If providing this term, please note the contact email in column collaborationRequired." .

DUO:0000022 a owl:Class ;
    rdfs:label "DUO:0000022" ;
    rdfs:subClassOf mc2:DataUseModifiersEnum,
        mc2:StudyDataUseCodesEnum ;
    skos:definition "This data use modifier indicates that use is limited to within a specific geographic region. If providing this term, please provide the applicable country code(s) in column geographicalRestriction." .

DUO:0000024 a owl:Class ;
    rdfs:label "DUO:0000024" ;
    rdfs:subClassOf mc2:DataUseModifiersEnum,
        mc2:StudyDataUseCodesEnum ;
    skos:definition "This data use modifier indicates that requestor agrees not to publish results of studies until a specific date. If providing this term, please provide the date in column publicationMoratorium." .

DUO:0000025 a owl:Class ;
    rdfs:label "DUO:0000025" ;
    rdfs:subClassOf mc2:DataUseModifiersEnum,
        mc2:StudyDataUseCodesEnum ;
    skos:definition "This data use modifier indicates that use is approved for a specific number of months. If providing this term, please provide the number of months in column timeLimitOnUse." .

DUO:0000026 a owl:Class ;
    rdfs:label "DUO:0000026" ;
    rdfs:subClassOf mc2:DataUseModifiersEnum,
        mc2:StudyDataUseCodesEnum ;
    skos:definition "This data use modifier indicates that use is limited to use by approved users. If providing this term, please describe the restrictions in column userSpecificRestriction." .

DUO:0000028 a owl:Class ;
    rdfs:label "DUO:0000028" ;
    rdfs:subClassOf mc2:DataUseModifiersEnum,
        mc2:StudyDataUseCodesEnum ;
    skos:definition "This data use modifier indicates that use is limited to use within an approved institution. If providing this term, please provide the institution ROR ID(s) in column institutionSpecificRestriction." .

NCIT:C16475 a owl:Class ;
    rdfs:label "Cryopreservation in dry ice - dead tissue",
        "Cryopreservation in liquid nitrogen - dead tissue",
        "Cryopreservation in liquid nitrogen - live cells",
        "Cryopreserved" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMethodEnum ;
    skos:definition "Preservation of cells, tissues, organs, or embryos by storage at low temperatures." .

NCIT:C201930 a owl:Class ;
    rdfs:label "Random",
        "cDNA random priming" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum,
        mc2:NGSRNAReverseTranscriptionPrimerEnum ;
    skos:definition "A library selection method using random-sequence oligonucleotides to prime cDNA synthesis, allowing unbiased coverage of RNA transcripts including non-polyadenylated species.",
        "Random selection by shearing or other method",
        "Short oligonucleotides of random sequence that anneal throughout the length of RNA templates and are used to prime reverse transcription." .

NCIT:C36032 a owl:Class ;
    rdfs:label "Atypia or hyperplasia",
        "Premalignant",
        "Premalignant Neoplasm" ;
    rdfs:subClassOf mc2:BiospecimenCompositionEnum,
        mc2:BiospecimenPathologyEnum ;
    skos:definition "A lesion or cellular condition with the potential to develop into cancer.",
        "A pathological process that precedes and often leads to the development of cancer." .

NCIT:C38155 a owl:Class ;
    rdfs:label "Local recurrence",
        "Recurrence",
        "Recurrent" ;
    rdfs:subClassOf mc2:BiospecimenCompositionEnum,
        mc2:BiospecimenIncidenceTypeEnum ;
    skos:definition "The return of a disease after a period of remission." .

mc2:ChairRolesEnum a owl:Class ;
    rdfs:label "Chair Roles Enum" ;
    owl:unionOf ( <https://w3id.org/mc2-center/mc2-model/ChairRolesEnum#Annual%20Meeting> <https://w3id.org/mc2-center/mc2-model/ChairRolesEnum#None> <https://w3id.org/mc2-center/mc2-model/ChairRolesEnum#Steering%20Committee> <https://w3id.org/mc2-center/mc2-model/ChairRolesEnum#Working%20Group> ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
