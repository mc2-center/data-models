mc2:NGS_Raw_Reads a owl:DatatypeProperty ;
    rdfs:label "NGS Raw Reads" ;
    rdfs:range xsd:float ;
    skos:definition "Reads not yet analyzed in any way to be used for data analysis. The number of reads that pass filter from the flow cell represented in the FASTQ file." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "11529035" .

mc2:NGS_Sequencing_Platform a owl:ObjectProperty ;
    rdfs:label "NGS Sequencing Platform" ;
    rdfs:range mc2:NGSSequencingPlatformEnum ;
    skos:definition "A platform is an object aggregate that is the set of instruments and software needed to perform a process [OBI_0000050]. Specific model of the sequencing instrument." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "6352164" .

mc2:Workflow_Link a owl:DatatypeProperty ;
    rdfs:label "Workflow Link" ;
