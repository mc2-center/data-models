mc2:Collection_id a owl:DatatypeProperty ;
    rdfs:label "Collection_id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^C-\\d{2,9}$" ] ) ] ;
    skos:definition "Unique ID associated with a collection, used as a key for record linking and updates." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

<https://w3id.org/mc2-center/mc2-model/ConsentForPortalDisplayEnum#No> a owl:Class ;
    rdfs:label "No" ;
    rdfs:subClassOf mc2:ConsentForPortalDisplayEnum .

<https://w3id.org/mc2-center/mc2-model/ConsentForPortalDisplayEnum#Yes> a owl:Class ;
    rdfs:label "Yes" ;
    rdfs:subClassOf mc2:ConsentForPortalDisplayEnum .

<https://w3id.org/mc2-center/mc2-model/ConsortiumFundingAgencyEnum#NIH> a owl:Class ;
    rdfs:label "NIH" ;
    rdfs:subClassOf mc2:ConsortiumFundingAgencyEnum .

<https://w3id.org/mc2-center/mc2-model/ConsortiumFundingAgencyEnum#NIH-NCI> a owl:Class ;
    rdfs:label "NIH-NCI" ;
