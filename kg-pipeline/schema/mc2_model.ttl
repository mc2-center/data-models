    skos:definition "A molecular genetic technique that combines chromatin immunoprecipitation (ChIP) with massively parallel DNA sequencing to map the binding sites of DNA-associated proteins in a sample of cells. First, crosslinked protein-DNA complexes are isolated using ChIP. Next, the crosslinks are broken, the proteins are removed and the purified DNA is modified with adaptor oligonucleotides to facilitate massively parallel DNA sequencing. Following sequencing, the DNA sequences that are obtained can be mapped to their genomic locations." .

pmid:32868927 a owl:Class ;
    rdfs:label "scNT-Seq" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A molecular genetic technique that combines chromatin immunoprecipitation (ChIP) with massively parallel DNA sequencing to map the binding sites of DNA-associated proteins in a sample of cells. First, crosslinked protein-DNA complexes are isolated using ChIP. Next, the crosslinks are broken, the proteins are removed and the purified DNA is modified with adaptor oligonucleotides to facilitate massively parallel DNA sequencing. Following sequencing, the DNA sequences that are obtained can be mapped to their genomic locations." .

pmid:33188776 a owl:Class ;
    rdfs:label "DBiT-Seq" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "A molecular genetic technique that combines chromatin immunoprecipitation (ChIP) with massively parallel DNA sequencing to map the binding sites of DNA-associated proteins in a sample of cells. First, crosslinked protein-DNA complexes are isolated using ChIP. Next, the crosslinks are broken, the proteins are removed and the purified DNA is modified with adaptor oligonucleotides to facilitate massively parallel DNA sequencing. Following sequencing, the DNA sequences that are obtained can be mapped to their genomic locations." .

pmid:33960644 a owl:Class ;
    rdfs:label "Fluorescent Cell Barcoding" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An immunological procedure in which the antibodies are coupled with molecules which fluoresce under ultra violet (UV) light. This makes them particularly suitable for detection of specific antigens in tissues or on cells." .

pmid:3635273 a owl:Class ;
    rdfs:label "Stimulated Emission Depletion Microscopy" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "The use of various technologies to resolve the structure or features of objects too small or fine to naturally be seen by eye." .

pmid:4032528 a owl:Class ;
    rdfs:label "Co-culture Assay" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:MeasurementTechniqueEnum ;
    skos:definition "An assay in which two or more distinct cell types are cultured together to study their interactions." .

