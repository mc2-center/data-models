mc2:Publication_Dataset_Alias a owl:DatatypeProperty ;
    rdfs:label "Publication Dataset Alias" ;
    skos:definition "A list of the dataset aliases (An alias of the dataset must be unique. Can be the GEO identifier such as GSE12345, or a DOI. No Greek Letters) associated with the publication. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Publication_Grant_Number a owl:ObjectProperty ;
    rdfs:label "Publication Grant Number" ;
    rdfs:range mc2:PublicationGrantNumberEnum ;
    skos:definition "Relevant grant number associated witht the publication's development. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Publication_Keywords a owl:DatatypeProperty ;
    rdfs:label "Publication Keywords" ;
    skos:definition "Keywords associated with the publication. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Resource_Access_Hazard a owl:ObjectProperty ;
    rdfs:label "Resource Access Hazard" ;
    rdfs:range mc2:ResourceAccessHazardEnum ;
    skos:definition "Sensory hazards (Flashing, Motion, etc.) applicable to the item. Multiple values should be provided as a comma separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Resource_Dataset_Alias a owl:DatatypeProperty ;
    rdfs:label "Resource Dataset Alias" ;
    skos:definition "URL or persistent identifier (DOI, Synapse ID) for any dataset(s) that is intended to be used with the item. Multiple values should be provided as a comma separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Resource_Grant_Number a owl:ObjectProperty ;
    rdfs:label "Resource Grant Number" ;
    rdfs:range mc2:ResourceGrantNumberEnum ;
    skos:definition "The grant number(s) associated with the contributor(s) of the item. If no grant number listed is applicable, please select 'Affiliated/Non-Grant Associated'. Multiple values should be provided as a comma separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Resource_Internal_Identifier a owl:DatatypeProperty ;
    rdfs:label "Resource Internal Identifier" ;
    skos:definition "The institution-specific ID for the item, if applicable. May be non-unique. Multiple values should be provided as a comma separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Resource_License a owl:ObjectProperty ;
    rdfs:label "Resource License" ;
    rdfs:range mc2:ResourceLicenseEnum ;
    skos:definition "The name of the license applied to the item by the contributor(s), if applicable. Multiple values should be provided as a comma separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Resource_Media_Accessibility a owl:ObjectProperty ;
    rdfs:label "Resource Media Accessibility" ;
    rdfs:range mc2:ResourceMediaAccessibilityEnum ;
    skos:definition "Accessibility features (Alternative Text, Audio Description, etc.) incorporated into the item. Multiple values should be provided as a comma separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Resource_Secondary_Topic a owl:DatatypeProperty ;
    rdfs:label "Resource Secondary Topic" ;
    skos:definition "Additional topics or keywords to describe the content of the item, in addition to the primary topic. Multiple values should be provided as a comma-separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Resource_Tool_Link a owl:DatatypeProperty ;
    rdfs:label "Resource Tool Link" ;
    skos:definition "URL or persistent identifier (DOI, Synapse ID) for any software or tool that is intended to be used with the item. Multiple values should be provided as a comma separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

