        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Visium_Permeabilization_Time ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:DatasetView_Key ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "\\d+$|Not\\sApplicable$|unknown$" ] ) ] ;
            owl:onProperty mc2:NGS_Library_Preparation_Days_from_Index ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
