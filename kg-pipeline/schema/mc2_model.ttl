        NCIT:C48660,
        NCIT:C51944,
        EFO:0022998,
        EFO:0023019,
        EFO:0700006 .

NCIT:C3055 a owl:Class ;
    rdfs:label "Giant Cell Tumor",
        "Giant Cell Tumors" ;
    rdfs:subClassOf mc2:BiospecimenDiseaseTypeEnum,
        mc2:DSPDatasetTumorTypeEnum,
        mc2:DatasetTumorTypeEnum,
        mc2:FileTumorTypeEnum,
        mc2:IndividualDiseaseTypeEnum,
        mc2:ManifestationEnum,
        mc2:ModelDiseaseTypeEnum,
        mc2:PublicationTumorTypeEnum ;
    skos:definition "A benign, intermediate, or malignant tumor that arises from the bone or soft tissue. It is characterized by the presence of multinucleated osteoclast-like giant cells.",
        "A neoplasm characterized by the presence of multinucleated giant cells intermixed with mononuclear stromal cells." .

NCIT:C3059 a owl:Class ;
    rdfs:label "Glioma",
        "Gliomas" ;
    rdfs:subClassOf mc2:BiospecimenDiseaseTypeEnum,
        mc2:DSPDatasetTumorTypeEnum,
        mc2:DatasetTumorTypeEnum,
        mc2:FileTumorTypeEnum,
        mc2:IndividualDiseaseTypeEnum,
        mc2:ManifestationEnum,
        mc2:ModelDiseaseTypeEnum,
        mc2:PublicationTumorTypeEnum ;
    skos:definition "A general term for tumors of the central nervous system, including astrocytomas, ependymal tumors, glioblastoma multiforme, and primitive neuroectodermal tumors.",
        "A neoplasm arising from glial cells of the central nervous system, including astrocytes, oligodendrocytes, and ependymal cells." .

NCIT:C3161 a owl:Class ;
    rdfs:label "Leukemia",
        "Leukemias" ;
    rdfs:subClassOf mc2:BiospecimenDiseaseTypeEnum,
        mc2:DSPDatasetTumorTypeEnum,
        mc2:DatasetTumorTypeEnum,
        mc2:FileTumorTypeEnum,
        mc2:IndividualDiseaseTypeEnum,
        mc2:ManifestationEnum,
        mc2:ModelDiseaseTypeEnum,
        mc2:PublicationTumorTypeEnum ;
    skos:definition "A malignant clonal hematologic disorder involving hematopoietic stem cells, characterized by the presence of primitive or atypical myeloid or lymphoid cells in the bone marrow and blood.",
        "Cancer that starts in blood-forming tissue such as the bone marrow and causes large numbers of blood cells to be produced and enter the bloodstream." .

NCIT:C3230 a owl:Class ;
    rdfs:label "Meningioma",
        "Meningiomas" ;
    rdfs:subClassOf mc2:BiospecimenDiseaseTypeEnum,
        mc2:DSPDatasetTumorTypeEnum,
        mc2:DatasetTumorTypeEnum,
        mc2:FileTumorTypeEnum,
        mc2:IndividualDiseaseTypeEnum,
        mc2:ManifestationEnum,
        mc2:ModelDiseaseTypeEnum,
        mc2:PublicationTumorTypeEnum ;
    skos:definition "A usually benign neoplasm arising from the meninges, the membranes that cover and protect the brain and spinal cord.",
        "A usually benign tumor that develops in the meninges." .

NCIT:C3784 a owl:Class ;
    rdfs:label "Basal Cell Neoplasm",
        "Basal Cell Neoplasms" ;
    rdfs:subClassOf mc2:BiospecimenDiseaseTypeEnum,
        mc2:DSPDatasetTumorTypeEnum,
        mc2:DatasetTumorTypeEnum,
        mc2:FileTumorTypeEnum,
        mc2:IndividualDiseaseTypeEnum,
        mc2:ManifestationEnum,
        mc2:ModelDiseaseTypeEnum,
        mc2:PublicationTumorTypeEnum ;
    skos:definition "A neoplastic proliferation of basal cells in the epidermis (part of the skin) or other anatomic sites (most frequently the salivary glands).  The basal cell neoplastic proliferation in the epidermis results in basal cell carcinomas.  The basal cell neoplastic proliferation in the salivary glands can be benign, resulting in basal cell adenomas or malignant, resulting in basal cell adenocarcinomas.",
        "A neoplastic proliferation of basal cells in the epidermis or other anatomic sites (most frequently the salivary glands); the epidermal proliferation results in basal cell carcinomas, while the salivary gland proliferation can be benign (basal cell adenoma) or malignant (basal cell adenocarcinoma)." .

NCIT:C3787 a owl:Class ;
    rdfs:label "Neuroepithelial Neoplasm",
        "Neuroepitheliomatous Neoplasms" ;
    rdfs:subClassOf mc2:BiospecimenDiseaseTypeEnum,
        mc2:DSPDatasetTumorTypeEnum,
        mc2:DatasetTumorTypeEnum,
        mc2:FileTumorTypeEnum,
        mc2:IndividualDiseaseTypeEnum,
        mc2:ManifestationEnum,
        mc2:ModelDiseaseTypeEnum,
        mc2:PublicationTumorTypeEnum ;
    skos:definition "A neoplasm of the nervous system that arises from the neuroepithelial tissues.  Representative examples include astrocytic tumors, oligodendroglial tumors, ependymal tumors, and primitive neuroectodermal tumors.",
        "A neoplasm of the nervous system that arises from the neuroepithelial tissues. Representative examples include astrocytic tumors, oligodendroglial tumors, ependymal tumors, and primitive neuroectodermal tumors." .

NCIT:C7388 a owl:Class ;
    rdfs:label "Blood Vessel Tumors",
        "Vascular Neoplasm" ;
    rdfs:subClassOf mc2:BiospecimenDiseaseTypeEnum,
        mc2:DSPDatasetTumorTypeEnum,
        mc2:DatasetTumorTypeEnum,
        mc2:FileTumorTypeEnum,
        mc2:IndividualDiseaseTypeEnum,
        mc2:ManifestationEnum,
        mc2:ModelDiseaseTypeEnum,
        mc2:PublicationTumorTypeEnum ;
    skos:definition "A benign, intermediate, or malignant neoplasm arising from vascular tissue including arteries, veins, venous sinuses, lymphatic vessels, arterioles and capillaries. It may occur in essentially any body location and is characterized by the presence of vascular channel formation and endothelial cells.",
        "An ICD-O-3 morphology category comprising benign and malignant neoplasms that arise from blood vessels, such as hemangioma, hemangioendothelioma, and angiosarcoma." .

