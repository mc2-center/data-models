        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( mc2:ResourceLanguageEnum [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
