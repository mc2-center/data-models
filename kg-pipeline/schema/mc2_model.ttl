mc2:Individual_Lymph_Node_Involvement_Anatomic_Site_Uberon_Identifier a owl:DatatypeProperty ;
    rdfs:label "Individual Lymph Node Involvement Anatomic Site Uberon Identifier" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^UBERON:\\d+$" ] ) ] ;
    skos:definition "The UBERON identifier of the organ or part of the body describing lymph node involvement in disease (see https://www.ebi.ac.uk/ols4/ontologies/uberon)." ;
    skos:exactMatch CRDC_CDE:14883075 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Individual_Progression_or_Recurrence_Anatomic_Site_Uberon_Identifier a owl:DatatypeProperty ;
    rdfs:label "Individual Progression or Recurrence Anatomic Site Uberon Identifier" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^UBERON:\\d+$" ] ) ] ;
    skos:definition "The UBERON identifier of the organ or part of the body related to the progressive or recurrent disease (see https://www.ebi.ac.uk/ols4/ontologies/uberon)." ;
