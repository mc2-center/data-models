    rdfs:label "dataType Enum" ;
    owl:unionOf ( <https://w3id.org/mc2-center/mc2-model/DataTypeEnum#gene%20expression> <https://w3id.org/mc2-center/mc2-model/DataTypeEnum#chromatin%20activity> <https://w3id.org/mc2-center/mc2-model/DataTypeEnum#genomic%20variants> <https://w3id.org/mc2-center/mc2-model/DataTypeEnum#immunoassay> <https://w3id.org/mc2-center/mc2-model/DataTypeEnum#network> <https://w3id.org/mc2-center/mc2-model/DataTypeEnum#nucleic%20acid%20sequence%20record> <https://w3id.org/mc2-center/mc2-model/DataTypeEnum#image> ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values <https://w3id.org/mc2-center/mc2-model/DataTypeEnum#chromatin%20activity>,
        <https://w3id.org/mc2-center/mc2-model/DataTypeEnum#gene%20expression>,
