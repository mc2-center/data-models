    rdfs:subClassOf mc2:DataCatalogLicenseEnum ;
    skos:definition "MIT License, a permissive license allowing for use, modification, and distribution." .

mc2:DataCatalog_id a owl:DatatypeProperty ;
    rdfs:label "DataCatalog_id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^syn\\d{7,8}$" ] ) ] ;
    skos:definition "Unique ID associated with a Data Catalog entry, used as a key for record linking and updates." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:DataDSP_id a owl:DatatypeProperty ;
    rdfs:label "DataDSP_id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^CA\\d{6}-DSP-\\d{2,9}$" ] ) ] ;
    skos:definition "Unique row identifier, used as a primary key for record updates. This should be in CAxxxxxx-DSPxxx format unless otherwise directed." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

