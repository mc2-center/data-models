mc2:Biospecimen_Anatomic_Site a owl:DatatypeProperty ;
    rdfs:label "Biospecimen Anatomic Site" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^UBERON:\\d+$" ] ) ] ;
    skos:definition "The UBERON identifier of the primary disease site of the submitted tumor sample (see https://www.ebi.ac.uk/ols4/ontologies/uberon). Reference-validated, not a fixed list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "14156279" .

mc2:Biospecimen_Site_of_Resection_or_Biopsy a owl:DatatypeProperty ;
    rdfs:label "Biospecimen Site of Resection or Biopsy" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^UBERON:\\d+$" ] ) ] ;
    skos:definition "The UBERON identifier of the anatomic site of the resection or biopsy of the patient's malignant disease (see https://www.ebi.ac.uk/ols4/ontologies/uberon)." ;
    skos:exactMatch CRDC_CDE:12083894,
        CRDC_CDE:14883054 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "14883054" .

mc2:Biospecimen_Table_Id a owl:DatatypeProperty ;
    rdfs:label "Biospecimen Table Id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^syn\\d{7,8}$" ] ) ] ;
    skos:definition "The Synapse Id corresponding to a Biospecimen metadata table associated with the Dataset(s)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Biospecimen_Taxonomy_ID a owl:DatatypeProperty ;
    rdfs:label "Biospecimen Taxonomy ID" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^\\d+$" ] ) ] ;
    skos:definition "A label provided by the NCBI Taxonomy Database (https://www.ncbi.nlm.nih.gov/taxonomy/) that uniquely identifies the species or other taxonomic group from which the biospecimen originates (e.g. 9606 for Homo sapiens). Companion formal identifier to Biospecimen Species; reference-validated, not a fixed list." ;
    skos:exactMatch CRDC_CDE:10543100 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Biospecimen_id a owl:DatatypeProperty ;
    rdfs:label "Biospecimen_id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "B\\d{1,9}$" ] ) ] ;
    skos:definition "Unique row identifier, used as a primary key for record updates. This should terminate in ModelKey-Bxxx or IndividualKey-Bxxx format, unless directed otherwise." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "15100774" .

