<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#3D%20ATAC-PALM> a owl:Class ;
    rdfs:label "3D ATAC-PALM" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "A super-resolution imaging technique that combines ATAC-see (a fluorescence-based chromatin accessibility assay) with photoactivated localization microscopy (PALM) to visualize the 3D spatial organization of accessible chromatin in single cells." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#Angiogenesis%20Assay> a owl:Class ;
    rdfs:label "Angiogenesis Assay" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "An assay used to measure the formation of new blood vessels from existing vasculature, typically by quantifying endothelial cell tube formation, migration, or sprouting in vitro or in vivo." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#CRISPR> a owl:Class ;
    rdfs:label "CRISPR" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "A genome-editing and functional-screening technology based on the Clustered Regularly Interspaced Short Palindromic Repeats (CRISPR)-Cas system, used here as a general assay category for CRISPR-based perturbation experiments." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#Co-Immunoprecipitation%20Mass%20Spectrometry> a owl:Class ;
    rdfs:label "Co-Immunoprecipitation Mass Spectrometry" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "A method that combines co-immunoprecipitation (using an antibody to pull down a protein and its binding partners) with mass spectrometry to identify protein-protein interaction partners." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#DRIP-seq> a owl:Class ;
    rdfs:label "DRIP-seq" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "A molecular genetic technique that combines chromatin immunoprecipitation (ChIP) with massively parallel DNA sequencing to map the binding sites of DNA-associated proteins in a sample of cells. First, crosslinked protein-DNA complexes are isolated using ChIP. Next, the crosslinks are broken, the proteins are removed and the purified DNA is modified with adaptor oligonucleotides to facilitate massively parallel DNA sequencing. Following sequencing, the DNA sequences that are obtained can be mapped to their genomic locations." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#Dye%20Endocytosis%20Assay> a owl:Class ;
    rdfs:label "Dye Endocytosis Assay" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "An assay that measures cellular endocytic activity by quantifying the uptake of a fluorescent or otherwise detectable dye into cells." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#Human%20Induced%20Pluripotent%20Stem%20Cell-derived%20Cardiomyocytes%20Culture> a owl:Class ;
    rdfs:label "Human Induced Pluripotent Stem Cell-derived Cardiomyocytes Culture" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "The in vitro culture of cardiomyocytes (heart muscle cells) that have been differentiated from human induced pluripotent stem cells (iPSCs), used to model cardiac biology and disease." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#Macrophage%20Polarization%20Assay> a owl:Class ;
    rdfs:label "Macrophage Polarization Assay" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "An assay that measures the differentiation of macrophages into functional phenotypes (e.g., M1 pro-inflammatory or M2 anti-inflammatory) in response to specific stimuli, typically via marker expression or cytokine profiling." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#Metastatic%20Colonization%20Assay> a owl:Class ;
    rdfs:label "Metastatic Colonization Assay" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "An in vivo assay that measures the ability of tumor cells to establish and grow secondary colonies at a distant site after introduction into a host organism, modeling the colonization step of metastasis." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#Micropipette%20Aspiration> a owl:Class ;
    rdfs:label "Micropipette Aspiration" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "A biophysical technique that uses a fine glass micropipette and controlled suction pressure to measure the mechanical properties (e.g., membrane tension, cortical stiffness) of individual cells." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#Monolayer%20Stress%20Microscopy> a owl:Class ;
    rdfs:label "Monolayer Stress Microscopy" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "The use of various technologies to resolve the structure or features of objects too small or fine to naturally be seen by eye." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#Nanopatterning> a owl:Class ;
    rdfs:label "Nanopatterning" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "A fabrication technique that creates nanoscale surface features or patterns, used e.g. to control cell adhesion, shape, or substrate mechanics in cell-biology experiments." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#Paraquat%20Survival%20Assay> a owl:Class ;
    rdfs:label "Paraquat Survival Assay" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "A survival assay that exposes an organism (commonly Caenorhabditis elegans) to the oxidative-stress-inducing herbicide paraquat to measure resistance to oxidative stress and longevity." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#Partial%20Wave%20Spectroscopy> a owl:Class ;
    rdfs:label "Partial Wave Spectroscopy" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "The technique of measuring the emission and absorption of different wavelengths (spectra) of visible and non-visible light. This can be done via a spectroscope, which consists of a slit, prism, collimator lens, object lens, and a grating." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#RNA%20array> a owl:Class ;
    rdfs:label "RNA array" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "A microarray platform used to measure RNA expression levels." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#Scanning%20Angle%20Interference%20Microscopy> a owl:Class ;
    rdfs:label "Scanning Angle Interference Microscopy" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "Technique of electron microscopy in which the specimen is coated with heavy metal and then scanned by an electron beam. The resolution is not as great as with transmission electron microscopy, but preparation is easier (often by fixation followed by critical point drying), the depth of focus is relatively enormous, the surface of a specimen can be seen (though not the interior unless the specimen is cracked open) and the image is aesthetically pleasing." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#Single-Cell%20Barcode%20Chip> a owl:Class ;
    rdfs:label "Single-Cell Barcode Chip" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "A molecular genetic technique that combines chromatin immunoprecipitation (ChIP) with massively parallel DNA sequencing to map the binding sites of DNA-associated proteins in a sample of cells. First, crosslinked protein-DNA complexes are isolated using ChIP. Next, the crosslinks are broken, the proteins are removed and the purified DNA is modified with adaptor oligonucleotides to facilitate massively parallel DNA sequencing. Following sequencing, the DNA sequences that are obtained can be mapped to their genomic locations." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#Single-Molecule%20Localization%20Microscopy> a owl:Class ;
    rdfs:label "Single-Molecule Localization Microscopy" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "A super-resolution fluorescence microscopy technique that localizes individual fluorophore molecules with high precision over many imaging cycles to reconstruct an image beyond the diffraction limit." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#Structural%20Variant%20Analysis> a owl:Class ;
    rdfs:label "Structural Variant Analysis" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "The computational analysis of sequencing or array data to detect large-scale genomic alterations such as deletions, duplications, insertions, inversions, and translocations." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#Surveyor%20Nuclease%20Assay> a owl:Class ;
    rdfs:label "Surveyor Nuclease Assay" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "An assay that uses the Surveyor nuclease to detect and cleave DNA at sites of sequence mismatch, commonly used to quantify genome-editing efficiency (e.g., after CRISPR/TALEN treatment)." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#Synthetic%20Genetic%20Array> a owl:Class ;
    rdfs:label "Synthetic Genetic Array" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "A molecular biology device that utilizes a set of defined cDNA clones attached in a specific grid arrangement to a solid support for nucleic acid hybridization assays in gene mapping studies or in determining gene sequences, sequence variations, or gene expression patterns." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#Targeted%20Error%20Correction%20Sequencing> a owl:Class ;
    rdfs:label "Targeted Error Correction Sequencing" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "A targeted sequencing approach that incorporates molecular barcoding or redundant sequencing of the same DNA molecule to computationally distinguish true low-frequency variants from sequencing errors." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#Traction%20Force%20Microscopy> a owl:Class ;
    rdfs:label "Traction Force Microscopy" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "A technique utilizing a scanning probe to image and analyze the surface of a material with atomic-level resolution." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#compound%20screen> a owl:Class ;
    rdfs:label "compound screen" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "A screening assay testing multiple chemical compounds for a biological effect." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#histology> a owl:Class ;
    rdfs:label "histology" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "Microscopic examination of tissue structure via sectioning and staining." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#in%20silico%20synthesis> a owl:Class ;
    rdfs:label "in silico synthesis" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "Computational/simulation-based synthesis of a molecule or construct rather than a wet-lab technique." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#in%20vivo%20PDX%20viability> a owl:Class ;
    rdfs:label "in vivo PDX viability" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "A functional viability readout from a patient-derived xenograft (PDX) model." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#in%20vivo%20tumor%20growth> a owl:Class ;
    rdfs:label "in vivo tumor growth" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "Monitoring of tumor growth (e.g. volume/size over time) in a live animal model, typically as a functional readout rather than a molecular assay." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#metabolic%20screening> a owl:Class ;
    rdfs:label "metabolic screening" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "A screening assay assessing metabolic activity or metabolite profiles." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#proximity%20extension%20assay> a owl:Class ;
    rdfs:label "proximity extension assay" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "An antibody-based protein detection method (e.g. Olink) in which paired antibodies with attached DNA oligonucleotides bind a target protein, allowing proximity-dependent DNA amplification and readout." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#scCGI-seq> a owl:Class ;
    rdfs:label "scCGI-seq" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "A molecular genetic technique that combines chromatin immunoprecipitation (ChIP) with massively parallel DNA sequencing to map the binding sites of DNA-associated proteins in a sample of cells. First, crosslinked protein-DNA complexes are isolated using ChIP. Next, the crosslinks are broken, the proteins are removed and the purified DNA is modified with adaptor oligonucleotides to facilitate massively parallel DNA sequencing. Following sequencing, the DNA sequences that are obtained can be mapped to their genomic locations." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#shRNA-seq> a owl:Class ;
    rdfs:label "shRNA-seq" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "A pooled shRNA screening assay read out by sequencing to identify short hairpin RNA constructs enriched or depleted under a selection condition." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetAssayEnum#spatial%20transcriptomics> a owl:Class ;
    rdfs:label "spatial transcriptomics" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum ;
    skos:definition "A general term for assays that measure RNA expression while preserving spatial location information within a tissue section." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetGrantNumberEnum#Affiliated%2FNon-Grant%20Associated> a owl:Class ;
    rdfs:label "Affiliated/Non-Grant Associated" ;
    rdfs:subClassOf mc2:DSPDatasetGrantNumberEnum .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetGrantNumberEnum#CA184897> a owl:Class ;
    rdfs:label "CA184897" ;
    rdfs:subClassOf mc2:DSPDatasetGrantNumberEnum .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetGrantNumberEnum#CA184898> a owl:Class ;
    rdfs:label "CA184898" ;
    rdfs:subClassOf mc2:DSPDatasetGrantNumberEnum .

