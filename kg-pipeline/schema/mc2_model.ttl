    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "Use of a DNA or RNA probe to detect the presence of complementary sequences in chromosomes, cells, or tissues. (NCI)" .

EFO:0008991 a owl:Class ;
    rdfs:label "seqFISH" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "seqFISH is an in situ multiplexed imaging method that uses sequential rounds of fluorescence in situ hybridization to identify large numbers of RNA species within intact cells." .

EFO:0008992 a owl:Class ;
    rdfs:label "Multiplexed Error-Robust Fluorescence In Situ Hybridization" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "Use of a DNA or RNA probe to detect the presence of complementary sequences in chromosomes, cells, or tissues. (NCI)" .

EFO:0009294 a owl:Class ;
    rdfs:label "CITE-seq" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "A molecular genetic technique that combines chromatin immunoprecipitation (ChIP) with massively parallel DNA sequencing to map the binding sites of DNA-associated proteins in a sample of cells. First, crosslinked protein-DNA complexes are isolated using ChIP. Next, the crosslinks are broken, the proteins are removed and the purified DNA is modified with adaptor oligonucleotides to facilitate massively parallel DNA sequencing. Following sequencing, the DNA sequences that are obtained can be mapped to their genomic locations." .

EFO:0009918 a owl:Class ;
    rdfs:label "smFISH" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "Single-molecule RNA FISH, a method for detecting and localizing individual RNA molecules within cells using short, fluorescently labeled oligonucleotide probes." .

EFO:0009973 a owl:Class ;
    rdfs:label "CUT&RUN" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "Cleavage Under Targets and Release Using Nuclease (CUT&RUN), a method for mapping DNA-protein interactions using an antibody-targeted nuclease to selectively cleave DNA near a bound protein." .

EFO:0009998 a owl:Class ;
    rdfs:label "eCLIP-Seq" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "A molecular genetic technique that combines chromatin immunoprecipitation (ChIP) with massively parallel DNA sequencing to map the binding sites of DNA-associated proteins in a sample of cells. First, crosslinked protein-DNA complexes are isolated using ChIP. Next, the crosslinks are broken, the proteins are removed and the purified DNA is modified with adaptor oligonucleotides to facilitate massively parallel DNA sequencing. Following sequencing, the DNA sequences that are obtained can be mapped to their genomic locations." .

EFO:0010039 a owl:Class ;
    rdfs:label "Deep Mutational Scanning" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "Technique of electron microscopy in which the specimen is coated with heavy metal and then scanned by an electron beam. The resolution is not as great as with transmission electron microscopy, but preparation is easier (often by fixation followed by critical point drying), the depth of focus is relatively enormous, the surface of a specimen can be seen (though not the interior unless the specimen is cracked open) and the image is aesthetically pleasing." .

EFO:0010040 a owl:Class ;
    rdfs:label "Nano-hmC-Seal" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "A chemical labeling and capture approach for genome-wide profiling of 5-hydroxymethylcytosine (5hmC) using selective chemical tagging followed by sequencing." .

EFO:0010188 a owl:Class ;
    rdfs:label "3' RNA-seq" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "A method for profiling gene expression in which RNA-sequencing library preparation and sequencing are restricted to a short region at the 3' end of polyadenylated transcripts (typically captured via oligo-dT priming), rather than covering full-length transcripts." .

EFO:0010936 a owl:Class ;
    rdfs:label "SDS-PAGE" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "A protein assay that allows protein separation by mass in a polyacrylamide-based discontinuous gel." .

EFO:0010961 a owl:Class ;
    rdfs:label "Visium Spatial Gene Expression" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "A spatial transcriptomics method developed by 10x Genomics that measures the whole transcriptome or a defined set of transcripts within intact tissue sections while preserving spatial context." .

EFO:0011016 a owl:Class ;
    rdfs:label "ImmunoFISH" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "A method combining immunolabeling with fluorescent in situ hybridization (FISH) to simultaneously detect the nuclear distribution of a protein and specific DNA or RNA sequences." .

EFO:0022989 a owl:Class ;
    rdfs:label "Quantitative Multiplex Immunofluorescence" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "A method that enables simultaneous detection of multiple biomarkers on a single tissue section using immunofluorescence techniques." .

EFO:0030029 a owl:Class ;
    rdfs:label "NanoString Digital Spatial Profiling" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "A spatial transcriptomics technique that enables analysis of RNA and protein expression in tissue specimens on slides using multiplexed probe hybridization and digital counting." .

EFO:0030058 a owl:Class ;
    rdfs:label "Transcription profiling by NanoString" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "A gene expression profiling technique that uses the NanoString nCounter system's multiplexed probe hybridization to capture and digitally count individual mRNA transcripts." .

EFO:0030059 a owl:Class ;
    rdfs:label "10x Multiome" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "A single-cell multiomic assay that simultaneously profiles gene expression (RNA) and chromatin accessibility (ATAC) from the same individual cell." .

EFO:0030077 a owl:Class ;
    rdfs:label "MULTI-Seq" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "A molecular genetic technique that combines chromatin immunoprecipitation (ChIP) with massively parallel DNA sequencing to map the binding sites of DNA-associated proteins in a sample of cells. First, crosslinked protein-DNA complexes are isolated using ChIP. Next, the crosslinks are broken, the proteins are removed and the purified DNA is modified with adaptor oligonucleotides to facilitate massively parallel DNA sequencing. Following sequencing, the DNA sequences that are obtained can be mapped to their genomic locations." .

EFO:0920004 a owl:Class ;
    rdfs:label "CUT&Tag-Sequencing" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "Cleavage Under Targets and Tagmentation (CUT&Tag), a chromatin profiling method that uses antibody-targeted tagmentation to map the genome-wide location of a protein of interest." .

pmid:11509510 a owl:Class ;
    rdfs:label "Magnetic Twisting Cytometry" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "A flow cytometry technique that utilizes mass spectrometry to detect antibodies labeled with heavy metal ion tags that are bound to antigens of interest on single cells." .

pmid:15576905 a owl:Class ;
    rdfs:label "Cell-spreading Assay" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "Any method to measure the number of dividing cells in a culture, or to measure the change in the proportion of cells that are dividing." .

pmid:17460669 a owl:Class ;
    rdfs:label "Suspended Microchannel Resonator" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "Particles are weighed in real-time with the suspended microchannel resonator (SMR) as they flow through a hollow cantilever. In addition to weighing particles with femtogram precision, the SMR can also measure mass density with a resolution of 10-4 g/mL. This is possible since the microchannel resonant frequency is determined by the difference in mass of the particle with respect to that of the displaced fluid. Thus, the particle's density is determined by measuring its mass in two fluids of different densities. The SMR can measure the growth of single cells as well as the absorption of biomolecules to microchannel walls. Scaling the current SMR design by ten-fold will result in a thousand-fold improvement in mass resolution (attogram) and thereby enable single viruses to be weighed with high precision." .

pmid:18228343 a owl:Class ;
    rdfs:label "QFISH" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "Quantitative fluorescence in situ hybridization, a technique combining FISH with quantitative fluorescence measurement, commonly used to measure telomere length." .

pmid:18638197 a owl:Class ;
    rdfs:label "Knife-Edge Scanning Microscopy" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "Technique of electron microscopy in which the specimen is coated with heavy metal and then scanned by an electron beam. The resolution is not as great as with transmission electron microscopy, but preparation is easier (often by fixation followed by critical point drying), the depth of focus is relatively enormous, the surface of a specimen can be seen (though not the interior unless the specimen is cracked open) and the image is aesthetically pleasing." .

pmid:20061193 a owl:Class ;
    rdfs:label "UPLC-MSMS" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "An analytical technique combining ultra-performance liquid chromatography (UPLC) with tandem mass spectrometry (MS/MS) to separate, identify, and quantify compounds such as metabolites or proteins in complex biological samples." .

pmid:21115850 a owl:Class ;
    rdfs:label "Binding Assay" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "An assay that measures the interaction or binding affinity between two molecules, such as a ligand and its receptor or an antibody and its antigen." .

pmid:21913069 a owl:Class ;
    rdfs:label "Methylation-Specific PCR" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "Polymerase chain reaction that uses two sets of primers, in two sequential runs of amplification, with the second set intended to amplify a target within the first run product." .

pmid:22083316 a owl:Class ;
    rdfs:label "Micropipette Adhesion Assay" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "A biophysical assay that uses a micropipette to apply and measure adhesive forces between individual cells or between a cell and a substrate." .

pmid:22246326 a owl:Class ;
    rdfs:label "Multi-Isotope Mass Spectrometry" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "An analytical technique wherein ions are separated according to their ratio of charge to mass. From the mass spectrum produced, the atomic weight of the particle can be deduced." .

pmid:22611051 a owl:Class ;
    rdfs:label "Affinity Purification Mass Spectrometry" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "An analytical technique wherein ions are separated according to their ratio of charge to mass. From the mass spectrum produced, the atomic weight of the particle can be deduced." .

pmid:23196972 a owl:Class ;
    rdfs:label "TAB-Seq" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "A molecular genetic technique that combines chromatin immunoprecipitation (ChIP) with massively parallel DNA sequencing to map the binding sites of DNA-associated proteins in a sample of cells. First, crosslinked protein-DNA complexes are isolated using ChIP. Next, the crosslinks are broken, the proteins are removed and the purified DNA is modified with adaptor oligonucleotides to facilitate massively parallel DNA sequencing. Following sequencing, the DNA sequences that are obtained can be mapped to their genomic locations." .

pmid:25023614 a owl:Class ;
    rdfs:label "Sirius Red Staining" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "A histological staining technique that uses Sirius Red dye to selectively stain collagen fibers in tissue sections, commonly used to assess fibrosis." .

pmid:25867607 a owl:Class ;
    rdfs:label "Mammosphere Formation Assay" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "An in vitro assay that measures the ability of mammary epithelial or stem/progenitor cells to form free-floating spherical colonies (mammospheres) under non-adherent culture conditions." .

pmid:26324940 a owl:Class ;
    rdfs:label "CASFISH" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "CRISPR/Cas9-mediated fluorescence in situ hybridization, a technique using a catalytically inactive Cas9 (dCas9) fused to a fluorescent tag to visualize specific genomic loci in fixed cells without denaturation." .

pmid:26721479 a owl:Class ;
    rdfs:label "CLIP-qPCR" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "A technique combining crosslinking immunoprecipitation (CLIP) of an RNA-binding protein with quantitative PCR to identify and quantify specific bound RNA sequences." .

pmid:26724184 a owl:Class ;
    rdfs:label "3D Bioprinting" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "A biofabrication technique that uses layer-by-layer deposition of cells, biomaterials, and growth factors to construct three-dimensional, tissue-like structures." .

pmid:27018580 a owl:Class ;
