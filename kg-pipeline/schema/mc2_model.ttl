        <https://w3id.org/mc2-center/mc2-model/DownloadTypeEnum#Synapse%20Indexed> .

mc2:FileLongitudinalEventTypeEnum a owl:Class ;
    rdfs:label "File Longitudinal Event Type Enum" ;
    owl:unionOf ( NCIT:C37948 NCIT:C25213 ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values NCIT:C25213,
        NCIT:C37948 .

mc2:Genomic_Reference a owl:DatatypeProperty ;
    rdfs:label "Genomic Reference" ;
    skos:definition "Exact version of the human genome reference used in the alignment of reads (e.g. GCF_000001405.39)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "11529031" .

mc2:ImagePixelsBigEndianEnum a owl:Class ;
    rdfs:label "Image Pixels BigEndian Enum" ;
    owl:unionOf ( NCIT:C68850 NCIT:C68851 ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values NCIT:C68850,
