    owl:unionOf ( <https://w3id.org/mc2-center/mc2-model/ConsentForPortalDisplayEnum#No> <https://w3id.org/mc2-center/mc2-model/ConsentForPortalDisplayEnum#Yes> ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values <https://w3id.org/mc2-center/mc2-model/ConsentForPortalDisplayEnum#No>,
        <https://w3id.org/mc2-center/mc2-model/ConsentForPortalDisplayEnum#Yes> .

mc2:Consortium_Key a owl:DatatypeProperty ;
    rdfs:label "Consortium Key" ;
    skos:definition "Unique Consortium_id foreign key(s) that group the resource with other components, as part of the same consortium-associated grants. Please provide multiple values as a comma-separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

mc2:DownloadTypeEnum a owl:Class ;
    rdfs:label "downloadType Enum" ;
    owl:unionOf ( <https://w3id.org/mc2-center/mc2-model/DownloadTypeEnum#Synapse%20Hosted> <https://w3id.org/mc2-center/mc2-model/DownloadTypeEnum#Synapse%20Indexed> ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
