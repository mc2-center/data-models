<https://w3id.org/mc2-center/mc2-model/ModelPrimaryDiagnosisEnum#Acute%20Myeloid%20Leukemia%20With%20Abnormal%20Marrow%20Eosinophils> a owl:Class ;
    rdfs:label "Acute Myeloid Leukemia With Abnormal Marrow Eosinophils" ;
    rdfs:subClassOf mc2:ModelPrimaryDiagnosisEnum .

<https://w3id.org/mc2-center/mc2-model/ModelPrimaryDiagnosisEnum#Acute%20Myeloid%20Leukemia%20With%20Mutated%20CEBPA> a owl:Class ;
