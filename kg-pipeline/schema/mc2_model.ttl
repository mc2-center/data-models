<https://w3id.org/mc2-center/mc2-model.owl.ttl> a owl:Ontology ;
    rdfs:label "mc2_model" ;
    skos:definition "LinkML schema generated from a schematic-style data model CSV (mc2_model)." .

mc2:10xVisiumAuxiliaryFiles a owl:Class ;
    rdfs:label "10x Visium Auxiliary Files" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:10xVisiumRNALevel3_Key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Biospecimen_Key ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:File_Level ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:File_Url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Longitudinal_Event_Type ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Visium_Run_ID ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Visium_File_Type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Assay ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:File_Alias ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Visium_Slide_ID ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Longitudinal_Group ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:File_Format ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Species ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Longitudinal_Total_Time_Elapsed ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Design ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Filename ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:10xVisiumRNALevel1_Key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:10xVisiumRNALevel2_Key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:10xVisiumRNALevel4_Key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Visium_Capture_Area ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "-B\\d{1,9}" ] ) ] ;
            owl:onProperty mc2:Biospecimen_Key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:DatasetView_Key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Study_Key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Longitudinal_Time_Elapsed_Unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Workflow_Link ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Workflow_Version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Longitudinal_Sequence_Identifier ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:10xVisiumAuxiliaryFiles_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^syn\\d{7,8}$" ] ) ] ;
            owl:onProperty mc2:10xVisiumAuxiliaryFiles_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:File_Description ] ;
    skos:definition "Auxiliary data associated with spot/slide analysis (aligned Images, quality control files, etc)  from Spatial Transcriptomics." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:10xVisiumRNALevel1 a owl:Class ;
