NCIT:C53470 a owl:Class ;
    rdfs:label "Pending Annotation" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:DSPDatasetTissueEnum,
        mc2:DSPDatasetTumorTypeEnum,
        mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum,
        mc2:ManifestationEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:TissueEnum,
        mc2:TumorTypeEnum ;
    skos:definition "A placeholder value indicating that the appropriate assay annotation for this record has not yet been determined or curated.",
        "A placeholder value indicating that the tissue annotation for this record has not yet been finalized and is pending curator review.",
        "An administrative placeholder value indicating that a definitive tumor/cancer type has not yet been curated or assigned for this record; the classification is awaiting manual annotation review.",
        "Indicates that curatorial annotation of the file's format has not yet been completed and is pending further review." .

