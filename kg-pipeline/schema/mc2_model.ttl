    rdfs:range mc2:GrantThemeNameEnum ;
    skos:definition "Theme(s) associated with the grant. 1...*" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Grant_Type a owl:ObjectProperty ;
    rdfs:label "Grant Type" ;
    rdfs:range mc2:GrantTypeEnum ;
    skos:definition "Type of grant" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Number_of_Features a owl:DatatypeProperty ;
    rdfs:label "Image Number of Features" ;
    rdfs:range xsd:float ;
    skos:definition "The number of features (eg channels) described" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Object_Class_Description a owl:DatatypeProperty ;
    rdfs:label "Image Object Class Description" ;
    skos:definition "If Imaging Object Class is \"Other\", please use this field to provide a text description of the imaging object class associated with the segmentation data" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Segmentation_Data_Type a owl:ObjectProperty ;
    rdfs:label "Image Segmentation Data Type" ;
    rdfs:range mc2:ImageSegmentationDataTypeEnum ;
    skos:definition "Specifies how the segmentation is stored" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Summary_Statistic a owl:ObjectProperty ;
    rdfs:label "Image Summary Statistic" ;
    rdfs:range mc2:ImageSummaryStatisticEnum ;
    skos:definition "Function used to summarize object/feature intensity" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:ImagingChannel_id a owl:DatatypeProperty ;
    rdfs:label "ImagingChannel_id" ;
    skos:definition "Unique row identifier, used as a primary key for record updates." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:ImagingLevel1_Key a owl:DatatypeProperty ;
    rdfs:label "ImagingLevel1 Key" ;
    skos:definition "Unique ImagingLevel1_id foreign key(s) that link metadata entries as part of the same Dataset. Please provide multiple values as a comma-separate list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

mc2:ImagingLevel3Segments_Key a owl:DatatypeProperty ;
    rdfs:label "ImagingLevel3Segments Key" ;
    skos:definition "Unique ImagingLevel3Segments_id foreign key(s) that link metadata entries as part of the same Dataset. Please provide multiple values as a comma-separate list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

mc2:Individual_Age_at_Diagnosis a owl:DatatypeProperty ;
    rdfs:label "Individual Age at Diagnosis" ;
    rdfs:range xsd:float ;
    skos:definition "Age at the time the individual was diagnosed, expressed in years." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "15019300" .

mc2:Individual_Days_To_Recurrence a owl:DatatypeProperty ;
    rdfs:label "Individual Days To Recurrence" ;
    rdfs:range xsd:float ;
    skos:definition "Number of days between the date used for index and the date the patient's disease recurred" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Individual_Days_to_Last_Followup a owl:DatatypeProperty ;
