<https://w3id.org/mc2-center/mc2-model/DSPDatasetLevelEnum#Auxiliary> a owl:Class ;
    rdfs:label "Auxiliary" ;
    rdfs:subClassOf mc2:DSPDatasetLevelEnum ;
    skos:definition "Additional files that contain information or experimental details, but do not contain data or processed derivatives" .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetLevelEnum#Level%202> a owl:Class ;
    rdfs:label "Level 2" ;
    rdfs:subClassOf mc2:DSPDatasetLevelEnum ;
    skos:definition "Data that has undergone a basic or initial processing step, like quality control, alignment, or stitching. Typically derived from Level 1 files." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetLevelEnum#Level%203> a owl:Class ;
    rdfs:label "Level 3" ;
    rdfs:subClassOf mc2:DSPDatasetLevelEnum ;
    skos:definition "Files that contain summary counts, coverage files, or other processed representations of the data. Typically derived from Level 2 files." .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetLevelEnum#Level%204> a owl:Class ;
    rdfs:label "Level 4" ;
    rdfs:subClassOf mc2:DSPDatasetLevelEnum ;
    skos:definition "\"Files that are processed through multiple steps or contain descriptors of the data. Typically derived from Level 2, Level 3, and/or auxiliary files.\"" .

<https://w3id.org/mc2-center/mc2-model/DSPDatasetTumorTypeEnum#Pan-cancer> a owl:Class ;
    rdfs:label "Pan-cancer" ;
    rdfs:subClassOf mc2:DSPDatasetTumorTypeEnum ;
    skos:definition "A term describing analyses, datasets, or studies that span and compare multiple different cancer/tumor types together, rather than being limited to a single cancer type, in order to identify shared or distinguishing molecular and clinical features across cancers." .

mc2:DSP_IRB_Form a owl:DatatypeProperty ;
    rdfs:label "DSP IRB Form" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "syn\\d+" ] ) ] ;
    skos:definition "The Synapse Id for the executed IRB protocol or exemption document that was uploaded to Synapse. Required if human-derived data was generated for this study and will be uploaded as part of this dataset" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

<https://w3id.org/mc2-center/mc2-model/DataCatalogDataUseModifiersEnum#DUOPlus1> a owl:Class ;
    rdfs:label "DUOPlus1" ;
    rdfs:subClassOf mc2:DataCatalogDataUseModifiersEnum ;
    skos:definition "Source geography is relevant to governance decisions. If providing this term, please provide the applicable country code(s) in column sourceGeography" .

<https://w3id.org/mc2-center/mc2-model/DataCatalogDataUseModifiersEnum#DUOPlus2> a owl:Class ;
    rdfs:label "DUOPlus2" ;
