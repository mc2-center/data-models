NCIT:C122936 a owl:Class ;
    rdfs:label "Patient Derived Xenograft",
        "Primary Xenograft Tissue",
        "Xenograft Tissue" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "A mouse model for human cancer studies in which a human-derived tumor sample is transplanted into an immunodeficient mouse.",
        "Tissue derived from a patient's tumor that has been directly implanted and grown in a non-human host organism without prior in vitro culturing.",
        "Tissue derived from human or animal cells or tumor material that has been transplanted into and grown within a different (non-human) host organism." .

NCIT:C17003 a owl:Class ;
    rdfs:label "PCR",
        "Random PCR" ;
    rdfs:subClassOf mc2:DSPDatasetAssayEnum,
        mc2:DatasetAssayEnum,
        mc2:FileAssayEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:NGSLibrarySelectionMethodEnum,
        mc2:PublicationAssayEnum ;
    skos:definition "Polymerase chain reaction that uses two sets of primers, in two sequential runs of amplification, with the second set intended to amplify a target within the first run product.",
        "Source material was selected by designed primers",
        "Source material was selected by randomly generated primers" .

