            owl:onProperty mc2:ToolView_Key ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "CA\\d{6}" ] ) ] ;
            owl:onProperty mc2:GrantView_Key ] ;
