mc2:NanoStringGeoMxDSPLevel3_Key a owl:DatatypeProperty ;
    rdfs:label "NanoStringGeoMxDSPLevel3 Key" ;
    skos:definition "Unique NanoStringGeoMxDSPLevel3_id foreign key(s) that link metadata entries as part of the same Dataset. Please provide multiple values as a comma-separate list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

mc2:PersonView a owl:Class ;
    rdfs:label "Person View" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Consortium_Key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:GrantView_Key ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Working_Group_Participation ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "\\d{4}\\-\\d{4}\\-\\d{4}\\-\\d{3}(\\d|X)" ] ) ] ;
            owl:onProperty mc2:Orcid_Id ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Last_Known_Institution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Email ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:PersonView_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Institution_Key ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Portal_Display ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Orcid_Id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Url ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Consent_For_Portal_Display ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Synapse_Profile_Id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Chair_Roles ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "CA\\d{6}" ] ) ] ;
            owl:onProperty mc2:GrantView_Key ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Name ] ;
    skos:definition "The denormalized manifest for person submission." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Person_Datasets a owl:DatatypeProperty ;
    rdfs:label "Person Datasets" ;
    skos:definition "A list of the dataset aliases (An alias of the dataset must be unique. Can be the GEO identifier such as GSE12345, or a DOI. No Greek Letters) associated with the person. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Person_Educational_Resources a owl:DatatypeProperty ;
    rdfs:label "Person Educational Resources" ;
    skos:definition "A list of educational resource identifiers associated with the person. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Person_Publications a owl:DatatypeProperty ;
    rdfs:label "Person Publications" ;
    skos:definition "A list of the pubmed Ids associated with the person. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Person_Tools a owl:DatatypeProperty ;
    rdfs:label "Person Tools" ;
    skos:definition "A list of the tool names associated with the person. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:ProjectView a owl:Class ;
    rdfs:label "Project View" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Investigator ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Consortium_Key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Project_Short_Name ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Project_Type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:GrantView_Key ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "CA\\d{6}" ] ) ] ;
            owl:onProperty mc2:GrantView_Key ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Project_Description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:PersonView_Key ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:ProjectView_id ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Project_Name ] ;
    skos:definition "The denormalized manifest for project submission." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:PublicationView a owl:Class ;
    rdfs:label "Publication View" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Publication_Journal ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Publication_Doi ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Publication_Abstract ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Pubmed_Id ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Publication_Year ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "CA\\d{6}" ] ) ] ;
            owl:onProperty mc2:GrantView_Key ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Assay ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:Publication_Authors ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:GrantView_Key ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Publication_Accessibility ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Study_Key ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Pubmed_Url ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Publication_Title ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:PublicationView_id ] ;
    skos:definition "The denormalized manifest for publication submission." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Publication_Dataset_Alias a owl:DatatypeProperty ;
    rdfs:label "Publication Dataset Alias" ;
    skos:definition "A list of the dataset aliases (An alias of the dataset must be unique. Can be the GEO identifier such as GSE12345, or a DOI. No Greek Letters) associated with the publication. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Publication_Keywords a owl:DatatypeProperty ;
    rdfs:label "Publication Keywords" ;
    skos:definition "Keywords associated with the publication. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Resource_Access_Hazard a owl:ObjectProperty ;
    rdfs:label "Resource Access Hazard" ;
    rdfs:range mc2:ResourceAccessHazardEnum ;
    skos:definition "Sensory hazards (Flashing, Motion, etc.) applicable to the item. Multiple values should be provided as a comma separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Resource_Dataset_Alias a owl:DatatypeProperty ;
    rdfs:label "Resource Dataset Alias" ;
    skos:definition "URL or persistent identifier (DOI, Synapse ID) for any dataset(s) that is intended to be used with the item. Multiple values should be provided as a comma separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Resource_Internal_Identifier a owl:DatatypeProperty ;
    rdfs:label "Resource Internal Identifier" ;
    skos:definition "The institution-specific ID for the item, if applicable. May be non-unique. Multiple values should be provided as a comma separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Resource_Media_Accessibility a owl:ObjectProperty ;
    rdfs:label "Resource Media Accessibility" ;
    rdfs:range mc2:ResourceMediaAccessibilityEnum ;
    skos:definition "Accessibility features (Alternative Text, Audio Description, etc.) incorporated into the item. Multiple values should be provided as a comma separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Resource_Secondary_Topic a owl:DatatypeProperty ;
    rdfs:label "Resource Secondary Topic" ;
    skos:definition "Additional topics or keywords to describe the content of the item, in addition to the primary topic. Multiple values should be provided as a comma-separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Resource_Tool_Link a owl:DatatypeProperty ;
    rdfs:label "Resource Tool Link" ;
    skos:definition "URL or persistent identifier (DOI, Synapse ID) for any software or tool that is intended to be used with the item. Multiple values should be provided as a comma separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

