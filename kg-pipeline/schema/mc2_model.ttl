            owl:onProperty mc2:Resource_Activity_Type ] ;
    skos:definition "Manifest for describing educational resources." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:FileView a owl:Class ;
    rdfs:label "File View" ;
    rdfs:subClassOf [ a owl:Restriction ;
