        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "-B\\d{1,9}" ] ) ] ;
            owl:onProperty mc2:Biospecimen_Key ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Visium_Spatial_Read1 ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:File_Level ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:NGS_Library_Preparation_Days_from_Index ] ;
    skos:definition "Files contain raw RNA-seq data associated with spot/slide data." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

