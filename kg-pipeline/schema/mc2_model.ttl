mc2:Individual_Table_Id a owl:DatatypeProperty ;
    rdfs:label "Individual Table Id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^syn\\d{7,8}$" ] ) ] ;
    skos:definition "The Synapse Id corresponding to a Individual metadata table associated with the Dataset(s)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Individual_id a owl:DatatypeProperty ;
    rdfs:label "Individual_id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^CA\\d{6}-IND\\d{1,9}$" ] ) ] ;
    skos:definition "Unique row identifier, used as a primary key for record updates. This should follow the GrantNumber-INDxxx convention unless otherwise indicated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "12220014" .

