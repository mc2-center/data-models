NCIT:C38046 a owl:Class ;
    rdfs:label "Not Specified",
        "Not specified",
        "Unspecified" ;
    rdfs:subClassOf mc2:AssayEnum,
        mc2:BiospecimenAcquisitionMethodEnum,
        mc2:DSPDatasetAssayEnum,
        mc2:DSPDatasetSpeciesEnum,
        mc2:DSPDatasetTissueEnum,
        mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum,
        mc2:ImageSummaryStatisticEnum,
        mc2:IndividualGenderEnum,
        mc2:IndividualVitalStatusEnum,
        mc2:MeasurementTechniqueEnum,
        mc2:NGSLibrarySelectionMethodEnum,
        mc2:SpeciesEnum,
        mc2:TissueEnum ;
    skos:definition "An indication that the acquisition method was not specified or documented.",
        "An indication that the summary statistic type was not specified or documented.",
        "Indicates that the file format of the associated dataset or file has not been specified by the data submitter.",
        "Library enrichment, screening, or selection is not specified (please include additional info in the “design description”)",
        "Not stated explicitly or in detail." .

mc2:Study_Key a owl:DatatypeProperty ;
    rdfs:label "Study Key" ;
