EDAM:format_1333 a owl:Class ;
    rdfs:label "BLAST Results" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of results from a sequence database search using some variant of BLAST, including score data, alignment data, and summary tables." .

EDAM:format_1457 a owl:Class ;
    rdfs:label "Dot-Bracket Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format for RNA secondary structure using dot-bracket notation, originally generated by the Vienna RNA package/server." .

EDAM:format_1476 a owl:Class ;
    rdfs:label "PDB" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Protein Data Bank (PDB) format, a text-based format for representing macromolecular tertiary structure (atomic coordinates) and associated metadata, as used by PDB database entries." .

EDAM:format_1638 a owl:Class ;
    rdfs:label "cel" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of an Affymetrix CEL data file containing (raw) expression intensity information for individual probes on a microarray." .

EDAM:format_1644 a owl:Class ;
    rdfs:label "CHP" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "Format of an Affymetrix data file containing computed (normalized) expression, genotyping, or resequencing results for individual probes on a microarray, generated by Affymetrix analysis software." .

EDAM:format_1912 a owl:Class ;
    rdfs:label "Nexus Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Phylogenetic tree Nexus (text) format, used to store aligned sequences and/or tree data along with associated metadata blocks." .

EDAM:format_1919 a owl:Class ;
    rdfs:label "Sequence Record Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Data format for a molecular sequence record." .

EDAM:format_1920 a owl:Class ;
    rdfs:label "Sequence Feature Annotation Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Data format for molecular sequence feature information." .

EDAM:format_1921 a owl:Class ;
    rdfs:label "Alignment Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Data format for molecular sequence alignment information." .

EDAM:format_1930 a owl:Class ;
    rdfs:label "FASTQ" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Text-based format for storing both a biological sequence (usually nucleotide) and its corresponding quality scores, most commonly used for raw sequencing reads." .

EDAM:format_1931 a owl:Class ;
    rdfs:label "FASTQ-Illumina" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "FASTQ short read format variant using the Illumina 1.3+ quality-score encoding scheme." .

EDAM:format_1935 a owl:Class ;
    rdfs:label "GCG" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "GCG is a legacy sequence file format originally used by the Genetics Computer Group (GCG) software suite, now part of the Wisconsin Package, for representing annotated nucleotide or protein sequences." .

EDAM:format_1975 a owl:Class ;
    rdfs:label "GFF3" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Generic Feature Format version 3 (GFF3), a tab-delimited format for describing genomic features with a well-defined hierarchy of parent-child relationships." .

EDAM:format_1997 a owl:Class ;
    rdfs:label "Phylip Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "PHYLIP format for (aligned) molecular sequences, used by the PHYLIP phylogenetics software package." .

EDAM:format_1999 a owl:Class ;
    rdfs:label "Scores Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Alignment format for score values associated with pairs of sequences." .

EDAM:format_2006 a owl:Class ;
    rdfs:label "Phylogenetic Tree Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Data format for representing a phylogenetic tree." .

EDAM:format_2030 a owl:Class ;
    rdfs:label "Chemical Data Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of a report on a chemical compound or other chemical data." .

EDAM:format_2031 a owl:Class ;
    rdfs:label "Gene Annotation Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of a report on a particular locus, gene, gene system, or group of genes." .

EDAM:format_2032 a owl:Class ;
    rdfs:label "Workflow Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format used to represent a computational workflow." .

EDAM:format_2033 a owl:Class ;
    rdfs:label "Tertiary Structure Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Data format for a molecular tertiary (3D) structure." .

EDAM:format_2054 a owl:Class ;
    rdfs:label "Protein Interaction Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format for molecular (protein-protein) interaction data." .

EDAM:format_2057 a owl:Class ;
    rdfs:label "Sequence Trace Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format for sequence trace data, including base-call information from a sequencing instrument." .

EDAM:format_2058 a owl:Class ;
    rdfs:label "Gene Expression Report Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of a file of gene expression data, such as a gene expression matrix or profile." .

EDAM:format_2060 a owl:Class ;
    rdfs:label "Map Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "A format used to encode a genetic or physical map, specifying the positions and/or order of markers such as SNPs or genes along a chromosome (e.g. PLINK MAP files)." .

EDAM:format_2066 a owl:Class ;
    rdfs:label "Database Hits (Sequence) Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of a report on sequence hits and associated data from searching a sequence database." .

EDAM:format_2069 a owl:Class ;
    rdfs:label "Sequence Profile Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of a sequence profile, e.g. summarizing conserved positions across a family of aligned sequences." .

EDAM:format_2072 a owl:Class ;
    rdfs:label "Hidden Markov Model Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format for representing a hidden Markov model, e.g. as used for sequence profile searching." .

EDAM:format_2076 a owl:Class ;
    rdfs:label "RNA Secondary Structure Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format for the (predicted or experimentally determined) secondary structure of an RNA molecule." .

EDAM:format_2078 a owl:Class ;
    rdfs:label "Sequence Range Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format used to specify one or more ranges of sequence positions." .

EDAM:format_2170 a owl:Class ;
    rdfs:label "Sequence Cluster Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format used to represent clusters of molecular sequences." .

EDAM:format_2171 a owl:Class ;
    rdfs:label "Sequence Cluster Format (Protein)" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format used to represent clusters of protein sequences." .

EDAM:format_2195 a owl:Class ;
    rdfs:label "Ontology Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "A generic category of formats used for representing ontologies." .

EDAM:format_2206 a owl:Class ;
    rdfs:label "Sequence Feature Table Format (Text)" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Text-based format for a table of sequence features." .

EDAM:format_2305 a owl:Class ;
    rdfs:label "GFF" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "General/Generic Feature Format (GFF) for describing genes and other sequence features, of indeterminate version." .

EDAM:format_2306 a owl:Class ;
    rdfs:label "GTF" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Gene Transfer Format (GTF), a restricted, more strictly-defined version of GFF used to describe gene structure annotations." .

EDAM:format_2333 a owl:Class ;
    rdfs:label "Binary Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "A generic format in which data is encoded as binary, machine-readable content rather than plain text." .

EDAM:format_2548 a owl:Class ;
    rdfs:label "Sequence Feature Table Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format for a table of sequence features." .

EDAM:format_2554 a owl:Class ;
    rdfs:label "Alignment Format (Text)" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Text-based format for molecular sequence alignment information." .

EDAM:format_2556 a owl:Class ;
    rdfs:label "Phylogenetic Tree Format (Text)" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Text-based format for representing a phylogenetic tree." .

EDAM:format_2571 a owl:Class ;
    rdfs:label "Raw Sequence Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of a raw molecular sequence, i.e. specifying only the alphabet/characters used with no additional annotation." .

EDAM:format_2572 a owl:Class ;
    rdfs:label "BAM" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "BAM format, the binary, BGZF-compressed version of SAM format for alignment of nucleotide sequences (e.g. sequencing reads) to a reference sequence; may contain base-call and alignment qualities and other data." .

EDAM:format_2573 a owl:Class ;
    rdfs:label "SAM" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Sequence Alignment/Map (SAM) format, a text-based format for storing alignments of nucleotide sequences (e.g. sequencing reads) to a reference sequence, including base-call and alignment qualities." .

EDAM:format_2585 a owl:Class ;
    rdfs:label "SBML" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Systems Biology Markup Language (SBML), the standard XML format for encoding models of biological processes such as metabolism, cell signaling, and gene regulation." .

EDAM:format_2919 a owl:Class ;
    rdfs:label "Sequence Annotation Track Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of a sequence annotation track, typically displayed as a row of features in a genome browser." .

EDAM:format_2920 a owl:Class ;
    rdfs:label "Alignment Format (Pair Only)" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Data format for molecular sequence alignment information that can hold the alignment of only two sequences." .

EDAM:format_2921 a owl:Class ;
    rdfs:label "Sequence Variation Annotation Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of sequence variation annotation, e.g. describing indels, polymorphisms, or structural variants." .

EDAM:format_2924 a owl:Class ;
    rdfs:label "Phylip Format Variant" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Some non-standard variant of PHYLIP format for (aligned) sequences." .

EDAM:format_3005 a owl:Class ;
    rdfs:label "WIG" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "Wiggle format (WIG) of a sequence annotation track that consists of a value for each sequence position, typically displayed in a genome browser." .

EDAM:format_3006 a owl:Class ;
    rdfs:label "bigWig" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "bigWig format, an indexed binary format for large sequence annotation tracks consisting of a value for each sequence position; similar to the textual WIG format." .

EDAM:format_3016 a owl:Class ;
    rdfs:label "VCF" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Variant Call Format (VCF), a tabular text format for storing genomic sequence variations such as SNPs, indels, and structural variants." .

EDAM:format_3020 a owl:Class ;
    rdfs:label "BCF" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "The binary version of Variant Call Format (VCF) used to store sequence variation data such as indels, polymorphisms, and structural variants." .

EDAM:format_3033 a owl:Class ;
    rdfs:label "Matrix Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of a matrix (array) of numerical values." .

EDAM:format_3161 a owl:Class ;
    rdfs:label "MAGE-ML" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "MAGE-ML, an XML-based format standardized by MGED (now FGED) for representing microarray gene expression data." .

EDAM:format_3162 a owl:Class ;
    rdfs:label "MAGE-TAB" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "MAGE-TAB, a tab-delimited textual format standardized by MGED (now FGED) for representing microarray gene expression data." .

EDAM:format_3235 a owl:Class ;
    rdfs:label "Cytoband Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format for chromosome cytoband data, reflecting a UCSC Genome Browser database table." .

EDAM:format_3244 a owl:Class ;
    rdfs:label "mzML" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "mzML, an XML-based format standardized by HUPO PSI for raw mass spectrometer output data; the successor and unifier of the earlier mzData and mzXML formats." .

EDAM:format_3245 a owl:Class ;
    rdfs:label "Mass Spectrometry Data Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format for mass spectra and derived data, including peptide sequences and related metadata." .

EDAM:format_3247 a owl:Class ;
    rdfs:label "mzIdentML" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "The exchange format for peptides and proteins identified from mass spectra, standardised by HUPO PSI-PI; it can be used for outputs of proteomics search engines." .

EDAM:format_3285 a owl:Class ;
    rdfs:label "MAP" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "MAP files are plain-text files that associate genomic marker positions with identifiers, most commonly the PLINK .map format used in genetics to record chromosome and position information for markers paired with a corresponding genotype file." .

EDAM:format_3287 a owl:Class ;
    rdfs:label "Individual Genetic Data Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format for metadata describing an individual along with their associated genetic data." .

EDAM:format_3464 a owl:Class ;
    rdfs:label "JSON" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "JavaScript Object Notation (JSON), a lightweight, text-based format for representing tree-structured data using key-value pairs." .

EDAM:format_3467 a owl:Class ;
    rdfs:label "GIF" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Graphics Interchange Format, a bitmap image format supporting compression and animation." .

EDAM:format_3468 a owl:Class ;
    rdfs:label "xls" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Microsoft Excel spreadsheet binary file format (.xls), used prior to the introduction of the XML-based .xlsx format." .

EDAM:format_3475 a owl:Class ;
    rdfs:label "TSV" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Tabular data represented as tab-separated values in a text file." .

EDAM:format_3477 a owl:Class ;
    rdfs:label "Cytoscape Input File Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of the Cytoscape input file in which gene expression ratios or values are specified over one or more experiments." .

EDAM:format_3507 a owl:Class ;
    rdfs:label "Document Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of documents, including word processor, spreadsheet, and presentation files." .

EDAM:format_3508 a owl:Class ;
    rdfs:label "PDF" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Portable Document Format (PDF), a fixed-layout document format for reliably presenting text, images, and formatting independent of application, hardware, or operating system." .

EDAM:format_3547 a owl:Class ;
    rdfs:label "Image Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "A generic category of formats used for images and associated image metadata." .

EDAM:format_3554 a owl:Class ;
    rdfs:label "R File Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "File format used for scripts written in the R programming language, executed within the R software environment for statistical computation and graphics." .

EDAM:format_3580 a owl:Class ;
    rdfs:label "rcc" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "Reporter Code Count (RCC) is a data file output by the NanoString nCounter Digital Analyzer, containing gene/sample information, probe information, and probe counts." .

EDAM:format_3583 a owl:Class ;
    rdfs:label "bedgraph" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "BedGraph format, a tab-delimited text format for displaying continuous-valued genomic data (e.g. probability scores) as a track." .

EDAM:format_3586 a owl:Class ;
    rdfs:label "bed12" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A BED file variant in which each feature is described using all twelve standard BED columns, with no non-standard columns allowed." .

EDAM:format_3603 a owl:Class ;
    rdfs:label "PNG" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Portable Network Graphics (PNG), a lossless bitmap image compression format intended to replace GIF." .

EDAM:format_3604 a owl:Class ;
    rdfs:label "SVG" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Scalable Vector Graphics (SVG), an XML-based vector image format for two-dimensional graphics supporting interactivity and animation." .

EDAM:format_3617 a owl:Class ;
    rdfs:label "Graph Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Data format for representing graph data, i.e. a set of nodes and the edges connecting them." .

EDAM:format_3619 a owl:Class ;
    rdfs:label "sif" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Simple Interaction Format (SIF), a plain-text network/pathway format used by tools such as Cytoscape to represent nodes and their interactions." .

EDAM:format_3620 a owl:Class ;
    rdfs:label "xlsx" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Microsoft Excel spreadsheet format (.xlsx) consisting of a set of XML documents packaged in a ZIP-compressed container." .

EDAM:format_3651 a owl:Class ;
    rdfs:label "MGF" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "Mascot Generic Format (MGF) is a text-based file format that encodes multiple tandem mass spectrometry (MS/MS) spectra, with m/z and intensity pairs, in a single file." .

EDAM:format_3654 a owl:Class ;
    rdfs:label "mzXML" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A common file format for proteomics mass spectrometric data developed at the Seattle Proteome Center/Institute for Systems Biology." .

EDAM:format_3682 a owl:Class ;
    rdfs:label "imzML Metadata File" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "The metadata XML file (.imzML) component of the imzML mass spectrometry imaging data format, based on mzML, that stores acquisition and instrument metadata; paired with a binary .ibd file containing the mass spectra." .

EDAM:format_3696 a owl:Class ;
    rdfs:label "PS" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "PostScript format, a page description language used for representing formatted printable or displayable documents and vector graphics." .

EDAM:format_3698 a owl:Class ;
    rdfs:label "SRA" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "SRA archive format is the archive format used for input to, and export from, the NCBI Sequence Read Archive, storing raw next-generation sequencing reads and associated metadata." .

EDAM:format_3709 a owl:Class ;
    rdfs:label "GCT/Res Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Tab-delimited text file format (used by GenePattern) containing a column for each sample, a row for each gene, and an expression value for each gene in each sample." .

EDAM:format_3727 a owl:Class ;
    rdfs:label "OME-TIFF" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Open Microscopy Environment TIFF (OME-TIFF), an image file format consisting of standard TIFF/BigTIFF data with OME-XML metadata embedded in the image description, used to store microscopy image data." .

EDAM:format_3750 a owl:Class ;
    rdfs:label "YAML" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "YAML (YAML Ain't Markup Language), a human-readable, tree-structured data serialization format." .

EDAM:format_3751 a owl:Class ;
    rdfs:label "DSV" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Tabular data represented as values delimited by some (non-comma, non-tab) character in a text file." .

EDAM:format_3752 a owl:Class ;
    rdfs:label "CSV" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Tabular data represented as comma-separated values in a text file." .

EDAM:format_3780 a owl:Class ;
    rdfs:label "Annotated Text Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Data format of an annotated text, e.g. with recognised entities, concepts, and relations." .

EDAM:format_3822 a owl:Class ;
    rdfs:label "GML" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Graph Modeling Language (GML), a plain-text format for describing graph/network data, used by tools such as Cytoscape, Pajek, yEd, and NetworkX." .

EDAM:format_3865 a owl:Class ;
    rdfs:label "RNA Annotation Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "A general category of formats for annotated RNA data, including e.g. microRNA and RNA-Seq data." .

EDAM:format_3866 a owl:Class ;
    rdfs:label "Trajectory Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "File format used to store trajectory information (e.g. atomic coordinates over time) for a 3D structure, such as from a molecular dynamics simulation." .

EDAM:format_3879 a owl:Class ;
    rdfs:label "Topology Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format of topology files containing the static structural information of a molecular system needed for a molecular simulation (e.g. GROMACS TOP, CHARMM PSF, AMBER PRMTOP)." .

EDAM:format_3882 a owl:Class ;
    rdfs:label "PSF" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Protein Structure File (PSF), a structure topology file format used by NAMD and CHARMM molecular simulation programs, containing atoms, bonds, angles, dihedrals, and related force-field terms." .

EDAM:format_3972 a owl:Class ;
    rdfs:label "BNGL" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "BioNetGen Language (BNGL), a format for specifying and simulating rule-based models of biochemical systems such as signal transduction, metabolic, and genetic regulatory networks." .

EDAM:format_3973 a owl:Class ;
    rdfs:label "Docker Image Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "A Docker image is a file, comprised of multiple layers, used to execute code in a Docker container; it packages an application together with its dependencies for a complete, executable environment." .

EDAM:format_3980 a owl:Class ;
    rdfs:label "RPKM" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Tab-delimited format for a gene expression levels table, with values calculated as Reads Per Kilobase of transcript per Million mapped reads (RPKM)." .

EDAM:format_3988 a owl:Class ;
    rdfs:label "LSM" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Zeiss' proprietary microscopy image format (based on TIFF), the default data export format for Zeiss LSM-series confocal microscopes, containing image data plus imaging acquisition settings." .

EDAM:format_3996 a owl:Class ;
    rdfs:label "Python Script" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "File format for scripts written in Python, a widely used high-level, general-purpose programming language." .

EDAM:format_3999 a owl:Class ;
    rdfs:label "R Script" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "Format for scripts written in the R language, an open-source programming language and environment for statistical computing and graphics." .

EDAM:format_4003 a owl:Class ;
    rdfs:label "NumPy Format" ;
    rdfs:subClassOf mc2:ToolInputFormatEnum,
        mc2:ToolOutputFormatEnum ;
    skos:definition "The standard binary file format used by NumPy - a fundamental Python package for scientific computing - for persisting a single arbitrary NumPy array on disk, including its shape and dtype information." .

EDAM:topic_3295 a owl:Class ;
    rdfs:label "Epigenetics" ;
    rdfs:subClassOf mc2:GrantThemeNameEnum,
        mc2:ToolTopicEnum .

BTO:0001020 a owl:Class ;
    rdfs:label "Periodontal Ligament" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The fibrous connective tissue surrounding the root of a tooth that separates it from and attaches it to the alveolar bone." .

DUO:0000004 a owl:Class ;
    rdfs:label "DUO:0000004" ;
    rdfs:subClassOf mc2:DataCatalogDataUseModifiersEnum,
        mc2:DataUseModifiersEnum ;
    skos:definition "This data use permission indicates there is no restriction on use." .

DUO:0000006 a owl:Class ;
    rdfs:label "DUO:0000006" ;
    rdfs:subClassOf mc2:DataCatalogDataUseModifiersEnum,
        mc2:DataUseModifiersEnum ;
    skos:definition "This data use permission indicates that use is allowed for health/medical/biomedical purposes; does not include the study of population origins or ancestry." .

DUO:0000011 a owl:Class ;
    rdfs:label "DUO:0000011" ;
    rdfs:subClassOf mc2:DataCatalogDataUseModifiersEnum,
        mc2:DataUseModifiersEnum ;
    skos:definition "This data use permission indicates that use of the data is limited to the study of population origins or ancestry." .

DUO:0000015 a owl:Class ;
    rdfs:label "DUO:0000015" ;
    rdfs:subClassOf mc2:DataCatalogDataUseModifiersEnum,
        mc2:DataUseModifiersEnum ;
    skos:definition "This data use modifier indicates that use does not allow methods development research (e.g., development of software or algorithms)." .

DUO:0000016 a owl:Class ;
    rdfs:label "DUO:0000016" ;
    rdfs:subClassOf mc2:DataCatalogDataUseModifiersEnum,
        mc2:DataUseModifiersEnum ;
    skos:definition "This data use modifier indicates that use is limited to genetic studies only (i.e., studies that include genotype research alone or both genotype and phenotype research, but not phenotype research exclusively)" .

DUO:0000017 a owl:Class ;
    rdfs:label "DUO:0000017" ;
    rdfs:subClassOf mc2:DataCatalogDataUseModifiersEnum,
        mc2:DataUseModifiersEnum ;
    skos:definition "Data use modifiers indicate additional conditions for use." .

DUO:0000018 a owl:Class ;
    rdfs:label "DUO:0000018" ;
    rdfs:subClassOf mc2:DataCatalogDataUseModifiersEnum,
        mc2:DataUseModifiersEnum ;
    skos:definition "This data use modifier indicates that use of the data is limited to not-for-profit organizations and not-for-profit use, non-commercial use." .

DUO:0000019 a owl:Class ;
    rdfs:label "DUO:0000019" ;
    rdfs:subClassOf mc2:DataCatalogDataUseModifiersEnum,
        mc2:DataUseModifiersEnum ;
    skos:definition "This data use modifier indicates that requestor agrees to make results of studies using the data available to the larger scientific community." .

DUO:0000021 a owl:Class ;
    rdfs:label "DUO:0000021" ;
    rdfs:subClassOf mc2:DataCatalogDataUseModifiersEnum,
        mc2:DataUseModifiersEnum ;
    skos:definition "This data use modifier indicates that the requestor must provide documentation of local IRB/ERB approval." .

DUO:0000027 a owl:Class ;
    rdfs:label "DUO:0000027" ;
    rdfs:subClassOf mc2:DataCatalogDataUseModifiersEnum,
        mc2:DataUseModifiersEnum ;
    skos:definition "This data use modifier indicates that use is limited to use within an approved project." .

DUO:0000029 a owl:Class ;
    rdfs:label "DUO:0000029" ;
    rdfs:subClassOf mc2:DataCatalogDataUseModifiersEnum,
        mc2:DataUseModifiersEnum ;
    skos:definition "This data use modifier indicates that the requestor must return derived/enriched data to the database/resource." .

DUO:0000042 a owl:Class ;
    rdfs:label "DUO:0000042" ;
    rdfs:subClassOf mc2:DataCatalogDataUseModifiersEnum,
        mc2:DataUseModifiersEnum ;
    skos:definition "This data use permission indicates that use is allowed for general research use for any research purpose." .

DUO:0000043 a owl:Class ;
    rdfs:label "DUO:0000043" ;
    rdfs:subClassOf mc2:DataCatalogDataUseModifiersEnum,
        mc2:DataUseModifiersEnum ;
    skos:definition "This data use modifier indicates that use is allowed for clinical use and care." .

DUO:0000044 a owl:Class ;
    rdfs:label "DUO:0000044" ;
    rdfs:subClassOf mc2:DataCatalogDataUseModifiersEnum,
        mc2:DataUseModifiersEnum ;
    skos:definition "This data use modifier indicates use for purposes of population, origin, or ancestry research is prohibited." .

DUO:0000045 a owl:Class ;
    rdfs:label "DUO:0000045" ;
    rdfs:subClassOf mc2:DataCatalogDataUseModifiersEnum,
        mc2:DataUseModifiersEnum ;
    skos:definition "This data use modifier indicates that use of the data is limited to not-for-profit organizations." .

DUO:0000046 a owl:Class ;
    rdfs:label "DUO:0000046" ;
    rdfs:subClassOf mc2:DataCatalogDataUseModifiersEnum,
        mc2:DataUseModifiersEnum ;
    skos:definition "This data use modifier indicates that use of the data is limited to not-for-profit use." .

NCIT:C12252 a owl:Class ;
    rdfs:label "Abdominal Esophagus" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "Clinical esophageal segment composed of smooth muscle. It corresponds to the inferior part of the lower third topographic segment of the esophagus. (NCI)" .

NCIT:C12256 a owl:Class ;
    rdfs:label "Cardia" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The region of the stomach immediately surrounding the gastroesophageal junction, where the esophagus empties into the stomach." .

NCIT:C12263 a owl:Class ;
    rdfs:label "Duodenum" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The portion of the small intestine between the stomach and jejunum." .

NCIT:C12265 a owl:Class ;
    rdfs:label "Ascending Colon" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The first part of the colon (large intestine) that starts in the right lower quadrant of the abdomen and ends at the transverse colon in the right upper quadrant of the abdomen. (NCI)" .

NCIT:C12284 a owl:Class ;
    rdfs:label "Main Bronchus" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The left and right main bronchi considered as a group." .

NCIT:C12309 a owl:Class ;
    rdfs:label "Endocervix" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The portion of the cervix which is lined by single columnar epithelium (mucosa). (NCI)" .

NCIT:C12311 a owl:Class ;
    rdfs:label "Cervix Uteri" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The portion of the uterus (or uterine horns) that empties into the vagina." .

NCIT:C12313 a owl:Class ;
    rdfs:label "Endometrium" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The mucous membrane comprising the inner layer of the uterine wall; it consists of a simple columnar epithelium and a lamina propria that contains simple tubular uterine glands. The structure, thickness, and state of the endometrium undergo marked change with the menstrual cycle." .

NCIT:C12342 a owl:Class ;
    rdfs:label "Cornea" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The transparent, avascular tissue covering the front of the eye and is continuous with the sclera." .

NCIT:C12344 a owl:Class ;
    rdfs:label "Choroid" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "A thin layer of tissue that is part of the middle layer of the wall of the eye, between the sclera (white outer layer of the eye) and the retina (the inner layer of nerve tissue at the back of the eye). The choriod is filled with blood vessels that bring oxygen and nutrients to the eye." .

NCIT:C12348 a owl:Class ;
    rdfs:label "Meninges" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The three thin layers of tissue that cover and protect the brain and spinal cord." .

NCIT:C12352 a owl:Class ;
    rdfs:label "Frontal Lobe" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The part of the brain located anterior to the parietal lobes at the front of each cerebral hemisphere. (NCI)" .

NCIT:C12359 a owl:Class ;
    rdfs:label "Intrathoracic Lymph Nodes" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "Any lymph node within the thoracic cavity." .

NCIT:C12360 a owl:Class ;
    rdfs:label "Intra-Abdominal Lymph Nodes" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "Any lymph node within the abdomen." .

NCIT:C12363 a owl:Class ;
    rdfs:label "Pelvic Lymph Nodes" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "Any lymph node within the pelvic region. (NCI)" .

NCIT:C12366 a owl:Class ;
    rdfs:label "Bone" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The structural organ comprised of specialized connective tissue that forms the skeletal components of the body." .

NCIT:C12367 a owl:Class ;
    rdfs:label "Mammary Gland" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The exocrine glands of the mammae that produce milk in females, and are composed of lobules, alveolar ducts and alveoli." .

NCIT:C12371 a owl:Class ;
    rdfs:label "Heart Muscle" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The muscle tissue of the HEART composed of striated, involuntary muscle known as cardiac muscle." .

NCIT:C12372 a owl:Class ;
    rdfs:label "Artery" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "A blood vessel that carries blood from the heart to tissues and organs in the body." .

NCIT:C12373 a owl:Class ;
    rdfs:label "Cartilage" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "A type of connective tissue composed of chondrocytes and an extracellular matrix, composed of collagen, elastin, and ground substance. There are three types of cartilage; namely elastic, hyaline, and fibrocartilage." .

NCIT:C12376 a owl:Class ;
    rdfs:label "Bile Duct" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "Any of the ducts conveying bile between the liver and the intestine, including hepatic, cystic, and common bile duct." .

NCIT:C12381 a owl:Class ;
    rdfs:label "Caecum" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The blind pouch forming the beginning of the large intestine, located at its junction with the ileum (small intestine), from which the vermiform appendix arises." .

NCIT:C12382 a owl:Class ;
    rdfs:label "Colon" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The portion of the large intestine which extends from the cecum (or small intestine in animals that don't have a cecum) to the rectum." .

NCIT:C12386 a owl:Class ;
    rdfs:label "Small Intestine" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The villous section of the intestine extending from the pylorus to the proximal large intestine." .

NCIT:C12389 a owl:Class ;
    rdfs:label "Esophagus" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The portion of the digestive tract between the pharynx and stomach." .

NCIT:C12390 a owl:Class ;
    rdfs:label "Rectum" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The terminal portion of the large intestine extending from the terminus of the colon to the anus or anal canal." .

NCIT:C12391 a owl:Class ;
    rdfs:label "Stomach" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The portion of the gastrointestinal tract located between the esophagus and the proximal duodenum." .

NCIT:C12392 a owl:Class ;
    rdfs:label "Liver" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "An abdominal organ that has variable lobation which are composed mainly of hepatic lobules." .

NCIT:C12393 a owl:Class ;
    rdfs:label "Pancreas" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "An organ behind the lower part of the stomach that is the shape of a fish and about the size of a hand. It is a compound gland composed of both exocrine and endocrine tissues. The endocrine pancreas makes insulin so that the body can use glucose (sugar) for energy. The exocrine pancreas makes enzymes that help the body digest food. Spread all over the pancreas are areas called the Islets of Langerhans. The cells in these areas each have a special purpose. The alpha cells make glucagon, which raises the level of glucose in the blood; the beta cells make insulin; the delta cells make somatostatin. There are also PP cells and D1 cells, about which little is known." .

NCIT:C12394 a owl:Class ;
    rdfs:label "Ear" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "A sensory organ that contains auditory and vestibular apparatuses." .

NCIT:C12399 a owl:Class ;
    rdfs:label "Pituitary Gland" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The main endocrine gland. It produces hormones that control other glands and many body functions, especially growth." .

NCIT:C12400 a owl:Class ;
    rdfs:label "Thyroid Gland" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "Endocrine gland(s) adjacent to the trachea in mammals that produce thyroxine and other hormones." .

NCIT:C12401 a owl:Class ;
    rdfs:label "Eye" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The sensory organ of vision." .

NCIT:C12403 a owl:Class ;
    rdfs:label "Fallopian Tube" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The tube through which eggs pass from an ovary." .

NCIT:C12404 a owl:Class ;
    rdfs:label "Ovary" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The pair of female reproductive glands in which the ova, or eggs, are formed. The ovaries are located in the pelvis, one on each side of the uterus." .

NCIT:C12405 a owl:Class ;
    rdfs:label "Uterus" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The small, hollow, pear-shaped organ in a woman's pelvis. This is the organ in which a fetus develops." .

NCIT:C12407 a owl:Class ;
    rdfs:label "Vagina" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The muscular canal extending from the uterus to the exterior of the body." .

NCIT:C12410 a owl:Class ;
    rdfs:label "Prostate Gland" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The walnut shaped accessory sex gland of the male reproductive system. It is located in the pelvis just below the bladder, surrounding the prostatic part of the urethra. The prostate gland secretes a fluid which is part of the semen." .

NCIT:C12412 a owl:Class ;
    rdfs:label "Testis" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The male gonad." .

NCIT:C12414 a owl:Class ;
    rdfs:label "Bladder" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The organ that stores urine." .

NCIT:C12415 a owl:Class ;
    rdfs:label "Kidney" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The organs of the urinary tract located in the retroperitoneal cavity adjacent to the spine and composed of the renal cortex and the renal medulla." .

NCIT:C12418 a owl:Class ;
    rdfs:label "Head and Neck" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The area of the body comprising the skull, facial bones and the cervical vertebrae, sinuses, orbits, salivary glands, oral cavity, oropharynx, larynx, thyroid, facial and neck musculature, soft tissue and lymph nodes draining these areas." .

NCIT:C12420 a owl:Class ;
    rdfs:label "Larynx" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The cartilaginous structure of the respiratory tract between the pharynx and the trachea. It contains elastic vocal cords required for sound production." .

NCIT:C12421 a owl:Class ;
    rdfs:label "Oral Cavity" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The cavity of the mouth." .

NCIT:C12422 a owl:Class ;
    rdfs:label "Tongue" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The muscular organ located in the floor of the mouth and serving as the principal organ of taste and modification of the voice in speech." .

NCIT:C12424 a owl:Class ;
    rdfs:label "Nasal Cavity" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The upper respiratory tract extending from the nares to the pharynx." .

NCIT:C12425 a owl:Class ;
    rdfs:label "Pharynx" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The hollow tube inside the neck that starts behind the nose and ends at the top of the trachea (windpipe) and esophagus (the tube that goes to the stomach). The pharynx is about 5 inches long, depending on body size." .

NCIT:C12426 a owl:Class ;
    rdfs:label "Salivary Gland" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "Any number of exocrine glands that secrete saliva into the oral cavity." .

NCIT:C12428 a owl:Class ;
    rdfs:label "Trachea" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The fibrocartilaginous, mucous-lined tube passing from the larynx to the bronchi." .

NCIT:C12431 a owl:Class ;
    rdfs:label "Bone Marrow" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The tissue occupying the spaces of some bones. It consists of blood vessel sinuses and a network of hematopoietic cells." .

NCIT:C12432 a owl:Class ;
    rdfs:label "Spleen" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "An organ that is part of the lymphatic system. The spleen produces lymphocytes, filters the blood, stores blood cells, and destroys old blood cells. It is located on the left side of the abdomen near the stomach." .

NCIT:C12433 a owl:Class ;
    rdfs:label "Thymus" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "An organ that is part of the lymphatic system, in which T lymphocytes grow and multiply. The thymus is in the chest behind the breastbone." .

NCIT:C12434 a owl:Class ;
    rdfs:label "Blood" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "A tissue with red blood cells, white blood cells, platelets, and other substances suspended in fluid called plasma. Blood takes oxygen and nutrients to the tissues, and carries away wastes." .

NCIT:C12439 a owl:Class ;
    rdfs:label "Brain" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "An organ composed of grey and white matter containing billions of neurons that is the center for intelligence and reasoning. It is protected by the bony cranium." .

NCIT:C12444 a owl:Class ;
    rdfs:label "Hippocampus" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "A curved gray matter structure of the temporal lobe lying on the floor of the lateral ventricle of the brain." .

NCIT:C12464 a owl:Class ;
    rdfs:label "Spinal Cord" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The portion of the central nervous system that lies within the vertebral canal and from which the spinal nerves emerge." .

NCIT:C12465 a owl:Class ;
    rdfs:label "Peripheral Nerves" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The nerves outside of the brain and spinal cord, including the autonomic, cranial, and spinal nerves. Peripheral nerves contain non-neuronal cells and connective tissue as well as axons. The connective tissue layers include, from the outside to the inside, the epineurium, the perineurium, and the endoneurium." .

NCIT:C12468 a owl:Class ;
    rdfs:label "Lung" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "One of a pair of viscera occupying the pulmonary cavities of the thorax, the organs of respiration in which aeration of the blood takes place. As a rule, the right lung is slightly larger than the left and is divided into three lobes (an upper, a middle, and a lower or basal), while the left has two lobes (an upper and a lower or basal). Each lung is irregularly conical in shape, presenting a blunt upper extremity (the apex), a concave base following the curve of the diaphragm, an outer convex surface (costal surface), an inner or mediastinal surface (mediastinal surface), a thin and sharp anterior border, and a thick and rounded posterior border." .

NCIT:C12469 a owl:Class ;
    rdfs:label "Pleura" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The tissue that lines the wall of the thoracic cavity and the surface of the lungs." .

NCIT:C12470 a owl:Class ;
    rdfs:label "Skin" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "An organ that constitutes the external surface of the body. It consists of the epidermis, dermis, and skin appendages. (NCI)" .

NCIT:C12472 a owl:Class ;
    rdfs:label "Adipose Tissue" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "Connective tissue consisting primarily of adipocytes (fat cells) and supporting structural matrix." .

NCIT:C12473 a owl:Class ;
    rdfs:label "Synovial Membrane" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The inner layer of the connective tissue that seals the joint." .

NCIT:C12481 a owl:Class ;
    rdfs:label "Endothelium" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The layer of cells that lines the cavities of the heart and of the blood vessels (Endothelium, Vascular) and lymph vessels (Endothelium, Lymphatic), and the serous cavities of the body, originating from the mesoderm." .

NCIT:C12508 a owl:Class ;
    rdfs:label "Cell",
        "Whole Cell" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum,
        mc2:ImageObjectClassEnum ;
    skos:definition "The smallest unit of living structure capable of independent existence, composed of a membrane-enclosed mass of protoplasm containing a nucleus or nucleoid.",
        "The smallest units of living structure capable of independent existence, composed of a membrane-enclosed mass of protoplasm and containing a nucleus or nucleoid." .

NCIT:C12666 a owl:Class ;
    rdfs:label "Adrenal Gland" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The endocrine glands adjacent to the kidneys that consist of the outer adrenal cortex and the inner adrenal medulla in mammals." .

NCIT:C12669 a owl:Class ;
    rdfs:label "Aorta" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The major artery of the body; it arises from the left ventricle of the heart and terminally bifurcates into the common iliac arteries." .

NCIT:C12679 a owl:Class ;
    rdfs:label "Blood Vessel" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "A tubular structure through which the blood circulates in the body. Blood vessels constitute a network composed of arteries, arterioles, capillaries, venules, and veins. (NCI)" .

NCIT:C12710 a owl:Class ;
    rdfs:label "Epithelium" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The avascular cellular layers that cover body surfaces and cavities and may form glands." .

NCIT:C12725 a owl:Class ;
    rdfs:label "Gonad" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The part of the reproductive system that produces and releases eggs (ovaries) or sperm (testicles/testes)." .

NCIT:C12727 a owl:Class ;
    rdfs:label "Heart" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "A hollow organ located slightly to the left of the middle portion of the chest. It is composed of muscle and it is divided by a septum into two sides: the right side which receives de-oxygenated blood from the body and the left side which sends newly oxygenated blood to the body. Each side is composed of two chambers: the atrium (receiving blood) and ventricle (ejecting blood)." .

NCIT:C12736 a owl:Class ;
    rdfs:label "Intestine" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The portion of the gastrointestinal tract that includes the small and large intestines." .

NCIT:C12745 a owl:Class ;
    rdfs:label "Lymph Node" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "Secondary lymphoid organ associated with lymphatic vessels and consisting of an outer cortex, inner medulla and sinuses." .

NCIT:C12746 a owl:Class ;
    rdfs:label "Lymphatic System" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The tissues and organs that produce, store, and carry white blood cells that fight infections and other diseases. This system includes the bone marrow, spleen, thymus, lymph nodes, and lymphatic vessels (a network of thin tubes that carry lymph and white blood cells). Lymphatic vessels branch, like blood vessels, into all the tissues of the body." .

NCIT:C12755 a owl:Class ;
    rdfs:label "Nervous System" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The organized network of nerve tissue in the body. It includes the central nervous system (the brain and spinal cord), the peripheral nervous system (nerves that extend from the spinal cord to the rest of the body), and other nerve tissue." .

NCIT:C12770 a owl:Class ;
    rdfs:label "Peritoneum" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The tissue that lines the wall of the abdominal cavity, intestine, mesentery, and pelvic organs. It consists of the parietal peritoneum and the visceral peritoneum." .

NCIT:C12779 a owl:Class ;
    rdfs:label "Respiratory System" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The organs that are involved in breathing. These include the nose, throat, larynx, trachea, bronchi, and lungs." .

NCIT:C12784 a owl:Class ;
    rdfs:label "Sclera" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The white, opaque, fibrous, outer tunic of the eyeball, covering it entirely excepting the segment covered anteriorly by the cornea. It is essentially avascular but contains apertures for vessels, lymphatics, and nerves. It receives the tendons of insertion of the extraocular muscles and at the corneoscleral junction contains the canal of Schlemm. (From Cline et al., Dictionary of Visual Science, 4th ed)" .

NCIT:C12802 a owl:Class ;
    rdfs:label "Tonsil" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "excludes lingual tonsil C02.4 and pharyngeal tonsil C11.1" .

NCIT:C12810 a owl:Class ;
    rdfs:label "Genitourinary" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "Of or related to the genital and urinary organs or their functions." .

NCIT:C12814 a owl:Class ;
    rdfs:label "Vein" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "A blood vessel that carries blood towards the heart." .

NCIT:C12841 a owl:Class ;
    rdfs:label "Reproductive System" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The organs and tissues involved in the production and maturation of gametes and in their union and subsequent development as offspring." .

NCIT:C12904 a owl:Class ;
    rdfs:label "Lymph Nodes of Axilla or Arm" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "One of approximately 20-30 lymph nodes in chain formation that traverse the concavity of the underarm to the clavicle." .

NCIT:C12909 a owl:Class ;
    rdfs:label "Hematopoietic System" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The bodily system of organs and tissues, primarily the bone marrow, spleen, tonsils, and lymph nodes, involved in the production of blood." .

NCIT:C12933 a owl:Class ;
    rdfs:label "Vertebra" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "Any of the ring-shaped bony structures that constitute the spinal column and surround the spinal cord." .

NCIT:C12954 a owl:Class ;
    rdfs:label "Peripheral Blood Mononuclear Cell" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "A peripheral blood cell with a single nucleus. This category includes lymphocytes and monocytes." .

NCIT:C12964 a owl:Class ;
    rdfs:label "Connective and Soft Tissue" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The supporting connective tissue of an organ." .

NCIT:C12971 a owl:Class ;
    rdfs:label "Breast" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "One of two hemispheric projections of variable size situated in the subcutaneous layer over the pectoralis major muscle on either side of the chest. (NCI)" .

NCIT:C12986 a owl:Class ;
    rdfs:label "Alveolus" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "Tiny air sacs at the end of the bronchioles (tiny branches of air tubes) in the lungs. The alveoli are where the lungs and the bloodstream exchange carbon dioxide and oxygen. Carbon dioxide in the blood passes into the lungs through the alveoli. Oxygen in the lungs passes through the alveoli into the blood." .

NCIT:C13044 a owl:Class ;
    rdfs:label "Joint" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "is an organ that constitutes an anatomical junction; it consists of two or more adjacent bones, parts of which are interconnected by organ parts that consist of various types of connective tissue. Together with other joints and bones, a joint constitutes the skeletal system. Example(s): pubic symphysis, knee joint, temporomandibular joint." .

NCIT:C13045 a owl:Class ;
    rdfs:label "Tendon" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "Tough, fibrous, cord-like tissue that connects muscle to bone or another structure, such as an eyeball. Tendons help the bone or structure to move." .

NCIT:C13046 a owl:Class ;
    rdfs:label "Ligament" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "Band of fibrous tissue connecting bone to bone or cartilage to bone thereby supporting or strengthening a joint. (NCI)" .

NCIT:C13053 a owl:Class ;
    rdfs:label "Vascular Endothelium" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The layer of simple squamous epithelial tissue that lines the luminal surface of the entire circulatory system." .

NCIT:C13056 a owl:Class ;
    rdfs:label "Muscle" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "One of the contractile organs of the body." .

NCIT:C13166 a owl:Class ;
    rdfs:label "Mucosa" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "Mucous membrane." .

NCIT:C13252 a owl:Class ;
    rdfs:label "Lymph" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The clear fluid that travels through the lymphatic system and carries cells that help fight infections and other diseases." .

NCIT:C13272 a owl:Class ;
    rdfs:label "Placenta" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The organ that nourishes the developing fetus in the uterus." .

NCIT:C13301 a owl:Class ;
    rdfs:label "Mesenchyme" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "Embryonic tissue of mesodermal origin.  Develops into connective tissue, blood vessels, and lymphatic tissue." .

NCIT:C13317 a owl:Class ;
    rdfs:label "Hair Follicle" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "A tube-like invagination of the epidermis from which the hair shaft develops and into which the sebaceous glands open; the follicle is lined by a cellular inner and outer root sheath of epidermal origin and is invested with a fibrous sheath derived from the dermis. (NCI)" .

NCIT:C133726 a owl:Class ;
    rdfs:label "Foundation Medicine Inc" ;
    rdfs:subClassOf mc2:ConsortiumFundingAgencyEnum,
        mc2:FunderEnum .

NCIT:C142663 a owl:Class ;
    rdfs:label "Level 1" ;
    rdfs:subClassOf mc2:DSPDatasetLevelEnum,
        mc2:FileLevelEnum ;
    skos:definition "Raw or minimally processed data" .

NCIT:C153249 a owl:Class ;
    rdfs:label "BAM" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A binary representation of a sequence alignment map (SAM), a compact and indexable representation of nucleotide sequence alignments, compressed using the BGZF (Blocked GNU Zip Format) library." .

NCIT:C158521 a owl:Class ;
    rdfs:label "Broad Institute" ;
    rdfs:subClassOf mc2:ConsortiumFundingAgencyEnum,
        mc2:FunderEnum .

NCIT:C162623 a owl:Class ;
    rdfs:label "Normal" ;
    rdfs:subClassOf mc2:BiospecimenCompositionEnum,
        mc2:BiospecimenTumorStatusEnum ;
    skos:definition "Tissue sample with cellular composition and architectural patterns expected for the particular anatomic site in which it belongs. There is no evidence of abnormal cellular infiltrates or tumor mass formation.",
        "Tissue sample with cellular composition and architectural patterns expected for the particular anatomic site in which it belongs; no evidence of abnormal cellular infiltrates or tumor mass formation." .

NCIT:C162692 a owl:Class ;
    rdfs:label "SVS" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "SVS is a proprietary, pyramidal TIFF-based whole-slide image file format produced by Aperio (Leica Biosystems) digital slide scanners, used to store high-resolution histopathology images." .

NCIT:C164049 a owl:Class ;
    rdfs:label "TSV" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A file format where each line in the file contains a single piece of data and where each field or value in a line of data is separated from the next by a tab character." .

NCIT:C164050 a owl:Class ;
    rdfs:label "xlsx" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A proprietary file format developed by Microsoft that allows the user to save a spreadsheet created in Excel in an open XML format; the file can be read and opened by other spreadsheet-compatible applications." .

NCIT:C16565 a owl:Class ;
    rdfs:label "Evolution" ;
    rdfs:subClassOf mc2:GrantThemeNameEnum,
        mc2:ResourceTopicEnum ;
    skos:definition "The process by which populations of organisms change over successive generations through mechanisms such as mutation, genetic drift, and natural selection." .

NCIT:C16576 a owl:Class ;
    rdfs:label "Female" ;
    rdfs:subClassOf mc2:IndividualGenderEnum,
        mc2:SexEnum ;
    skos:definition "An individual who belongs to the sex that normally produces ova." .

NCIT:C168534 a owl:Class ;
    rdfs:label "Cancer-Associated Fibroblast" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "A fibroblast found proximal to or within cancerous tissue." .

NCIT:C16895 a owl:Class ;
    rdfs:label "National Institutes of Health" ;
    rdfs:subClassOf mc2:ConsortiumFundingAgencyEnum,
        mc2:FunderEnum .

NCIT:C172216 a owl:Class ;
    rdfs:label "VCF" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A text-based electronic file used for storing gene sequence variation data. The first text section is composed of a header containing the metadata and keywords used in the file, followed by the body of the file which is tab-separated into eight mandatory data columns for each sample, plus optional columns for other sample-related data." .

NCIT:C17237 a owl:Class ;
    rdfs:label "Food and Drug Administration" ;
    rdfs:subClassOf mc2:ConsortiumFundingAgencyEnum,
        mc2:FunderEnum .

NCIT:C172484 a owl:Class ;
    rdfs:label "Semiautomatic" ;
    rdfs:subClassOf mc2:DeidentificationTypeEnum,
        mc2:StudyDeidentificationMethodTypeEnum ;
    skos:definition "Of or related to a method or process performed using a combination of manual and automatic means." .

NCIT:C17609 a owl:Class ;
    rdfs:label "Tumor Progression" ;
    rdfs:subClassOf mc2:GrantThemeNameEnum,
        mc2:ResourceTopicEnum ;
    skos:definition "A pathologic process in which molecular alterations result in a more aggressive cytologic and phenotypic profile and clinical course of a neoplasm over time." .

NCIT:C182456 a owl:Class ;
    rdfs:label "CSV" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A text file format that separates data elements with commas." .

NCIT:C184762 a owl:Class ;
    rdfs:label "IDAT" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A proprietary, encrypted, compressed electronic file format from Illumina Inc. for storing genome-wide profiling data. The data contains a summary of the intensity data generated from each probe used during a sequencing or array run." .

NCIT:C184763 a owl:Class ;
    rdfs:label "HDF5" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A hierarchical, filesystem-like data format that can store metadata in the form of user-defined, named attributes, which are attached to groups and datasets, and representations of images and tables built up using datasets, groups and attributes." .

NCIT:C184769 a owl:Class ;
    rdfs:label "JSON" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A common open standard file format and data interchange format that uses human-readable text consisting of attribute-value pairs and arrays to store and transmit data." .

NCIT:C185402 a owl:Class ;
    rdfs:label "Formalin Fixed - Unbuffered",
        "Formalin fixed-unbuffered" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMediumEnum,
        mc2:BiospecimenPreservationMethodEnum ;
    skos:definition "The use of unbuffered formalin for preservation of tissue samples.",
        "Unbuffered Formalin Fixation" .

NCIT:C185403 a owl:Class ;
    rdfs:label "Formalin Fixed - Buffered",
        "Formalin fixed-buffered" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMediumEnum,
        mc2:BiospecimenPreservationMethodEnum ;
    skos:definition "Buffered Formalin Fixation",
        "The use of buffered formalin for preservation of tissue samples." .

NCIT:C190162 a owl:Class ;
    rdfs:label "AVI" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A multimedia container format for audio video interleaved (AVI) files that allows for synchronous audio-with-video playback." .

NCIT:C190163 a owl:Class ;
    rdfs:label "BAI" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "An index file associated with a binary alignment map (BAM) file, a compressed binary version of a sequence alignment/map (SAM) file, used to enable rapid random access to alignment records." .

NCIT:C190165 a owl:Class ;
    rdfs:label "bedgraph" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A format that allows display of continuous-valued data in track format. This display type is useful for probability scores and transcriptome data." .

NCIT:C190167 a owl:Class ;
    rdfs:label "BIGWIG" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A format for large sequence annotation tracks that consist of a value for each sequence position, similar to the textual wiggle (WIG) format, but indexed and compressed for efficient random access." .

NCIT:C190171 a owl:Class ;
    rdfs:label "docx" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A file type that uses Open XML Document format to store data for Microsoft Word and other compatible programs." .

NCIT:C190175 a owl:Class ;
    rdfs:label "GFF3" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A tab-separated format for sequence data. It uses one line per feature, each containing 9 columns of data, plus optional track definition lines." .

NCIT:C190177 a owl:Class ;
    rdfs:label "GTF" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A tab-delimited text format based on the general feature format (GFF) but which also contains some additional information for each gene." .

NCIT:C190184 a owl:Class ;
    rdfs:label "Python Script" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A plain text file that stores python code." .

NCIT:C190186 a owl:Class ;
    rdfs:label "R File Format" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "R is a tool for data manipulation and analysis, both a programming language and a working environment; the format is used for writing and executing scripts, typically for statistical computation and graphics, and for storing complete R workspaces or selected R objects." .

NCIT:C190189 a owl:Class ;
    rdfs:label "TAR Format" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A file format generated by the Unix command-line utility tar (tape archive). It is used for collecting many files into one archive file." .

NCIT:C190190 a owl:Class ;
    rdfs:label "RAW" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A proprietary file format developed by Thermo Scientific to capture mass spectrometry data produced by Thermo mass spectrometers." .

NCIT:C190191 a owl:Class ;
    rdfs:label "xls" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A proprietary binary file format used to store spreadsheet data in Microsoft Excel." .

NCIT:C190192 a owl:Class ;
    rdfs:label "ZIP" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "An archive file format that supports lossless data compression. It is used to compress one or more files together into a single location." .

NCIT:C19095 a owl:Class ;
    rdfs:label "Tumor-Immune" ;
    rdfs:subClassOf mc2:GrantThemeNameEnum,
        mc2:ResourceTopicEnum ;
    skos:definition "The study of the interactions between the immune system and tumor cells, including immune surveillance, immune evasion, and immune-based responses to cancer." .

NCIT:C191737 a owl:Class ;
    rdfs:label "cel" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A type of file that stores the results of intensity calculations of pixel values for DNA microarray image analysis, including intensity values, standard deviation, pixel counts, and outlier/exclusion flags for each feature on the probe array." .

NCIT:C19202 a owl:Class ;
    rdfs:label "National Cancer Institute" ;
    rdfs:subClassOf mc2:ConsortiumFundingAgencyEnum,
        mc2:FunderEnum .

NCIT:C19217 a owl:Class ;
    rdfs:label "Division of Cancer Control and Population Sciences" ;
    rdfs:subClassOf mc2:ConsortiumFundingAgencyEnum,
        mc2:FunderEnum .

NCIT:C19225 a owl:Class ;
    rdfs:label "Department of Defense" ;
    rdfs:subClassOf mc2:ConsortiumFundingAgencyEnum,
        mc2:FunderEnum .

NCIT:C19536 a owl:Class ;
    rdfs:label "Metabolism" ;
    rdfs:subClassOf mc2:GrantThemeNameEnum,
        mc2:ResourceTopicEnum ;
    skos:definition "The organic biochemical processes within a cell or organism that are necessary to sustain life, encompassing both anabolic (biosynthetic) and catabolic (degradative) reactions." .

NCIT:C19590 a owl:Class ;
    rdfs:label "MDA",
        "WGA" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum,
        mc2:NGSLibraryStrategyEnum ;
    skos:definition "Multiple displacement amplification",
        "Random sequencing of the whole genome following non-pcr amplification" .

NCIT:C19597 a owl:Class ;
    rdfs:label "Methacarn fixed paraffin embedded - MFPE",
        "Paraffin Block" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMediumEnum,
        mc2:BiospecimenPreservationMethodEnum ;
    skos:definition "A tissue sample that has been fixed with Methacarn and embedded in paraffin for long-term preservation and histological analysis.",
        "Paraffin Embedded Tissue" .

NCIT:C20160 a owl:Class ;
    rdfs:label "NCI Center for Cancer Research" ;
    rdfs:subClassOf mc2:ConsortiumFundingAgencyEnum,
        mc2:FunderEnum .

NCIT:C201789 a owl:Class ;
    rdfs:label "MTX" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A format for the storage of numerical or pattern matrices in a dense (array format) or sparse (coordinate format) representation." .

NCIT:C20197 a owl:Class ;
    rdfs:label "Male" ;
    rdfs:subClassOf mc2:IndividualGenderEnum,
        mc2:SexEnum ;
    skos:definition "An individual who belongs to the sex that normally produces sperm." .

NCIT:C204821 a owl:Class ;
    rdfs:label "5-methylcytidine antibody",
        "MeDIP-Seq" ;
    rdfs:subClassOf mc2:NGSLibrarySelectionMethodEnum,
        mc2:NGSLibraryStrategyEnum ;
    skos:definition "Methylated DNA Immunoprecipitation Sequencing strategy",
        "Selection of methylated DNA fragments using an antibody raised against 5-methylcytosine or 5-methylcytidine (m5C)" .

NCIT:C209896 a owl:Class ;
    rdfs:label "RTF" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A file format that contains various formatting elements and enables exchanges of text files across different word processing platforms and applications." .

NCIT:C217035 a owl:Class ;
    rdfs:label "Evelyn H. Lauder Founder’s Fund for Metastatic Breast Cancer Research" ;
    rdfs:subClassOf mc2:ConsortiumFundingAgencyEnum,
        mc2:FunderEnum .

NCIT:C217036 a owl:Class ;
    rdfs:label "Center for Inherited Disease Research" ;
    rdfs:subClassOf mc2:ConsortiumFundingAgencyEnum,
        mc2:FunderEnum .

NCIT:C217037 a owl:Class ;
    rdfs:label "Leukemia and Lymphoma Society" ;
    rdfs:subClassOf mc2:ConsortiumFundingAgencyEnum,
        mc2:FunderEnum .

NCIT:C217038 a owl:Class ;
    rdfs:label "Multiple Myeloma Research Foundation" ;
    rdfs:subClassOf mc2:ConsortiumFundingAgencyEnum,
        mc2:FunderEnum .

NCIT:C217039 a owl:Class ;
    rdfs:label "National Clinical Trials Network" ;
    rdfs:subClassOf mc2:ConsortiumFundingAgencyEnum,
        mc2:FunderEnum ;
    skos:definition "National Clinical Trials Network (NCI)" .

NCIT:C217040 a owl:Class ;
    rdfs:label "Proteogenomic Translational Research Centers" ;
    rdfs:subClassOf mc2:ConsortiumFundingAgencyEnum,
        mc2:FunderEnum ;
    skos:definition "Proteogenomic Translational Research Center" .

NCIT:C217041 a owl:Class ;
    rdfs:label "Transplant Recipients International Organization" ;
    rdfs:subClassOf mc2:ConsortiumFundingAgencyEnum,
        mc2:FunderEnum .

NCIT:C224009 a owl:Class ;
    rdfs:label "pptx" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A visual design format that includes layout, fonts, colors, and aspect ratios for slide-based presentations. PPTX is an XML-based format that is the default for modern Microsoft PowerPoint files." .

NCIT:C224011 a owl:Class ;
    rdfs:label "PZFX" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "An XML-based file format used by GraphPad Prism software to store analysis projects, including data tables, graphs, and statistical results." .

NCIT:C28147 a owl:Class ;
    rdfs:label "Embryo" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "Early stage in the prenatal development of an animal. This stage occurs from implantation until closure of the hard palate." .

NCIT:C28359 a owl:Class ;
    rdfs:label "Heterogeneity" ;
    rdfs:subClassOf mc2:GrantThemeNameEnum,
        mc2:ResourceTopicEnum ;
    skos:definition "The quality or state of consisting of elements that are not of the same kind or nature, such as variability among cells, tissues, or tumors within a biological system." .

NCIT:C3261 a owl:Class ;
    rdfs:label "Metastatic",
        "Metastatic Neoplasm" ;
    rdfs:subClassOf mc2:BiospecimenCompositionEnum,
        mc2:BiospecimenPathologyEnum ;
    skos:definition "A malignant tumor that has spread from its original site of growth to another anatomic location.",
        "A tumor that has spread from its original site of growth to another anatomic site." .

NCIT:C3262 a owl:Class ;
    rdfs:label "Neoplasms; NOS",
        "Tumor" ;
    rdfs:subClassOf mc2:BiospecimenTypeEnum,
        mc2:DiseaseTypeEnum ;
    skos:definition "An abnormal mass of tissue that results from excessive cell division; used broadly to denote a neoplasm, which may be benign or malignant.",
        "An abnormal tissue growth resulting from uncontrolled and progressive cell proliferation; may be benign or malignant." .

NCIT:C32668 a owl:Class ;
    rdfs:label "Gastroesophageal Junction" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The place where the esophagus is connected to the stomach." .

NCIT:C32801 a owl:Class ;
    rdfs:label "Lymph Nodes of Inguinal Region or Leg" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "Any lymph node that is located in the inguinal region or in either leg." .

NCIT:C33049 a owl:Class ;
    rdfs:label "Foreskin" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The loose skin that covers the head of the penis." .

NCIT:C33205 a owl:Class ;
    rdfs:label "Olfactory Mucosa" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The part of the nasal mucosa composed of neuroepithelial tissue and mucus-producing Bowman's glands. The mucus moistens the epithelium and helps dissolve odor-containing gases." .

NCIT:C33209 a owl:Class ;
    rdfs:label "Omentum" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "A fold of the peritoneum (the thin tissue that lines the abdomen) that surrounds the stomach and other organs in the abdomen." .

NCIT:C34082 a owl:Class ;
    rdfs:label "Gastrointestinal Tract" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The upper gastrointestinal (GI) tract is comprised of mouth, pharynx, esophagus and stomach while the lower GI tract consists of intestines and anus. The primary function of the GI tract is to ingest, digest, absorb and ultimately excrete food stuff. (NCI)" .

NCIT:C34153 a owl:Class ;
    rdfs:label "Embryonic Heart" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The rudimentary heart found in the human embryo that begins development during the third week of gestation, and which is formed by paired endocardial heart tubes derived from splanchnic mesenchyme, which subsequently fuse to form the primitive heart." .

NCIT:C34320 a owl:Class ;
    rdfs:label "Umbilical Cord" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "Extraembryonic structure that connects the fetus to the placenta. It contains two arteries and one vein." .

NCIT:C39343 a owl:Class ;
    rdfs:label "Knight Cancer Institute" ;
    rdfs:subClassOf mc2:ConsortiumFundingAgencyEnum,
        mc2:FunderEnum .

NCIT:C39502 a owl:Class ;
    rdfs:label "Purdue University Center for Cancer Research" ;
    rdfs:subClassOf mc2:ConsortiumFundingAgencyEnum,
        mc2:FunderEnum .

NCIT:C39530 a owl:Class ;
    rdfs:label "Georgetown Lombardi Comprehensive Cancer Center" ;
    rdfs:subClassOf mc2:ConsortiumFundingAgencyEnum,
        mc2:FunderEnum .

NCIT:C39554 a owl:Class ;
    rdfs:label "UNC Lineberger Comprehensive Cancer Center" ;
    rdfs:subClassOf mc2:ConsortiumFundingAgencyEnum,
        mc2:FunderEnum .

NCIT:C40413 a owl:Class ;
    rdfs:label "No Disease",
        "No Evidence of Disease" ;
    rdfs:subClassOf mc2:BiospecimenIncidenceTypeEnum,
        mc2:TreatmentResponseEnum ;
    skos:definition "Diagnostic tests fail to detect presence of disease." .

NCIT:C45908 a owl:Class ;
    rdfs:label "Intersex" ;
    rdfs:subClassOf mc2:IndividualGenderEnum,
        mc2:SexEnum ;
    skos:definition "Refers to an individual who was born with genitalia and/or secondary sexual characteristics of indeterminate sex, or which combine features of both sexes.",
        "Refers to an individual who was born with genitalia, chromosomes, or reproductive organs that do not fit typical definitions for either male or female." .

NCIT:C4798 a owl:Class ;
    rdfs:label "Recurrent Neoplasm",
        "Recurrent Tumor" ;
    rdfs:subClassOf mc2:BiospecimenPathologyEnum,
        mc2:BiospecimenTypeEnum ;
    skos:definition "A lesion that has reappeared at the original site of a neoplasm after a period of remission.",
        "A tumor specimen collected after the reemergence of cancer at the original or a related site following a period of remission." .

NCIT:C49487 a owl:Class ;
    rdfs:label "No",
        "No - Channel Failed QC" ;
    rdfs:subClassOf mc2:ChannelPassedQCEnum,
        mc2:IndividualRecurrenceStatusEnum ;
    skos:definition "The non-affirmative response to a question." .

NCIT:C49488 a owl:Class ;
    rdfs:label "Yes" ;
    rdfs:subClassOf mc2:ChannelPassedQCEnum,
        mc2:IndividualRecurrenceStatusEnum ;
    skos:definition "The affirmative response to a question." .

NCIT:C52095 a owl:Class ;
    rdfs:label "Metadata" ;
    rdfs:subClassOf mc2:DSPDatasetLevelEnum,
        mc2:FileLevelEnum ;
    skos:definition "Files that are or will be stored and shared as metadata." .

NCIT:C54292 a owl:Class ;
    rdfs:label "Sinonasal Tract" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The area of the head comprised of the nasal cavity and paranasal sinuses." .

NCIT:C63513 a owl:Class ;
    rdfs:label "Manual" ;
    rdfs:subClassOf mc2:DeidentificationTypeEnum,
        mc2:StudyDeidentificationMethodTypeEnum ;
    skos:definition "Of or related to the hands; reference to a method, process, task, or activity being done by hand (as opposed as being performed with the assistance of automation or other supportive means)." .

NCIT:C63523 a owl:Class ;
    rdfs:label "OCT" ;
    rdfs:subClassOf mc2:BiospecimenPreservationMediumEnum,
        mc2:BiospecimenPreservationMethodEnum ;
    skos:definition "A solution of water soluble glycols and resins that provide a specimen support matrix for cryostat sectioning at temperatures of -10 degrees C and below.",
        "Optimal Cutting Temperature Compound" .

NCIT:C63805 a owl:Class ;
    rdfs:label "PDF" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "An open file format created and controlled by Adobe Systems for representing two-dimensional documents in a device-independent and resolution-independent fixed-layout format that encapsulates text, fonts, images, and vector graphics." .

NCIT:C70669 a owl:Class ;
    rdfs:label "Automatic" ;
    rdfs:subClassOf mc2:DeidentificationTypeEnum,
        mc2:StudyDeidentificationMethodTypeEnum ;
    skos:definition "Operating with minimal human intervention; independent of external control." .

NCIT:C77637 a owl:Class ;
    rdfs:label "Oral Mucosa" ;
    rdfs:subClassOf mc2:DSPDatasetTissueEnum,
        mc2:TissueEnum ;
    skos:definition "The mucosal membranes that line the oral cavity." .

NCIT:C80220 a owl:Class ;
    rdfs:label "GZIP Format" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A file format consisting of a 10-byte header containing a magic number, a version number, and a timestamp, a Deflate-compressed body, and an 8-byte footer containing a checksum and the length of the original uncompressed data." .

NCIT:C82329 a owl:Class ;
    rdfs:label "Center for Biomedical Informatics and Information Technology" ;
    rdfs:subClassOf mc2:ConsortiumFundingAgencyEnum,
        mc2:FunderEnum .

NCIT:C82620 a owl:Class ;
    rdfs:label "National Library of Medicine" ;
    rdfs:subClassOf mc2:ConsortiumFundingAgencyEnum,
        mc2:FunderEnum .

NCIT:C85437 a owl:Class ;
    rdfs:label "PNG" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "An extensible file format for lossless data compression of images." .

NCIT:C85873 a owl:Class ;
    rdfs:label "TXT" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "A data format consisting of readable textual material maintained as a sequential file." .

NCIT:C94498 a owl:Class ;
    rdfs:label "Microenvironment" ;
    rdfs:subClassOf mc2:GrantThemeNameEnum,
        mc2:ResourceTopicEnum ;
    skos:definition "The cellular and molecular environment surrounding a tumor or biological system, including neighboring cells, blood vessels, immune cells, signaling molecules, and the extracellular matrix, that influences its growth and behavior." .

EFO:0004155 a owl:Class ;
    rdfs:label "FASTQ" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum,
        mc2:FileFormatEnum ;
    skos:definition "FASTQ format is a text-based format for storing both a biological sequence (usually nucleotide sequence) and its corresponding quality scores." .

mc2:FileDataChecksumTypeEnum a owl:Class ;
    rdfs:label "File Data Checksum Type Enum" ;
    owl:unionOf ( <https://w3id.org/mc2-center/mc2-model/FileDataChecksumTypeEnum#SHA-1> <https://w3id.org/mc2-center/mc2-model/FileDataChecksumTypeEnum#SHA-256> <https://w3id.org/mc2-center/mc2-model/FileDataChecksumTypeEnum#SHA-512> ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values <https://w3id.org/mc2-center/mc2-model/FileDataChecksumTypeEnum#SHA-1>,
        <https://w3id.org/mc2-center/mc2-model/FileDataChecksumTypeEnum#SHA-256>,
        <https://w3id.org/mc2-center/mc2-model/FileDataChecksumTypeEnum#SHA-512> .

mc2:FileDataCompressionStatusEnum a owl:Class ;
    rdfs:label "File Data Compression Status Enum" ;
    owl:unionOf ( <https://w3id.org/mc2-center/mc2-model/FileDataCompressionStatusEnum#Unknown> <https://w3id.org/mc2-center/mc2-model/FileDataCompressionStatusEnum#Compressed> <https://w3id.org/mc2-center/mc2-model/FileDataCompressionStatusEnum#Uncompressed> ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values <https://w3id.org/mc2-center/mc2-model/FileDataCompressionStatusEnum#Compressed>,
        <https://w3id.org/mc2-center/mc2-model/FileDataCompressionStatusEnum#Uncompressed>,
        <https://w3id.org/mc2-center/mc2-model/FileDataCompressionStatusEnum#Unknown> .

mc2:GeoMxDSPAssayTypeEnum a owl:Class ;
    rdfs:label "GeoMx DSP Assay Type Enum" ;
    owl:unionOf ( NCIT:C198498 NCIT:C198498 <https://w3id.org/mc2-center/mc2-model/GeoMxDSPAssayTypeEnum#Protein%20NGS> <https://w3id.org/mc2-center/mc2-model/GeoMxDSPAssayTypeEnum#RNA%20NGS> ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values NCIT:C198498,
        <https://w3id.org/mc2-center/mc2-model/GeoMxDSPAssayTypeEnum#Protein%20NGS>,
        <https://w3id.org/mc2-center/mc2-model/GeoMxDSPAssayTypeEnum#RNA%20NGS> .

mc2:ICD_10_CM_Disease_Code a owl:DatatypeProperty ;
    rdfs:label "ICD-10-CM Disease Code" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[A-Z][0-9]{2}(\\.[0-9A-Z]{1,4})?-?$" ] ) ] ;
    skos:definition "An alphanumeric value from the tenth version of the International Classification of Disease (ICD-10-CM) used to identify the diagnosis (e.g. C80.1). Reference-validated against the ICD-10-CM code system, not a fixed list." ;
    skos:exactMatch CRDC_CDE:11479873 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:ImageSummaryStatisticEnum a owl:Class ;
    rdfs:label "Image Summary Statistic Enum" ;
    owl:unionOf ( NCIT:C53319 NCIT:C28007 NCIT:C38046 ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values NCIT:C28007,
        NCIT:C38046,
        NCIT:C53319 .

mc2:Image_Assay_Type a owl:ObjectProperty ;
    rdfs:label "Image Assay Type" ;
    rdfs:range mc2:ImageAssayTypeEnum ;
    skos:definition "Type of imaging assay" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "7789196" .

mc2:Image_Platform_Manufacturer a owl:DatatypeProperty ;
    rdfs:label "Image Platform Manufacturer" ;
    skos:definition "Producer of the imaging equipment that was used to generate the digital image" ;
    skos:exactMatch CRDC_CDE:16065939 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Platform_Model a owl:DatatypeProperty ;
    rdfs:label "Image Platform Model" ;
    skos:definition "The specific model of the instrument used to carry out an imaging experiment." ;
    skos:exactMatch CRDC_CDE:16072578 ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:ImagingChannel_Key a owl:DatatypeProperty ;
    rdfs:label "ImagingChannel Key" ;
    skos:definition "Unique ImagingChannel_id foreign key(s) that link metadata entries as part of the same Dataset. Please provide multiple values as a comma-separate list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

mc2:Individual_Key a owl:DatatypeProperty ;
    rdfs:label "Individual Key" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "CA\\d{6}-IND\\d{1,9}" ] ) ] ;
    skos:definition "Unique Individual_id foreign key(s) that link metadata entries as part of the same collection. Please provide multiple values as a comma-separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

mc2:NGSRNAEndBiasEnum a owl:Class ;
    rdfs:label "NGS RNA End Bias Enum" ;
    owl:unionOf ( NCIT:C202270 NCIT:C202271 NCIT:C202272 ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values NCIT:C202270,
        NCIT:C202271,
        NCIT:C202272 .

mc2:NGSRNAReverseTranscriptionPrimerEnum a owl:Class ;
    rdfs:label "NGS RNA Reverse Transcription Primer Enum" ;
    owl:unionOf ( NCIT:C201929 NCIT:C201929 NCIT:C202255 NCIT:C201930 ) ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    linkml:permissible_values NCIT:C201929,
        NCIT:C201930,
        NCIT:C202255 .

mc2:NGS_Read_Indicator a owl:ObjectProperty ;
    rdfs:label "NGS Read Indicator" ;
    rdfs:range mc2:NGSReadIndicatorEnum ;
    skos:definition "Indicate if this is Read 1 (R1), Read 2 (R2), Index Reads (I1), or Other" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:NanoStringGeoMxAuxiliaryFiles_Key a owl:DatatypeProperty ;
    rdfs:label "NanoStringGeoMxAuxiliaryFiles Key" ;
    skos:definition "Unique NanoStringGeoMxAuxiliaryFiles_id foreign key(s) that link metadata entries as part of the same Dataset. Please provide multiple values as a comma-separate list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

mc2:PublicationView_Key a owl:DatatypeProperty ;
    rdfs:label "PublicationView Key" ;
    skos:definition "Unique PublicationView_id foreign key(s) that link metadata entries as part of the same collection. Please provide multiple values as a comma-separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

mc2:ToolAccessibilityEnum a owl:Class ;
    rdfs:label "Tool Accessibility Enum" ;
    owl:unionOf ( <https://w3id.org/mc2-center/mc2-model/ToolAccessibilityEnum#Open%20Access> <https://w3id.org/mc2-center/mc2-model/ToolAccessibilityEnum#Open%20Access%20%28With%20Restrictions%29> <https://w3id.org/mc2-center/mc2-model/ToolAccessibilityEnum#Restricted%20Access> ) ;
