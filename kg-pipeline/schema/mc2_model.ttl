    rdfs:label "Resource Access Hazard Enum" ;
    owl:unionOf ( <https://w3id.org/mc2-center/mc2-model/ResourceAccessHazardEnum#Flashing> <https://w3id.org/mc2-center/mc2-model/ResourceAccessHazardEnum#Motion> <https://w3id.org/mc2-center/mc2-model/ResourceAccessHazardEnum#Simulation> <https://w3id.org/mc2-center/mc2-model/ResourceAccessHazardEnum#Sound> ) ;
