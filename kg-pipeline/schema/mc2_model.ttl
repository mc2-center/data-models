        <https://w3id.org/mc2-center/mc2-model/ChairRolesEnum#None>,
        <https://w3id.org/mc2-center/mc2-model/ChairRolesEnum#Steering%20Committee>,
        <https://w3id.org/mc2-center/mc2-model/ChairRolesEnum#Working%20Group> .

mc2:DataPermissionEnum a owl:Class ;
    rdfs:label "dataPermission Enum" ;
    owl:unionOf ( <https://w3id.org/mc2-center/mc2-model/DataPermissionEnum#Agreement> <https://w3id.org/mc2-center/mc2-model/DataPermissionEnum#Attestation> <https://w3id.org/mc2-center/mc2-model/DataPermissionEnum#Award> <https://w3id.org/mc2-center/mc2-model/DataPermissionEnum#Other> ) ;
