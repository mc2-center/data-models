mc2:Grant_Number a owl:DatatypeProperty ;
    rdfs:label "Grant Number" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^CA\\d{6}$" ] ) ] ;
    skos:definition "Number of the grant (i.e. \"CA------\" format)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

<https://w3id.org/mc2-center/mc2-model/ImageImmersionTypeEnum#Multi> a owl:Class ;
    rdfs:label "Multi" ;
    rdfs:subClassOf mc2:ImageImmersionTypeEnum ;
    skos:definition "An imaging immersion condition using a multi-immersion objective lens compatible with more than one immersion medium (e.g., air, water, oil, or glycerol), allowing the same lens to be used across different sample preparations." .

<https://w3id.org/mc2-center/mc2-model/ImageObjectClassEnum#Spot> a owl:Class ;
    rdfs:label "Spot" ;
    rdfs:subClassOf mc2:ImageObjectClassEnum ;
    skos:definition "A discrete, localized region of signal (e.g. a fluorescent punctum) identified within an image, distinct from whole-cell or subcellular compartment segmentation." .

<https://w3id.org/mc2-center/mc2-model/ImageSegmentationDataTypeEnum#Probability%20Map> a owl:Class ;
    rdfs:label "Probability Map" ;
    rdfs:subClassOf mc2:ImageSegmentationDataTypeEnum ;
    skos:definition "A segmentation output in which each pixel is assigned a continuous value representing the estimated probability that it belongs to a given object class, typically produced by a probabilistic or machine-learning-based segmentation algorithm rather than a binary mask." .

mc2:Image_Number_of_Objects a owl:DatatypeProperty ;
    rdfs:label "Image Number of Objects" ;
    rdfs:range xsd:float ;
    skos:definition "The number of objects (eg cells) described" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Object_Class a owl:ObjectProperty ;
    rdfs:label "Image Object Class" ;
    rdfs:range mc2:ImageObjectClassEnum ;
    skos:definition "Defines the structure that the mask delineates" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Image_Parameter_file a owl:DatatypeProperty ;
    rdfs:label "Image Parameter file" ;
    skos:definition "Path in Synapse to a text file listing algorithm version numbers and relevant parameters needed to reproduce the analysis" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:ImagingLevel1_id a owl:DatatypeProperty ;
    rdfs:label "ImagingLevel1_id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^syn\\d{7,8}$" ] ) ] ;
    skos:definition "Unique row identifier, used as a primary key for record updates. This should be equivalent to the file Synapse Id unless otherwise indicated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:ImagingLevel2_id a owl:DatatypeProperty ;
    rdfs:label "ImagingLevel2_id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^syn\\d{7,8}$" ] ) ] ;
    skos:definition "Unique row identifier, used as a primary key for record updates. This should be equivalent to the file Synapse Id unless otherwise indicated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:ImagingLevel3Image_Key a owl:DatatypeProperty ;
    rdfs:label "ImagingLevel3Image Key" ;
    skos:definition "Unique ImagingLevel3Image_id foreign key(s) that link metadata entries as part of the same Dataset. Please provide multiple values as a comma-separate list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
