    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:DSP_Number_of_Samples a owl:DatatypeProperty ;
    rdfs:label "DSP Number of Samples" ;
    rdfs:range xsd:float ;
    skos:definition "The number of biospecimens associated with the files included in the dataset" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:DSP_Planned_Release_Date a owl:DatatypeProperty ;
    rdfs:label "DSP Planned Release Date" ;
    skos:definition "The projected date that marks the end of any requested or required sharing embargo for the dataset." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
