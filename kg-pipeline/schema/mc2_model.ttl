    rdfs:subClassOf mc2:DataUseModifiersEnum ;
    skos:definition "A data tier designation is associated with the Study. If providing this term, please provide the applicable data tier designation(s) in column dataTier." .

<https://w3id.org/mc2-center/mc2-model/DataUseModifiersEnum#DUOPlus6> a owl:Class ;
    rdfs:label "DUOPlus6" ;
    rdfs:subClassOf mc2:DataUseModifiersEnum ;
    skos:definition "A license is associated with the Study. If providing this term, please provide the applicable license in column license." .

<https://w3id.org/mc2-center/mc2-model/DataUseModifiersEnum#DUOPlus7> a owl:Class ;
    rdfs:label "DUOPlus7" ;
    rdfs:subClassOf mc2:DataUseModifiersEnum ;
    skos:definition "Attribution conditions are associated with this Study. If providing this term, please provide the attribution statement in column attribution." .

<https://w3id.org/mc2-center/mc2-model/DataUseModifiersEnum#Pending%20Annotation> a owl:Class ;
    rdfs:label "Pending Annotation" ;
    rdfs:subClassOf mc2:DataUseModifiersEnum ;
    skos:definition "Data Use Codes have not yet been provided or documented for this resource." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#3D%20ATAC-PALM> a owl:Class ;
    rdfs:label "3D ATAC-PALM" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "A super-resolution imaging technique that combines ATAC-see (a fluorescence-based chromatin accessibility assay) with photoactivated localization microscopy (PALM) to visualize the 3D spatial organization of accessible chromatin in single cells." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#Angiogenesis%20Assay> a owl:Class ;
    rdfs:label "Angiogenesis Assay" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "An assay used to measure the formation of new blood vessels from existing vasculature, typically by quantifying endothelial cell tube formation, migration, or sprouting in vitro or in vivo." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#CRISPR> a owl:Class ;
    rdfs:label "CRISPR" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "A genome-editing and functional-screening technology based on the Clustered Regularly Interspaced Short Palindromic Repeats (CRISPR)-Cas system, used here as a general assay category for CRISPR-based perturbation experiments." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#Co-Immunoprecipitation%20Mass%20Spectrometry> a owl:Class ;
    rdfs:label "Co-Immunoprecipitation Mass Spectrometry" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "A method that combines co-immunoprecipitation (using an antibody to pull down a protein and its binding partners) with mass spectrometry to identify protein-protein interaction partners." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#DRIP-seq> a owl:Class ;
    rdfs:label "DRIP-seq" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "A molecular genetic technique that combines chromatin immunoprecipitation (ChIP) with massively parallel DNA sequencing to map the binding sites of DNA-associated proteins in a sample of cells. First, crosslinked protein-DNA complexes are isolated using ChIP. Next, the crosslinks are broken, the proteins are removed and the purified DNA is modified with adaptor oligonucleotides to facilitate massively parallel DNA sequencing. Following sequencing, the DNA sequences that are obtained can be mapped to their genomic locations." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#Dye%20Endocytosis%20Assay> a owl:Class ;
    rdfs:label "Dye Endocytosis Assay" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "An assay that measures cellular endocytic activity by quantifying the uptake of a fluorescent or otherwise detectable dye into cells." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#Human%20Induced%20Pluripotent%20Stem%20Cell-derived%20Cardiomyocytes%20Culture> a owl:Class ;
    rdfs:label "Human Induced Pluripotent Stem Cell-derived Cardiomyocytes Culture" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "The in vitro culture of cardiomyocytes (heart muscle cells) that have been differentiated from human induced pluripotent stem cells (iPSCs), used to model cardiac biology and disease." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#Macrophage%20Polarization%20Assay> a owl:Class ;
    rdfs:label "Macrophage Polarization Assay" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "An assay that measures the differentiation of macrophages into functional phenotypes (e.g., M1 pro-inflammatory or M2 anti-inflammatory) in response to specific stimuli, typically via marker expression or cytokine profiling." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#Metastatic%20Colonization%20Assay> a owl:Class ;
    rdfs:label "Metastatic Colonization Assay" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "An in vivo assay that measures the ability of tumor cells to establish and grow secondary colonies at a distant site after introduction into a host organism, modeling the colonization step of metastasis." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#Micropipette%20Aspiration> a owl:Class ;
    rdfs:label "Micropipette Aspiration" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "A biophysical technique that uses a fine glass micropipette and controlled suction pressure to measure the mechanical properties (e.g., membrane tension, cortical stiffness) of individual cells." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#Monolayer%20Stress%20Microscopy> a owl:Class ;
    rdfs:label "Monolayer Stress Microscopy" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "The use of various technologies to resolve the structure or features of objects too small or fine to naturally be seen by eye." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#Nanopatterning> a owl:Class ;
    rdfs:label "Nanopatterning" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "A fabrication technique that creates nanoscale surface features or patterns, used e.g. to control cell adhesion, shape, or substrate mechanics in cell-biology experiments." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#Paraquat%20Survival%20Assay> a owl:Class ;
    rdfs:label "Paraquat Survival Assay" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "A survival assay that exposes an organism (commonly Caenorhabditis elegans) to the oxidative-stress-inducing herbicide paraquat to measure resistance to oxidative stress and longevity." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#Partial%20Wave%20Spectroscopy> a owl:Class ;
    rdfs:label "Partial Wave Spectroscopy" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "The technique of measuring the emission and absorption of different wavelengths (spectra) of visible and non-visible light. This can be done via a spectroscope, which consists of a slit, prism, collimator lens, object lens, and a grating." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#RNA%20array> a owl:Class ;
    rdfs:label "RNA array" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "A microarray platform used to measure RNA expression levels." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#Scanning%20Angle%20Interference%20Microscopy> a owl:Class ;
    rdfs:label "Scanning Angle Interference Microscopy" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "Technique of electron microscopy in which the specimen is coated with heavy metal and then scanned by an electron beam. The resolution is not as great as with transmission electron microscopy, but preparation is easier (often by fixation followed by critical point drying), the depth of focus is relatively enormous, the surface of a specimen can be seen (though not the interior unless the specimen is cracked open) and the image is aesthetically pleasing." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#Single-Cell%20Barcode%20Chip> a owl:Class ;
    rdfs:label "Single-Cell Barcode Chip" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "A molecular genetic technique that combines chromatin immunoprecipitation (ChIP) with massively parallel DNA sequencing to map the binding sites of DNA-associated proteins in a sample of cells. First, crosslinked protein-DNA complexes are isolated using ChIP. Next, the crosslinks are broken, the proteins are removed and the purified DNA is modified with adaptor oligonucleotides to facilitate massively parallel DNA sequencing. Following sequencing, the DNA sequences that are obtained can be mapped to their genomic locations." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#Single-Molecule%20Localization%20Microscopy> a owl:Class ;
    rdfs:label "Single-Molecule Localization Microscopy" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "A super-resolution fluorescence microscopy technique that localizes individual fluorophore molecules with high precision over many imaging cycles to reconstruct an image beyond the diffraction limit." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#Structural%20Variant%20Analysis> a owl:Class ;
    rdfs:label "Structural Variant Analysis" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "The computational analysis of sequencing or array data to detect large-scale genomic alterations such as deletions, duplications, insertions, inversions, and translocations." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#Surveyor%20Nuclease%20Assay> a owl:Class ;
    rdfs:label "Surveyor Nuclease Assay" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "An assay that uses the Surveyor nuclease to detect and cleave DNA at sites of sequence mismatch, commonly used to quantify genome-editing efficiency (e.g., after CRISPR/TALEN treatment)." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#Synthetic%20Genetic%20Array> a owl:Class ;
    rdfs:label "Synthetic Genetic Array" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "A molecular biology device that utilizes a set of defined cDNA clones attached in a specific grid arrangement to a solid support for nucleic acid hybridization assays in gene mapping studies or in determining gene sequences, sequence variations, or gene expression patterns." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#Targeted%20Error%20Correction%20Sequencing> a owl:Class ;
    rdfs:label "Targeted Error Correction Sequencing" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "A targeted sequencing approach that incorporates molecular barcoding or redundant sequencing of the same DNA molecule to computationally distinguish true low-frequency variants from sequencing errors." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#Traction%20Force%20Microscopy> a owl:Class ;
    rdfs:label "Traction Force Microscopy" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "A technique utilizing a scanning probe to image and analyze the surface of a material with atomic-level resolution." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#compound%20screen> a owl:Class ;
    rdfs:label "compound screen" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "A screening assay testing multiple chemical compounds for a biological effect." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#histology> a owl:Class ;
    rdfs:label "histology" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "Microscopic examination of tissue structure via sectioning and staining." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#in%20silico%20synthesis> a owl:Class ;
    rdfs:label "in silico synthesis" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "Computational/simulation-based synthesis of a molecule or construct rather than a wet-lab technique." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#in%20vivo%20PDX%20viability> a owl:Class ;
    rdfs:label "in vivo PDX viability" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "A functional viability readout from a patient-derived xenograft (PDX) model." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#in%20vivo%20tumor%20growth> a owl:Class ;
    rdfs:label "in vivo tumor growth" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "Monitoring of tumor growth (e.g. volume/size over time) in a live animal model, typically as a functional readout rather than a molecular assay." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#metabolic%20screening> a owl:Class ;
    rdfs:label "metabolic screening" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "A screening assay assessing metabolic activity or metabolite profiles." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#proximity%20extension%20assay> a owl:Class ;
    rdfs:label "proximity extension assay" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "An antibody-based protein detection method (e.g. Olink) in which paired antibodies with attached DNA oligonucleotides bind a target protein, allowing proximity-dependent DNA amplification and readout." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#scCGI-seq> a owl:Class ;
    rdfs:label "scCGI-seq" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "A molecular genetic technique that combines chromatin immunoprecipitation (ChIP) with massively parallel DNA sequencing to map the binding sites of DNA-associated proteins in a sample of cells. First, crosslinked protein-DNA complexes are isolated using ChIP. Next, the crosslinks are broken, the proteins are removed and the purified DNA is modified with adaptor oligonucleotides to facilitate massively parallel DNA sequencing. Following sequencing, the DNA sequences that are obtained can be mapped to their genomic locations." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#shRNA-seq> a owl:Class ;
    rdfs:label "shRNA-seq" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "A pooled shRNA screening assay read out by sequencing to identify short hairpin RNA constructs enriched or depleted under a selection condition." .

<https://w3id.org/mc2-center/mc2-model/DatasetAssayEnum#spatial%20transcriptomics> a owl:Class ;
    rdfs:label "spatial transcriptomics" ;
    rdfs:subClassOf mc2:DatasetAssayEnum ;
    skos:definition "A general term for assays that measure RNA expression while preserving spatial location information within a tissue section." .

<https://w3id.org/mc2-center/mc2-model/DatasetFileFormatsEnum#BPM> a owl:Class ;
    rdfs:label "BPM" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum ;
    skos:definition "BPM (BeadPool Manifest) is a proprietary Illumina binary file format that contains the design and manifest information, such as probe sequences, bead addresses, and annotations, for a genotyping or methylation microarray." .

<https://w3id.org/mc2-center/mc2-model/DatasetFileFormatsEnum#CDS> a owl:Class ;
    rdfs:label "CDS" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum ;
    skos:definition "CDS (coding sequence) refers to a nucleotide sequence file, typically in FASTA-like text format, that contains only the protein-coding portion of a gene or transcript, excluding untranslated regions." .

<https://w3id.org/mc2-center/mc2-model/DatasetFileFormatsEnum#CLS> a owl:Class ;
    rdfs:label "CLS" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum ;
    skos:definition "CLS is a plain-text categorical class (phenotype) label file format used by tools such as GSEA to specify sample group or class assignments corresponding to columns in an expression dataset." .

<https://w3id.org/mc2-center/mc2-model/DatasetFileFormatsEnum#COOL> a owl:Class ;
    rdfs:label "COOL" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum ;
    skos:definition "cool is a sparse, compressed binary file format built on HDF5 for storing genomic contact matrices, such as Hi-C interaction data, developed as part of the Cooler/cooltools software ecosystem." .

<https://w3id.org/mc2-center/mc2-model/DatasetFileFormatsEnum#DAE> a owl:Class ;
    rdfs:label "DAE" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum ;
    skos:definition "DAE (Digital Asset Exchange) is an XML-based file format defined by the COLLADA specification for exchanging 3D graphics assets, including geometry, materials, and animation, between different software applications." .

<https://w3id.org/mc2-center/mc2-model/DatasetFileFormatsEnum#DCC> a owl:Class ;
    rdfs:label "DCC" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum ;
    skos:definition "A legacy, tab-delimited text file format used by data coordinating centers (e.g., the TCGA/TARGET Data Coordinating Center) to distribute processed microarray and other genomic data to downstream users." .

<https://w3id.org/mc2-center/mc2-model/DatasetFileFormatsEnum#DS_Store> a owl:Class ;
    rdfs:label "DS_Store" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum ;
    skos:definition ".DS_Store is a hidden metadata file automatically generated by the macOS Finder to store folder view settings and icon positions; it is not a data format and typically appears as an incidental artifact rather than an intended data file." .

<https://w3id.org/mc2-center/mc2-model/DatasetFileFormatsEnum#FIG> a owl:Class ;
    rdfs:label "FIG" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum ;
    skos:definition "FIG is a vector graphics file format associated with drawing and plotting tools, such as Xfig or MATLAB saved figures, used to store editable diagrams, plots, or illustrations." .

<https://w3id.org/mc2-center/mc2-model/DatasetFileFormatsEnum#FREQ> a owl:Class ;
    rdfs:label "FREQ" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum ;
    skos:definition "FREQ is a generic, tool-specific text file format used to report allele, genotype, or variant frequency data, with column structure varying by the producing software." .

<https://w3id.org/mc2-center/mc2-model/DatasetFileFormatsEnum#GCTx> a owl:Class ;
    rdfs:label "GCTx" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum ;
    skos:definition "GCTx is a binary, HDF5-based extension of the GCT format used to store very large gene-expression or profiling matrices, developed for the Broad Institute's Connectivity Map (CMap)/LINCS projects." .

<https://w3id.org/mc2-center/mc2-model/DatasetFileFormatsEnum#LIF> a owl:Class ;
    rdfs:label "LIF" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum ;
    skos:definition "LIF (Leica Image File) is a proprietary container file format produced by Leica microscopy acquisition software that stores multi-dimensional, multi-channel microscope images along with associated metadata." .

<https://w3id.org/mc2-center/mc2-model/DatasetFileFormatsEnum#ROUT> a owl:Class ;
    rdfs:label "ROUT" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum ;
    skos:definition "A .Rout file is the plain-text output log generated when an R script is executed in batch mode (via R CMD BATCH), capturing console output, computed results, and any warnings or errors." .

<https://w3id.org/mc2-center/mc2-model/DatasetFileFormatsEnum#RPROJ> a owl:Class ;
    rdfs:label "RPROJ" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum ;
    skos:definition "An .Rproj file is a plain-text configuration file created by RStudio that records project-specific settings, such as the working directory and build options, for an R project." .

<https://w3id.org/mc2-center/mc2-model/DatasetFileFormatsEnum#SCN> a owl:Class ;
    rdfs:label "SCN" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum ;
    skos:definition "SCN is a proprietary, TIFF-based whole-slide image file format produced by Leica Biosystems digital pathology scanners, encoding multi-resolution, multi-channel brightfield or fluorescence slide images." .

<https://w3id.org/mc2-center/mc2-model/DatasetFileFormatsEnum#SF> a owl:Class ;
    rdfs:label "SF" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum ;
    skos:definition "SF commonly denotes the tab-delimited transcript-quantification output file (e.g., quant.sf) produced by RNA-seq pseudoalignment/quantification tools such as Salmon, reporting per-transcript abundance estimates (TPM and read counts)." .

<https://w3id.org/mc2-center/mc2-model/DatasetFileFormatsEnum#SGI> a owl:Class ;
    rdfs:label "SGI" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum ;
    skos:definition "SGI (Silicon Graphics Image) is a raster image file format originally developed by Silicon Graphics, Inc. for storing bitmap graphics, supporting both uncompressed and run-length-encoded pixel data." .

<https://w3id.org/mc2-center/mc2-model/DatasetFileFormatsEnum#STAT> a owl:Class ;
    rdfs:label "STAT" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum ;
    skos:definition "STAT denotes a plain-text file containing summary statistics or quality-control metrics generated by an analysis tool, such as alignment or variant-calling statistics; its exact content and structure vary by the producing software." .

<https://w3id.org/mc2-center/mc2-model/DatasetFileFormatsEnum#TDF> a owl:Class ;
    rdfs:label "TDF" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum ;
    skos:definition "TDF (Tiled Data File) is a binary, indexed file format used by the Integrative Genomics Viewer (IGV) to store precomputed, multi-resolution genomic data, such as coverage or feature density, for fast visualization across zoom levels." .

<https://w3id.org/mc2-center/mc2-model/DatasetFileFormatsEnum#cloupe> a owl:Class ;
    rdfs:label "cloupe" ;
    rdfs:subClassOf mc2:DatasetFileFormatsEnum ;
    skos:definition "The .cloupe file format is a proprietary binary format produced by 10x Genomics Cell Ranger pipelines for visualizing and exploring single-cell sequencing data in the Loupe Browser desktop application." .

<https://w3id.org/mc2-center/mc2-model/DatasetGrantNumberEnum#Affiliated%2FNon-Grant%20Associated> a owl:Class ;
    rdfs:label "Affiliated/Non-Grant Associated" ;
    rdfs:subClassOf mc2:DatasetGrantNumberEnum .

<https://w3id.org/mc2-center/mc2-model/DatasetGrantNumberEnum#CA184897> a owl:Class ;
    rdfs:label "CA184897" ;
    rdfs:subClassOf mc2:DatasetGrantNumberEnum .

