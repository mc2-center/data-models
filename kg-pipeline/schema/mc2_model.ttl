        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Study_Key ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:Dataset_Name ] ;
    skos:definition "The denormalized manifest for dataset submission." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:Dataset_File_Formats a owl:ObjectProperty ;
    rdfs:label "Dataset File Formats" ;
    rdfs:range mc2:DatasetFileFormatsEnum ;
    skos:definition "A list of file formats associated with the dataset. Multiple values permitted, comma separated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "11416926" .

mc2:Disease_Type a owl:ObjectProperty ;
    rdfs:label "Disease Type" ;
    rdfs:range mc2:DiseaseTypeEnum ;
