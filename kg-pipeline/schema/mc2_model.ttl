mc2:NGS_Library_Layout a owl:ObjectProperty ;
    rdfs:label "NGS Library Layout" ;
    rdfs:range mc2:NGSLibraryLayoutEnum ;
    skos:definition "Text description of the library layout, one of Paired-end or Single." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "11527735" .

mc2:NGS_Library_Selection_Method a owl:ObjectProperty ;
    rdfs:label "NGS Library Selection Method" ;
    rdfs:range mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "How nucleic acid molecules are isolated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "6347743" .

mc2:NGS_Library_Source_Material a owl:ObjectProperty ;
    rdfs:label "NGS Library Source Material" ;
    rdfs:range mc2:NGSLibrarySourceMaterialEnum ;
    skos:definition "The type of source material being sequenced." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
