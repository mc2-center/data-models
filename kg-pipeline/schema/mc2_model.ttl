<https://w3id.org/mc2-center/mc2-model/ResourceMediaAccessibilityEnum#Alternative%20Text> a owl:Class ;
    rdfs:label "Alternative Text" ;
    rdfs:subClassOf mc2:ResourceMediaAccessibilityEnum ;
    skos:definition "A text alternative provided for non-text content (such as images), allowing assistive technologies like screen readers to convey the content's meaning to users who cannot see it." .

<https://w3id.org/mc2-center/mc2-model/ResourceMediaAccessibilityEnum#Audio%20Description> a owl:Class ;
    rdfs:label "Audio Description" ;
    rdfs:subClassOf mc2:ResourceMediaAccessibilityEnum ;
    skos:definition "An additional narration track that describes important visual information in video content (actions, scenes, on-screen text) for users who are blind or have low vision." .

<https://w3id.org/mc2-center/mc2-model/ResourceMediaAccessibilityEnum#Braille> a owl:Class ;
    rdfs:label "Braille" ;
    rdfs:subClassOf mc2:ResourceMediaAccessibilityEnum ;
    skos:definition "Indicates the resource, or a version of it, is available in Braille, a tactile writing system that enables reading by touch for people who are blind or have low vision." .

<https://w3id.org/mc2-center/mc2-model/ResourceMediaAccessibilityEnum#Described%20Math> a owl:Class ;
    rdfs:label "Described Math" ;
    rdfs:subClassOf mc2:ResourceMediaAccessibilityEnum ;
    skos:definition "A text-based or audio description of mathematical notation and expressions, provided as an alternative to visual math formulas for users who use screen readers or other assistive technology." .

<https://w3id.org/mc2-center/mc2-model/ResourceMediaAccessibilityEnum#Display%20Transformability> a owl:Class ;
    rdfs:label "Display Transformability" ;
    rdfs:subClassOf mc2:ResourceMediaAccessibilityEnum ;
    skos:definition "Indicates that the resource's visual presentation (e.g., text size, color, spacing, layout) can be modified or resized by the user without loss of content or functionality, supporting users with low vision or reading disabilities." .

<https://w3id.org/mc2-center/mc2-model/ResourceMediaAccessibilityEnum#High%20Contrast> a owl:Class ;
    rdfs:label "High Contrast" ;
    rdfs:subClassOf mc2:ResourceMediaAccessibilityEnum ;
    skos:definition "Indicates that a high-contrast display option (e.g., strongly differentiated foreground/background colors) is available to improve readability for users with low vision." .

<https://w3id.org/mc2-center/mc2-model/ResourceMediaAccessibilityEnum#Large%20Print> a owl:Class ;
    rdfs:label "Large Print" ;
    rdfs:subClassOf mc2:ResourceMediaAccessibilityEnum ;
    skos:definition "Indicates that the resource, or a version of it, is available in a large-print format with enlarged text to improve readability for users with low vision." .

<https://w3id.org/mc2-center/mc2-model/ResourceMediaAccessibilityEnum#Long%20Description> a owl:Class ;
    rdfs:label "Long Description" ;
    rdfs:subClassOf mc2:ResourceMediaAccessibilityEnum ;
    skos:definition "A detailed textual description provided for complex non-text content (such as charts, graphs, or images) that cannot be adequately conveyed through brief alternative text alone." .

<https://w3id.org/mc2-center/mc2-model/ResourceMediaAccessibilityEnum#Nemeth%20Braille> a owl:Class ;
    rdfs:label "Nemeth Braille" ;
    rdfs:subClassOf mc2:ResourceMediaAccessibilityEnum ;
    skos:definition "A specialized Braille code used to represent mathematical and scientific notation, enabling readers who are blind or have low vision to access complex math content." .

<https://w3id.org/mc2-center/mc2-model/ResourceMediaAccessibilityEnum#Structural%20Navigation> a owl:Class ;
    rdfs:label "Structural Navigation" ;
    rdfs:subClassOf mc2:ResourceMediaAccessibilityEnum ;
    skos:definition "Indicates that the resource is structured with navigational markup (such as headings, landmarks, or lists) that allows assistive technology users to move efficiently between sections of content." .

<https://w3id.org/mc2-center/mc2-model/ResourceMediaAccessibilityEnum#Tactile%20Graphics> a owl:Class ;
    rdfs:label "Tactile Graphics" ;
    rdfs:subClassOf mc2:ResourceMediaAccessibilityEnum ;
    skos:definition "Raised or textured versions of images, diagrams, or graphics that can be explored by touch, enabling users who are blind or have low vision to perceive visual information." .

<https://w3id.org/mc2-center/mc2-model/ResourceMediaAccessibilityEnum#Text%20Transcript> a owl:Class ;
    rdfs:label "Text Transcript" ;
    rdfs:subClassOf mc2:ResourceMediaAccessibilityEnum ;
    skos:definition "A full text version of the spoken and relevant non-speech audio content of a media resource, allowing users to read the content instead of, or in addition to, listening to it." .

<https://w3id.org/mc2-center/mc2-model/ResourcePrimaryAudienceEnum#General%20Audience> a owl:Class ;
    rdfs:label "General Audience" ;
    rdfs:subClassOf mc2:ResourcePrimaryAudienceEnum ;
    skos:definition "The broad general public, without restriction to a specific educational role, age group, or professional background." .

<https://w3id.org/mc2-center/mc2-model/ResourcePrimaryFormatEnum#Braille%2FBNF> a owl:Class ;
    rdfs:label "Braille/BNF" ;
    rdfs:subClassOf mc2:ResourcePrimaryFormatEnum ;
    skos:definition "Content formatted in Braille or Braille-ready format (BRF) for tactile reading by individuals who are blind or have low vision." .

<https://w3id.org/mc2-center/mc2-model/ResourcePrimaryFormatEnum#Downloadable%20docs> a owl:Class ;
    rdfs:label "Downloadable docs" ;
    rdfs:subClassOf mc2:ResourcePrimaryFormatEnum ;
    skos:definition "Documents (e.g., PDF, Word) provided as downloadable files for offline viewing or use." .

<https://w3id.org/mc2-center/mc2-model/ResourcePrimaryFormatEnum#Graphics%2FPhotos> a owl:Class ;
    rdfs:label "Graphics/Photos" ;
    rdfs:subClassOf mc2:ResourcePrimaryFormatEnum ;
    skos:definition "Static visual content, such as illustrations, diagrams, or photographs." .

<https://w3id.org/mc2-center/mc2-model/ResourcePrimaryFormatEnum#Interactive> a owl:Class ;
    rdfs:label "Interactive" ;
    rdfs:subClassOf mc2:ResourcePrimaryFormatEnum ;
    skos:definition "Content that requires or invites active user engagement, such as simulations, games, or interactive multimedia exercises." .

<https://w3id.org/mc2-center/mc2-model/ResourcePrimaryFormatEnum#Text%2FHTML> a owl:Class ;
    rdfs:label "Text/HTML" ;
    rdfs:subClassOf mc2:ResourcePrimaryFormatEnum ;
    skos:definition "Content delivered as plain text or as HTML web pages viewable in a web browser." .

<https://w3id.org/mc2-center/mc2-model/ResourcePrimaryFormatEnum#eBook> a owl:Class ;
    rdfs:label "eBook" ;
    rdfs:subClassOf mc2:ResourcePrimaryFormatEnum ;
    skos:definition "A digital book formatted for reading on an e-reader, tablet, computer, or other electronic device." .

<https://w3id.org/mc2-center/mc2-model/ResourceTopicEnum#Anatomy%2FPhysiology> a owl:Class ;
    rdfs:label "Anatomy/Physiology" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The study of the structure of living organisms and their parts (anatomy) together with the functions and mechanisms of those structures (physiology)." .

<https://w3id.org/mc2-center/mc2-model/ResourceTopicEnum#Computational%20Model%20Development> a owl:Class ;
    rdfs:label "Computational Model Development" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The construction and refinement of mathematical, statistical, or computational models used to simulate, predict, or analyze biological or clinical phenomena." .

<https://w3id.org/mc2-center/mc2-model/ResourceTopicEnum#Computational%20Resource> a owl:Class ;
    rdfs:label "Computational Resource" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "Software tools, algorithms, databases, or computing infrastructure developed or used to support computational research and data analysis." .

<https://w3id.org/mc2-center/mc2-model/ResourceTopicEnum#Drug%20Resistance%2FSensitivity> a owl:Class ;
    rdfs:label "Drug Resistance/Sensitivity" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The diminished or absent response of cancer cells or tumors to a therapeutic agent (resistance), or their degree of susceptibility to being affected or killed by that agent (sensitivity)." .

<https://w3id.org/mc2-center/mc2-model/ResourceTopicEnum#Experimental%20Model%20Development> a owl:Class ;
    rdfs:label "Experimental Model Development" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The design, generation, and validation of laboratory-based systems, such as cell lines, organoids, or animal models, used to study disease biology or evaluate therapeutic interventions." .

<https://w3id.org/mc2-center/mc2-model/ResourceTopicEnum#Measurement%20and%20Data> a owl:Class ;
    rdfs:label "Measurement and Data" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "An educational topic area covering skills and concepts related to measuring quantities and to collecting, representing, and interpreting data." .

<https://w3id.org/mc2-center/mc2-model/ResourceTopicEnum#Mechano-genetics> a owl:Class ;
    rdfs:label "Mechano-genetics" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The study of how mechanical forces and the physical properties of cells and tissues influence gene expression and genetic regulation." .

<https://w3id.org/mc2-center/mc2-model/ResourceTopicEnum#Mechano-resistance> a owl:Class ;
    rdfs:label "Mechano-resistance" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The study of how mechanical properties of, or forces acting on, cells and tissues contribute to resistance against therapeutic agents or other stressors." .

<https://w3id.org/mc2-center/mc2-model/ResourceTopicEnum#Method%2FAssay%20Development> a owl:Class ;
    rdfs:label "Method/Assay Development" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The design, optimization, and validation of new experimental techniques, protocols, or assays for measuring biological or clinical phenomena." .

<https://w3id.org/mc2-center/mc2-model/ResourceTopicEnum#Oncogenic%20Stress> a owl:Class ;
    rdfs:label "Oncogenic Stress" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "Cellular stress arising from the activation of oncogenes or dysregulated growth signaling, which can trigger protective responses such as senescence or apoptosis." .

<https://w3id.org/mc2-center/mc2-model/ResourceTopicEnum#Other> a owl:Class ;
    rdfs:label "Other" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "A resource topic that does not fit within any of the other defined categories." .

<https://w3id.org/mc2-center/mc2-model/ResourceTopicEnum#Outreach> a owl:Class ;
    rdfs:label "Outreach" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "Activities and programs designed to engage, inform, or provide resources to communities, patients, or the public outside of a research institution's core scientific work." .

<https://w3id.org/mc2-center/mc2-model/ResourceTopicEnum#Platform%20Development> a owl:Class ;
    rdfs:label "Platform Development" ;
    rdfs:subClassOf mc2:ResourceTopicEnum ;
    skos:definition "The creation and refinement of technological, computational, or experimental platforms and infrastructure that support research workflows or data generation." .

mc2:Resource_Language a owl:ObjectProperty ;
    rdfs:label "Resource Language" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( mc2:ResourceLanguageEnum [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "[a-z]{2}" ] ) ] ) ] ;
    skos:definition "Language of the item (not of the metadata). Multiple values should be provided as a comma separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:SequencingLevel1_id a owl:DatatypeProperty ;
    rdfs:label "SequencingLevel1_id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^syn\\d{7,8}$" ] ) ] ;
    skos:definition "Unique row identifier, used as a primary key for record updates. This should be equivalent to the file Synapse Id unless otherwise indicated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

