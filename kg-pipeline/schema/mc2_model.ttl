mc2:FileView_Key a owl:DatatypeProperty ;
    rdfs:label "FileView Key" ;
    skos:definition "Unique FileView_id foreign key(s) that link metadata entries as part of the same Dataset. Please provide multiple values as a comma-separate list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

mc2:File_Anatomic_Site a owl:ObjectProperty ;
    rdfs:label "File Anatomic Site" ;
    rdfs:range mc2:FileAnatomicSiteEnum ;
    skos:definition "The anatomic site associated with the data contained in this file." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "14156279" .

mc2:File_Data_Use_Codes a owl:DatatypeProperty ;
    rdfs:label "File Data Use Codes" ;
    skos:definition "DUO code - A data item that is used to indicate consent permissions for datasets and/or materials, and relates to the purposes for which datasets and/or material might be removed, stored or used. Available DUO code definitions can be found here: https://mc2-center.github.io/data-models/valid_values/study/#attribute-study-data-use-codes" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "0002001" .

mc2:File_Longitudinal_Sequential_Time_Elapsed a owl:DatatypeProperty ;
    rdfs:label "File Longitudinal Sequential Time Elapsed" ;
    rdfs:range xsd:float ;
    skos:definition "The time elapsed between collecting the current and previous files in this longitudinal group." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_Biological_probe_median a owl:DatatypeProperty ;
    rdfs:label "GeoMx Biological probe median" ;
    rdfs:range xsd:float ;
    skos:definition "Is the median count from all probes except the negative control probes. A measure of signal to background for each segment" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_Imaging_AOI_Coordinates a owl:DatatypeProperty ;
    rdfs:label "GeoMx Imaging AOI Coordinates" ;
    skos:definition "Synapse Id(s) of tabular file(s) containing coordinate points for AOIs found in the image; multiple values should be provided as a comma-separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_Imaging_Channel_Names a owl:DatatypeProperty ;
    rdfs:label "GeoMx Imaging Channel Names" ;
    skos:definition "Name(s) of imaging channel(s) associated with the image; multiple values should be provided as a comma-separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_In_Situ_Negative_median a owl:DatatypeProperty ;
    rdfs:label "GeoMx In Situ Negative median" ;
    rdfs:range xsd:float ;
    skos:definition "Is the median of all negative control probes for a given segment. A measure of signal to background for each segment." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_QC_status a owl:DatatypeProperty ;
    rdfs:label "GeoMx QC status" ;
    skos:definition "ROI quality control flag as reported by the application" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:GeoMx_Sequencing_Saturation a owl:DatatypeProperty ;
    rdfs:label "GeoMx Sequencing Saturation" ;
    rdfs:range xsd:float ;
    skos:definition "The fraction of reads originating from an already-observed UMI. This is a function of library complexity and sequencing depth. More specifically, this is the fraction of confidently mapped, valid spot-barcode, valid UMI reads that had a non-unique (spot-barcode, UMI, gene)." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

