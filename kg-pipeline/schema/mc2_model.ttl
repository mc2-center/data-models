            owl:onProperty mc2:doi ] ;
    skos:definition "The manifest used to describe datasets for the Synapse Data Catalog." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:DataDSP a owl:Class ;
    rdfs:label "DataDSP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:DSP_Planned_Upload_Date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:Study_Key ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:DSP_Dataset_Assay ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:DSP_Number_of_Samples ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "syn\\d+" ] ) ] ;
            owl:onProperty mc2:DSP_IRB_Form ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:DSP_Dataset_Destination ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:DSP_Dataset_Description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:DatasetView_Key ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:DSP_Dataset_Name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:DSP_Dataset_Url ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mc2:DSP_Dataset_Species ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:GrantView_Key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:DSP_IRB_Form ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "CA\\d{6}" ] ) ] ;
            owl:onProperty mc2:GrantView_Key ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^CA\\d{6}-DSP-\\d{2,9}$" ] ) ] ;
            owl:onProperty mc2:DataDSP_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:DSP_Dataset_Alias ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:DSP_Dataset_Level ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:DSP_Storage_Size ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:DSP_Number_of_Files ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty mc2:DataDSP_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:DSP_Planned_Release_Date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mc2:DSP_Number_of_Participants ] ;
    skos:definition "Dataset sharing plan information. Used to indicate planned usage of MC2 Center supported Synapse projects." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

mc2:DataDSP_Key a owl:DatatypeProperty ;
    rdfs:label "DataDSP Key" ;
    skos:definition "Unique DataDSP_id foreign key(s) that link metadata entries as part of the same collection. Please provide multiple values as a comma-separated list." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:foreign_key true .

mc2:Data_Use_Codes a owl:ObjectProperty ;
    rdfs:label "Data Use Codes" ;
    rdfs:range mc2:DataUseCodesEnum ;
    skos:definition "DUO code - A data item that is used to indicate consent permissions for datasets and/or materials, and relates to the purposes for which datasets and/or material might be removed, stored or used. Available DUO code definitions can be found here: https://mc2-center.github.io/data-models/valid_values/study/#attribute-study-data-use-codes" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "0002001" .

mc2:DatasetView a owl:Class ;
    rdfs:label "Dataset View" ;
    rdfs:subClassOf [ a owl:Restriction ;
