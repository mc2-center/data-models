mc2:NGS_Library_Layout a owl:ObjectProperty ;
    rdfs:label "NGS Library Layout" ;
    rdfs:range mc2:NGSLibraryLayoutEnum ;
    skos:definition "Text description of the library layout, one of Paired-end or Single." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "11527735" .

mc2:NGS_Library_Selection_Method a owl:ObjectProperty ;
    rdfs:label "NGS Library Selection Method" ;
    rdfs:range mc2:NGSLibrarySelectionMethodEnum ;
    skos:definition "How nucleic acid molecules are isolated." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "6347743" .

mc2:NGS_Library_Source_Material a owl:ObjectProperty ;
    rdfs:label "NGS Library Source Material" ;
    rdfs:range mc2:NGSLibrarySourceMaterialEnum ;
    skos:definition "The type of source material being sequenced." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "15235975" .

mc2:NGS_Library_Source_Molecule a owl:ObjectProperty ;
    rdfs:label "NGS Library Source Molecule" ;
    rdfs:range mc2:NGSLibrarySourceMoleculeEnum ;
    skos:definition "The source of nucleic acids represented in the sequencing library." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "15235981" .

mc2:NGS_Library_Strategy a owl:ObjectProperty ;
    rdfs:label "NGS Library Strategy" ;
    rdfs:range mc2:NGSLibraryStrategyEnum ;
    skos:definition "The assay associated with the nucleic acid library (e.g., RNA-Seq, ChIP-Seq)" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "6273393" .

mc2:NGS_Read_Length a owl:DatatypeProperty ;
    rdfs:label "NGS Read Length" ;
    rdfs:range xsd:float ;
    skos:definition "The average length of the sequencing reads. Can be integer, null" ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "12426615" .

mc2:NGS_Sequencing_Design_Description a owl:DatatypeProperty ;
    rdfs:label "NGS Sequencing Design Description" ;
    skos:definition "Free-form description of the methods used to create the sequencing library; a brief 'materials and methods' section." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> ;
    mc2:cde_id "11529028" .

mc2:NGS_Unique_Bases a owl:DatatypeProperty ;
    rdfs:label "NGS Unique Bases" ;
    rdfs:range xsd:float ;
    skos:definition "Count of unique basecalls present in the data." ;
    skos:inScheme <https://w3id.org/mc2-center/mc2-model> .

