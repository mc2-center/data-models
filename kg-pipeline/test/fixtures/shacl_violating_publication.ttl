@prefix cckp:    <https://w3id.org/mc2-center/cckp-portal/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# Violates PublicationShape: pubMedId is a plain string, not xsd:integer.
<https://w3id.org/mc2-center/cckp-portal/data/Publication/p1>
    rdf:type cckp:Publication ;
    cckp:pubMedId "12345678" .
