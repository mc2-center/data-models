<https://w3id.org/mc2-center/cckp-portal/data/Publication/12345678>
    rdf:type cckp:Publication ;
    cckp:pubMedId "12345678"^^xsd:integer ;
    cckp:pubMedIdIri <https://pubmed.ncbi.nlm.nih.gov/12345678> ;
    cckp:grantNumberRef <https://w3id.org/mc2-center/cckp-portal/data/Grant/syn_grant_1> ;
