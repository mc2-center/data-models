# name: investigator_ref_targets_are_persons
# expect: empty
# description: Every cckp:investigatorRef/contributorRef edge (from
#   link_scdm.py's link_investigators()) should point at a node typed
#   sagecdm:Person - catches a broken mint/lookup returning the wrong IRI.
PREFIX cckp: <https://w3id.org/mc2-center/cckp-portal/>
PREFIX sagecdm: <https://sage-bionetworks.github.io/SageCommonDataModel/>

SELECT ?subject ?predicate ?target WHERE {
  { ?subject cckp:investigatorRef ?target . BIND(cckp:investigatorRef AS ?predicate) }
  UNION
  { ?subject cckp:contributorRef ?target . BIND(cckp:contributorRef AS ?predicate) }
  FILTER NOT EXISTS { ?target a sagecdm:Person }
}
