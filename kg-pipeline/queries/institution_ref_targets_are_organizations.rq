# name: institution_ref_targets_are_organizations
# expect: empty
# description: Every cckp:institutionRef edge (from link_scdm.py's
#   link_institutions()) should point at a node typed sagecdm:Organization -
#   catches a crosswalk lookup returning a stale or mistyped id.
PREFIX cckp: <https://w3id.org/mc2-center/cckp-portal/>
PREFIX sagecdm: <https://sage-bionetworks.github.io/SageCommonDataModel/>

SELECT ?subject ?target WHERE {
  ?subject cckp:institutionRef ?target .
  FILTER NOT EXISTS { ?target a sagecdm:Organization }
}
