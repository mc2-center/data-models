# History files
.Rhistory
.Rapp.history

venv/

# Session Data files
.RData

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron
.venv/

# schematic-related files
great_expectations/
.DS_Store
**/.DS_Store
**/**/.DS_Store

# MKDocs
scripts/__pycache__

# Release workflow outputs
release_output.txt

# KG pipeline generated data (raw/harmonized extracts + RDF instance graphs;
# schema/*.ttl and mappings/sssom/*.tsv ARE committed, these row-level
# extracts are not)
kg-pipeline/data/raw/*
kg-pipeline/data/harmonized/*
kg-pipeline/data/rdf/*
!kg-pipeline/data/raw/.gitkeep
!kg-pipeline/data/harmonized/.gitkeep
!kg-pipeline/data/rdf/.gitkeep

# MC2 assay-metadata KG (biospecimen/individual/model/sequencing/imaging):
# same "generated, not committed" rule as above, PLUS this data may be
# access-restricted (sourced from per-file Synapse annotations that can
# require login), unlike the public CCKP portal tables above - never lift
# this rule even if the public data/ rule above ever changes.
kg-pipeline/data/mc2_assay/raw/*
kg-pipeline/data/mc2_assay/harmonized/*
kg-pipeline/data/mc2_assay/rdf/*
!kg-pipeline/data/mc2_assay/raw/.gitkeep
!kg-pipeline/data/mc2_assay/harmonized/.gitkeep
!kg-pipeline/data/mc2_assay/rdf/.gitkeep

kg-pipeline/__pycache__/
kg-pipeline/**/__pycache__/
kg-pipeline/.venv/
.pytest_cache/