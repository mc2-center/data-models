{
  "$id": "http://example.com/FileView",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "if": {
        "properties": {
          "DataUseCodes": {
            "enum": [
              "COL"
            ]
          }
        },
        "required": [
          "DataUseCodes"
        ]
      },
      "then": {
        "properties": {
          "CollaborationRequired": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "CollaborationRequired"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseCodes": {
            "enum": [
              "MOR"
            ]
          }
        },
        "required": [
          "DataUseCodes"
        ]
      },
      "then": {
        "properties": {
          "PublicationMoratorium": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "PublicationMoratorium"
        ]
      }
    }
  ],
  "description": "The denormalized manifest for file submission.",
  "properties": {
    "BiospecimenKey": {
      "description": "Unique Biospecimen_id foreign key(s) that link metadata entries as part of the same collection. Please provide multiple values as a comma-separated list.",
      "title": "Biospecimen Key",
      "type": "string"
    },
    "CollaborationRequired": {
      "description": "If collaboration is required for the access requirement, provide the PI email address. Provide multiple as a comma-separated list.",
      "title": "collaborationRequired",
      "type": "string"
    },
    "Component": {
      "description": "Category of metadata (e.g. Tools, Publications, etc.); provide the same one for all items/rows.",
      "title": "Component",
      "type": "string"
    },
    "DataUseCodes": {
      "description": " https",
