    "GrantInvestigator": {
      "description": "Investigator(s) associated witht the grant. 1...*",
      "items": {
        "type": "string"
      },
      "title": "Grant Investigator",
      "type": "array"
    },
    "GrantName": {
      "description": "Name of the grant",
      "title": "Grant Name",
      "type": "string"
    },
    "GrantNumber": {
      "description": "Number of the grant (i.e. \"CA------\" format)",
      "pattern": "^CA\\d{6}$",
      "title": "Grant Number",
      "type": "string"
    },
    "GrantStartDate": {
      "description": "The start date of the grant YYYY-MM-DD format",
      "format": "date",
      "title": "Grant Start Date",
      "type": "string"
    },
    "GrantSynapseProject": {
      "description": "The Synapse project associated with the grant, created by the MC2 Center",
      "format": "uri",
      "title": "Grant Synapse Project",
      "type": "string"
    },
    "GrantSynapseTeam": {
      "description": "The Synapse team associated with the grant, created by the MC2 Center",
      "format": "uri",
      "title": "Grant Synapse Team",
      "type": "string"
    },
    "GrantThemeName": {
      "description": "Theme(s) associated with the grant. 1...*",
      "items": {
        "enum": [
          "ComputationalModelDevelopment",
          "ComputationalResource",
          "DrugResistance/Sensitivity",
          "Epigenetics",
          "Evolution",
          "ExperimentalModelDevelopment",
          "Heterogeneity",
          "Immunotherapy",
          "Mechano-genetics",
          "Mechano-resistance",
          "Metabolism",
          "Metastasis",
          "Method/AssayDevelopment",
          "Microenvironment",
          "OncogenicStress",
          "PlatformDevelopment",
          "Tumor-Immune",
          "TumorProgression"
        ],
        "type": "string"
      },
      "title": "Grant Theme Name",
      "type": "array"
    },
    "GrantType": {
      "description": "Type of grant",
      "enum": [
        "R01",
        "R21",
        "R37",
        "U01",
        "U24",
        "U54"
      ],
      "title": "Grant Type"
    },
    "GrantViewId": {
      "description": "Unique row identifier, used as a primary key for record updates. This should be equivalent to the grant number in CAxxxxxx format unless otherwise indicated.",
      "title": "GrantView_id",
      "type": "string"
    },
    "NIHRePORTERLink": {
      "description": "Link to the search results for this grant number on the NIH Reporter website",
      "format": "uri",
      "title": "NIH RePORTER Link",
      "type": "string"
    }
  },
  "required": [
    "GrantAbstract",
    "GrantConsortiumName",
    "GrantEndDate",
    "GrantInstitutionAlias",
    "GrantInstitutionName",
    "GrantInvestigator",
    "GrantName",
    "GrantNumber",
    "GrantStartDate",
    "GrantThemeName",
    "GrantType",
    "GrantViewId",
    "NIHRePORTERLink"
  ],
  "title": "GrantView",
  "type": "object"
}