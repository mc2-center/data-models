{
  "$id": "http://example.com/GrantView",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "The denormalized manifest for grant submission.",
  "properties": {
    "DurationofFunding": {
      "description": "Duration of the funding period, in years",
      "title": "Duration of Funding",
      "type": "number"
    },
    "EmbargoEndDate": {
      "description": "Date at which an embargo on related resources had lifted",
      "format": "date",
      "title": "Embargo End Date",
      "type": "string"
    },
    "GrantAbstract": {
      "description": "Abstract for the grant",
      "title": "Grant Abstract",
      "type": "string"
    },
    "GrantConsortiumName": {
      "description": "Consortium(s) associated with the grant. 1...1",
      "enum": [
        "CCBIR",
        "CSBC",
        "HTAN",
        "ICBP",
        "MetNet",
        "NCI",
        "NCIClinicalandTranslationalExploratory/DevelopmentalStudies",
        "PDMC",
        "PS-ON",
        "SageBionetworks",
        "TEC"
      ],
      "title": "Grant Consortium Name"
    },
    "GrantEndDate": {
      "description": "The end date of the grant YYYY-MM-DD format",
      "format": "date",
      "title": "Grant End Date",
      "type": "string"
    },
    "GrantInstitutionAlias": {
      "description": "The alias of the institution(s) associated with the grant (e.g. UCSD). 1...*",
