          "DUO:0000046",
          "DUOPlus1",
          "DUOPlus2",
          "DUOPlus3",
          "DUOPlus4",
          "DUOPlus5",
          "DUOPlus6",
          "DUOPlus7",
          "PendingAnnotation"
        ],
        "type": "string"
