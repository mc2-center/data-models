{
  "$id": "http://example.com/Study",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "enum": [
              "COL"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "CollaborationRequired": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "CollaborationRequired"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "enum": [
              "DSR"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "DiseaseSpecificResearch": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "DiseaseSpecificResearch"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "enum": [
              "DUOPlus1"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "SourceGeography": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "SourceGeography"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "enum": [
              "DUOPlus2"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "PopulationType": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "PopulationType"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "enum": [
              "DUOPlus3"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "DeidentificationType": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "DeidentificationType"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "enum": [
              "DUOPlus4"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "DataPermission": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "DataPermission"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "enum": [
              "DUOPlus5"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "DataTier": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "DataTier"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "enum": [
              "DUOPlus6"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "License": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "License"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "enum": [
              "DUOPlus7"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "Attribution": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "Attribution"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "enum": [
              "GSR"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "GeographicalRestriction": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "GeographicalRestriction"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "enum": [
              "IST"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "InstitutionSpecificRestriction": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "InstitutionSpecificRestriction"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "enum": [
              "MOR"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "PublicationMoratorium": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "PublicationMoratorium"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "enum": [
              "RST"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "ResearchSpecificRestrictions": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "ResearchSpecificRestrictions"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "enum": [
              "TSM"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "TimeLimitOnUse": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "TimeLimitOnUse"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "enum": [
              "USE"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "UserSpecificRestriction": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "UserSpecificRestriction"
        ]
      }
    }
  ],
  "description": "Studies associated with a grant",
  "properties": {
    "Attribution": {
      "description": "The attribution statement for the data associated with the access requirement. Equivalent to DUOPlus7.",
      "title": "attribution",
      "type": "string"
    },
    "CollaborationRequired": {
      "description": "If collaboration is required for the access requirement, provide the PI email address. Provide multiple as a comma-separated list.",
      "title": "collaborationRequired",
      "type": "string"
    },
    "Component": {
      "description": "Category of metadata (e.g. Tools, Publications, etc.); provide the same one for all items/rows.",
      "title": "Component",
      "type": "string"
    },
    "DataPermission": {
      "description": "The permissions associated with the data under the access requirement. Equivalent to DUOPlus4.",
      "items": {
        "enum": [
          "Agreement",
          "Attestation",
          "Award",
          "Other"
        ],
        "type": "string"
      },
      "title": "dataPermission",
      "type": "array"
    },
    "DataTier": {
      "description": "The tier of data access associated with the access requirement. Equivalent to DUOPlus5.",
      "items": {
        "enum": [
          "Anonymous",
          "Controlled",
          "Open",
          "Private"
        ],
        "type": "string"
      },
      "title": "dataTier",
      "type": "array"
    },
    "DataUseModifiers": {
      "description": "A list of data use modifiers that apply to the access requirement. Examples include GRU, IRB, etc.",
      "items": {
        "enum": [
          "CC",
          "COL",
          "DSR",
          "DUM",
          "DUOPlus1",
          "DUOPlus2",
          "DUOPlus3",
          "DUOPlus4",
          "DUOPlus5",
          "DUOPlus6",
          "DUOPlus7",
          "GRU",
          "GSO",
          "GSR",
          "HMB",
          "IRB",
          "IST",
          "MOR",
          "NCU",
          "NMDS",
          "NPOA",
          "NPU",
          "NPUNCU",
          "NRES",
          "POA",
          "PS",
          "PUB",
          "Pending Annotation",
          "RST",
          "RTN",
          "TSM",
          "USE"
        ],
        "type": "string"
      },
      "title": "dataUseModifiers",
      "type": "array"
    },
    "DeidentificationType": {
      "description": "The type of de-identification applied to the data associated with the access requirement. Equivalent to DUOPlus3.",
      "items": {
        "enum": [
          "Automatic",
          "Manual",
          "Not Applicable",
          "Semiautomatic"
        ],
        "type": "string"
      },
      "title": "deidentificationType",
      "type": "array"
    },
    "DiseaseSpecificResearch": {
      "description": "id. Provide multiple values as a comma-separated list. MONDO terms can be found here",
      "pattern": "MONDO:\\d{7}",
      "title": "diseaseSpecificResearch",
      "type": "array"
    },
