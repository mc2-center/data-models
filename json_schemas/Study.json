    "StudyDeidentificationMethodDescription": {
      "description": "Description of the process of removing potentially identifying data or data elements to render data into a form that does not identify individuals and where identification is not likely to take place.",
      "title": "Study Deidentification Method Description",
      "type": "string"
    },
    "StudyDeidentificationMethodSoftware": {
      "description": "Software that was used to de-identify the data (if used)",
      "title": "Study Deidentification Method Software",
      "type": "string"
    },
    "StudyDeidentificationMethodType": {
      "description": "General description of the de-identification method. Maps to DUOplus3.",
      "enum": [
        "Automatic",
        "Manual",
        "NotApplicable",
        "Semiautomatic"
      ],
      "title": "Study Deidentification Method Type"
    },
    "StudyDescription": {
      "description": "Description of the study, including the types of experimental assays, model systems, types of analysis, description of cohort, associated vulnerable populations, special categories of data, rare diseases, etc. Maps to DUOplus2.",
      "title": "Study Description",
      "type": "string"
    },
    "StudyId": {
      "description": "Unique row identifier, used as a primary key for record updates.",
      "title": "Study_id",
      "type": "string"
    },
    "StudyIndexDate": {
      "description": "The reference event associated with timepoints in this study. One of Diagnosis Date, Enrollment Date, Collection Date, or Birth Date.",
      "enum": [
        "BirthDate",
        "CollectionDate",
        "DiagnosisDate",
        "EnrollmentDate"
      ],
      "title": "Study Index Date"
    },
