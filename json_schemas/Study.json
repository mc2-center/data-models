    "StudyDe-identificationMethodDescription": {
      "description": "Description of the process of removing potentially identifying data or data elements to render data into a form that does not identify individuals and where identification is not likely to take place.",
      "title": "Study De-identification Method Description",
      "type": "string"
    },
    "StudyDe-identificationMethodSoftware": {
      "description": "Software that was used to de-identify the data (if used)",
      "title": "Study De-identification Method Software",
      "type": "string"
    },
    "StudyDe-identificationMethodType": {
      "description": "General description of the de-identification method. Maps to DUOplus3.",
      "enum": [
        "Automatic",
        "Manual",
        "Not Applicable",
        "Semiautomatic"
      ],
      "title": "Study De-identification Method Type"
    },
    "StudyDescription": {
      "description": "Description of the study, including the types of experimental assays, model systems, types of analysis, description of cohort, associated vulnerable populations, special categories of data, rare diseases, etc. Maps to DUOplus2.",
      "title": "Study Description",
      "type": "string"
    },
    "StudyId": {
      "description": "A unique primary key that enables record updates using schematic.",
      "title": "Study_id",
      "type": "string"
    },
    "StudyIndexDate": {
      "description": "The reference event associated with timepoints in this study. One of Diagnosis Date, Enrollment Date, Collection Date, or Birth Date.",
      "enum": [
        "Birth Date",
        "Collection Date",
        "Diagnosis Date",
        "Enrollment Date"
      ],
      "title": "Study Index Date"
    },
    "StudyInvestigator": {
      "description": "Investigator(s) associated with the project. Multiple names should be provided as a comma-separated list.",
      "title": "Study Investigator",
      "type": "array"
    },
    "StudyName": {
      "description": "Name of the study",
      "title": "Study Name",
      "type": "string"
    },
    "StudyNumberofParticipants": {
      "description": "The number of participant instances associated with systematic investigation into a subject.",
      "title": "Study Number of Participants",
      "type": "number"
    },
    "StudyNumberofSamples": {
      "description": "TBD",
      "title": "Study Number of Samples"
    },
    "StudyProjectIdentifier": {
      "description": "The Synapse Project identifier (synID) with which this Study is related.",
      "pattern": "syn[0-9]+",
      "title": "Study Project Identifier",
      "type": "array"
    },
    "StudydbGaPAccessionId": {
      "description": "A stable unique alphanumeric identifier assigned to a study and any objects by the database of Genotypes and Phenotypes (dbGaP). Required for controlled access data being submitted to CDS/CRDC.",
      "title": "Study dbGaP Accession Id",
      "type": "string"
    },
    "TimeLimitOnUse": {
      "description": "Time limit on the use of the data associated with the access requirement.",
      "title": "timeLimitOnUse",
      "type": "number"
    },
    "UserSpecificRestriction": {
      "description": "The user-specific restrictions associated with the access requirement.",
      "title": "userSpecificRestriction",
      "type": "string"
    }
  },
  "required": [
    "Component",
    "StudyDe-identificationMethodType",
    "StudyDescription",
    "StudyId",
    "StudyInvestigator",
    "StudyName",
    "StudyNumberofParticipants"
  ],
  "title": "Study",
  "type": "object"
}