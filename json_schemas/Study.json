    "GrantViewKey": {
      "description": "Unique GrantView_id foreign key(s) that group the resource with other components, as part of the same grant-associated collection. Please provide multiple values as a comma-separated list.",
      "title": "GrantView Key",
      "type": "string"
    },
    "InstitutionSpecificRestriction": {
      "description": "id. Provide multiple entries as a comma-separated list. ROR IDs can be found here",
      "pattern": "ROR:[a-z0-9]{9}",
      "title": "institutionSpecificRestriction",
      "type": "array"
    },
    "License": {
      "description": "The license under which the data associated with the access requirement is shared. Equivalent to DUOPlus6.",
      "items": {
        "enum": [
          "Apache_2",
          "BSD_3_Clause",
          "CC0",
          "CC_BY",
          "CC_BY_NC",
          "CC_BY_NC_ND",
          "CC_BY_NC_SA",
          "CC_BY_ND",
          "CC_BY_SA",
          "GPL_3",
          "MIT"
        ],
        "type": "string"
      },
      "title": "license",
      "type": "array"
    },
    "PersonViewKey": {
      "description": "Unique PersonView_id foreign key(s) that group the resource with other components, as part of the same person-associated studies. Please provide multiple values as a comma-separated list.",
      "title": "PersonView Key",
      "type": "string"
    },
    "PopulationType": {
      "description": "The population studied in the research associated with the access requirement. Equivalent to DUOPlus2",
      "title": "populationType",
      "type": "string"
    },
    "ProjectViewKey": {
      "description": "Unique ProjectView_id foreign key(s) that group the resource with other components, as part of the same grant-associated studies. Please provide multiple values as a comma-separated list.",
      "title": "ProjectView Key",
      "type": "string"
    },
    "PublicationMoratorium": {
      "description": "End date of the publication moratorium associated with the access requirement.",
      "format": "date",
      "title": "publicationMoratorium"
    },
    "ResearchSpecificRestrictions": {
      "description": "Research-specific restrictions associated with the access requirement.",
      "title": "researchSpecificRestrictions",
      "type": "string"
    },
