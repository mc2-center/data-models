{
  "$id": "http://example.com/DataDSP",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "if": {
        "properties": {
          "DSPDataUseCodes": {
            "enum": [
              "COL"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "CollaborationRequired": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "CollaborationRequired"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DSPDataUseCodes": {
            "enum": [
              "DSR"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "DiseaseSpecificResearch": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "DiseaseSpecificResearch"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DSPDataUseCodes": {
            "enum": [
              "DUOPlus1"
