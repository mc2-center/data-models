      "title": "dataCatalogStudyId",
      "type": "string"
    },
    "DataType": {
      "description": "Broad data-type category for the dataset (e.g. gene expression, chromatin activity, genomic variants). Aligned with modules/shared/mc2_iconTag_map_3-4-25.csv's label taxonomy.",
      "items": {
        "enum": [
          "chromatin activity",
          "gene expression",
          "genomic variants",
          "image",
          "immunoassay",
          "network",
          "nucleic acid sequence record"
        ],
        "type": "string"
      },
      "title": "dataType",
      "type": "array"
    },
    "DatasetViewKey": {
      "description": "Unique DatasetView_id foreign key(s) that link metadata entries as part of the same collection. Please provide multiple values as a comma-separated list.",
      "title": "DatasetView Key",
      "type": "string"
    },
    "DatePublished": {
      "description": "Date data were published/available on Synapse.",
      "title": "datePublished",
      "type": "number"
    },
    "Description": {
      "description": "A text description of the dataset. Can be identifical to Dataset Description.",
      "title": "description",
      "type": "string"
    },
    "DiseaseFocus": {
      "description": "Disease area the dataset focuses on, as annotated directly on the Synapse Dataset entity. Not populated in current practice.",
      "title": "diseaseFocus",
      "type": "string"
    },
    "Doi": {
      "description": "Digital Object Identifier (DOI) for citation and identification. Can be identical to Dataset Doi",
      "format": "uri",
      "title": "doi",
      "type": "string"
    },
    "DownloadType": {
      "description": "Hosting type for the dataset's files, as annotated directly on the Synapse Dataset entity (distinct from the CCKP portal's own DatasetView.downloadType column).",
      "enum": [
        "Synapse Hosted",
        "Synapse Indexed"
      ],
      "title": "downloadType"
    },
    "ExternalRepositoryUri": {
      "description": "External repository identifier(s) for the dataset, as CURIE-shaped references (e.g. geo:GSE12345, sra:SRP12345, bioproject:PRJNA12345).",
      "items": {
        "type": "string"
      },
      "title": "externalRepositoryUri",
      "type": "array"
    },
    "Funder": {
      "description": "The entity(ies) responsible for funding the data contributors.",
      "items": {
        "enum": [
