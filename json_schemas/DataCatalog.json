{
  "$id": "http://example.com/DataCatalog",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "The manifest used to describe datasets for the Synapse Data Catalog.",
  "properties": {
    "AccessType": {
      "description": "Access type for the dataset.",
      "enum": [
        "Open Access",
        "Restricted Access"
      ],
      "title": "accessType"
    },
    "AgeGroup": {
      "description": "Age group of the individual(s)/subject(s) the dataset's data were generated from (e.g. Adult). Free text pending a confident controlled vocabulary - too few real values observed to seed one yet.",
      "title": "ageGroup",
      "type": "string"
    },
    "AlternateName": {
      "description": "An altername name that can be used for search and discovery improvement.",
      "title": "alternateName",
      "type": "string"
    },
    "Authors": {
      "description": "Author list for the dataset's associated publication. Distinct from creator, which captures the person(s)/organization(s) that generated or deposited the data itself.",
      "items": {
        "type": "string"
      },
      "title": "authors",
      "type": "array"
    },
    "Citation": {
      "description": "Academic articles that are recommended by the data provider to be cited in addition to the dataset doi itself. Can be identical to DatasetView.PublicationView Key.",
      "title": "citation",
      "type": "string"
    },
    "Community": {
      "description": "The Sage Bionetworks project or initiative with which the dataset is associated.",
      "title": "community",
      "type": "string"
    },
    "ConditionsOfAccess": {
      "description": "Additional requirements a user may need outside of Data Use Modifiers. This could include additional registration, updating profile information, joining a Synapse Team, or using specific authentication methods like 2FA or RAS. Omit property if not applicable/unknown.",
