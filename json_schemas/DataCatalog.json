        "enum": [
          "Apache2",
          "BSD3Clause",
          "CC0",
          "CCBY",
          "CCBYNC",
          "CCBYNCND",
          "CCBYNCSA",
          "CCBYND",
          "CCBYSA",
          "GPL3",
          "MIT"
