      "description": "Unique DatasetView_id foreign key(s) that link metadata entries as part of the same collection. Please provide multiple values as a comma-separated list.",
      "title": "DatasetView Key",
      "type": "string"
    },
    "DatePublished": {
      "description": "Date data were published/available on Synapse.",
      "title": "datePublished",
      "type": "integer"
    },
    "Description": {
      "description": "A text description of the dataset. Can be identifical to Dataset Description.",
      "title": "description",
      "type": "string"
    },
    "Doi": {
      "description": "Digital Object Identifier (DOI) for citation and identification. Can be identical to Dataset Doi",
      "format": "uri",
      "title": "doi",
      "type": "string"
    },
    "Funder": {
      "description": "The entity(ies) responsible for funding the data contributors.",
      "enum": [
        "NIH"
      ],
      "title": "funder"
    },
    "GrantViewKey": {
      "description": "Unique GrantView_id foreign key(s) that group the resource with other components, as part of the same grant-associated collection. Please provide multiple values as a comma-separated list.",
      "title": "GrantView Key",
      "type": "string"
    },
    "IncludedInDataCatalog": {
      "description": "Link(s) to known data catalog(s) the dataset is included in.",
      "title": "includedInDataCatalog",
      "type": "string"
    },
    "Individuals": {
      "description": "The number of participants or samples associated with the files in the dataset. Can be identical to Study Number of Participants or DSP Number of Participants",
      "title": "individuals",
      "type": "integer"
    },
    "Keywords": {
      "description": "Keywords associated with the dataset. Can be identical to Publication Keywords.",
      "title": "keywords",
      "type": "string"
    },
    "License": {
      "description": "The license under which the data associated with the access requirement is shared. Equivalent to DUOPlus6.",
