{
  "$id": "http://example.com/ToolView",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "The denormalized manifest for tool submission.",
  "properties": {
    "Component": {
      "description": "Category of metadata (e.g. Tools, Publications, etc.); provide the same one for all items/rows.",
      "title": "Component",
      "type": "string"
    },
    "DatasetViewKey": {
      "description": "Unique DatasetView_id foreign key(s) that link metadata entries as part of the same collection. Please provide multiple values as a comma-separated list.",
      "title": "DatasetView Key",
      "type": "string"
    },
    "GrantViewKey": {
      "description": "Unique GrantView_id foreign key(s) that group the resource with other components, as part of the same grant-associated collection. Please provide multiple values as a comma-separated list.",
      "title": "GrantView Key",
      "type": "string"
    },
    "PublicationViewKey": {
      "description": "Unique PublicationView_id foreign key(s) that link metadata entries as part of the same collection. Please provide multiple values as a comma-separated list.",
      "title": "PublicationView Key",
      "type": "string"
    },
    "StudyKey": {
      "description": "The unique Study_id foreign keys associated with the resource, found in the grant Study information. Used to group the resource with other components. Please provide multiple values as a comma-separated list.",
      "title": "Study Key",
      "type": "string"
    },
    "ToolAccessibility": {
      "description": "Whether there are non-monetary restrictions on accessing an online service.",
      "enum": [
        "OpenAccess",
        "OpenAccess(WithRestrictions)",
        "RestrictedAccess"
      ],
      "title": "Tool Accessibility"
    },
    "ToolCmd": {
      "description": "Relevant command, command-line fragment, or option for executing this function/running the tool in this mode.",
      "title": "Tool Cmd",
      "type": "string"
    },
    "ToolComputeRequirements": {
      "description": " DirectX, Java or .NET runtime).",
      "title": "Tool Compute Requirements",
      "type": "array"
    },
    "ToolCost": {
      "description": "Monetary cost of acquiring the software.",
      "enum": [
        "Commercial",
        "FreeofCharge",
        "FreeofCharge(WithRestrictions)"
      ],
      "title": "Tool Cost"
    },
    "ToolDateLastModified": {
      "description": "The date indicating when the tool's entry was most recently modified or updated, providing a timestamp of the latest changes made to the tool's information.",
      "format": "date",
      "title": "Tool Date Last Modified",
      "type": "string"
    },
    "ToolDescription": {
      "description": "Textual description of the tool.",
      "title": "Tool Description",
      "type": "string"
    },
    "ToolDocumentationNote": {
      "description": "Comment about the documentation.",
      "title": "Tool Documentation Note",
      "type": "string"
    },
    "ToolDocumentationType": {
      "description": "Type of documentation that is linked to. Multiple values permitted, comma separated.",
      "items": {
        "enum": [
          "APIDocumentation",
          "CitationInstructions",
          "CodeofConduct",
          "Command-LineOptions",
          "ContributionsPolicy",
          "FAQ",
          "General",
          "Governance",
          "InstallationInstructions",
          "Other",
          "QuickStartGuide",
          "ReleaseNotes",
          "TermsofUse",
          "TrainingMaterial",
          "UserManual"
        ],
        "type": "string"
      },
      "title": "Tool Documentation Type",
      "type": "array"
    },
    "ToolDocumentationUrl": {
      "description": "Link to documentation on the web for the tool.",
      "format": "uri",
      "title": "Tool Documentation Url",
      "type": "string"
    },
    "ToolDoi": {
      "description": "The Digital Object Identifier (DOI) associated with the computational tool.",
      "format": "uri",
      "title": "Tool Doi",
      "type": "string"
    },
    "ToolDownloadNote": {
      "description": "Comment about the download.",
      "title": "Tool Download Note",
      "type": "string"
    },
    "ToolDownloadType": {
      "description": "The type of data, information, or system that is obtained when the link is resolved.",
      "enum": [
        "APISpecification",
        "Binaries",
        "BiologicalData",
        "Command-LineSpecification",
        "ContainerFile",
        "DownloadsPage",
        "Icon",
        "Other",
        "Screenshot",
        "SoftwarePackage",
        "SourceCode",
        "TestData",
        "TestScript",
        "ToolWrapper(CWL)",
        "ToolWrapper(Galaxy)",
        "ToolWrapper(Taverna)",
        "Toolwrapper(Other)",
        "VMImage"
      ],
      "title": "Tool Download Type"
    },
    "ToolDownloadUrl": {
      "description": "Link to download (or repo providing a download) for the software.",
      "format": "uri",
      "title": "Tool Download Url",
      "type": "string"
    },
    "ToolDownloadVersion": {
      "description": "Version information (typically a version number) of the software applicable to this download.",
      "title": "Tool Download Version",
      "type": "string"
    },
    "ToolEntityName": {
      "description": "Name of the entities that may be credited",
      "title": "Tool Entity Name",
      "type": "array"
    },
    "ToolEntityRole": {
      "description": "Role performed by entity that is credited, e.g. “Developer”",
      "items": {
        "enum": [
          "Contributor",
          "Developer",
          "Documentor",
          "Maintainer",
          "PrimaryContact",
          "Provider",
          "Support"
        ],
        "type": "string"
      },
      "title": "Tool Entity Role",
      "type": "array"
    },
    "ToolEntityType": {
      "description": "Types of entities that may be credited, e.g. ‘Person’.",
      "items": {
        "enum": [
          "Division",
          "FundingAgency",
          "Institute",
          "Person",
          "Project",
          "ResearchConsortium"
        ],
        "type": "string"
      },
      "title": "Tool Entity Type",
      "type": "array"
    },
    "ToolFunctionNote": {
      "description": "Concise comment about this function, if not apparent from the software description and EDAM annotations.",
      "title": "Tool Function Note",
      "type": "string"
    },
    "ToolHomepage": {
      "description": "Homepage of the software, or some URL that best serves this purpose.",
      "format": "uri",
      "title": "Tool Homepage",
      "type": "string"
    },
