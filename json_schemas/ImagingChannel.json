      "title": "Channel Metal Symbol"
    },
    "ChannelName": {
      "description": "This must match the corresponding field in the OME-XML / TIFF header. (eg 'Blue' or 'CD45' or 'E-cadherin')",
      "title": "Channel Name",
      "type": "string"
    },
    "ChannelOligoBarcodeLowerStrand": {
      "description": "Oligo Barcode - Lower Strand",
      "title": "Channel Oligo Barcode Lower Strand",
      "type": "string"
    },
    "ChannelOligoBarcodeUpperStrand": {
      "description": "Oligo Barcode - Upper Strand",
      "title": "Channel Oligo Barcode Upper Strand",
      "type": "string"
    },
    "ChannelPassedQC": {
      "description": "Identify stains that did not pass QC but are included in the dataset.",
      "enum": [
        "No-ChannelFailedQC",
        "Yes"
      ],
      "title": "Channel Passed QC"
    },
    "ChannelProbeConcentration": {
      "description": "Concentration (eg 10ug/mL)",
      "title": "Channel Probe Concentration",
      "type": "string"
    },
    "ChannelProbeDilutionRatio": {
      "description": "Dilution (eg 1:1000)",
      "title": "Channel Probe Dilution Ratio",
      "type": "string"
    },
    "ChannelResourceID": {
      "description": "Research Resource Identifier (eg “RRID: AB_394606”)",
      "title": "Channel Resource ID",
      "type": "string"
    },
    "ChannelSub-cycleNumber": {
      "description": "Sub cycle number",
      "title": "Channel Sub-cycle Number",
      "type": "number"
    },
    "ChannelTargetName": {
      "description": "Short descriptive name (abbreviation) for this target (antigen)",
      "title": "Channel Target Name",
      "type": "string"
    },
    "ImagingChannelId": {
      "description": "Unique row identifier, used as a primary key for record updates.",
      "title": "ImagingChannel_id",
      "type": "string"
    },
    "StudyKey": {
      "description": "The unique Study_id foreign keys associated with the resource, found in the grant Study information. Used to group the resource with other components. Please provide multiple values as a comma-separated list.",
      "title": "Study Key",
      "type": "string"
    }
  },
  "required": [
    "ChannelIdentifier",
    "ChannelName",
    "ChannelTargetName",
    "ImagingChannelId"
  ],
  "title": "ImagingChannel",
  "type": "object"
}