{
  "$id": "http://example.com/ImagingChannel",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Channel-level Metadata Attributes",
  "properties": {
    "ChannelAntibodyCatalogNumber": {
      "description": "Catalog Number",
      "title": "Channel Antibody Catalog Number",
      "type": "string"
    },
    "ChannelAntibodyClone": {
      "description": "Clone",
      "title": "Channel Antibody Clone",
      "type": "string"
    },
    "ChannelAntibodyLot": {
      "description": "Lot number from vendor",
      "title": "Channel Antibody Lot",
      "type": "string"
    },
    "ChannelAntibodyName": {
      "description": "Antibody Name (free text (eg “Keratin”, “CD163”, “DNA”))",
      "title": "Channel Antibody Name",
      "type": "string"
    },
    "ChannelAntibodyRole": {
      "description": "Is this antibody acting as a primary or secondary antibody?",
      "enum": [
        "Primary",
        "Secondary"
      ],
      "title": "Channel Antibody Role"
    },
    "ChannelAntibodyVendor": {
      "description": "Vendor",
      "title": "Channel Antibody Vendor",
      "type": "string"
    },
    "ChannelCycleNumber": {
      "description": "The cycle # in which the co-listed reagent(s) was(were) used. Integer >= 1 (up to number of cycles)",
      "title": "Channel Cycle Number",
      "type": "number"
    },
    "ChannelEmissionBandwidth": {
      "description": "Nominal width of emission spectrum (nm)",
      "title": "Channel Emission Bandwidth",
      "type": "number"
    },
    "ChannelEmissionWavelength": {
      "description": "Center/peak of the emission spectrum (nm)",
      "title": "Channel Emission Wavelength",
      "type": "number"
    },
    "ChannelExcitationBandwidth": {
      "description": "Nominal width of excitation spectrum (nm)",
      "title": "Channel Excitation Bandwidth",
      "type": "number"
    },
    "ChannelExcitationWavelength": {
      "description": "Center/peak of the excitation spectrum (nm)",
      "title": "Channel Excitation Wavelength",
      "type": "number"
    },
    "ChannelFluorophore": {
      "description": "Fluorescent dye label (eg Alexa Fluor 488)",
      "title": "Channel Fluorophore",
      "type": "string"
    },
    "ChannelIdentifier": {
      "description": "This must match the corresponding field in the OME-XML / TIFF header. (eg 'Channel:0:1')",
      "title": "Channel Identifier",
      "type": "string"
    },
    "ChannelMetalIsotope": {
      "description": "Element mass number",
      "title": "Channel Metal Isotope",
      "type": "number"
    },
    "ChannelMetalSymbol": {
