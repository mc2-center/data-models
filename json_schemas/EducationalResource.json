{
  "$id": "http://example.com/EducationalResource",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Manifest for describing educational resources.",
  "properties": {
    "DatasetViewKey": {
      "description": "Unique DatasetView_id foreign key(s) that link metadata entries as part of the same collection. Please provide multiple values as a comma-separated list.",
      "title": "DatasetView Key",
      "type": "string"
    },
    "EducationalResourceId": {
      "description": "Unique ID associated with a Educational Resource entry, used as a key for record linking and updates.",
      "title": "EducationalResource_id",
      "type": "string"
    },
    "GrantViewKey": {
      "description": "Unique GrantView_id foreign key(s) that group the resource with other components, as part of the same grant-associated collection. Please provide multiple values as a comma-separated list.",
      "pattern": "CA\\d{6}",
      "title": "GrantView Key",
      "type": "string"
    },
    "PublicationViewKey": {
      "description": "Unique PublicationView_id foreign key(s) that link metadata entries as part of the same collection. Please provide multiple values as a comma-separated list.",
      "title": "PublicationView Key",
      "type": "string"
    },
    "ResourceAccessHazard": {
      "description": "Sensory hazards (Flashing, Motion, etc.) applicable to the item. Multiple values should be provided as a comma separated list.",
      "items": {
        "enum": [
          "Flashing",
          "Motion",
          "Simulation",
          "Sound"
        ],
        "type": "string"
      },
      "title": "Resource Access Hazard",
      "type": "array"
    },
    "ResourceActivityType": {
      "description": "The type(s) of activities for which the item is intended to be used. Multiple values should be provided as a comma separated list.",
      "items": {
        "enum": [
          "Activity/Lab",
          "Assessment",
          "CaseStudy",
          "DataSet",
          "Diagram/Illustration",
          "FullCourse",
          "Game",
          "Homework/Assignment",
          "Interactive",
          "Lecture",
          "LectureNotes",
          "Lesson",
          "LessonPlan",
          "Module",
          "PrimarySource",
          "Reading",
          "Simulation",
          "StudentGuide",
          "Syllabus",
          "Teaching/LearningStrategy",
          "Textbook",
          "UnitofStudy"
        ],
        "type": "string"
      },
      "title": "Resource Activity Type",
      "type": "array"
    },
    "ResourceAlias": {
      "description": "A unique identifier (DOI, Synapse ID) for the item, if it exists.",
      "title": "Resource Alias",
      "type": "string"
    },
    "ResourceContributors": {
      "description": "The name(s) of the contributor(s) to the item. Multiple contributor names should be provided as a comma-separated list.",
      "items": {
        "type": "string"
      },
      "title": "Resource Contributors",
      "type": "array"
    },
    "ResourceDatasetAlias": {
      "description": "URL or persistent identifier (DOI, Synapse ID) for any dataset(s) that is intended to be used with the item. Multiple values should be provided as a comma separated list.",
      "items": {
        "type": "string"
      },
      "title": "Resource Dataset Alias",
      "type": "array"
    },
    "ResourceDescription": {
      "description": "Abstract or summary of the item.",
      "title": "Resource Description",
      "type": "string"
    },
    "ResourceDoi": {
      "description": "The Digital Object Identifier (DOI) associated with the educational resource.",
      "format": "uri",
      "title": "Resource Doi",
      "type": "string"
    },
    "ResourceEducationalLevel": {
      "description": "Educational context (pre-school, lower-primary, upper-primary…) in which the item was intended to be used. Multiple values should be provided as a comma separated list.",
      "items": {
        "enum": [
          "AdultEducation",
          "Career/Technical",
          "College/UpperDivision",
          "CommunityCollege/LowerDivision",
          "Graduate/Profession",
          "HighSchool",
          "LowerPrimary",
          "MiddleSchool",
          "Preschool",
          "UpperPrimary"
        ],
        "type": "string"
      },
      "title": "Resource Educational Level",
      "type": "array"
    },
    "ResourceIntendedUse": {
      "description": "The purpose of the material for education. Multiple values should be provided as a comma separated list.",
      "items": {
        "enum": [
          "Assessment",
          "Curriculum/Instruction",
          "Other",
          "ProfessionalDevelopment"
        ],
        "type": "string"
      },
      "title": "Resource Intended Use",
      "type": "array"
    },
    "ResourceInternalIdentifier": {
      "description": "The institution-specific ID for the item, if applicable. May be non-unique. Multiple values should be provided as a comma separated list.",
      "items": {
        "type": "string"
      },
      "title": "Resource Internal Identifier",
      "type": "array"
    },
