        {
            "@id": "bts:BiospecimenId",
            "@type": "rdfs:Class",
            "rdfs:comment": "Unique row identifier, used as a primary key for record updates. This should terminate in ModelKey-Bxxx or IndividualKey-Bxxx format, unless directed otherwise.",
            "rdfs:label": "BiospecimenId",
            "rdfs:subClassOf": [
                {
                    "@id": "bts:Thing"
                }
            ],
            "schema:isPartOf": {
                "@id": "http://schema.biothings.io"
            },
            "sms:IsTemplate": "sms:false",
            "sms:columnType": "string",
            "sms:displayName": "Biospecimen_id",
            "sms:pattern": "B\\d{1,9}$",
            "sms:required": "sms:true",
            "sms:validationRules": []
        },
        {
            "@id": "bts:StudyKey",
            "@type": "rdfs:Class",
            "rdfs:comment": "The unique Study_id foreign keys associated with the resource, found in the grant Study information. Used to group the resource with other components. Please provide multiple values as a comma-separated list.",
            "rdfs:label": "StudyKey",
            "rdfs:subClassOf": [
                {
                    "@id": "bts:Thing"
                }
            ],
            "schema:isPartOf": {
                "@id": "http://schema.biothings.io"
            },
            "sms:IsTemplate": "sms:false",
            "sms:columnType": "string",
            "sms:displayName": "Study Key",
            "sms:required": "sms:false",
            "sms:validationRules": []
        },
        {
            "@id": "bts:IndividualKey",
            "@type": "rdfs:Class",
            "rdfs:comment": "Unique Individual_id foreign key(s) that link metadata entries as part of the same collection. Please provide multiple values as a comma-separated list.",
            "rdfs:label": "IndividualKey",
            "rdfs:subClassOf": [
                {
                    "@id": "bts:Thing"
                }
            ],
            "schema:isPartOf": {
                "@id": "http://schema.biothings.io"
            },
            "sms:IsTemplate": "sms:false",
            "sms:columnType": "string",
            "sms:displayName": "Individual Key",
            "sms:pattern": "CA\\d{6}-IND\\d{1,9}",
            "sms:required": "sms:false",
            "sms:validationRules": []
        },
        {
            "@id": "bts:ModelKey",
            "@type": "rdfs:Class",
            "rdfs:comment": "Unique Model_id foreign key(s) that link metadata entries as part of the same collection. Please provide multiple values as a comma-separate list.",
            "rdfs:label": "ModelKey",
