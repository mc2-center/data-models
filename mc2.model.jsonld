        {
            "@id": "bts:ModelId",
            "@type": "rdfs:Class",
            "rdfs:comment": "Unique row identifier, used as a primary key for record updates. This should use the GrantNumber-Mxxx format unless directed otherwise.",
            "rdfs:label": "ModelId",
            "rdfs:subClassOf": [
                {
                    "@id": "bts:Thing"
                }
            ],
            "schema:isPartOf": {
                "@id": "http://schema.biothings.io"
            },
            "sms:IsTemplate": "sms:false",
            "sms:columnType": "string",
            "sms:displayName": "Model_id",
            "sms:pattern": "^CA\\d{6}-M\\d{1,9}$",
            "sms:required": "sms:true",
            "sms:validationRules": []
        },
        {
