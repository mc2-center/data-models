            "sms:displayName": "Model Key",
            "sms:pattern": "CA\\d{6}-M\\d{1,9}",
            "sms:required": "sms:false",
            "sms:validationRules": []
        },
        {
            "@id": "bts:ParentBiospecimenKey",
