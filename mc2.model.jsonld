            "sms:displayName": "Visium Slide ID",
            "sms:required": "sms:true",
            "sms:validationRules": []
        },
        {
            "@id": "bts:VisiumCaptureArea",
            "@type": "rdfs:Class",
            "rdfs:comment": "Area (or Capture Area) - One of the either four or two active regions where tissue can be placed on a Visium slide. Each area is intended to contain only one tissue sample. Slide areas are named consecutively from top to bottom: A1, B1, C1, D1 for Visium slides with 6.5 mm Capture Area and A, B for CytAssist slides with 11 mm Capture Area. Both CytAssist slides with 6.5 mm Capture Area and Gateway Slides contain only two slide areas, A1 and D1.",
            "rdfs:label": "VisiumCaptureArea",
            "rdfs:subClassOf": [
                {
                    "@id": "bts:Thing"
                }
            ],
            "schema:isPartOf": {
                "@id": "http://schema.biothings.io"
            },
            "schema:rangeIncludes": [
                {
                    "@id": "bts:A"
                },
                {
