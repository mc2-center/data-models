        {
            "@id": "bts:VisiumSlideID",
            "@type": "rdfs:Class",
            "rdfs:comment": "For Visium, it is the unique identifier printed on the label of each Visium slide. The serial number starts with V followed by a number which can range between one through five and ends with a dash and a three digit number, such as 123. For CosMx, this refers to the loaded Flow Cell ID. For Xenium, this ID indicates the slide orientation, as it matches the relative location of the ID on the physical Xenium slide.",
            "rdfs:label": "VisiumSlideID",
            "rdfs:subClassOf": [
                {
                    "@id": "bts:Thing"
                }
            ],
            "schema:isPartOf": {
